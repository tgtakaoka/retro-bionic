(1)     164 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     164 :                    ;;; [queue] The byte ring of ../z80/queue.inc, same structure and
(1)     164 :                    ;;; interface, written for the Z280: the element is addressed by
(1)     164 :                    ;;; base-index addressing, (HL+IX) with HL the offset into the
(1)     164 :                    ;;; structure, instead of two 16-bit adds through DE.
(1)     164 : =0                 queue_len:      equ     0       ; queue length
(1)     164 : =1                 queue_size:     equ     1       ; buffer size
(1)     164 : =2                 queue_put:      equ     2       ; queue put index
(1)     164 : =3                 queue_get:      equ     3       ; queue get index
(1)     164 : =4                 queue_buf:      equ     4       ; buffer start offset
(1)     164 :
(1)     164 :                    ;;; [queue] Initialize queue
(1)     164 :                    ;;; @param HL queue work space pointer
(1)     164 :                    ;;; @param B queue work space size
(1)     164 :                    queue_init:
(1)     164 : F5                         push    AF
(1)     165 : E5                         push    HL
(1)     166 : 36 00                      ld      (HL), 0         ; queue_len
(1)     168 : 78                         ld      A, B
(1)     169 : D6 04                      sub     queue_buf
(1)     16B : 23                         inc     HL
(1)     16C : 77                         ld      (HL), A         ; queue_size
(1)     16D : 23                         inc     HL
(1)     16E : 36 00                      ld      (HL), 0         ; queue_put
(1)     170 : 23                         inc     HL
(1)     171 : 36 00                      ld      (HL), 0         ; queue_get
(1)     173 : E1                         pop     HL
(1)     174 : F1                         pop     AF
(1)     175 : C9                         ret
(1)     176 :
(1)     176 :                    ;;; [queue] Add an element to queue
(1)     176 :                    ;;; @param HL queue work space pointer
(1)     176 :                    ;;; @param A an element
(1)     176 :                    ;;; @return F.C 0 if queue is full
(1)     176 :                    queue_add:
(1)     176 : E5                         push    HL
(1)     177 : DD E3                      ex      (SP), IX        ; IX points queue structure
(1)     179 : F5                         push    AF              ; keep the element
(1)     17A : DD 7E 00                   ld      A, (IX+queue_len)
(1)     17D : DD BE 01                   cp      (IX+queue_size)
(1)     180 : 30 20                      jr      NC, queue_add_full  ; queue_len >= queue_size
(1)     182 : DD 34 00                   inc     (IX+queue_len)
(1)     185 : DD 7E 02                   ld      A, (IX+queue_put)
(1)     188 : 21 04 00                   ld      HL, queue_buf
(1)     18B : ED 6D                      add     HL, A           ; HL=offset of queue_buf[queue_put]; A unchanged
(1)     18D : 3C                         inc     A               ; queue_put++
(1)     18E : DD BE 01                   cp      (IX+queue_size)
(1)     191 : 38 01                      jr      C, queue_add_update ; queue_put < queue_size
(1)     193 : AF                         xor     A                   ; wrap around
(1)     194 :                    queue_add_update:
(1)     194 : DD 77 02                   ld      (IX+queue_put), A
(1)     197 : F1                         pop     AF
(1)     198 : ED 0B                      ld      (HL+IX), A      ; store an element
(1)     19A : ED 2A 00 00                lda     HL, (IX+0)      ; restore HL, no stack access
(1)     19E : DD E1                      pop     IX
(1)     1A0 : 37                         scf                     ; set carry
(1)     1A1 : C9                         ret
(1)     1A2 :                    queue_add_full:
(1)     1A2 : F1                         pop     AF
(1)     1A3 : ED 2A 00 00                lda     HL, (IX+0)      ; restore HL, no stack access
(1)     1A7 : DD E1                      pop     IX
(1)     1A9 : B7                         or      A               ; clear carry
(1)     1AA : C9                         ret
(1)     1AB :
(1)     1AB :                    ;;; [queue] Remove an element from queue
(1)     1AB :                    ;;; @param HL queue work space pointer
(1)     1AB :                    ;;; @return A an element
(1)     1AB :                    ;;; @return F.C 0 if queue is empty
(1)     1AB :                    queue_remove:
(1)     1AB : 7E                         ld      A, (HL)         ; queue_len
(1)     1AC : B7                         or      A               ; clear carry
(1)     1AD : C8                         ret     Z               ; queue_len == 0
(1)     1AE : E5                         push    HL
(1)     1AF : DD E3                      ex      (SP), IX        ; IX points queue structure
(1)     1B1 : DD 35 00                   dec     (IX+queue_len)
(1)     1B4 : DD 7E 03                   ld      A, (IX+queue_get)
(1)     1B7 : 21 04 00                   ld      HL, queue_buf
(1)     1BA : ED 6D                      add     HL, A           ; HL=offset of queue_buf[queue_get]; A unchanged
(1)     1BC : 3C                         inc     A               ; queue_get++
(1)     1BD : DD BE 01                   cp      (IX+queue_size)
(1)     1C0 : 38 01                      jr      C, queue_remove_update ; queue_get < queue_size
(1)     1C2 : AF                         xor     A                      ; wrap around
(1)     1C3 :                    queue_remove_update:
(1)     1C3 : DD 77 03                   ld      (IX+queue_get), A
(1)     1C6 : DD 79                      ld      A, (HL+IX)      ; read an element
(1)     1C8 : ED 2A 00 00                lda     HL, (IX+0)      ; restore HL, no stack access
(1)     1CC : DD E1                      pop     IX
(1)     1CE : 37                         scf                     ; set carry
(1)     1CF : C9                         ret
