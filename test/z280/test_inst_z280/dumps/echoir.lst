        1DB : 01 40 01                   ld      BC, USARTD
        1DE : ED 78                      in      A, (C)          ; (USARTD)
        1E0 : E5                         push    HL
        1E1 : 21 00 20                   ld      HL, rx_queue
        1E4 : CD 76 01                   call    queue_add
        1E7 : E1                         pop     HL
        1E8 :                    isr_intr_recv_end:
        1E8 : C1                         pop     BC
        1E9 : F1                         pop     AF
        1EA : FB                         ei
        1EB : ED 4D                      reti
