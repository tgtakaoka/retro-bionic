(1)     438 : 92 12                      lde     @RR2, R1        ; update queue_len
(1)     43A : A0 E2                      incw    RR2
(1)     43C : 82 42                      lde     R4, @RR2        ; R4=queue_size
(1)     43E : A0 E2                      incw    RR2
(1)     440 : A0 E2                      incw    RR2             ; RR2 points queue_get
(1)     442 : 70 E3                      push    R3
(1)     444 : 70 E2                      push    R2
(1)     446 : 82 12                      lde     R1, @RR2        ; queue_get
(1)     448 : A0 E2                      incw    RR2             ; RR2 points queue_buf
(1)     44A : 02 31                      add     R3, R1
(1)     44C : 16 E2 00                   adc     R2, #0          ; RR2=&queue_buf[queue_get]
(1)     44F : 82 02                      lde     R0, @RR2        ; read an element
(1)     451 : 50 E2                      pop     R2              ; restore RR2 points to queue_get
(1)     453 : 50 E3                      pop     R3
(1)     455 : 1E                         inc     R1              ; queue_get++
(1)     456 : A2 14                      cp      R1, R4
(1)     458 : 7B 02                      jr      c, queue_remove_update ; queue_get < queue_size
(1)     45A : B0 E1                      clr     R1
(1)     45C :                    queue_remove_update:
(1)     45C : 92 12                      lde     @RR2, R1        ; update queue_get
(1)     45E : 80 E2                      decw    RR2
(1)     460 : 80 E2                      decw    RR2
(1)     462 : 80 E2                      decw    RR2             ; RR2 points queue_len
(1)     464 : 50 E4                      pop     R4              ; restore R1, R4
(1)     466 : 50 E1                      pop     R1
(1)     468 : DF                         scf                     ; set carry
(1)     469 : AF                         ret
