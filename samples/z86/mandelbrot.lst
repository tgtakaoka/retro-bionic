(1)      A2 :                    mandelbrot:
(1)      A2 : E6 40 00                   ld      c229, #HIGH 229
(1)      A5 : E6 41 E5                   ld      c229+1, #LOW 229
(1)      A8 : E6 42 01                   ld      c416, #HIGH 416
(1)      AB : E6 43 A0                   ld      c416+1, #LOW 416
(1)      AE : E6 44 00                   ld      c100, #HIGH 100
(1)      B1 : E6 45 64                   ld      c100+1, #LOW 100
(1)      B4 : E6 46 00                   ld      vF, #HIGH 50    ; F=50
(1)      B7 : E6 47 32                   ld      vF+1, #LOW 50
(1)      BA : E6 54 FF                   ld      vY, #HIGH -12   ; Y=-12
(1)      BD : E6 55 F4                   ld      vY+1, #LOW -12
(1)      C0 :                    loop_y:
(1)      C0 : E8 42                      ld      R14, c416
(1)      C2 : F8 43                      ld      R15, c416+1
(1)      C4 : C8 54                      ld      R12, vY
(1)      C6 : D8 55                      ld      R13, vY+1
(1)      C8 : D6 02 D7                   call    mul16           ; 416*Y
(1)      CB : C8 44                      ld      R12, c100
(1)      CD : D8 45                      ld      R13, c100+1
(1)      CF : D6 04 02                   call    div16           ; D=Y*416/100, the same for the whole row
(1)      D2 : C9 4A                      ld      vD, R12
(1)      D4 : D9 4B                      ld      vD+1, R13
(1)      D6 : E6 56 FF                   ld      vX, #HIGH -49   ; X=-49
(1)      D9 : E6 57 CF                   ld      vX+1, #LOW -49
(1)      DC :                    loop_x:
(1)      DC : E8 40                      ld      R14, c229
(1)      DE : F8 41                      ld      R15, c229+1
(1)      E0 : C8 56                      ld      R12, vX
(1)      E2 : D8 57                      ld      R13, vX+1
(1)      E4 : D6 02 D7                   call    mul16           ; 229*X
(1)      E7 : C8 44                      ld      R12, c100
(1)      E9 : D8 45                      ld      R13, c100+1
(1)      EB : D6 04 02                   call    div16           ; C=X*229/100
(1)      EE : C9 48                      ld      vC, R12
(1)      F0 : D9 49                      ld      vC+1, R13
(1)      F2 : 48 EC                      ld      R4, R12         ; RR4=A=C
(1)      F4 : 58 ED                      ld      R5, R13
(1)      F6 : E8 4A                      ld      R14, vD
(1)      F8 : F8 4B                      ld      R15, vD+1
(1)      FA : 68 EE                      ld      R6, R14         ; RR6=B=D
(1)      FC : 78 EF                      ld      R7, R15
(1)      FE : C8 46                      ld      R12, vF
(1)     100 : D8 47                      ld      R13, vF+1
(1)     102 : D6 04 02                   call    div16           ; Q=B/F, S=B-Q*F
(1)     105 : C9 4E                      ld      vQ, R12
(1)     107 : D9 4F                      ld      vQ+1, R13
(1)     109 : E9 50                      ld      vS, R14
(1)     10B : F9 51                      ld      vS+1, R15
(1)     10D : E6 58 00                   ld      vI, #HIGH 0     ; I=0
(1)     110 : E6 59 00                   ld      vI+1, #LOW 0
