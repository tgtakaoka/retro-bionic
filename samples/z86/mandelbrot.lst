(1)     113 :                            ;; call    print
(1)     113 :                            ;; call    newline
(1)     113 :
(1)     113 :                    ;;; The loop keeps A in RR4, B in RR6 and T in RR8, which neither
(1)     113 :                    ;;; mul16, div16 nor the interrupt handlers change.
(1)     113 :                    loop_i:
(1)     113 : E8 E4                      ld      R14, R4
(1)     115 : F8 E5                      ld      R15, R5
(1)     117 : C8 E4                      ld      R12, R4
(1)     119 : D8 E5                      ld      R13, R5
(1)     11B : 02 F7                      add     R15, R7
(1)     11D : 12 E6                      adc     R14, R6         ; A+B
(1)     11F : 22 D7                      sub     R13, R7
(1)     121 : 32 C6                      sbc     R12, R6         ; A-B
(1)     123 : D6 02 D7                   call    mul16           ; A*A-B*B=(A+B)*(A-B)
(1)     126 : C8 46                      ld      R12, vF
(1)     128 : D8 47                      ld      R13, vF+1
(1)     12A : D6 04 02                   call    div16           ; (A*A-B*B)/F
(1)     12D : 04 49 ED                   add     R13, vC+1
(1)     130 : 14 48 EC                   adc     R12, vC
(1)     133 : 88 EC                      ld      R8, R12
