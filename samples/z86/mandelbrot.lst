(1)     3BD :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     3BD :                    ;;; [queue] queue structure
(1)     3BD : =0                 queue_len:      equ     0       ; queue length
(1)     3BD : =1                 queue_size:     equ     1       ; buffer size
(1)     3BD : =2                 queue_put:      equ     2       ; queue put index
(1)     3BD : =3                 queue_get:      equ     3       ; queue get index
(1)     3BD : =4                 queue_buf:      equ     4       ; buffer start offset
(1)     3BD :
(1)     3BD :                    ;;; [queue] Initialize queue
(1)     3BD :                    ;;; @param RR2 queue work space pointer
(1)     3BD :                    ;;; @param R1 queue work space size
(1)     3BD :                    ;;; @clobber R1
(1)     3BD :                    queue_init:
(1)     3BD : 70 E0                      push    R0
(1)     3BF : 70 E2                      push    R2
(1)     3C1 : 70 E3                      push    R3
(1)     3C3 : B0 E0                      clr     R0
(1)     3C5 : 92 02                      lde     @RR2, R0        ; queue_len
(1)     3C7 : A0 E2                      incw    RR2
(1)     3C9 : 08 E1                      ld      R0, R1
(1)     3CB : 26 E0 04                   sub     R0, #queue_buf
(1)     3CE : 92 02                      lde     @RR2, R0        ; queue_size
(1)     3D0 : A0 E2                      incw    RR2
(1)     3D2 : 06 E0 02                   add     R0, #2          ; for queue_put and queue_get
(1)     3D5 : B0 E1                      clr     R1
(1)     3D7 :                    queue_init_loop:
(1)     3D7 : 92 12                      lde     @RR2, R1
(1)     3D9 : A0 E2                      incw    RR2
(1)     3DB : 0A FA                      djnz    R0, queue_init_loop
(1)     3DD : 50 E3                      pop     R3
(1)     3DF : 50 E2                      pop     R2
(1)     3E1 : 50 E0                      pop     R0
(1)     3E3 : AF                         ret
(1)     3E4 :
(1)     3E4 :                    ;;; [queue] Add an element to queue
(1)     3E4 :                    ;;; @param RR2 queue work space pointer
(1)     3E4 :                    ;;; @param R0 an element
(1)     3E4 :                    ;;; @return FLAGS.C 0 if queue is full
(1)     3E4 :                    queue_add:
(1)     3E4 : 70 E1                      push    R1
(1)     3E6 : 70 E4                      push    R4              ; save R1, R4
(1)     3E8 : 82 12                      lde     R1, @RR2        ; queue_len
(1)     3EA : 1E                         inc     R1              ; queue_len++
(1)     3EB : A0 E2                      incw    RR2             ; RR2 points queue_size
(1)     3ED : 82 42                      lde     R4, @RR2        ; R4=queue_size
(1)     3EF : A2 14                      cp      R1, R4
(1)     3F1 : 80 E2                      decw    RR2                ; RR2 points queue_len
(1)     3F3 : 7B 05                      jr      c, queue_add_store ; queue_len < queue_size
(1)     3F5 : 50 E4                      pop     R4                 ; restore R1, R4
(1)     3F7 : 50 E1                      pop     R1
(1)     3F9 : AF                         ret                     ; return with FLAGS.C=0
(1)     3FA :                    queue_add_store:
(1)     3FA : 92 12                      lde     @RR2, R1        ; update queue_len
(1)     3FC : A0 E2                      incw    RR2
(1)     3FE : A0 E2                      incw    RR2             ; RR2 points to queue_put
(1)     400 : 82 12                      lde     R1, @RR2        ; queue_put
(1)     402 : 70 E3                      push    R3              ; save RR2
(1)     404 : 70 E2                      push    R2
(1)     406 : A0 E2                      incw    RR2
(1)     408 : A0 E2                      incw    RR2             ; RR2 points to queue_buf
(1)     40A : 02 31                      add     R3, R1
(1)     40C : 16 E2 00                   adc     R2, #0          ; RR2=&queue_buf[queue_put]
(1)     40F : 92 02                      lde     @RR2, R0        ; store an element
(1)     411 : 50 E2                      pop     R2              ; restore RR2 points to queue_put
(1)     413 : 50 E3                      pop     R3
(1)     415 : 1E                         inc     R1              ; queue_put++
(1)     416 : A2 14                      cp      R1, R4
(1)     418 : 7B 02                      jr      c, queue_add_update ; queue_put < queue_size
(1)     41A : B0 E1                      clr     R1
(1)     41C :                    queue_add_update:
(1)     41C : 92 12                      lde     @RR2, R1        ; queue_put
(1)     41E : 80 E2                      decw    RR2
(1)     420 : 80 E2                      decw    RR2             ; RR2 points queue_len
(1)     422 : DF                         scf                     ; set carry flag
(1)     423 : 50 E4                      pop     R4              ; restpre R1, R4
(1)     425 : 50 E1                      pop     R1              ; restore R1
(1)     427 : AF                         ret
(1)     428 :
(1)     428 :                    ;;; [queue] Remove an element from queue
(1)     428 :                    ;;; @param RR2 queue work space pointer
(1)     428 :                    ;;; @return R0 an element
(1)     428 :                    ;;; @return FLAGS.C 0 if queue is empty
(1)     428 :                    queue_remove:
(1)     428 : 70 E1                      push    R1              ; save R1
(1)     42A : 82 12                      lde     R1, @RR2        ; queue_len
(1)     42C : 42 11                      or      R1, R1
(1)     42E : EB 04                      jr      nz, queue_remove_elem ; queue_len > 0
(1)     430 : CF                         rcf                           ; reset carry flag
(1)     431 : 50 E1                      pop     R1
(1)     433 : AF                         ret
(1)     434 :                    queue_remove_elem:
(1)     434 : 70 E4                      push    R4              ; save R4
