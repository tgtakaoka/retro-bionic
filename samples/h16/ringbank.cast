[0.503932, "o", "HD641016 * 1.0\r\r\n PC=000010C1  SR=__S_ I=7 CCR=_____    EBR=00000000 RBR=FFFFFBFF IBR=FFFFFFFF BMR=B4\r\r\n R0=00001100  R1=00000003  R2=000011CD  R3=12345678  R4=00000000  R5=00000002 GBNR=0\r\r\n R6=00000003  R7=00000000  R8=00000000  R9=0000FFD8 R10=0000000D R11=00007FF0 VBNR=1\r\r\nR12=00007FF0 R13=00001288 R14=0000128C  SP=00000FDC USP=00006000 BSP=00007FF0 CBNR=0\r\r\n000010C1: 0E 74 40 70 43     MOV:G.L  PR0, CR3\r\r\n\r\r\n  R              : reset the target HD641016\r\r\n  U              : upload Intel HEX / S-record (^C to end)\r\r\n  G [n]          : run freely, backtrace last n lines (default: all)\r\r\n  g addr [n]     : run until addr (a one-shot breakpoint), same backtrace\r\r\n  B addr         : set a breakpoint\r\r\n  b [index]      : list breakpoints, clear one\r\r\n  S              : step one instruction\r\r\n\r\r\n  r              : print registers\r\r\n  = reg value    : set a register (unknown name lists valid names)\r\r\n  d addr [len]   : dump data memory (len defaults to 16)\r\r\n  p addr [len]   : dump program memory (len defaults to 16)\r\r\n  D addr [n]     : disassemble n instructions (default 20)\r\r\n  m addr byte... : write & dump data memory, 16 bytes max\r\r\n  M addr byte... : write & dump program memory, 16 bytes max\r\r\n  c addr n v...  : fill data memory, n times v... (16 max)\r\r\n  C addr n v...  : fill program memory, likewise\r\r\n\r\r\n  I dev [addr]   : select an I/O device, optionally its base\r\r\n  I dev addr rx [tx]\r\r\n                 : likewise, and its Rx and Tx interrupt vectors\r\r\n                   (0: none; tx defaults to rx)\r\r\n  P [from to]    : show, or set, the target's memory area\r\r\n  W +identity    : write identity EEPROM\r\r\n  V              : toggle verbose bus-cycle printing\r\r\n  ?              : this help\r\r\n\r\r\n  HALT button    : stop a free running HD641016\r\r\n                   held at power up skips the identity EEPROM check, to recover\r\r\n                   from a bad identity EEPROM\r\r\n  2nd USB serial : send any byte to stop a free running HD641016\r\r\n> "]
