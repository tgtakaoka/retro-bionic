          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                    ;;; Probe the opcodes where ASL departs from the HD641016 Programming
          0 :                    ;;; Manual, and the encodings the other samples take on trust. Each probe
          0 :                    ;;; prints one line, e.g. "dadd A3 R2=00000042 Z=0 C=0" for a result, or
          0 :                    ;;; "dadd 83 ILL+00" for an illegal instruction exception and its stacked
          0 :                    ;;; PC less the probe's address. The manual's readings are in the regress
          0 :                    ;;; expectation; where ASL reads a byte differently, its line is noted.
          0 :                    ;;;
          0 :                    ;;;   probe     bytes     manual                     ASL
          0 :                    ;;;   dadd A3   A3 43 42  DADD R3,R2 (16.3.29)       -
          0 :                    ;;;   dsub A7   A7 43 42  DSUB R3,R2 (16.3.34)       -
          0 :                    ;;;   dadd 83   83 43 42  unassigned: ILL+00         DADD R3,R2: R2=00000042
          0 :                    ;;;   dsub 87   87 43 42  unassigned: ILL+00         DSUB R3,R2: R2=00000023
          0 :                    ;;;   btst 6A   6A 61 42  BTST.L R1,R2               -
          0 :                    ;;;   btst 66   66 61 42  ROTXR.L #1,R2: 00000008    BTST.L R1,R2: 00000010 Z=1
          0 :                    ;;;   bset 68   68 01 42  BSET.B R1,R2               -
          0 :                    ;;;   bset 64   64 01 42  SHAR.B #1,R2: 00000008     BSET.B R1,R2: 00000018 Z=1
          0 :                    ;;;   abs16     76 80 00  @H'8000:16 is FFFF8000, the bus FF8000
          0 :                    ;;;   imm16     72 80 00  #H'8000:16 to a long is FFFF8000
          0 :                    ;;;   imm16.b   72 00 94  #H'0094:16 to a byte stores its low byte
          0 :                    ;;;   add:rq    31 F2     ADD:RQ.W #15,R2: 00000023  ADD:RQ.W #-1,R2: 00000013
          0 :                    ;;;   sub:g     05 71 0A  SUB:G.W #10,R2: C=0        -
          0 :                    ;;;   add:q     11 F6 42  ADD:Q.W #-10,R2: C=1       SUB.W #10,R2 (C=0 meant)
          0 :                    ;;;   stc ccr   FC 20 42  CCR is a word (Table 16-9) or a byte (Table 16-10):
          0 :                    ;;;                       FFFF0005 or FFFFFF05; ASL takes it as a byte
          0 :                            include "hd641016.inc"
