       10AF :                    ;;; Ackermann function by recursion, each call in a ring bank of its own.
       10AF :                    ;;; The caller's bank becomes the previous bank: the arguments come in
       10AF :                    ;;; its CR0 and CR1, read here as PR0 and PR1, and the result goes back
       10AF :                    ;;; in its CR2, written here as PR2. CRn are this call's own; Rn, the
       10AF :                    ;;; global bank, are shared. Past the 8th level the ring overflows: the
       10AF :                    ;;; bank about to be reused is stacked through BSP, the registers its
       10AF :                    ;;; CR15 lists, and returning unstacks it.
       10AF :                    ;;;   A(0, n) = n+1
       10AF :                    ;;;   A(m, 0) = A(m-1, 1)
       10AF :                    ;;;   A(m, n) = A(m-1, A(m, n-1))
       10AF :                    ;;; @param PR0 m
       10AF :                    ;;; @param PR1 n
       10AF :                    ;;; @return PR2 A(m, n)
       10AF :                    ;;; @clobber R10-R12
       10AF :                    ack:
       10AF : FD                         icbn                    ; a fresh ring bank for this call
       10B0 : 1E 0F 70 4F                mov.l   #$000F, cr15    ; an overflow stacks CR0-CR3
       10B4 : 31 A1                      add.w   #1, r10         ; one more call
       10B6 : FC 41 4B                   stc     bsp, r11
       10B9 : 2A CB                      cmp.l   r12, r11
       10BB : A5 04 00 02                bcc     ack_args
       10BF : 2E BC                      mov.l   r11, r12        ; deeper than before
       10C1 :                    ack_args:
       10C1 : 0E 74 40 70 43             mov.l   pr0, cr3        ; m, kept over the calls below
       10C6 : 59 70 43                   tst.w   cr3
       10C9 : B1 00 0C                   bne     ack_m
       10CC : 0E 74 41 70 42             mov.l   pr1, cr2        ; A(0, n) = n+1
       10D1 : 11 01 70 42                add.w   #1, cr2
       10D5 : 99 00 3E                   bra     ack_return
       10D8 :                    ack_m:
       10D8 : 0E 70 43 70 40             mov.l   cr3, cr0
       10DD : 05 71 01 70 40             sub.w   #1, cr0         ; m-1
       10E2 : 59 74 41                   tst.w   pr1
       10E5 : B1 00 0A                   bne     ack_mn
       10E8 : 1E 01 70 41                mov.l   #1, cr1         ; A(m-1, 1)
       10EC : A9 FF C0                   bsr     ack
       10EF : 99 00 24                   bra     ack_return
       10F2 :                    ack_mn:
       10F2 : 0E 70 43 70 40             mov.l   cr3, cr0        ; A(m, n-1)
       10F7 : 0E 74 41 70 41             mov.l   pr1, cr1
       10FC : 05 71 01 70 41             sub.w   #1, cr1
