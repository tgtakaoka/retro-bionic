(1)    1809 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)    1809 :                    ;;; [queue] queue structure
(1)    1809 : =0                 queue_len       =       0       ; queue length
(1)    1809 : =1                 queue_size      =       1       ; buffer size
(1)    1809 : =2                 queue_put       =       2       ; queue put index
(1)    1809 : =3                 queue_get       =       3       ; queue get index
(1)    1809 : =4                 queue_buf       =       4       ; buffer start offset
(1)    1809 :
(1)    1809 :                    ;;; [queue] Initialize queue
