(1)    1843 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)    1843 :                    ;;; Routines are called by XPPC P1; each exit XPPC sits just before the
(1)    1843 :                    ;;; entry, so the return leaves P1 ready for the next call.
(1)    1843 :                    ;;; [queue] queue structure
(1)    1843 : =0                 queue_len       =       0       ; queue length
(1)    1843 : =1                 queue_size      =       1       ; buffer size
(1)    1843 : =2                 queue_put       =       2       ; queue put index
(1)    1843 : =3                 queue_get       =       3       ; queue get index
(1)    1843 : =4                 queue_buf       =       4       ; buffer start offset
(1)    1843 :
