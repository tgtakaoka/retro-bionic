(1)    17FF :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)    17FF :                    ;;; [queue] queue structure
(1)    17FF : =0                 queue_len       =       0       ; queue length
(1)    17FF : =1                 queue_size      =       1       ; buffer size
(1)    17FF : =2                 queue_put       =       2       ; queue put index
(1)    17FF : =3                 queue_get       =       3       ; queue get index
(1)    17FF : =4                 queue_buf       =       4       ; buffer start offset
(1)    17FF :
(1)    17FF :                    ;;; [queue] Initialize queue
