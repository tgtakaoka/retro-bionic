          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                            cpu     ins8060
          0 :                            include "ins8060.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; INS8060
(1)       0 :                    ;;; Status Register
(1)       0 : =80                S_CY    =       X'80           ; Carry bit
(1)       0 : =80                S_L     =       X'80           ; Link bit
(1)       0 : =40                S_OV    =       X'40           ; Overflow bit
(1)       0 : =20                S_SB    =       X'20           ; Sense B bit
(1)       0 : =10                S_SA    =       X'10           ; Sense A bit
(1)       0 : =8                 S_IE    =       X'08           ; Interrupt Enable bit
(1)       0 : =4                 S_F2    =       X'04           ; Flag 2 bit
(1)       0 : =2                 S_F1    =       X'02           ; Flag 1 bit
(1)       0 : =1                 S_F0    =       X'01           ; flag 0 bit
(1)       0 :
(1)       0 :                    ;;; Dynamic Offset by E register
(1)       0 : =80                OFFSET_E        =       X'80    ; offset by E register
(1)       0 :
(1)       0 :                    ;;; Transfer locations
(1)       0 : =1                 ORG_RESTART     =       X'0001  ; Restart transfer location
          0 :
          0 :                    ;;; Bit-banged console: SENSE B is RXD, FLAG 0 is TXD inverted (FLAG 0
          0 :                    ;;; high sends a space). 8 data bits LSB first, 1 stop bit, 1200 bps at
          0 :                    ;;; XIN 2 MHz. GECO and PUTC are NIBL's 1200 bps routines
          0 :                    ;;; (NIBL1200BPS.asm), timed by DLY; GECO echoes each bit as it arrives.
          0 :
          0 : =FFFFFFFF          NUM     =       -1
          0 : =FFFFFFFE          TEMP    =       -2
          0 : =FFFFFFFD          TEMP2   =       -3
          0 : =FFFFFFFC          TEMP3   =       -4
          0 :
          1 :                            .=      ORG_RESTART
          1 : C4 FF                      ldi     L(stack)
          3 : 32                         xpal    P2
          4 : C4 0F                      ldi     H(stack)
          6 : 36                         xpah    P2
          7 : C4 FF                      ldi     L(ADDR(initialize))
          9 : 33                         xpal    P3
          A : C4 1F                      ldi     H(ADDR(initialize))
          C : 37                         xpah    P3
          D : 3F                         xppc    P3
          E :
       1000 :                            .=      X'1000
       1000 : =FFF               stack   =       .-1
       1000 :                    initialize:
       1000 : 06                         csa
       1001 : D4 FE                      ani     X'FE            ; mark
       1003 : 07                         cas
       1004 :                    echo:
       1004 : C4 1C                      ldi     L(ADDR(GECO))
       1006 : 33                         xpal    P3
       1007 : C4 10                      ldi     H(ADDR(GECO))
       1009 : 37                         xpah    P3
       100A : 3F                         xppc    P3              ; A=received and echoed character
       100B : 98 0F                      jz      halt_to_system  ; NUL halts
       100D : E4 0D                      xri     X'0D
       100F : 9C F3                      jnz     echo
       1011 : C4 67                      ldi     L(ADDR(PUTC))
       1013 : 33                         xpal    P3
       1014 : C4 10                      ldi     H(ADDR(PUTC))
       1016 : 37                         xpah    P3
       1017 : C4 0A                      ldi     X'0A            ; follow CR with LF
       1019 : 3F                         xppc    P3
       101A : 90 E8                      jmp     echo
       101C :                    halt_to_system:
       101C : 00                         halt
       101D :
       101D :                    ;*************************************
       101D :                    ;*     GET CHARACTER AND ECHO IT     *
       101D :                    ;*************************************
       101D : C4 08              GECO:   LDI     8               ;SET COUNT = 8
       101F : CA FF                      ST      NUM(P2)
       1021 : 06                         CSA                     ;SET READER RELAY
       1022 : DC 02                      ORI     2
       1024 : 07                         CAS
       1025 : 06                 GETCO1: CSA                     ;WAIT FOR START BIT
       1026 : D4 20                      ANI     X'20
       1028 : 9C FB                      JNZ     GETCO1          ;NOT FOUND
       102A : C4 3D                      LDI     61              ; DELAY 1/2 BIT TIME
       102C : 8F 00                      DLY     0
       102E : 06                         CSA                     ; IS START BIT STILL THERE?
       102F : D4 20                      ANI     X'20
       1031 : 9C F2                      JNZ     GETCO1          ; NO
       1033 : 06                         CSA                     ;SEND START BIT
       1034 : D4 FD                      ANI     X'FD           ; RESET READER RELAY
       1036 : DC 01                      ORI     1
       1038 : 07                         CAS
       1039 : C4 76              GETCO2: LDI     118             ; DELAY 1 BIT TIME
       103B : 8F 00                      DLY     0
       103D : 06                         CSA                     ;GET BIT (SENSED)
       103E : D4 20                      ANI     X'20
       1040 : 98 04                      JZ      GETCO3
       1042 : C4 01                      LDI     1
       1044 : 90 04                      JMP     GETCO4
       1046 : C4 00              GETCO3: LDI     0
       1048 : 9C 00                      JNZ     GETCO4
       104A : CA FE              GETCO4: ST      TEMP(P2)        ;SAVE BIT VALUE (0 OR 1)
       104C : 1F                         RRL                     ;ROTATE INTO LINK
       104D : 01                         XAE
       104E : 1D                         SRL                     ; SHIFT INTO CHARACTER
       104F : 01                         XAE                     ; RETURN CHAR TO E
       1050 : 06                         CSA                     ;ECHO BIT TO OUTPUT
       1051 : DC 01                      ORI     1
       1053 : E2 FE                      XOR     TEMP(P2)
       1055 : 07                         CAS
       1056 : BA FF                      DLD     NUM(P2)         ;DECREMENT BIT COUNT
       1058 : 9C DF                      JNZ     GETCO2          ;LOOP UNTIL 0
       105A : C4 76                      LDI     118
       105C : 8F 00                      DLY     0               ; DELAY APPROX. 1 BIT TIME
       105E : 06                         CSA                     ;SET STOP BIT
       105F : D4 FE                      ANI     X'FE
       1061 : 07                         CAS
       1062 : 40                         LDE                     ; AC HAS INPUT CHARACTER
       1063 : 01                         XAE
       1064 : 40                         LDE
       1065 : 3F                         XPPC    P3              ;RETURN
       1066 : 90 B5                      JMP     GECO
       1068 :
       1068 :                    ;*************************************
       1068 :                    ;*     PRINT CHARACTER  AT  TTY      *
       1068 :                    ;*************************************
       1068 : 01                 PUTC:   XAE
       1069 : C4 86                      LDI     134              ; DELAY ALMOST
       106B : 8F 01                      DLY     1                ; 3  BIT  TIMES
       106D : 06                         CSA                      ;SET OUTPUT  BIT  TO  LOGIC  0
       106E : DC 01                      ORI     1                ; FOR START  BIT
       1070 : 07                         CAS
       1071 : C4 09                      LDI     9                ; INITIALIZE BIT COUNT
       1073 : CA FC                      ST      TEMP3(P2)
       1075 : C4 81              PUTC1:  LDI     129              ; DELAY 1 BIT TIME
       1077 : 8F 00                      DLY     0
       1079 : BA FC                      DLD     TEMP3(P2)        ; DECREMENT BIT COUNT
       107B : 98 10                      JZ      PUTC2
       107D : 40                         LDE                      ; PREPARE NEXT BIT
       107E : D4 01                      ANI     1
       1080 : CA FD                      ST      TEMP2(P2)
       1082 : 01                         XAE
       1083 : 1C                         SR
       1084 : 01                         XAE
       1085 : 06                         CSA                      ; SET UP OUTPUT BIT
       1086 : DC 01                      ORI    1
       1088 : E2 FD                      XOR    TEMP2(P2)
       108A : 07                         CAS                      ; PUT BIT INTO TTY
       108B : 90 E8                      JMP    PUTC1
       108D : 06                 PUTC2:  CSA                      ; SET STOP BIT
       108E : D4 FE                      ANI    X'FE
       1090 : 07                         CAS
       1091 : 3F                         XPPC   P3
       1092 : 90 D4                      JMP    PUTC
       1094 :
       1094 :                            end
