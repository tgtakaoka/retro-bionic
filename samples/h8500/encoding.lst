          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                    ;;; Probe the encodings the assemblers disagree on, and what the manuals
          0 :                    ;;; leave to the chip. Each probe prints "name value"; the expectations
          0 :                    ;;; are the Programming Manual's readings. ASL rejects or misreads every
          0 :                    ;;; negative @(d,Rn), h8500-hms-as drops JMP/JSR displacements and
          0 :                    ;;; mis-encodes CMP:E and RTD #xx:16, and libasm can't emit 8-bit data for
          0 :                    ;;; a word operation, so those probes are bytes.
          0 :                    ;;;
          0 :                    ;;;   probe      bytes      manual                       assemblers
          0 :                    ;;;   movf-ld    88 FE      MOV:F.W @(-2,FP),R0: 1111    ASL rejects
          0 :                    ;;;   movf-st    90 FC      MOV:F.B R0,@(-4,FP): 005A    ASL rejects
          0 :                    ;;;   movg-d8    EB FE 80   MOV:G.W @(-2,R3),R0: 1111    ASL: B8 80 (@-R0)
          0 :                    ;;;   movg-d16   FB FED4 80 MOV:G.W @(-300,R3),R0: 3333  ASL: B8 80 (@-R0)
          0 :                    ;;;   jmp-d8     11 E0 FB   JMP @(-5,R0): 600D           ASL rejects, GAS d=0
          0 :                    ;;;   jmp-d16    11 F0 00CE JMP @(206,R0): 600D          GAS d=0
          0 :                    ;;;   jsr-d8     11 E8 FC   JSR @(-4,R0): 600D           ASL rejects, GAS d=0
          0 :                    ;;;   jsr-d16    11 F8 FF30 JSR @(-208,R0): 600D         ASL rejects, GAS d=0
          0 :                    ;;;   mov-imm8w  D9 06 80   #H'80:8 to a word, sign      ASL emits it, libasm
          0 :                    ;;;                         extended (2.2.24 note 3):    can't; 0080 zero
          0 :                    ;;;                         FF80                         extended, 8000 word
          0 :                    ;;;   cmp-imm8w  D9 04 80   CMP.W #H'80:8 with FF80:     ASL rejects: data
          0 :                    ;;;                         Z (0004) if sign extended;   length follows Sz,
          0 :                    ;;;                         0000 if 4 bytes, data 8000;  as the CMP format
          0 :                    ;;;                         N (0008) if zero extended    footnote reads
          0 :                    ;;;   cmp-g      04 55 70   CMP:G.B #H'55,R0 with 54: NC -
          0 :                    ;;;   cmp-g-ead  A0 04 55   GAS's CMP:G.B #H'55,R0: an   GAS's CMP:G form
          0 :                    ;;;                         invalid instruction (Table
          0 :                    ;;;                         2-10 (a)), taken once
          0 :                    ;;;   cmp-e-i    40 55      CMP:E then CMP:I 48: Z, Z    GAS: 48 55 for CMP:E
          0 :                    ;;;   rtd-8      14 04      RTD #4: SP+4                 -
          0 :                    ;;;   rtd-16     1C 01 04   RTD #H'104: SP+104           GAS: 14 01 04
          0 :                    ;;;   bcc-d16    36 00 CB   BNE d:16: 600D               GAS crashes
          0 :                    ;;;   stm-order  12 0F      R0 at the lowest address     -
          0 :                    ;;;   stm-r7     12 81      pushes R7-2: FFFE            -
          0 :                    ;;;   ldm-r7     02 81      skips R7's slot, SP back: 0  -
          0 :                    ;;;   trap-sr/cp/pc         SR 0708, CP 00, PC less the  -
          0 :                    ;;;                         return address 0000
          0 :                    ;;;                         (Hardware Manual Table 4-3)
          0 :                    ;;;   aa8-br     68 40      @H'40:8 is BR:40: BEEF       -
          0 :                    ;;;   invalid-0b 0B         an invalid instruction, once -
          0 :                    ;;;   invalid-pc            stacked PC less the probe's address: "not
          0 :                    ;;;                         necessarily" the first byte, so unknown
          0 :                            include "h8500.inc"
