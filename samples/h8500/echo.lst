          0 : =1000              stack:  equ     $1000
          0 :
         7C :                            org     VEC_TRAPA15
         7C : 00 00 00 7C                .data.l VEC_TRAPA15     ; for halt to system
         80 :
          0 :                            org     VEC_RESET
          0 : 00 00 10 00                .data.l initialize
          4 :
       1000 :                            org     $1000
       1000 :                    initialize:
       1000 : 04 00 8F                   ldc.b   #0, tp          ; LDC holds off interrupts for one instruction
       1003 : 5F 10 00                   mov.w   #stack, sp
       1006 : 04 00 8D                   ldc.b   #0, dp          ; page of @aa:16 and @R0-@R3
       1009 : 04 00 8C                   ldc.b   #0, ep          ; page of @R4-@R5
       100C : 15 F0 00 06 03             mov.b   #CDS_RESET_gc, @ACIA_control ; Master reset
       1011 : 15 F0 00 06 14             mov.b   #WSB_8N1_gc, @ACIA_control   ; 8 bits + No Parity + 1 Stop Bits
       1016 :                                                    ; Transmit, Receive interrupts disabled
       1016 : 0E 10              loop:   bsr     getchar
       1018 : A0 16                      tst.b   r0
       101A : 27 0A                      beq     halt_to_system
       101C : 0E 15              echo:   bsr     putchar
       101E : 40 0D                      cmp.b   #$0D, r0
       1020 : 26 F4                      bne     loop
       1022 : 50 0A                      mov.b   #$0A, r0
       1024 : 20 F6                      bra     echo
       1026 :                    halt_to_system:
       1026 : 08 1F                      trapa   #15             ; halt to system
       1028 :
       1028 :                    getchar:
       1028 : 15 F0 00 F0                btst.b  #0, @ACIA_status        ; RDRF
       102C : 27 FA                      beq     getchar
       102E : 15 F0 01 80                mov.b   @ACIA_data:16, r0
       1032 : 19                         rts
       1033 :
