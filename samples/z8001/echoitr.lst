(1)       0 : =142               USARTRV:        equ     USART+2 ; Receive interrupt identifier
(1)       0 : =143               USARTTV:        equ     USART+3 ; Transmit interrupt identifier
(1)       0 :                    ;;; The identifiers the USART answers its vectored interrupts with: even,
