(2)   102C8 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)   102C8 :                    ;;; [queue] queue structure: the queues live in segment DATA, a pointer
(2)   102C8 :                    ;;; their offset there
(2)   102C8 : =0                 queue_len:      equ     0       ; queue length
(2)   102C8 : =1                 queue_size:     equ     1       ; buffer size
(2)   102C8 : =2                 queue_put:      equ     2       ; queue put index
(2)   102C8 : =3                 queue_get:      equ     3       ; queue get index
(2)   102C8 : =4                 queue_buf:      equ     4       ; buffer start offset
(2)   102C8 :
(2)   102C8 :                    ;;; [queue] Initialize queue
(2)   102C8 :                    ;;; @param R1 queue work space pointer
(2)   102C8 :                    ;;; @param RL0 queue work space size
(2)   102C8 :                    ;;; @clobber RL0
(2)   102C8 :                    queue_init:
(2)   102C8 : 4C18 0200                  clrb    DATA+queue_len(r1)
(2)   102CC : 0208 0404                  subb    rl0, #queue_buf
(2)   102D0 : 6E18 0201                  ldb     DATA+queue_size(r1), rl0
(2)   102D4 : 4C18 0202                  clrb    DATA+queue_put(r1)
(2)   102D8 : 4C18 0203                  clrb    DATA+queue_get(r1)
(2)   102DC : 9E08                       ret
(2)   102DE :
(2)   102DE :                    ;;; [queue] Add an element to queue
(2)   102DE :                    ;;; @param R1 queue work space pointer
(2)   102DE :                    ;;; @param RL0 an element
