(1)   101A2 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)   101A2 :                    ;;; Console through the USART's interrupts: received characters queue
(1)   101A2 :                    ;;; at rx_queue, characters to send at tx_queue. The USART interrupts on
(1)   101A2 :                    ;;; VI with identifier RX_ID or TX_ID. The queues are offsets in segment
(1)   101A2 :                    ;;; DATA.
(1)   101A2 : =2000              rx_queue:       equ     2000H
(1)   101A2 : =80                rx_queue_size:  equ     128
(1)   101A2 : =2080              tx_queue:       equ     2080H
(1)   101A2 : =80                tx_queue_size:  equ     128
(1)   101A2 :
(1)   101A2 :                    ;;; Initialize the queues and the USART
