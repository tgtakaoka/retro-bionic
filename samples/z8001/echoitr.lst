(2)   102DE :                    queue_add:
(2)   102DE : 93E2                       push    @rr14, r2
(2)   102E0 : 601A 0200                  ldb     rl2, DATA+queue_len(r1)
(2)   102E4 : 4A1A 0201                  cpb     rl2, DATA+queue_size(r1)
(2)   102E8 : E703                       jr      c, queue_add_store ; queue_len < queue_size
(2)   102EA : 97E2                       pop     r2, @rr14
