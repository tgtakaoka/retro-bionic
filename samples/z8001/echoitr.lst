(1)   101A6 : C880                       ldb     rl0, #rx_queue_size
(1)   101A8 : 5F00 8100 02C8             call    queue_init
(1)   101AE : 2101 2080                  ld      r1, #tx_queue
(1)   101B2 : C880                       ldb     rl0, #tx_queue_size
(1)   101B4 : 5F00 8100 02C8             call    queue_init
(1)   101BA : 8C88                       clrb    rl0
(1)   101BC : 3A86 0141                  outb    USARTC, rl0
