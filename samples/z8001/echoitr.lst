(1)   101CE : 8D07                       nop
(1)   101D0 : 8D07                       nop
(1)   101D2 : C84E                       ldb     rl0, #ASYNC_MODE
(1)   101D4 : 3A86 0141                  outb    USARTC, rl0
(1)   101D8 : 8D07                       nop
(1)   101DA : 8D07                       nop
(1)   101DC : C836                       ldb     rl0, #RX_EN_TX_DIS
(1)   101DE : 3A86 0141                  outb    USARTC, rl0
(1)   101E2 : C802                       ldb     rl0, #RX_ID
