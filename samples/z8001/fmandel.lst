(2)   103CC :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)   103CC :                    ;;; [queue] queue structure: the queues live in the data area DATA, a
(2)   103CC :                    ;;; pointer their offset there
(2)   103CC : =0                 queue_len:      equ     0       ; queue length
(2)   103CC : =1                 queue_size:     equ     1       ; buffer size
