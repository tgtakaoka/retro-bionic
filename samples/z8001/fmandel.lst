(1)     100 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     100 :                    ;;; Zilog's Z8070 emulator, FPE.O of CP/M-8000, on the bare Z8001. The
(1)     100 :                    ;;; extended instruction trap enters segmented with the frame FPE takes
(1)     100 :                    ;;; at fp_epu, the Olivetti M20's, already partly pushed: the trap's
(1)     100 :                    ;;; identifier (the instruction's first word), the FCW and the PC's
(1)     100 :                    ;;; segment and offset; R0-R13 and the normal stack pointer go below.
(1)     100 :                    ;;; FPE runs nonsegmented, so it, this file, its data and the system
(1)     100 :                    ;;; stack are in segment 0, where its addresses go; what it needs of the
(1)     100 :                    ;;; system copies between there and the program's segments.
(1)     100 : =0                 FPE_R0:         equ     0
(1)     100 : =1C                FPE_NR14:       equ     28
(1)     100 : =1E                FPE_NR15:       equ     30      ; FPE fills it in
(1)     100 : =20                FPE_ID:         equ     32
(1)     100 : =22                FPE_FCW:        equ     34
(1)     100 : =24                FPE_PCSEG:      equ     36
(1)     100 : =4                 FPE_CO:         equ     4       ; the segmented call above the frame
(1)     100 :
(1)     100 :                            cpu     z8001
(1)     100 :                    fpe_trap:
(1)     100 : 030F 0020                  sub     r15, #FPE_ID
(1)     104 : 1CE9 000D                  ldm     @rr14, r0, #14
(1)     108 : 7D06                       ldctl   r0, nspseg
(1)     10A : 33E0 001C                  ld      rr14(#FPE_NR14), r0
(1)     10E : 5F00 8000 59EA             call    fp_epu          ; runs the instruction, the PC past it
(1)     114 : 1CE1 000D                  ldm     r0, @rr14, #14
(1)     118 : 010F 0020                  add     r15, #FPE_ID
(1)     11C : 7B00                       iret
(1)     11E :
(1)     11E :                    ;;; Where the frame keeps R0, the identifier, the FCW and the PC's
(1)     11E :                    ;;; segment, as offsets from FPE's stack.
(1)     11E :                            cpu     z8002
(1)     11E : 0004               stareg:         word    FPE_R0+FPE_CO
(1)     120 : 0024               staevnt:        word    FPE_ID+FPE_CO
(1)     122 : 0026               stafcw:         word    FPE_FCW+FPE_CO
(1)     124 : 0028               stapcsg:        word    FPE_PCSEG+FPE_CO
