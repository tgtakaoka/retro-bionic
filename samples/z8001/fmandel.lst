(1)     158 : BA61 0340                  ldirb   @rr4, @rr6, r3
(1)     15C : 7D22                       ldctl   r2, fcw
(1)     15E : A32F                       res     r2, #15
(1)     160 : 7D2A                       ldctl   fcw, r2
(1)     162 :                            cpu     z8002
(1)     162 : 95F6                       popl    rr6, @r15
(1)     164 : 95F4                       popl    rr4, @r15
