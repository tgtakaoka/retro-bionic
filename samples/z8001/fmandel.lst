(1)   102A6 :                    ;;; Console through the USART's interrupts: received characters queue
(1)   102A6 :                    ;;; at rx_queue, characters to send at tx_queue. The USART interrupts on
(1)   102A6 :                    ;;; VI with identifier RX_ID or TX_ID, which usart.inc defines. The queues
(1)   102A6 :                    ;;; are offsets in the data area DATA.
(1)   102A6 : =2000              rx_queue:       equ     2000H
(1)   102A6 : =80                rx_queue_size:  equ     128
