(1)   1014C :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)   1014C :                    ;;; samples/arith/fmandel.c in Z8070 instructions, as DRI's C compiles
(1)   1014C :                    ;;; it: each sum and product is worked out in double from the float
(1)   1014C :                    ;;; variables, then stored as float. Without a Z8070 each instruction
(1)   1014C :                    ;;; traps, and Zilog's emulator, FPE.O, runs it.
(1)   1014C :
(1)   1014C :                    ;;; Print one 79x25 frame of the Mandelbrot set in float: each point is
(1)   1014C :                    ;;; its escape iteration in hex, or a space if it does not escape in 16.
