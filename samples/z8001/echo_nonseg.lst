        12C :                    receive_loop:
        12C : 3A84 0141                  inb     rl0, USARTS
        130 : A681                       bitb    rl0, #ST_RxRDY_bp
        132 : E6FC                       jr      z, receive_loop
        134 :                    receive_data:
        134 : 3AB4 0140                  inb     rl3, USARTD
        138 : 8CB4                       testb   rl3
        13A : E60B                       jr      z, halt_to_system
        13C :                    transmit_loop:
