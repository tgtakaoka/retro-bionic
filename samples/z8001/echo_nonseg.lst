        100 : 210F 1000                  ld      r15, #stack
        104 :                    init_usart:
        104 : 8C88                       clrb    rl0
        106 : 3A86 0141                  outb    USARTC, rl0
        10A : 3A86 0141                  outb    USARTC, rl0
        10E : 3A86 0141                  outb    USARTC, rl0     ; safest way to sync mode
        112 : C840                       ldb     rl0, #CMD_IR_bm
        114 : 3A86 0141                  outb    USARTC, rl0     ; reset
        118 : 8D07                       nop
        11A : 8D07                       nop
        11C : C84E                       ldb     rl0, #ASYNC_MODE
        11E : 3A86 0141                  outb    USARTC, rl0
        122 : 8D07                       nop
        124 : 8D07                       nop
