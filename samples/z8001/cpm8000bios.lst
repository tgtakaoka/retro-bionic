        1F2 : 9E08                       ret
        1F4 :                    trap_ret:
        1F4 : 7D02                       ldctl   r0, fcw
        1F6 : A30F                       res     r0, #15
        1F8 : 7D0A                       ldctl   fcw, r0
        1FA :                            cpu     z8002
        1FA : 61F1 001E                  ld      r1, FR_NR15(r15)
        1FE : 61FE 001C                  ld      r14, FR_NR14(r15)
