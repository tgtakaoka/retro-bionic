        364 :                    ;;; The BIOS functions.
        364 :                    functions:
        364 : 015E                       word    biosinit        ; 0 cold boot, done before the CCP
        366 : 0392                       word    wboot
        368 : 03A2                       word    const
        36A : 03B6                       word    conin
        36C : 03CA                       word    conout
        36E : 03D8                       word    list
        370 : 03D8                       word    auxout
        372 : 03E2                       word    auxin
        374 : 03EA                       word    home
        376 : 0408                       word    seldsk
        378 : 03EC                       word    settrk
        37A : 03F2                       word    setsec
        37C : 03F8                       word    setdma
        37E : 0460                       word    read
        380 : 0464                       word    write
        382 : 03DA                       word    listst
        384 : 0488                       word    sectran
        386 : 03D8                       word    unused
        388 : 049C                       word    getmrt
        38A : 04A4                       word    getiob
        38C : 04AE                       word    setiob
        38E : 04B4                       word    flush
        390 : 04B8                       word    setexc
        392 : =17                NFUNCS: equ     ($-functions)/2
        392 :
        392 :                    ;;; CCP and BDOS stay in memory: a fresh system stack and the CCP.
        392 :                    wboot:
        392 : 5F00 015E                  call    biosinit
        396 : 210F FFFE                  ld      r15, #SYSSTK
        39A : 0DF9 0392                  push    @r15, #wboot
        39E : 5E08 4AE0                  jp      ccp
        3A2 :
        3A2 :                    ;;; R7=FFH when a character is waiting, else 0.
        3A2 :                    const:
        3A2 : 8D68                       clr     r6
        3A4 : 3AF4 0141                  inb     rl7, USARTS
        3A8 : A6F1                       bitb    rl7, #ST_RxRDY_bp
        3AA : 2107 0000                  ld      r7, #0
        3AE : E602                       jr      z, const_ret
        3B0 : 2107 00FF                  ld      r7, #0FFH
        3B4 :                    const_ret:
        3B4 : 9E08                       ret
        3B6 :
        3B6 :                    conin:
        3B6 : 3AF4 0141                  inb     rl7, USARTS
        3BA : A6F1                       bitb    rl7, #ST_RxRDY_bp
        3BC : E6FC                       jr      z, conin
        3BE : 3AF4 0140                  inb     rl7, USARTD
        3C2 : 0707 007F                  and     r7, #7FH
        3C6 : 8D68                       clr     r6
        3C8 : 9E08                       ret
        3CA :
        3CA :                    ;;; RL5 to the console.
        3CA :                    conout:
        3CA : 3A84 0141                  inb     rl0, USARTS
        3CE : A680                       bitb    rl0, #ST_TxRDY_bp
        3D0 : E6FC                       jr      z, conout
        3D2 : 3AD6 0140                  outb    USARTD, rl5
        3D6 : 9E08                       ret
        3D8 :
        3D8 :                    ;;; No list or auxiliary device.
        3D8 :                    list:
        3D8 :                    auxout:
        3D8 :                    unused:
        3D8 : 9E08                       ret
        3DA :                    listst:
        3DA : 8D68                       clr     r6
        3DC : 2107 00FF                  ld      r7, #0FFH       ; ready, to drop the output
        3E0 : 9E08                       ret
        3E2 :                    auxin:
        3E2 : 8D68                       clr     r6
        3E4 : 2107 001A                  ld      r7, #1AH        ; end of file
        3E8 : 9E08                       ret
        3EA :
        3EA :                    home:
        3EA : 8D58                       clr     r5
        3EC :                    settrk:
        3EC : 3AD6 0151                  outb    DISK_TRACK, rl5
        3F0 : 9E08                       ret
        3F2 :
        3F2 :                    setsec:
        3F2 : 3AD6 0152                  outb    DISK_SECTOR, rl5
        3F6 : 9E08                       ret
        3F8 :
        3F8 :                    ;;; RR4, the DMA address, a long address whose segment the disk's 24-bit
        3F8 :                    ;;; DMA takes as its high byte.
        3F8 :                    setdma:
        3F8 : A048                       ldb     rl0, rh4
        3FA : 0608 7F7F                  andb    rl0, #7FH
        3FE : 6E08 0584                  ldb     dma_seg, rl0
        402 : 6F05 0582                  ld      dma_off, r5
        406 : 9E08                       ret
        408 :
        408 :                    ;;; RR6=the DPH of drive R5, or 0 when it has no image or a format this
        408 :                    ;;; BIOS lacks. DRIVE reads back the drive's format in bits 4-7, whose
        408 :                    ;;; skew table and DPB go in its DPH.
        408 :                    seldsk:
        408 : 0B05 0004                  cp      r5, #NDISKS
        40C : EF23                       jr      uge, seldsk_none
        40E : 3A84 0156                  inb     rl0, DISK_MOUNTED
        412 : 2605 0800                  bitb    rl0, r5
        416 : E61E                       jr      z, seldsk_none
        418 : 3AD6 0150                  outb    DISK_DRIVE, rl5
        41C : 3A84 0150                  inb     rl0, DISK_DRIVE
        420 : B281 00FC                  srlb    rl0, #4
        424 : 0A08 0202                  cpb     rl0, #NFORMATS
        428 : EF15                       jr      uge, seldsk_none
        42A : 8C08                       clrb    rh0
        42C : B301 0002                  sll     r0, #2
        430 : 0100 0458                  add     r0, #formats
        434 : A102                       ld      r2, r0
        436 : A151                       ld      r1, r5
        438 : B311 0004                  sll     r1, #4
        43C : 0101 0512                  add     r1, #dph0
        440 : 2120                       ld      r0, @r2
        442 : 6F10 0000                  ld      DPH_XLT(r1), r0
        446 : 6120 0002                  ld      r0, 2(r2)
        44A : 6F10 000A                  ld      DPH_DPB(r1), r0
        44E : 8D68                       clr     r6
        450 : A117                       ld      r7, r1
        452 : 9E08                       ret
        454 :                    seldsk_none:
        454 : 9266                       subl    rr6, rr6
        456 : 9E08                       ret
        458 :
        458 :                    ;;; Each format's skew table, or 0 for none, and DPB, by the index DRIVE
        458 :                    ;;; reads back.
        458 :                    formats:
        458 : 04D4 04EE                  word    xlt, dpb        ; 0: 8" single density, IBM 3740
        45C : 0000 0500                  word    0, dpb_hd8      ; 1: hd8, 8 MB
        460 : =2                 NFORMATS:       equ     ($-formats)/4
        460 :
        460 :                    ;;; R7=0 when the sector moved, else 1. Every write goes through; the
        460 :                    ;;; disk's DMA reaches any segment.
        460 :                    read:
        460 : C801                       ldb     rl0, #CMD_READ
        462 : E801                       jr      disk_go
        464 :                    write:
        464 : C802                       ldb     rl0, #CMD_WRITE
        466 :                    disk_go:
        466 : 6101 0582                  ld      r1, dma_off
        46A : 3A96 0153                  outb    DISK_DMAL, rl1
        46E : 3A16 0154                  outb    DISK_DMAH, rh1
        472 : 6009 0584                  ldb     rl1, dma_seg
        476 : 3A96 0157                  outb    DISK_DMAX, rl1
        47A : 3A86 0155                  outb    DISK_COMMAND, rl0
        47E : 3AF4 0155                  inb     rl7, DISK_COMMAND
        482 : 8C78                       clrb    rh7
        484 : 8D68                       clr     r6
        486 : 9E08                       ret
        488 :
        488 :                    ;;; R7=the physical sector of logical sector R5, from 0, through the
        488 :                    ;;; table at R7, or R5 itself when R7 is 0.
        488 :                    sectran:
        488 : 8D68                       clr     r6
        48A : 8D74                       test    r7
        48C : E605                       jr      z, sectran_none
        48E : A171                       ld      r1, r7
        490 : 701F 0500                  ldb     rl7, r1(r5)
        494 : 8C78                       clrb    rh7
        496 : 9E08                       ret
        498 :                    sectran_none:
        498 : A157                       ld      r7, r5
        49A : 9E08                       ret
        49C :
        49C :                    getmrt:
        49C : 8D68                       clr     r6
        49E : 2107 0552                  ld      r7, #mrt
        4A2 : 9E08                       ret
        4A4 :
        4A4 :                    getiob:
        4A4 : 8D68                       clr     r6
        4A6 : 600F 057C                  ldb     rl7, iobyte
        4AA : 8C78                       clrb    rh7
        4AC : 9E08                       ret
        4AE :
        4AE :                    setiob:
        4AE : 6E0D 057C                  ldb     iobyte, rl5
        4B2 : 9E08                       ret
        4B4 :
        4B4 :                    flush:
        4B4 : 9266                       subl    rr6, rr6
        4B6 : 9E08                       ret
        4B8 :
        4B8 :                    ;;; Sets exception vector R5 to RR6 and returns the old one in RR6.
        4B8 :                    setexc:
        4B8 : 0B05 0030                  cp      r5, #NTRAPS
        4BC : EF09                       jr      uge, setexc_bad
        4BE : A151                       ld      r1, r5
        4C0 : B311 0002                  sll     r1, #2
        4C4 : 5412 0586                  ldl     rr2, trapvec(r1)
        4C8 : 5D16 0586                  ldl     trapvec(r1), rr6
        4CC : 9426                       ldl     rr6, rr2
        4CE : 9E08                       ret
        4D0 :                    setexc_bad:
        4D0 : 9266                       subl    rr6, rr6
        4D2 : 9E08                       ret
        4D4 :
        4D4 :                    ;;; Skew 6, the 8" standard.
        4D4 :                    xlt:
        4D4 : 0107 0D13 1905             byte    1, 7, 13, 19, 25, 5, 11, 17, 23, 3, 9, 15, 21
        4DA : 0B11 1703 090F
        4E0 : 15
        4E1 :   02 080E 141A 060C            byte    2, 8, 14, 20, 26, 6, 12, 18, 24, 4, 10, 16, 22
        4E8 : 1218 040A 1016
        4EE :
        4EE :                    ;;; A Disk Parameter Block: SPT, BSH, BLM, EXM, a pad, DSM, DRM, AL0,
        4EE :                    ;;; AL1, CKS, OFF, then the physical sector shift and mask, 128-byte
        4EE :                    ;;; sectors here. The 8" single-density disk: 1K blocks, 243 of them, 64
        4EE :                    ;;; directory entries, 2 system tracks.
        4EE :                            align   2
        4EE :                    dpb:
        4EE : 001A                       word    26
        4F0 : 0307 0000                  byte    3, 7, 0, 0
        4F4 : 00F2                       word    242
        4F6 : 003F                       word    63
        4F8 : C000                       byte    0C0H, 0
        4FA : 0010                       word    16
        4FC : 0002                       word    2
        4FE : 0000                       byte    0, 0
        500 :                    ;;; hd8, the debugger's 8 MB format: 256 tracks of 256 sectors from 0,
        500 :                    ;;; no skew, 8K blocks, 1024 directory entries, 2 system tracks. The
        500 :                    ;;; values are the format's, the same under every CP/M.
        500 :                    dpb_hd8:
        500 : 0100                       word    256
        502 : 063F 0300                  byte    6, 63, 3, 0
        506 : 03F7                       word    1015
        508 : 03FF                       word    1023
        50A : F000                       byte    0F0H, 0
        50C : 0000                       word    0
        50E : 0002                       word    2
        510 : 0000                       byte    0, 0
        512 :
        512 :                    ;;; SELDSK sets each DPH's skew table and DPB by the drive's format.
        512 : 04D4 0000 0000     dph0:   word    xlt, 0, 0, 0, dirbuf, dpb, csvs+CSV_SIZE*0, alv+ALV_SIZE*0
        518 : 0000 0646 04EE
        51E : 06C6 0706
        522 : 04D4 0000 0000             word    xlt, 0, 0, 0, dirbuf, dpb, csvs+CSV_SIZE*1, alv+ALV_SIZE*1
        528 : 0000 0646 04EE
        52E : 06D6 0785
        532 : 04D4 0000 0000             word    xlt, 0, 0, 0, dirbuf, dpb, csvs+CSV_SIZE*2, alv+ALV_SIZE*2
        538 : 0000 0646 04EE
        53E : 06E6 0804
        542 : 04D4 0000 0000             word    xlt, 0, 0, 0, dirbuf, dpb, csvs+CSV_SIZE*3, alv+ALV_SIZE*3
        548 : 0000 0646 04EE
        54E : 06F6 0883
        552 :
        552 :                    ;;; The memory region table, the M20's, by the segment in each region's
        552 :                    ;;; high word: a merged program's 64K, a split program's code and data,
        552 :                    ;;; the data view of its code, and DDT's.
        552 : 0005               mrt:    word    5
        554 : 0A00 0000 0001             long    SEG_MERGED*10000H, 10000H
        55A : 0000
        55C : 0800 0000 0001             long    SEG_SPLIT*10000H, 10000H
        562 : 0000
        564 : 0800 0000 0001             long    SEG_SPLIT*10000H, 10000H
        56A : 0000
        56C : 0B00 0000 0001             long    SEG_ISPACE*10000H, 10000H
        572 : 0000
        574 : 0900 0000 0001             long    SEG_DDT*10000H, 10000H
        57A : 0000
        57C :
        57C : 00                 iobyte: byte    0
        57D :                    ;;; The kernel's system segment, 0, and the TPA's, which map_adr -1 sets,
        57D :                    ;;; both as a long address's high word.
        57E :                            align   2
        57E :                    _sysseg:
        57E : 0000                       word    0
        580 : 0000               usrseg: word    0
        582 :                    dma_off:
        582 : 0000                       word    0
        584 :                    dma_seg:
        584 : 00                         byte    0
        585 :
        585 :                    ;;; Uninitialised areas: the exception vector, then the BDOS's scratch.
        586 :                            align   2
        586 : =586               bss:    equ     $
        586 : =586               trapvec:        equ     bss
        586 : =646               dirbuf:         equ     trapvec+NTRAPS*4
        586 : =6C6               csvs:           equ     dirbuf+128
        586 : =706               alv:            equ     csvs+CSV_SIZE*NDISKS
        586 : =902               bss_end:        equ     alv+ALV_SIZE*NDISKS
        586 :                            end
