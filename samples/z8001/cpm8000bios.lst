        2DE :
        2DE :                    ;;; The context switch starts a program: copy the context block at RR6,
        2DE :                    ;;; R0-R15, a word to ignore, the FCW and the PC's segment and offset,
        2DE :                    ;;; over the caller's frame, which never resumes, and return into it.
        2DE :                    xfersc:
