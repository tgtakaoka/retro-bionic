        2AE : 9E0E                       ret     nz
        2B0 : A146                       ld      r6, r4                  ; else its PC's
        2B2 : 9E08                       ret
        2B4 :                    map_caller_prog:
        2B4 : A72F                       bit     r2, #15
        2B6 : EE0A                       jr      nz, map_prog
        2B8 : A146                       ld      r6, r4
        2BA : E808                       jr      map_prog
        2BC :                    map_sys:
        2BC : 6106 057E                  ld      r6, _sysseg
        2C0 : 9E08                       ret
        2C2 :                    map_tpa_data:
        2C2 : 6106 0580                  ld      r6, usrseg
        2C6 : 9E08                       ret
        2C8 :                    map_tpa_prog:
        2C8 : 6106 0580                  ld      r6, usrseg
        2CC :                    ;;; A split program's code, at segment 8, is in its instruction space;
        2CC :                    ;;; the BIOS reaches it as data through segment 0BH, unless the caller
