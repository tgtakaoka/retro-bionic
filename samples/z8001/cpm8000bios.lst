          0 :                    ;;; A Disk Parameter Header with the kernel's 16-bit pointers: XLT, three
          0 :                    ;;; scratch words, DIRBUF, DPB, CSV and ALV.
          0 : =10                DPH_SIZE:       equ     16
          0 : =0                 DPH_XLT:        equ     0
          0 : =A                 DPH_DPB:        equ     10
          0 : =7F                ALV_SIZE:       equ     127     ; hd8's 1016 blocks, a bit each
          0 : =10                CSV_SIZE:       equ     16      ; the 8" disk's 64 directory entries
          0 :
          0 :                    ;;; The Program Status Area, at <<0>>0000H: a reserved word, an FCW and a
          0 :                    ;;; PC's segment and offset per entry, the reset's first; the debugger
          0 :                    ;;; serves the reset FCW and takes #NMI itself. Every handler starts
          0 :                    ;;; segmented in system mode, interrupts disabled.
          0 :                            org     PSA
          0 : 0000 C000 0000             word    0, FCW_SEG|FCW_SN, 0, start
          6 : 0100
          8 : 0000 C000 0000             word    0, FCW_SEG|FCW_SN, 0, epu_trap  ; extended instruction
          E : 0198
         10 : 0000 C000 0000             word    0, FCW_SEG|FCW_SN, 0, pi_trap   ; privileged instruction
         16 : 019E
         18 : 0000 C000 0000             word    0, FCW_SEG|FCW_SN, 0, sc_trap   ; system call
         1E : 0192
         20 : 0000 C000 0000             word    0, FCW_SEG|FCW_SN, 0, seg_trap  ; segmentation
         26 : 01A4
         28 : 0000 C000 0000             word    0, FCW_SEG|FCW_SN, 0, nmi_trap
         2E : 01AA
         30 : 0000 C000 0000             word    0, FCW_SEG|FCW_SN, 0, isr_nvi
         36 : 021A
         38 : 0000 C000                  word    0, FCW_SEG|FCW_SN               ; vectored interrupts: a
         3C : 0000 0214 0000             word    0, isr_vi, 0, isr_vi, 0, isr_vi, 0, isr_vi  ; PC each
         42 : 0214 0000 0214
         48 : 0000 0214
         4C : 0000 0214 0000             word    0, isr_vi, 0, isr_vi, 0, isr_vi, 0, isr_vi
         52 : 0214 0000 0214
         58 : 0000 0214
         5C : 0000 0214 0000             word    0, isr_vi, 0, isr_vi, 0, isr_vi, 0, isr_vi
         62 : 0214 0000 0214
         68 : 0000 0214
         6C : 0000 0214 0000             word    0, isr_vi, 0, isr_vi, 0, isr_vi, 0, isr_vi
         72 : 0214 0000 0214
