        204 : 7D02                       ldctl   r0, fcw
        206 : A50F                       set     r0, #15
        208 : 7D0A                       ldctl   fcw, r0
        20A :                            cpu     z8001
        20A : 1CE1 000D                  ldm     r0, @rr14, #14
