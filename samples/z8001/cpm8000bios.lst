          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                    ;;; The CP/M-8000 BIOS for the Z8001: the console on the i8251 and four
          0 :                    ;;; drives on the debugger's sector disk, both polled, byte I/O at 16-bit
          0 :                    ;;; port addresses. DRI's 1.1 kernel, linked at SYSTEM by xout-link.py as
          0 :                    ;;; DRI shipped it for the Olivetti M20, runs nonsegmented in system mode
          0 :                    ;;; in segment 0 and calls the BIOS with SC #3: R3 the function, RR4 and
          0 :                    ;;; RR6 the parameters, the result back in RR6 (R7 for a word). SC #2 is
          0 :                    ;;; the BDOS, SC #1 memory management and the context switch that starts
          0 :                    ;;; a program. Traps enter segmented, as the Z8001 takes them; the
          0 :                    ;;; dispatcher saves the M20's frame and calls each handler segmented, as
          0 :                    ;;; the kernel's own trap glue expects. `cpu z8001` marks code that runs
          0 :                    ;;; segmented, `cpu z8002` code that runs nonsegmented.
          0 :                            cpu     z8001
          0 :                            include "cpm8000.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; CP/M-8000 1.1 on the Z8001: where everything sits, shared by
(1)       0 :                    ;;; cpm8000bios.asm and the Makefile's link. DRI released 1.1 for the
(1)       0 :                    ;;; Olivetti M20, a Z8001, and this follows its memory: the system in
(1)       0 :                    ;;; one segment, running nonsegmented, and each program in a segment of
(1)       0 :                    ;;; its own.
(1)       0 :                            include "z8001.inc"
(2)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)       0 :                    ;;; Z8001. A sample says `cpu z8001` for segmented code, its addresses
(2)       0 :                    ;;; seg<<16|off written <<seg>>off, or `cpu z8002` for code that runs
(2)       0 :                    ;;; nonsegmented, its addresses offsets in the PC's segment.
(2)       0 :
(2)       0 :                    ;;; Reset reads the FCW at 0002H, then the PC's segment at 0004H and its
(2)       0 :                    ;;; offset at 0006H, the reset entry of a Program Status Area at 0000H in
(2)       0 :                    ;;; segment 0.
(2)       0 : =0                 ORG_RESET:      equ     0000H
(2)       0 :                    ;;; Program Status Area offsets: a reserved word, an FCW, then a PC's
(2)       0 :                    ;;; segment and offset.
(2)       0 : =8                 PSA_EPA:        equ     08H     ; extended instruction trap
(2)       0 : =10                PSA_PRIV:       equ     10H     ; privileged instruction trap
(2)       0 : =18                PSA_SC:         equ     18H     ; system call
(2)       0 : =20                PSA_SEGT:       equ     20H     ; segment trap
(2)       0 : =28                PSA_NMI:        equ     28H     ; non-maskable interrupt
(2)       0 : =30                PSA_NVI:        equ     30H     ; non-vectored interrupt
(2)       0 : =38                PSA_VI:         equ     38H     ; vectored interrupt: the FCW, then a PC
(2)       0 :                                                    ; for each even identifier from 3CH, the
(2)       0 :                                                    ; one for identifier n at PSA_VI+4+2*n
(2)       0 :                    ;;; Flag and Control Word
(2)       0 : =8000              FCW_SEG:        equ     8000H   ; segmented mode
(2)       0 : =4000              FCW_SN:         equ     4000H   ; system mode
(2)       0 : =2000              FCW_EPA:        equ     2000H   ; extended processor architecture
(2)       0 : =1000              FCW_VIE:        equ     1000H   ; vectored interrupt enable
(2)       0 : =800               FCW_NVIE:       equ     0800H   ; non-vectored interrupt enable
(2)       0 :
(2)       0 :                    ;;; Where the segmented samples live, each in a segment of its own.
(2)       0 : =10000             CODE:           equ     010000H ; code, segment 1
(2)       0 : =100               CODE_SEG:       equ     0100H   ; its segment word: the number in bits 14-8
(2)       0 : =20000             SEGDATA:        equ     020000H ; their DATA: queues and variables, segment 2
(2)       0 : =3001000           STACK:          equ     03001000H ; RR14: segment 3, offset 1000H
(2)       0 :                    ;;; The normal mode stack, NSPSEG and NSPOFF: segment 4, offset 1000H.
(2)       0 : =400               USTACK_SEG:     equ     0400H
(2)       0 : =1000              USTACK_OFF:     equ     1000H
(2)       0 :
(2)       0 :                    ;;; SC #SC_EXIT hands control back to the debugger, as a breakpoint does.
(2)       0 : =FF                SC_EXIT:        equ     0FFH
(1)       0 :
(1)       0 :                    ;;; The system segment, 0: the Program Status Area at 0000H, whose first
(1)       0 :                    ;;; entry is the reset's, the BIOS, then the kernel, CCP and BDOS as DRI
(1)       0 :                    ;;; linked them with its commons linked after it at SYSTEM by
(1)       0 :                    ;;; xout-link.py, and the system stack at the top.
(1)       0 : =0                 PSA:            equ     0000H
(1)       0 :                    ;;; Through the vectored interrupts' table, identifiers 0 to 30.
(1)       0 : =80                PSA_SIZE:       equ     80H
(1)       0 : =100               BIOS_ORG:       equ     0100H
(1)       0 : =2000              SYSTEM:         equ     2000H
(1)       0 : =FFFE              SYSSTK:         equ     0FFFEH
(1)       0 :
(1)       0 :                    ;;; Where programs run, each segment's number in bits 14-8 of a long
(1)       0 :                    ;;; address's high word, as the memory region table hands them out: a
(1)       0 :                    ;;; merged program in 0AH; a split one's code and data both at 8, whose
(1)       0 :                    ;;; instruction space the debugger keeps in 0BH, the segment the loader
(1)       0 :                    ;;; writes the code through; DDT in 9.
(1)       0 : =A00               SEG_MERGED:     equ     0A00H
(1)       0 : =800               SEG_SPLIT:      equ     0800H
(1)       0 : =B00               SEG_ISPACE:     equ     0B00H
(1)       0 : =900               SEG_DDT:        equ     0900H
(1)       0 :
(1)       0 :                    ;;; System call numbers: SC #n.
(1)       0 : =1                 MEM_SC:         equ     1       ; memory management and context switch
(1)       0 : =2                 BDOS_SC:        equ     2
(1)       0 : =3                 BIOS_SC:        equ     3
(1)       0 :                    ;;; The exception vector the BIOS keeps: 48 longs, traps 0-31 and system
(1)       0 :                    ;;; calls 0-15 as 32-47, numbered as CP/M-68K's.
(1)       0 : =30                NTRAPS:         equ     48
(1)       0 : =20                SC0TRAP:        equ     32
(1)       0 : =1                 EPUTRAP:        equ     1
(1)       0 : =2                 SEGTRAP:        equ     2
(1)       0 : =8                 PITRAP:         equ     8
(1)       0 : =0                 NMITRAP:        equ     0
(1)       0 :
(1)       0 :                    ;;; The trap frame the dispatcher builds on the system stack, the M20's,
(1)       0 :                    ;;; which DRI's kernel reads: R0-R13, the normal R14 and R15, then what
(1)       0 :                    ;;; the CPU pushed, the SC identifier, FCW and PC's segment and offset.
(1)       0 :                    ;;; A handler is called segmented, with CO bytes of return address on
(1)       0 :                    ;;; top, and sees each CO higher. A program's startup context, which
(1)       0 :                    ;;; xfer copies over the frame, has the same layout.
(1)       0 : =0                 FR_R0:          equ     0
(1)       0 : =C                 FR_R6:          equ     12
(1)       0 : =E                 FR_R7:          equ     14
(1)       0 : =1C                FR_NR14:        equ     28
(1)       0 : =1E                FR_NR15:        equ     30
(1)       0 : =20                FR_ID:          equ     32
(1)       0 : =22                FR_FCW:         equ     34
(1)       0 : =24                FR_PCSEG:       equ     36
(1)       0 : =26                FR_PC:          equ     38
(1)       0 : =28                FRAME:          equ     40
(1)       0 : =4                 CO:             equ     4
(1)       0 :
(1)       0 :                    ;;; The SPLIT device's control port: on, a normal-mode program fetch in
(1)       0 :                    ;;; segment 8 reads segment 0BH, the M20's instruction space.
(1)       0 : =160               SPLIT_CTRL:     equ     160H
(1)       0 : =1                 SPLIT_ON:       equ     1
          0 :                            include "../z8002/usart.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; i8251 Universal Synchronous/Asynchronous Receiver/Transmitter
(1)       0 : =140               USART:  equ     140H
(1)       0 : =140               USARTD: equ     USART+0         ; Data register
(1)       0 : =141               USARTS: equ     USART+1         ; Status register
(1)       0 : =141               USARTC: equ     USART+1         ; Control register
(1)       0 : =142               USARTRV:        equ     USART+2 ; Receive interrupt identifier
(1)       0 : =143               USARTTV:        equ     USART+3 ; Transmit interrupt identifier
(1)       0 :                    ;;; The identifiers the USART answers its vectored interrupts with: even,
(1)       0 :                    ;;; as the Z8001 requires.
(1)       0 : =2                 RX_ID:          equ     2
(1)       0 : =4                 TX_ID:          equ     4
(1)       0 :                            include "../z80/i8251.inc"
(2)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)       0 :
(2)       0 :                    ;;; i8251 USART device emulator.
(2)       0 :                    ;;; Bit definition of mode register
(2)       0 : =6                 MODE_STOP_gp:   equ     6
(2)       0 : =C0                MODE_STOP_gm:   equ     11000000B
(2)       0 : =40                MODE_STOP1_gc:  equ     (1 << MODE_STOP_gp)
(2)       0 : =80                MODE_STOP15_gc: equ     (2 << MODE_STOP_gp)
(2)       0 : =C0                MODE_STOP2_gc:  equ     (3 << MODE_STOP_gp)
(2)       0 : =20                MODE_EVEN_bm:   equ     00100000B
(2)       0 : =10                MODE_PARITY_bm: equ     00010000B
(2)       0 : =2                 MODE_LEN_gp:    equ     2
(2)       0 : =C                 MODE_LEN_gm:    equ     00001100B
(2)       0 : =0                 MODE_LEN5_gc:   equ     (0 << MODE_LEN_gp)
(2)       0 : =4                 MODE_LEN6_gc:   equ     (1 << MODE_LEN_gp)
(2)       0 : =8                 MODE_LEN7_gc:   equ     (2 << MODE_LEN_gp)
(2)       0 : =C                 MODE_LEN8_gc:   equ     (3 << MODE_LEN_gp)
(2)       0 : =0                 MODE_BAUD_gp:   equ     0
(2)       0 : =3                 MODE_BAUD_gm:   equ     00000011B
(2)       0 : =1                 MODE_BAUD_X1:   equ     (1 << MODE_BAUD_gp)
(2)       0 : =2                 MODE_BAUD_X16:  equ (2 << MODE_BAUD_gp)
(2)       0 : =3                 MODE_BAUD_X64:  equ (3 << MODE_BAUD_gp)
(2)       0 :                    ;;; Bit Definition of command register
(2)       0 : =80                CMD_EH_bm:      equ     10000000B   ; Enter hunt mode
(2)       0 : =40                CMD_IR_bm:      equ     01000000B   ; Internal Reset
(2)       0 : =20                CMD_RTS_bm:     equ     00100000B   ; Request To Send
(2)       0 : =10                CMD_ER_bm:      equ     00010000B   ; Error Reset
(2)       0 : =8                 CMD_SBRK_bm:    equ     00001000B   ; Send Break
(2)       0 : =4                 CMD_RxEN_bm:    equ     00000100B   ; Receive Enable
(2)       0 : =2                 CMD_DTR_bm:     equ     00000010B   ; Data Terminal Ready
(2)       0 : =1                 CMD_TxEN_bm:    equ     00000001B   ; Transmit enable
(2)       0 :
(2)       0 :                    ;;; Bit definition of status register
(2)       0 : =80                ST_DSR_bm:      equ     10000000B   ; Data Set Ready
(2)       0 : =40                ST_BRK_bm:      equ     01000000B   ; BREAK detected
(2)       0 : =20                ST_FE_bm:       equ     00100000B   ; Framing Error
(2)       0 : =10                ST_OE_bm:       equ     00010000B   ; Overrun Error
(2)       0 : =8                 ST_PE_bm:       equ     00001000B   ; Parity Error
(2)       0 : =2                 ST_TxEMPTY_bp:  equ     2           ; Transmitter empty
(2)       0 : =1                 ST_RxRDY_bp:    equ     1           ; Receiver ready
(2)       0 : =0                 ST_TxRDY_bp:    equ     0           ; Transmitter ready
(1)       0 :                    ;;; Async 1stop 8data x16
(1)       0 : =4E                ASYNC_MODE:     equ     MODE_STOP1_gc|MODE_LEN8_gc|MODE_BAUD_X16
(1)       0 :                    ;;; RTS/DTR, error reset, Rx enable, Tx enable
(1)       0 : =37                RX_EN_TX_EN:    equ     CMD_RTS_bm|CMD_DTR_bm|CMD_ER_bm|CMD_RxEN_bm|CMD_TxEN_bm
(1)       0 : =36                RX_EN_TX_DIS:   equ     CMD_RTS_bm|CMD_DTR_bm|CMD_ER_bm|CMD_RxEN_bm
          0 :                            include "cpm8000sys.inc"
