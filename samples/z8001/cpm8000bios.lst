        26C : 61F2 0026                  ld      r2, FR_FCW+CO(r15)      ; and FCW
        270 : 5F00 027A                  call    map_space
        274 : 5DF6 0010                  ldl     FR_R6+CO(r15), rr6      ; the caller's RR6
        278 : E8E8                       jr      seg_ret
        27A :                    map_space:
        27A : 0B05 FFFF                  cp      r5, #-1
        27E : E613                       jr      eq, set_usrseg
        280 : 0A0D 0000                  cpb     rl5, #0
        284 : E613                       jr      eq, map_caller_data
        286 : 0A0D 0101                  cpb     rl5, #1
        28A : E614                       jr      eq, map_caller_prog
        28C : 0A0D 0202                  cpb     rl5, #2
        290 : E615                       jr      eq, map_sys
        292 : 0A0D 0303                  cpb     rl5, #3
        296 : E612                       jr      eq, map_sys
        298 : 0A0D 0404                  cpb     rl5, #4
        29C : E612                       jr      eq, map_tpa_data
        29E : 0A0D 0505                  cpb     rl5, #5
        2A2 : E612                       jr      eq, map_tpa_prog
        2A4 : 9E08                       ret
        2A6 :                    set_usrseg:
        2A6 : 6F06 0580                  ld      usrseg, r6              ; the region's high word
        2AA : 9E08                       ret
        2AC :                    map_caller_data:
