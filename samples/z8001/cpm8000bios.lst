        2F2 :                    ;;; An extended instruction with no EPU, called segmented: skipped. The C
        2F2 :                    ;;; start-up clears the Z8070's registers with them; a program that
        2F2 :                    ;;; computes in floating point gets nothing back. The trap's identifier is
        2F2 :                    ;;; the instruction's first word, whose mode bits say how long it is:
        2F2 :                    ;;; direct and indexed addressing take a word more, in segmented mode a
        2F2 :                    ;;; long address two.
