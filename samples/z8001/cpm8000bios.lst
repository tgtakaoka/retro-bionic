        24E : 7D0A                       ldctl   fcw, r0
        250 :                            cpu     z8001
        250 : 9E08                       ret
        252 :
        252 :                    ;;; SC #1, called segmented. With RR2 the length, from 1 to 64K, mem_cpy
        252 :                    ;;; copies RR2 bytes from RR6 to RR4, long addresses. With RR2 zero,
        252 :                    ;;; map_adr returns RR6 in the segment the space R5 names: 0 and 1 the
        252 :                    ;;; caller's data and program, 2 and 3 the system's, 4 and 5 the TPA's,
        252 :                    ;;; a program space plus 256 meaning an instruction address rather than
        252 :                    ;;; the data view of it; -1 sets the TPA's segment from the region the
        252 :                    ;;; loader passes, -2 is the context switch.
        252 :                    memsc:
        252 : 9C28                       testl   rr2
        254 : E603                       jr      z, mem_map
        256 : BA61 0340                  ldirb   @rr4, @rr6, r3
        25A : 9E08                       ret
        25C :                    mem_map:
        25C : 7D02                       ldctl   r0, fcw
        25E : A30F                       res     r0, #15
        260 : 7D0A                       ldctl   fcw, r0
        262 :                            cpu     z8002
        262 : 0B05 FFFE                  cp      r5, #-2
        266 : E63B                       jr      eq, xfersc
