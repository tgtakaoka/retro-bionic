         7C :                    ;;; Cold boot, entered segmented: the system stack, the PSA, the M20's
         7C :                    ;;; instruction space for split programs, then nonsegmented the traps and
         7C :                    ;;; the console, and the CCP, which warm boots if it ever returns. The
         7C :                    ;;; CCP initialises the BDOS only once, by a flag after autost it sets;
         7C :                    ;;; cleared, a reset without a reload boots too.
        100 :                            org     BIOS_ORG
        100 :                    start:
        100 : 7C00                       di      vi, nvi
        102 : 140E 0000 FFFE             ldl     rr14, #SYSSTK
        108 : 8D08                       clr     r0
        10A : 7D0C                       ldctl   psapseg, r0
        10C : 2100 0000                  ld      r0, #PSA
        110 : 7D0D                       ldctl   psapoff, r0
        112 : C801                       ldb     rl0, #SPLIT_ON
        114 : 3A86 0160                  outb    SPLIT_CTRL, rl0
        118 : 7D02                       ldctl   r0, fcw
        11A : A30F                       res     r0, #15
        11C : 7D0A                       ldctl   fcw, r0
        11E :                            cpu     z8002
        11E : 4C08 6EAF                  clrb    _autost+1
