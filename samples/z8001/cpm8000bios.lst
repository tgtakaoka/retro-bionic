        132 :                    ;;; The exception vector: cleared, then the memory management and BIOS
        132 :                    ;;; system calls, and the extended instruction trap no EPU takes, each a
        132 :                    ;;; long address in segment 0.
        132 :                    trapinit:
        132 : 2102 0586                  ld      r2, #trapvec
        136 : 2100 0030                  ld      r0, #NTRAPS
        13A : 9244                       subl    rr4, rr4
        13C :                    trapinit_clear:
        13C : 1D24                       ldl     @r2, rr4
        13E : A923                       inc     r2, #4
        140 : F083                       djnz    r0, trapinit_clear
        142 : 8D28                       clr     r2
        144 : 2103 0252                  ld      r3, #memsc
        148 : 5D02 060A                  ldl     trapvec+4*(SC0TRAP+MEM_SC), rr2
        14C : 2103 0220                  ld      r3, #biossc
        150 : 5D02 0612                  ldl     trapvec+4*(SC0TRAP+BIOS_SC), rr2
        154 : 2103 02F2                  ld      r3, #epu_exc
        158 : 5D02 058A                  ldl     trapvec+4*EPUTRAP, rr2
        15C : 9E08                       ret
        15E :
        15E :                    ;;; The console: asynchronous, 8 bits, 1 stop bit, polled. Its interrupt
        15E :                    ;;; identifiers, which a reset leaves as a sample set them, go to 0: a
        15E :                    ;;; program runs with interrupts enabled, and they would hang it.
        15E :                    biosinit:
        15E : 8C88                       clrb    rl0
        160 : 3A86 0141                  outb    USARTC, rl0
        164 : 3A86 0141                  outb    USARTC, rl0
        168 : 3A86 0141                  outb    USARTC, rl0     ; safest way to sync mode
        16C : C840                       ldb     rl0, #CMD_IR_bm
        16E : 3A86 0141                  outb    USARTC, rl0     ; reset
        172 : 8D07                       nop
        174 : 8D07                       nop
        176 : C84E                       ldb     rl0, #ASYNC_MODE
        178 : 3A86 0141                  outb    USARTC, rl0
        17C : 8D07                       nop
        17E : 8D07                       nop
        180 : C837                       ldb     rl0, #RX_EN_TX_EN
        182 : 3A86 0141                  outb    USARTC, rl0
        186 : 8C88                       clrb    rl0
        188 : 3A86 0142                  outb    USARTRV, rl0
        18C : 3A86 0143                  outb    USARTTV, rl0
        190 : 9E08                       ret
        192 :
        192 :                    ;;; The trap dispatcher, entered segmented. Each trap pushes its number
        192 :                    ;;; below what the CPU pushed and saves R0-R13 under it; nonsegmented,
        192 :                    ;;; the normal R14 and R15 go in, the number coming out for the frame of
        192 :                    ;;; cpm8000.inc, and the exception vector's handler is called segmented
        192 :                    ;;; with the frame at CO(R15); a zero vector resumes the program. A system
        192 :                    ;;; call's number comes from the SC instruction word the CPU pushed. The
        192 :                    ;;; stack is in segment 0, where nonsegmented addresses go, so the frame
        192 :                    ;;; is reached nonsegmented.
        192 :                            cpu     z8001
        192 :                    sc_trap:
        192 : 0DE9 7F00                  push    @rr14, #7F00H
        196 : E80B                       jr      trap
        198 :                    epu_trap:
        198 : 0DE9 0001                  push    @rr14, #EPUTRAP
        19C : E808                       jr      trap
        19E :                    pi_trap:
        19E : 0DE9 0008                  push    @rr14, #PITRAP
        1A2 : E805                       jr      trap
        1A4 :                    seg_trap:
        1A4 : 0DE9 0002                  push    @rr14, #SEGTRAP
        1A8 : E802                       jr      trap
        1AA :                    nmi_trap:
        1AA : 0DE9 0000                  push    @rr14, #NMITRAP
        1AE :                    trap:
        1AE : 030F 001E                  sub     r15, #FR_NR15
        1B2 : 1CE9 000D                  ldm     @rr14, r0, #14
        1B6 : 7D02                       ldctl   r0, fcw
        1B8 : A30F                       res     r0, #15
        1BA : 7D0A                       ldctl   fcw, r0
        1BC :                            cpu     z8002
        1BC : 7D17                       ldctl   r1, nsp
        1BE : 6FFE 001C                  ld      FR_NR14(r15), r14       ; nonsegmented, R14 is the normal one
        1C2 : 6DF1 001E                  ex      r1, FR_NR15(r15)
        1C6 : 0A01 7F7F                  cpb     rh1, #7FH
        1CA : EE05                       jr      ne, trap_disp
        1CC : 61F1 0020                  ld      r1, FR_ID(r15)          ; SC #n: 7F00H|n
        1D0 : 8C18                       clrb    rh1
        1D2 : 0101 0020                  add     r1, #SC0TRAP
        1D6 :                    trap_disp:
        1D6 : B311 0002                  sll     r1, #2
        1DA : 5410 0586                  ldl     rr0, trapvec(r1)
        1DE : 9C08                       testl   rr0
