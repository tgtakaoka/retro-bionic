        220 : 7D02                       ldctl   r0, fcw
        222 : A30F                       res     r0, #15
        224 : 7D0A                       ldctl   fcw, r0
        226 :                            cpu     z8002
        226 : 61F0 0026                  ld      r0, FR_FCW+CO(r15)
        22A : 0700 C000                  and     r0, #FCW_SEG|FCW_SN
        22E : EE03                       jr      nz, biossc_call
        230 : 61F4 0028                  ld      r4, FR_PCSEG+CO(r15)
        234 : A146                       ld      r6, r4
