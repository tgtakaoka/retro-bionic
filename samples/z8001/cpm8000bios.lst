        31A :                    ;;; What the kernel calls as C functions, the arguments on the stack
        31A :                    ;;; above the return address, leftmost first: long bios(code, p1, p2),
        31A :                    ;;; long bdos(code, p1), long map_adr(addr, space), mem_cpy(src, dst,
        31A :                    ;;; len) and xfer(context).
