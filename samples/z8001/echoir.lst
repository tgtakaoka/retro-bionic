(1)   101B4 : 8312                       sub     r2, r1
(1)   101B6 : A8A0                       incb    rl2, #1            ; queue_put++
(1)   101B8 : 4A1A 0201                  cpb     rl2, DATA+queue_size(r1)
(1)   101BC : E701                       jr      c, queue_add_update ; queue_put < queue_size
(1)   101BE : 8CA8                       clrb    rl2                 ; wrap around
(1)   101C0 :                    queue_add_update:
(1)   101C0 : 6E1A 0202                  ldb     DATA+queue_put(r1), rl2
(1)   101C4 : 97E2                       pop     r2, @rr14
(1)   101C6 : 8D81                       setflg  c
(1)   101C8 : 9E08                       ret
(1)   101CA :
(1)   101CA :                    ;;; [queue] Remove an element from queue
(1)   101CA :                    ;;; @param R1 queue work space pointer
