(1)   10198 : 4A1A 0201                  cpb     rl2, DATA+queue_size(r1)
(1)   1019C : E703                       jr      c, queue_add_store ; queue_len < queue_size
(1)   1019E : 97E2                       pop     r2, @rr14
(1)   101A0 : 8D83                       resflg  c
(1)   101A2 : 9E08                       ret
(1)   101A4 :                    queue_add_store:
(1)   101A4 : 6810 0200                  incb    DATA+queue_len(r1), #1
(1)   101A8 : 8D28                       clr     r2
(1)   101AA : 601A 0202                  ldb     rl2, DATA+queue_put(r1)
