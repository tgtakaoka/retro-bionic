(1)   1017C :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)   1017C :                    ;;; [queue] queue structure: the queues live in segment DATA, a pointer
(1)   1017C :                    ;;; their offset there
(1)   1017C : =0                 queue_len:      equ     0       ; queue length
(1)   1017C : =1                 queue_size:     equ     1       ; buffer size
(1)   1017C : =2                 queue_put:      equ     2       ; queue put index
(1)   1017C : =3                 queue_get:      equ     3       ; queue get index
(1)   1017C : =4                 queue_buf:      equ     4       ; buffer start offset
(1)   1017C :
(1)   1017C :                    ;;; [queue] Initialize queue
(1)   1017C :                    ;;; @param R1 queue work space pointer
(1)   1017C :                    ;;; @param RL0 queue work space size
(1)   1017C :                    ;;; @clobber RL0
(1)   1017C :                    queue_init:
(1)   1017C : 4C18 0200                  clrb    DATA+queue_len(r1)
(1)   10180 : 0208 0404                  subb    rl0, #queue_buf
(1)   10184 : 6E18 0201                  ldb     DATA+queue_size(r1), rl0
(1)   10188 : 4C18 0202                  clrb    DATA+queue_put(r1)
(1)   1018C : 4C18 0203                  clrb    DATA+queue_get(r1)
(1)   10190 : 9E08                       ret
(1)   10192 :
(1)   10192 :                    ;;; [queue] Add an element to queue
