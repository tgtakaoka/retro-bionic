# Scenario for scripts/record-scenario.py: CP/M-8000 1.1 on the Z8001:
# the system uploaded and its disks mounted from the SD card with O,
# then STAT, DIR of B:, and DRI's C compiling, linking and running
# B:IMANDEL.C, then B:FMANDEL.C, whose floating point Zilog's Z8070
# emulator runs. A program zeroes its heap at start-up, so each runs a
# few seconds at the debugger's clock.
#
# Needs a fresh samples/z8001/cpm8001.hex (make cpm8000) and the SD
# card's z8001/cpm8001a.dsk and cpm8001b.dsk (make cpm8000-sd).

key ?
pace 2.0

key R
upload samples/z8001/cpm8001.hex

type O
wait Disk?
command A z8001/cpm8001a.dsk
type O
wait Disk?
command B z8001/cpm8001b.dsk
type O
wait Disk?
command
pace 2.0

key R
type G
wait backtrace?
type 5\r
waitfor 20 A>
type \r
wait A>
pace 1.5

type STAT\r
waitfor 30 A>
type \r
wait A>
pace 1.5
type STAT A:DSK:\r
waitfor 30 A>
type \r
wait A>
pace 1.5
type DIR B:\r
waitfor 20 A>
type \r
wait A>
pace 1.5
type ZCC -C -M1 B:IMANDEL.C\r
waitfor 600 A>
type \r
wait A>
pace 1.5
type LD8K -W -I -O B:IMANDEL.Z8K STARTUP.O B:IMANDEL.O -LCPM\r
waitfor 600 A>
type \r
wait A>
pace 1.5
type B:IMANDEL\r
waitfor 300 A>
type \r
wait A>
pace 1.5
type ZCC -C -M1 B:FMANDEL.C\r
waitfor 600 A>
type \r
wait A>
pace 1.5
type LD8K -W -I -O B:FMANDEL.Z8K STARTUP.O B:FMANDEL.O -LCPM\r
waitfor 600 A>
type \r
wait A>
pace 1.5
type B:FMANDEL\r
waitfor 900 A>
type \r
wait A>
pace 2.0

halt
