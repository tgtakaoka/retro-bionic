# Scenario for scripts/record-scenario.py: CP/M-8000 1.1 on the Z8001:
# the system loaded from the SD card with its disks, then STAT, PIP to
# B:, TYPE, and DRI's C compiling, linking and running B:IMANDEL.C. A
# program zeroes its heap at start-up, so each runs a few seconds at the
# debugger's clock.
#
# Needs the SD card's z8001/cpm8001.hex, cpm8001a.dsk and cpm8001b.dsk
# (make cpm8000-sd, docs/samples.md).

key ?
pace 2.0

type L
wait Load?
command z8001/cpm8001.hex
key R
type G
wait backtrace?
type 5\r
waitfor 20 A>
type \r
wait A>
pace 1.5

type STAT\r
waitfor 30 A>
type \r
wait A>
pace 1.5
type STAT A:DSK:\r
waitfor 30 A>
type \r
wait A>
pace 1.5
type PIP B:=A:ERRNO.H\r
waitfor 60 A>
type \r
wait A>
pace 1.5
type DIR B:\r
waitfor 20 A>
type \r
wait A>
pace 1.5
type TYPE B:ERRNO.H\r
waitfor 40 A>
type \r
wait A>
pace 1.5
type ZCC -C -M1 B:IMANDEL.C\r
waitfor 600 A>
type \r
wait A>
pace 1.5
type LD8K -W -I -O B:IMANDEL.Z8K STARTUP.O B:IMANDEL.O -LCPM\r
waitfor 600 A>
type \r
wait A>
pace 1.5
type B:IMANDEL\r
waitfor 300 A>
type \r
wait A>
pace 2.0

halt
