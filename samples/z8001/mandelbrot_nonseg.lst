(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; i8251 Universal Synchronous/Asynchronous Receiver/Transmitter
(1)       0 : =140               USART:  equ     140H
(1)       0 : =140               USARTD: equ     USART+0         ; Data register
(1)       0 : =141               USARTS: equ     USART+1         ; Status register
(1)       0 : =141               USARTC: equ     USART+1         ; Control register
(1)       0 : =142               USARTRV:        equ     USART+2 ; Receive interrupt identifier
(1)       0 : =143               USARTTV:        equ     USART+3 ; Transmit interrupt identifier
(1)       0 :                    ;;; The identifiers the USART answers its vectored interrupts with: even,
(1)       0 :                    ;;; as the Z8001 requires.
