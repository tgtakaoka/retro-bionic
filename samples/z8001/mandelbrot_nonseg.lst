(1)     23C :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     23C :                    ;;; Console through the USART's interrupts: received characters queue
(1)     23C :                    ;;; at rx_queue, characters to send at tx_queue. The USART interrupts on
(1)     23C :                    ;;; VI with identifier RX_ID or TX_ID, which usart.inc defines. The queues
(1)     23C :                    ;;; are offsets in the data area DATA.
