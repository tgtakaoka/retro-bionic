(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; Z8001. A sample says `cpu z8001` for segmented code, its addresses
(1)       0 :                    ;;; seg<<16|off written <<seg>>off, or `cpu z8002` for code that runs
(1)       0 :                    ;;; nonsegmented, its addresses offsets in the PC's segment.
(1)       0 :
(1)       0 :                    ;;; Reset reads the FCW at 0002H, then the PC's segment at 0004H and its
(1)       0 :                    ;;; offset at 0006H, the reset entry of a Program Status Area at 0000H in
(1)       0 :                    ;;; segment 0.
(1)       0 : =0                 ORG_RESET:      equ     0000H
(1)       0 :                    ;;; Program Status Area offsets: a reserved word, an FCW, then a PC's
(1)       0 :                    ;;; segment and offset.
(1)       0 : =8                 PSA_EPA:        equ     08H     ; extended instruction trap
(1)       0 : =10                PSA_PRIV:       equ     10H     ; privileged instruction trap
(1)       0 : =18                PSA_SC:         equ     18H     ; system call
(1)       0 : =20                PSA_SEGT:       equ     20H     ; segment trap
(1)       0 : =28                PSA_NMI:        equ     28H     ; non-maskable interrupt
(1)       0 : =30                PSA_NVI:        equ     30H     ; non-vectored interrupt
(1)       0 : =38                PSA_VI:         equ     38H     ; vectored interrupt: the FCW, then a PC
(1)       0 :                                                    ; for each even identifier from 3CH, the
(1)       0 :                                                    ; one for identifier n at PSA_VI+4+2*n
(1)       0 :                    ;;; Flag and Control Word
(1)       0 : =8000              FCW_SEG:        equ     8000H   ; segmented mode
(1)       0 : =4000              FCW_SN:         equ     4000H   ; system mode
(1)       0 : =2000              FCW_EPA:        equ     2000H   ; extended processor architecture
(1)       0 : =1000              FCW_VIE:        equ     1000H   ; vectored interrupt enable
(1)       0 : =800               FCW_NVIE:       equ     0800H   ; non-vectored interrupt enable
(1)       0 :
(1)       0 :                    ;;; Where the segmented samples live, each in a segment of its own.
(1)       0 : =10000             CODE:           equ     010000H ; code, segment 1
(1)       0 : =100               CODE_SEG:       equ     0100H   ; its segment word: the number in bits 14-8
(1)       0 : =20000             DATA:           equ     020000H ; queues and variables, segment 2
(1)       0 : =3001000           STACK:          equ     03001000H ; RR14: segment 3, offset 1000H
(1)       0 :                    ;;; The normal mode stack, NSPSEG and NSPOFF: segment 4, offset 1000H.
(1)       0 : =400               USTACK_SEG:     equ     0400H
(1)       0 : =1000              USTACK_OFF:     equ     1000H
(1)       0 :
(1)       0 :                    ;;; SC #SC_EXIT hands control back to the debugger.
(1)       0 : =FE                SC_EXIT:        equ     0FEH
