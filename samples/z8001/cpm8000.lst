          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                    ;;; CP/M-8000 1.1 on the Z8001: where everything sits, shared by
          0 :                    ;;; cpm8000bios.asm and the Makefile's link. DRI released 1.1 for the
          0 :                    ;;; Olivetti M20, a Z8001, and this follows its memory: the system in
          0 :                    ;;; one segment, running nonsegmented, and each program in a segment of
          0 :                    ;;; its own.
          0 :                            include "z8001.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; Z8001. A sample says `cpu z8001` for segmented code, its addresses
(1)       0 :                    ;;; seg<<16|off written <<seg>>off, or `cpu z8002` for code that runs
(1)       0 :                    ;;; nonsegmented, its addresses offsets in the PC's segment.
(1)       0 :
(1)       0 :                    ;;; Reset reads the FCW at 0002H, then the PC's segment at 0004H and its
(1)       0 :                    ;;; offset at 0006H, the reset entry of a Program Status Area at 0000H in
(1)       0 :                    ;;; segment 0.
(1)       0 : =0                 ORG_RESET:      equ     0000H
(1)       0 :                    ;;; Program Status Area offsets: a reserved word, an FCW, then a PC's
(1)       0 :                    ;;; segment and offset.
(1)       0 : =8                 PSA_EPA:        equ     08H     ; extended instruction trap
(1)       0 : =10                PSA_PRIV:       equ     10H     ; privileged instruction trap
(1)       0 : =18                PSA_SC:         equ     18H     ; system call
(1)       0 : =20                PSA_SEGT:       equ     20H     ; segment trap
(1)       0 : =28                PSA_NMI:        equ     28H     ; non-maskable interrupt
(1)       0 : =30                PSA_NVI:        equ     30H     ; non-vectored interrupt
(1)       0 : =38                PSA_VI:         equ     38H     ; vectored interrupt: the FCW, then a PC
(1)       0 :                                                    ; for each even identifier from 3CH, the
(1)       0 :                                                    ; one for identifier n at PSA_VI+4+2*n
(1)       0 :                    ;;; Flag and Control Word
(1)       0 : =8000              FCW_SEG:        equ     8000H   ; segmented mode
(1)       0 : =4000              FCW_SN:         equ     4000H   ; system mode
(1)       0 : =2000              FCW_EPA:        equ     2000H   ; extended processor architecture
(1)       0 : =1000              FCW_VIE:        equ     1000H   ; vectored interrupt enable
(1)       0 : =800               FCW_NVIE:       equ     0800H   ; non-vectored interrupt enable
(1)       0 :
(1)       0 :                    ;;; Where the segmented samples live, each in a segment of its own.
(1)       0 : =10000             CODE:           equ     010000H ; code, segment 1
(1)       0 : =100               CODE_SEG:       equ     0100H   ; its segment word: the number in bits 14-8
(1)       0 : =20000             SEGDATA:        equ     020000H ; their DATA: queues and variables, segment 2
(1)       0 : =3001000           STACK:          equ     03001000H ; RR14: segment 3, offset 1000H
(1)       0 :                    ;;; The normal mode stack, NSPSEG and NSPOFF: segment 4, offset 1000H.
(1)       0 : =400               USTACK_SEG:     equ     0400H
(1)       0 : =1000              USTACK_OFF:     equ     1000H
(1)       0 :
(1)       0 :                    ;;; SC #SC_EXIT hands control back to the debugger, as a breakpoint does.
(1)       0 : =FF                SC_EXIT:        equ     0FFH
          0 :
          0 :                    ;;; The system segment, 0: the Program Status Area at 0000H, whose first
          0 :                    ;;; entry is the reset's, the BIOS, then the kernel, CCP and BDOS as DRI
          0 :                    ;;; linked them with its commons linked after it at SYSTEM by
          0 :                    ;;; xout-link.py, and the system stack at the top.
          0 : =0                 PSA:            equ     0000H
          0 :                    ;;; Through the vectored interrupts' table, identifiers 0 to 30.
          0 : =80                PSA_SIZE:       equ     80H
          0 : =100               BIOS_ORG:       equ     0100H
          0 : =2000              SYSTEM:         equ     2000H
          0 : =FFFE              SYSSTK:         equ     0FFFEH
          0 :
          0 :                    ;;; Where programs run, each segment's number in bits 14-8 of a long
          0 :                    ;;; address's high word, as the memory region table hands them out: a
          0 :                    ;;; merged program in 0AH; a split one's code and data both at 8, whose
          0 :                    ;;; instruction space the debugger keeps in 0BH, the segment the loader
          0 :                    ;;; writes the code through; DDT in 9.
          0 : =A00               SEG_MERGED:     equ     0A00H
          0 : =800               SEG_SPLIT:      equ     0800H
          0 : =B00               SEG_ISPACE:     equ     0B00H
          0 : =900               SEG_DDT:        equ     0900H
          0 :
          0 :                    ;;; System call numbers: SC #n.
          0 : =1                 MEM_SC:         equ     1       ; memory management and context switch
          0 : =2                 BDOS_SC:        equ     2
          0 : =3                 BIOS_SC:        equ     3
          0 :                    ;;; The exception vector the BIOS keeps: 48 longs, traps 0-31 and system
          0 :                    ;;; calls 0-15 as 32-47, numbered as CP/M-68K's.
          0 : =30                NTRAPS:         equ     48
          0 : =20                SC0TRAP:        equ     32
          0 : =1                 EPUTRAP:        equ     1
          0 : =2                 SEGTRAP:        equ     2
          0 : =8                 PITRAP:         equ     8
          0 : =0                 NMITRAP:        equ     0
          0 :
          0 :                    ;;; The trap frame the dispatcher builds on the system stack, the M20's,
          0 :                    ;;; which DRI's kernel reads: R0-R13, the normal R14 and R15, then what
          0 :                    ;;; the CPU pushed, the SC identifier, FCW and PC's segment and offset.
          0 :                    ;;; A handler is called segmented, with CO bytes of return address on
          0 :                    ;;; top, and sees each CO higher. A program's startup context, which
          0 :                    ;;; xfer copies over the frame, has the same layout.
          0 : =0                 FR_R0:          equ     0
          0 : =C                 FR_R6:          equ     12
          0 : =E                 FR_R7:          equ     14
          0 : =1C                FR_NR14:        equ     28
          0 : =1E                FR_NR15:        equ     30
          0 : =20                FR_ID:          equ     32
          0 : =22                FR_FCW:         equ     34
          0 : =24                FR_PCSEG:       equ     36
          0 : =26                FR_PC:          equ     38
          0 : =28                FRAME:          equ     40
          0 : =4                 CO:             equ     4
          0 :
          0 :                    ;;; The SPLIT device's control port: on, a normal-mode program fetch in
          0 :                    ;;; segment 8 reads segment 0BH, the M20's instruction space.
          0 : =160               SPLIT_CTRL:     equ     160H
          0 : =1                 SPLIT_ON:       equ     1
