(1)    12A1 :                    ;;; Print unsigned 16-bit integer as decimal
(1)    12A1 :                    ;;; @param R0 value
(1)    12A1 :                    ;;; @clobber A X Y R0 R1 R2
(1)    12A1 :                    print_uint16:
(1)    12A1 : A5 11                      lda     R0H
(1)    12A3 : 05 10                      ora     R0L
(1)    12A5 : F0 1C                      beq     print_uint16_digit ; branch if value==0
