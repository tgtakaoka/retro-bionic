# Scenario for scripts/record-scenario.py: CP/M 2.2 from the SD card,
# Microsoft's MBASIC 5.21 drawing fmandel from B:, and back to CP/M.
#
# Needs the SD card's i8080/cpm22.hex and cpm22.dsk, and a cpm22b.dsk
# with MBASIC.COM and FMANDEL.BAS (make cpm22b.dsk; docs/samples.md).

key ?
pace 2.0

# Load the cold boot; the disks beside it mount as A:-D:.
type L
wait Load?
command i8080/cpm22.hex
type I
wait which?
type \r
wait >
pace 1.5

# A short backtrace for the halt at the end.
key R
type G
wait backtrace?
type 5\r
wait A>
pace 1.5

type B:\r
wait B>
type DIR\r
wait B>
pace 1.5

# A frame takes minutes in MBASIC's floating point.
type MBASIC FMANDEL\r
waitfor 1800 Ok
pace 2.0

type SYSTEM\r
wait B>
pace 2.0

halt
