[4.75756, "o", "\r\r\n* Bionic"]
[4.761346, "o", "P8080 * 1.0\r\r\nPC=03BD SP=0FF6 BC=0000 DE=0640 HL=0006 A=06 PSW=__0H0P1_ IE=1\r\r\n03BD: 3D        DCR   A\r\r\n\r\r\n  R              : reset the target P8080\r\r\n  U              : upload Intel HEX / S-record (^C to end)\r\r\n  G [n]          : run freely, backtrace last n lines (default: all)\r\r\n  g addr [n]     : run until addr (a one-shot breakpoint), same backtrace\r\r\n  B addr         : set a breakpoint\r\r\n  b [index]      : list breakpoints, clear one\r\r\n  S              : step one instruction\r\r\n\r\r\n  r              : print registers\r\r\n  = reg value    : set a register (unknown name lists valid names)\r\r\n  d addr [len]   : dump data memory (len defaults to 16)\r\r\n  p addr [len]   : dump program memory (len defaults to 16)\r\r\n  D addr [n]     : disassemble n instructions (default 20)\r\r\n  m addr byte... : write & dump data memory, 16 bytes max\r\r\n  M addr byte... : write & dump program memory, 16 bytes max\r\r\n\r\r\n  I dev [addr]   : select an I/O device, optionally its base\r\r\n  P [from to]    : show, or set, protect area\r\r\n  W +identity    : write identity EEPROM\r\r\n  V              : toggle verbose bus-cycle printing\r\r\n  ?              : this help\r\r\n\r\r\n  HALT button    : stop a free running P8080\r\r\n                   held at power up skips the identity EEPROM check, to recover\r\r\n                   from a bad identity EEPROM\r\r\n  2nd USB serial : send any byte to stop a free running P8080\r\r\n> "]
[8.008388, "o", "Reset\r\r\nPC=0000 SP=0FEC BC=0000 DE=0640 HL=0006 A=06 PSW=__0H0P1_ IE=0\r\r\n0000: C3 00 01  JMP   0100H\r\r\n> "]
