          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                    ;;; CP/M 2.2 cold boot on 8-bit ports: L i8080/cpm22.hex loads this and
          0 :                    ;;; mounts cpm22.dsk as A: (and cpm22b.dsk etc. as B:-D:). It reads CCP,
          0 :                    ;;; BDOS and the BIOS from the system tracks and enters the BIOS's cold
          0 :                    ;;; boot. For the 8080, 8085, Z80, NSC800 and KL5C80.
          0 :                            include "i8080.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; i8080
(1)       0 :                            cpu     8080
(1)       0 :                    ;;; FLAGS Register
(1)       0 : =80                F_SIGN:         equ     10000000B ; set to 1 if negative
(1)       0 : =40                F_ZERO:         equ     01000000B ; set to 1 if zero
(1)       0 : =10                F_HALF_CARRY:   equ     00010000B ; set to 1 if carry from bit-3
(1)       0 : =4                 F_PARITY:       equ     00000100B ; set to 1 if even parity
(1)       0 : =1                 F_CARRY:        equ     00000001B ; set to 1 if carry
(1)       0 :                    ;;; Interrupt origin
(1)       0 : =0                 ORG_RESET:      equ     0000H   ; RESET
(1)       0 : =0                 ORG_RST0:       equ     0000H   ; RST 0
(1)       0 : =8                 ORG_RST1:       equ     0008H   ; RST 1
(1)       0 : =10                ORG_RST2:       equ     0010H   ; RST 2
(1)       0 : =18                ORG_RST3:       equ     0018H   ; RST 3
(1)       0 : =20                ORG_RST4:       equ     0020H   ; RST 4
(1)       0 : =28                ORG_RST5:       equ     0028H   ; RST 5
(1)       0 : =30                ORG_RST6:       equ     0030H   ; RST 6
(1)       0 : =38                ORG_RST7:       equ     0038H   ; RST 7
(1)       0 :                    ;;; RST instructions, which the 8251 hands the CPU in an INTA cycle
(1)       0 : =C7                INST_RST0:      equ     0C7H    ; RST 0
(1)       0 : =CF                INST_RST1:      equ     0CFH    ; RST 1
(1)       0 : =D7                INST_RST2:      equ     0D7H    ; RST 2
(1)       0 : =DF                INST_RST3:      equ     0DFH    ; RST 3
(1)       0 : =E7                INST_RST4:      equ     0E7H    ; RST 4
(1)       0 : =EF                INST_RST5:      equ     0EFH    ; RST 5
(1)       0 : =F7                INST_RST6:      equ     0F7H    ; RST 6
(1)       0 : =FF                INST_RST7:      equ     0FFH    ; RST 7
          0 :                            include "cpm22.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :
(1)       0 :                    ;;; CP/M 2.2 in 64K on 8" single-sided single-density disks: 77 tracks of
(1)       0 :                    ;;; 26 sectors of 128 bytes. The system tracks 0 and 1 hold the boot
(1)       0 :                    ;;; sector, then CCP and BDOS, then the BIOS.
(1)       0 : =40                MSIZE:  equ     64
(1)       0 : =E400              CCP:    equ     (MSIZE-7)*1024  ; E400
(1)       0 : =EC00              BDOS:   equ     CCP+0800H       ; EC00
(1)       0 : =FA00              BIOS:   equ     CCP+1600H       ; FA00
(1)       0 : =3                 IOBYTE: equ     0003H
(1)       0 : =4                 TDRIVE: equ     0004H           ; current drive and user
(1)       0 : =1A                SPT:    equ     26              ; sectors a track
(1)       0 : =2C                CCP_SECTORS:    equ     (BIOS-CCP)/128          ; 44
(1)       0 : =7                 BIOS_SECTORS:   equ     2*SPT-1-CCP_SECTORS     ; 7, to the end of track 1
(1)       0 : =4                 NDISKS: equ     4
(1)       0 :
(1)       0 :                    ;;; The BIOS's scratch areas, past it on the system tracks.
(1)    FD80 :                            org     BIOS+BIOS_SECTORS*128
(1)    FD80 :                    dirbuf: ds      128
(1)    FE00 :                    csv:    ds      16*NDISKS
(1)    FE40 :                    alv:    ds      31*NDISKS
       FEBC :
          0 :                            org     ORG_RESET
          0 : 31 00 01                   lxi     sp, 0100H
          3 : 21 00 E4                   lxi     h, CCP
          6 : 0E 33                      mvi     c, CCP_SECTORS+BIOS_SECTORS
          8 : CD 0F 00                   call    load_system
          B : CA 00 FA                   jz      BIOS                    ; cold boot
          E : 76                         hlt
          F :                            include "cpm22load.inc"
(1)       F :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       F :                    ;;; Reads C sectors of drive A's system tracks into HL, from track 0
(1)       F :                    ;;; sector 2, past the boot sector. Z when all were read, NZ on an error.
(1)       F :                    ;;; 8080 instructions only.
(1)       F :                    load_system:
(1)       F : AF                         xra     a
(1)      10 : CD 51 00                   call    disk_drive
(1)      13 : CD 54 00                   call    disk_track
(1)      16 : 06 02                      mvi     b, 2
(1)      18 :                    load_sector:
(1)      18 : 78                         mov     a, b
(1)      19 : CD 57 00                   call    disk_sector
(1)      1C : 7D                         mov     a, l
(1)      1D : CD 5A 00                   call    disk_dmal
(1)      20 : 7C                         mov     a, h
(1)      21 : CD 5D 00                   call    disk_dmah
(1)      24 : 3E 01                      mvi     a, CMD_READ
(1)      26 : CD 60 00                   call    disk_command
(1)      29 : CD 63 00                   call    disk_status
(1)      2C : B7                         ora     a
(1)      2D : C0                         rnz
(1)      2E : 11 80 00                   lxi     d, 128
(1)      31 : 19                         dad     d
(1)      32 : 04                         inr     b
(1)      33 : 78                         mov     a, b
(1)      34 : FE 1B                      cpi     SPT+1
(1)      36 : DA 40 00                   jc      load_count
(1)      39 : 06 01                      mvi     b, 1                    ; on to track 1
(1)      3B : 3E 01                      mvi     a, 1
(1)      3D : CD 54 00                   call    disk_track
(1)      40 :                    load_count:
(1)      40 : 0D                         dcr     c
(1)      41 : C2 18 00                   jnz     load_sector
(1)      44 : C9                         ret
         45 :                            include "cpm22io.inc"
(1)      45 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)      45 :                    ;;; CP/M's port routines on 8-bit I/O addresses: the i8251 at 40H and the
(1)      45 :                    ;;; sector disk at 50H. Each keeps every register but A and the flags.
(1)      45 :                    ;;; 8080, 8085, Z80, NSC800 and KL5C80.
(1)      45 : =40                USART:  equ     40H
(1)      45 : =40                USARTD: equ     USART+0         ; Data register
(1)      45 : =41                USARTS: equ     USART+1         ; Status register
(1)      45 : =41                USARTC: equ     USART+1         ; Control register
(1)      45 :                            include "i8251.inc"
(2)      45 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)      45 :
(2)      45 :                    ;;; i8251 USART device emulator.
(2)      45 :                    ;;; Bit definition of mode instruction (asynchronous)
(2)      45 : =6                 MODE_STOP_gp:   equ     6
(2)      45 : =C0                MODE_STOP_gm:   equ     11000000B
(2)      45 : =40                MODE_STOP1_gc:  equ     (1 << MODE_STOP_gp)
(2)      45 : =80                MODE_STOP15_gc: equ     (2 << MODE_STOP_gp)
(2)      45 : =C0                MODE_STOP2_gc:  equ     (3 << MODE_STOP_gp)
(2)      45 : =20                MODE_EVEN_bm:   equ     00100000B   ; Even parity
(2)      45 : =10                MODE_PARITY_bm: equ     00010000B   ; Parity enable
(2)      45 : =2                 MODE_LEN_gp:    equ     2
(2)      45 : =C                 MODE_LEN_gm:    equ     00001100B
(2)      45 : =0                 MODE_LEN5_gc:   equ     (0 << MODE_LEN_gp)
(2)      45 : =4                 MODE_LEN6_gc:   equ     (1 << MODE_LEN_gp)
(2)      45 : =8                 MODE_LEN7_gc:   equ     (2 << MODE_LEN_gp)
(2)      45 : =C                 MODE_LEN8_gc:   equ     (3 << MODE_LEN_gp)
(2)      45 : =0                 MODE_BAUD_gp:   equ     0
(2)      45 : =3                 MODE_BAUD_gm:   equ     00000011B
(2)      45 : =1                 MODE_BAUD_X1:   equ     (1 << MODE_BAUD_gp)
(2)      45 : =2                 MODE_BAUD_X16:  equ (2 << MODE_BAUD_gp)
(2)      45 : =3                 MODE_BAUD_X64:  equ (3 << MODE_BAUD_gp)
(2)      45 :                    ;;; Bit Definition of command register
(2)      45 : =80                CMD_EH_bm:      equ     10000000B   ; Enter hunt mode
(2)      45 : =40                CMD_IR_bm:      equ     01000000B   ; Internal Reset
(2)      45 : =20                CMD_RTS_bm:     equ     00100000B   ; Request To Send
(2)      45 : =10                CMD_ER_bm:      equ     00010000B   ; Error Reset
(2)      45 : =8                 CMD_SBRK_bm:    equ     00001000B   ; Send Break
(2)      45 : =4                 CMD_RxEN_bm:    equ     00000100B   ; Receive Enable
(2)      45 : =2                 CMD_DTR_bm:     equ     00000010B   ; Data Terminal Ready
(2)      45 : =1                 CMD_TxEN_bm:    equ     00000001B   ; Transmit enable
(2)      45 :
(2)      45 :                    ;;; Bit definition of status register
(2)      45 : =80                ST_DSR_bm:      equ     10000000B   ; Data Set Ready
(2)      45 : =40                ST_BRK_bm:      equ     01000000B   ; BREAK detected
(2)      45 : =20                ST_FE_bm:       equ     00100000B   ; Framing Error
(2)      45 : =10                ST_OE_bm:       equ     00010000B   ; Overrun Error
(2)      45 : =8                 ST_PE_bm:       equ     00001000B   ; Parity Error
(2)      45 : =4                 ST_TxEMPTY_bm:  equ     00000100B   ; Transmitter empty
(2)      45 : =2                 ST_RxRDY_bm:    equ     00000010B   ; Receiver ready
(2)      45 : =1                 ST_TxRDY_bm:    equ     00000001B   ; Transmitter ready
(1)      45 :                    ;;; Async 1stop 8data x16
(1)      45 : =4E                ASYNC_MODE:     equ     MODE_STOP1_gc|MODE_LEN8_gc|MODE_BAUD_X16
(1)      45 :                    ;;; RTS/DTR, error reset, Rx enable, Tx enable
(1)      45 : =37                RX_EN_TX_EN:    equ     CMD_RTS_bm|CMD_DTR_bm|CMD_ER_bm|CMD_RxEN_bm|CMD_TxEN_bm
(1)      45 :
(1)      45 : =50                DISK:   equ     50H
(1)      45 :                            include "sector_disk.inc"
(2)      45 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)      45 :
(2)      45 :                    ;;; The debugger's paravirtual sector disk (debugger/sector_disk.h).
(2)      45 :                    ;;; DISK is its base port.
(2)      45 : =50                DISK_DRIVE:     equ     DISK+0  ; 0-3
(2)      45 : =51                DISK_TRACK:     equ     DISK+1  ; 0-76
(2)      45 : =52                DISK_SECTOR:    equ     DISK+2  ; 1-26, physical
(2)      45 : =53                DISK_DMAL:      equ     DISK+3  ; DMA address, low byte
(2)      45 : =54                DISK_DMAH:      equ     DISK+4  ; high byte
(2)      45 : =55                DISK_COMMAND:   equ     DISK+5  ; write a command, read its status
(2)      45 : =56                DISK_MOUNTED:   equ     DISK+6  ; bit n: drive n has its image
(2)      45 : =1                 CMD_READ:       equ     1
(2)      45 : =2                 CMD_WRITE:      equ     2
(1)      45 :
(1)      45 :                            cpu     8080
(1)      45 :                    con_status:
(1)      45 : DB 41                      in      USARTS
(1)      47 : C9                         ret
(1)      48 :                    con_in:
(1)      48 : DB 40                      in      USARTD
(1)      4A : C9                         ret
(1)      4B :                    con_out:
(1)      4B : D3 40                      out     USARTD
(1)      4D : C9                         ret
(1)      4E :                    con_control:
(1)      4E : D3 41                      out     USARTC
(1)      50 : C9                         ret
(1)      51 :                    disk_drive:
(1)      51 : D3 50                      out     DISK_DRIVE
(1)      53 : C9                         ret
(1)      54 :                    disk_track:
(1)      54 : D3 51                      out     DISK_TRACK
(1)      56 : C9                         ret
(1)      57 :                    disk_sector:
(1)      57 : D3 52                      out     DISK_SECTOR
(1)      59 : C9                         ret
(1)      5A :                    disk_dmal:
(1)      5A : D3 53                      out     DISK_DMAL
(1)      5C : C9                         ret
(1)      5D :                    disk_dmah:
(1)      5D : D3 54                      out     DISK_DMAH
(1)      5F : C9                         ret
(1)      60 :                    disk_command:
(1)      60 : D3 55                      out     DISK_COMMAND
(1)      62 : C9                         ret
(1)      63 :                    disk_status:
(1)      63 : DB 55                      in      DISK_COMMAND
(1)      65 : C9                         ret
(1)      66 :                    disk_mounted:
(1)      66 : DB 56                      in      DISK_MOUNTED
(1)      68 : C9                         ret
