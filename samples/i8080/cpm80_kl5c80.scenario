# Scenario for scripts/record-scenario.py: CP/M 2.2 on the KL5C80,
# booted from an upload. HI-TECH C's ZAS and LINQ build mandel.asm,
# then BDS C builds imandel.c, and each draws the mandelbrot.
#
# U loads the cold boot but, unlike L, mounts nothing, so the disks are
# mounted from the SD card's i8080/ with O. Each CP/M command is preceded
# by an Enter: the first key after a prompt can be lost.
#
# Starts with no disk mounted (L mounts all four, and mounts outlive R
# and U) and clean disks: no MANDEL.OBJ or .COM, and no IMANDEL.CRL or
# .COM, on A: or B:.

key ?
pace 2.0

key R
upload samples/i8080/cpm80.hex

# A: the system disk with the CP/M tools, BDS C and HI-TECH C; B: the
# user disk with the sources. An empty line lists the drives.
type O
wait Disk?
command A i8080/cpm80.dsk
type O
wait Disk?
command B i8080/cpm80b.dsk
type O
wait Disk?
command
pace 2.0

# Boot: the cold boot reads the system from A:'s system tracks.
type G 5\r
waitfor 30 A>
pace 1.5
type \r
waitfor 5 A>
type DIR A:\r
waitfor 10 A>
pace 2.0
type \r
waitfor 5 A>
type DIR B:\r
waitfor 10 A>
pace 2.0

# ZAS assembles B:MANDEL.ASM to B:MANDEL.OBJ; LINQ links it into
# A:MANDEL.COM.
type \r
waitfor 5 A>
type ZAS -OB:MANDEL.OBJ B:MANDEL.ASM\r
waitfor 300 A>
pace 1.5
type \r
waitfor 5 A>
type LINQ -C100H -OMANDEL.COM B:MANDEL.OBJ\r
waitfor 300 A>
pace 1.5
type \r
waitfor 5 A>
type MANDEL\r
waitfor 600 A>
pace 3.0

# BDS C: CC compiles B:IMANDEL.C to B:IMANDEL.CRL; CLINK links it with
# the library on A: into B:IMANDEL.COM.
type \r
waitfor 5 A>
type CC B:IMANDEL\r
waitfor 300 A>
pace 1.5
type \r
waitfor 5 A>
type CLINK B:IMANDEL\r
waitfor 300 A>
pace 1.5
type \r
waitfor 5 A>
type B:IMANDEL\r
waitfor 600 A>
pace 3.0

halt
