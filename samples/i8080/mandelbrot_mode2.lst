(1)     463 :                    ;;; Mode 2 RxRDY and TxRDY interrupt of the i8251, sharing one vector:
(1)     463 :                    ;;; queue the received character, then send the next queued one, or
(1)     463 :                    ;;; disable Tx when the queue is empty. IN/OUT (C) put B on A8-A15, so
(1)     463 :                    ;;; boards decoding 16-bit I/O addresses find the USART at 0140H.
