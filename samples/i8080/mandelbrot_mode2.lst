(1)       0 : =28                ORG_RST5:       equ     0028H   ; RST 5
(1)       0 : =30                ORG_RST6:       equ     0030H   ; RST 6
(1)       0 : =38                ORG_RST7:       equ     0038H   ; RST 7
(1)       0 :                    ;;; RST instructions, which the 8251 hands the CPU in an INTA cycle
(1)       0 : =C7                INST_RST0:      equ     0C7H    ; RST 0
(1)       0 : =CF                INST_RST1:      equ     0CFH    ; RST 1
(1)       0 : =D7                INST_RST2:      equ     0D7H    ; RST 2
(1)       0 : =DF                INST_RST3:      equ     0DFH    ; RST 3
