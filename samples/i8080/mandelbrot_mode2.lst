        148 :                    ;;; Get character
        148 :                    ;;; @return A
        148 :                    ;;; @return F.C 0 if no character
        148 :                    getchar:
        148 : E5                         push    h
        149 : 21 00 20                   lxi     h, rx_queue
        14C : F3                         di
        14D : CD 3F 04                   call    queue_remove
        150 : FB                         ei
        151 : E1                         pop     h
        152 : C9                         ret
        153 :
        153 :                    ;;; Put character
        153 :                    ;;; @param A
        153 :                    putchar:
        153 : F5                         push    psw
        154 : E5                         push    h
        155 : 21 80 20                   lxi     h, tx_queue
        158 :                    putchar_retry:
        158 : F3                         di
        159 : CD 17 04                   call    queue_add
        15C : FB                         ei
        15D : D2 58 01                   jnc     putchar_retry   ; branch if queue is full
        160 : E1                         pop     h
        161 : 3E 37                      mvi     a, RX_EN_TX_EN  ; enable Tx
        163 : D3 41                      out     USARTC
        165 :                    putchar_exit:
        165 : F1                         pop     psw
        166 : C9                         ret
        167 :
        167 :                    ;;; Put newline
        167 :                    ;;; @clobber A
        167 :                    newline:
        167 : 3E 0D                      mvi     A, 0DH
        169 : CD 53 01                   call    putchar
        16C : 3E 0A                      mvi     A, 0AH
        16E : C3 53 01                   jmp     putchar
        171 :
        171 :                    ;;; Put space
        171 :                    ;;; @clobber A
        171 :                    putspace:
        171 : 3E 20                      mvi     A, ' '
        173 : C3 53 01                   jmp     putchar
