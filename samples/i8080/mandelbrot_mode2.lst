(1)       0 : =41                USARTS: equ     USART+1         ; Status register
(1)       0 : =41                USARTC: equ     USART+1         ; Control register
(1)       0 : =42                USARTRV:        equ     USART+2 ; Receive interrupt vector (ORG_*)
(1)       0 : =43                USARTTV:        equ     USART+3 ; Transmit interrupt vector (ORG_*)
