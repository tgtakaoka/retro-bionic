(1)     130 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     130 :                    ;;; Take interrupts in mode 2 through |vector|, the KL5C80A12's IR0
(1)     130 :                    ;;; included. OUT (n),A puts A on A8-A15, so a Z180 doesn't take the
(1)     130 :                    ;;; interrupt controller's ports for its on-chip I/O.
(1)     130 :                            cpu     z80
(1)     130 : 3E 00                      ld      A, HIGH vector
(1)     132 : ED 47                      ld      I, A
(1)     134 : 3E 80                      ld      A, LOW vector
(1)     136 : D3 37                      out     (IVR), A        ; vector register
(1)     138 : 3E FE                      ld      A, ~1           ; disable mask for IR0
(1)     13A : D3 36                      out     (IMRL), A
(1)     13C : ED 5E                      im      2
