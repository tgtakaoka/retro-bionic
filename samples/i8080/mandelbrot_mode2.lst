        113 : AF                         xra     a               ; clear A
        114 : D3 41                      out     USARTC
        116 : D3 41                      out     USARTC
        118 : D3 41                      out     USARTC          ; safest way to sync mode
        11A : 3E 40                      mvi     a, CMD_IR_bm
