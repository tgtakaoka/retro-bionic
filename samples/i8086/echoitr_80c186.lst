(1)    1170 : =20                I0CON_CAS:      equ     0020H   ; cascade mode
(1)    1170 : =10                I0CON_LVL:      equ     0010H   ; level triggered, as cascade mode wants
(1)    1170 :                                                    ; MSK clear, priority 0
(1)    1170 :
