(1)    1170 :                    ;;; 80C186XL Interrupt Control Unit, in the Peripheral Control Block at
(1)    1170 :                    ;;; I/O FF00H: INT0 in cascade mode runs two INTA cycles and reads the
(1)    1170 :                    ;;; interrupt type from the bus, as the 8086's INTR does, so the USART
(1)    1170 :                    ;;; picks VEC_RX or VEC_TX. Each handler must end with an End Of
(1)    1170 :                    ;;; Interrupt: wrap a shared handler as
(1)    1170 :                    ;;;     isr_x_eoi: pushf / callf 0:isr_x / jmp isr_eoi
