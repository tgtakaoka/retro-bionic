(1)    1011 :                    ;;; Console through the USART's interrupts: received characters queue
(1)    1011 :                    ;;; at rx_queue, characters to send at tx_queue. The USART interrupts
(1)    1011 :                    ;;; with type VEC_RX or VEC_TX, which usart.inc defines. Handlers and
(1)    1011 :                    ;;; the routines called per character start at even addresses: a 16-bit
