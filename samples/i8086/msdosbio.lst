          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                    ;;; MS-DOS 2.0 IO.SYS for the PC BIOS of rombios.asm: the OEM half, with
          0 :                    ;;; CON on INT 10H/16H, CLOCK on INT 1AH, and four disk units on INT 13H,
          0 :                    ;;; A and B the floppies 0 and 1, C and D the hard disks 80H and 81H;
          0 :                    ;;; AUX and PRN are absent. Microsoft's SYSINIT.OBJ and SYSIMES.OBJ
          0 :                    ;;; follow it in the file, linked by scripts/omf-link.py, which also
          0 :                    ;;; writes sysinit.inc, SYSINIT's variables. Modelled on the OEM kit's
          0 :                    ;;; SKELIO.ASM.
          0 :                    ;;;
          0 :                    ;;; The boot sector loads IO.SYS at 0070:0000 and enters it with DL the
          0 :                    ;;; BIOS drive and BX the paragraph MSDOS.SYS follows it at. SYSINIT then
          0 :                    ;;; moves the DOS down over the init code.
          0 :                            cpu     8086
          0 :                            include "sysinit.inc"
(1)       0 :                    ;;; SYSINIT.OBJ
(1)       0 : =0                 SYSINIT:                equ     0000H
(1)       0 : =5                 CURRENT_DOS_LOCATION:   equ     0005H
(1)       0 : =9                 FINAL_DOS_LOCATION:     equ     0009H
(1)       0 : =B                 DEVICE_LIST:            equ     000BH
(1)       0 : =F                 MEMORY_SIZE:            equ     000FH
(1)       0 : =11                DEFAULT_DRIVE:          equ     0011H
(1)       0 : =12                BUFFERS:                equ     0012H
(1)       0 : =13                FILES:                  equ     0013H
          0 :
          0 : =70                IOSEG:          equ     0070H
          0 : =4                 UNITS:          equ     4
          0 : =200               SECTOR:         equ     512
          0 : =7E00              SCRATCH:        equ     7E00H           ; a sector's room during init
          0 : =15                BPB_BYTES:      equ     21              ; from the boot sector's 0BH
          0 :
          0 :                    ;;; Request header offsets.
          0 : =1                 RH_UNIT:        equ     1
          0 : =2                 RH_CMD:         equ     2
          0 : =3                 RH_STATUS:      equ     3
          0 : =D                 RH_MEDIA:       equ     13              ; media, units for INIT
          0 : =E                 RH_TRANS:       equ     14              ; transfer address; the media
          0 :                                                            ; check's answer; INIT's break
          0 : =12                RH_COUNT:       equ     18              ; count; the BPB (array) pointer
          0 : =14                RH_START:       equ     20
          0 :
          0 :                    ;;; Driver errors.
          0 : =0                 E_WRITE_PROTECT: equ    0
          0 : =2                 E_NOT_READY:    equ     2
          0 : =3                 E_BAD_CMD:      equ     3
          0 : =6                 E_SEEK:         equ     6
          0 : =7                 E_BAD_MEDIA:    equ     7
          0 : =8                 E_NOT_FOUND:    equ     8
          0 : =A                 E_WRITE:        equ     10
          0 : =B                 E_READ:         equ     11
          0 : =C                 E_GENERAL:      equ     12
          0 :
          0 :                            org     0000H
