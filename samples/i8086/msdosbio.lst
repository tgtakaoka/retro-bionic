        1CF :                    ;;; CLOCK: 6 bytes, the days since 1980-01-01 then minutes, hours,
        1CF :                    ;;; hundredths and seconds, from the BIOS tick count: 549 hundredths
        1CF :                    ;;; per 100 ticks, and a day counted at each rollover.
        1CF : =225               HUNDREDTHS:     equ     549
        1CF : 00 00              days:   dw      0
        1D1 :
        1D1 :                    clk_read:
        1D1 : B4 00                      mov     ah, 0
