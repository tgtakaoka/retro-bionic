(1)    122A :                    ;;; 80C186XL Interrupt Control Unit, in the Peripheral Control Block at
(1)    122A :                    ;;; I/O FF00H: INT0 in cascade mode runs two INTA cycles and reads the
(1)    122A :                    ;;; interrupt type from the bus, as the 8086's INTR does, so the USART
