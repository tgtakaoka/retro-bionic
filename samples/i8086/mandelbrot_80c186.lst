(1)    122A : =20                I0CON_CAS:      equ     0020H   ; cascade mode
(1)    122A : =10                I0CON_LVL:      equ     0010H   ; level triggered, as cascade mode wants
(1)    122A :                                                    ; MSK clear, priority 0
