(1)    1128 :                    ;;; Console through the USART's interrupts: received characters queue
(1)    1128 :                    ;;; at rx_queue, characters to send at tx_queue. The USART interrupts
(1)    1128 :                    ;;; with type VEC_RX or VEC_TX, which usart.inc defines. Handlers and
(1)    1128 :                    ;;; the routines called per character start at even addresses: a 16-bit
(1)    1128 :                    ;;; bus fetches an odd jump target's first byte alone. align leaves its
(1)    1128 :                    ;;; gap unwritten, so nothing falls through into them.
