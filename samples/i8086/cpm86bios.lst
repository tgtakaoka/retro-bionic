          0 :                            include "cpm86.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :
(1)       0 :                    ;;; CP/M-86 1.1 in one segment at the top of memory: CCP and BDOS from
(1)       0 :                    ;;; CPM.SYS, then the BIOS at 2500H. The reset vector at FFFF0H is
(1)       0 :                    ;;; F000:FFF0, in the same segment. Memory below it, past the
(1)       0 :                    ;;; interrupt vectors and the debugger's park at 0400H-040FH, is the
(1)       0 :                    ;;; TPA.
(1)       0 : =F000              SYSSEG:         equ     0F000H
(1)       0 : =0                 CCP:            equ     0000H
(1)       0 : =6                 WARM_CCP:       equ     CCP+6           ; past the autoload command
(1)       0 : =B00               BDOS:           equ     CCP+0B00H
(1)       0 : =B06               BDOS_ENTRY:     equ     BDOS+6
(1)       0 : =2500              BIOS:           equ     CCP+2500H
(1)       0 : =E0                BDOS_INT:       equ     224             ; INT E0H calls BDOS
(1)       0 : =41                TPA_SEG:        equ     0041H
(1)       0 : =1A                SPT:            equ     26              ; sectors a track
          0 :                            include "usart.inc"
