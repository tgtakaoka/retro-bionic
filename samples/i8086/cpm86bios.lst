          0 :                    ;;; CP/M-86 1.1 BIOS: the console on the i8251 USART and four drives on
          0 :                    ;;; the debugger's sector disk. Addresses are offsets in the system
          0 :                    ;;; segment; the Makefile places it at F0000H. The BDOS calls it with
          0 :                    ;;; DS=CS.
