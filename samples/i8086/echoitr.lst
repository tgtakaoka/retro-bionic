(1)    106D :                    ;;; Console through the USART's interrupts: received characters queue
(1)    106D :                    ;;; at rx_queue, characters to send at tx_queue. The USART interrupts
(1)    106D :                    ;;; with type VEC_RX or VEC_TX, which usart.inc defines. Handlers and
(1)    106D :                    ;;; the routines called per character start at even addresses: a 16-bit
(1)    106D :                    ;;; bus fetches an odd jump target's first byte alone. align leaves its
(1)    106D :                    ;;; gap unwritten, so nothing falls through into them.
