# Scenario for scripts/record-scenario.py, which msdos-build.py bench
# 2.00 runs: boots bld200.dsk as C: with A: unmounted and runs BUILD,
# which assembles the 2.0 kernel, and stops; msdos-build.py
# turns the block cache off before and on after, and mounts C: and A:
# again.
#
# Needs the SD card's i8086/msdos200.hex, msdos200a.dsk, msdos200c.dsk
# and bld200.dsk.

command L i8086/msdos200.hex
type O
wait Disk?
command A
type O
wait Disk?
command C i8086/bld200.dsk

key R
type G
wait backtrace?
type 5\r
waitfor 60 C>
type BUILD\r
waitfor 21600 BUILD END
waitfor 20 C>

halt
