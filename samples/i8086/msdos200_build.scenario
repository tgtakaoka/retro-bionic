# Scenario for scripts/record-scenario.py, which msdos-build.py bench
# 2.00 runs: L bld200.hex loads the ROM BIOS and mounts bld200c.dsk as
# C:, the only drive; DOS 2.0 boots from it, lists it and runs BUILD,
# which assembles the 2.0 kernel, and stops.
#
# Needs the SD card's i8086/bld200.hex and bld200c.dsk, which
# msdos-build.py puts there.

key ?
pace 2.0

command L i8086/bld200.hex

key R
type G
wait backtrace?
type 5\r
waitfor 60 C>
type DIR C:\r
waitfor 60 C>
type BUILD\r
waitfor 21600 BUILD END
waitfor 20 C>

halt
