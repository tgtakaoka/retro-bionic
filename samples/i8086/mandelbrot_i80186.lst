(1)    1120 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)    1120 :                    ;;; Console through the USART's interrupts: received characters queue
(1)    1120 :                    ;;; at rx_queue, characters to send at tx_queue. The USART interrupts
(1)    1120 :                    ;;; with type VEC_RX or VEC_TX, which usart.inc defines. Handlers and
(1)    1120 :                    ;;; the routines called per character start at even addresses: a 16-bit
(1)    1120 :                    ;;; bus fetches an odd jump target's first byte alone. align leaves its
(1)    1120 :                    ;;; gap unwritten, so nothing falls through into them.
