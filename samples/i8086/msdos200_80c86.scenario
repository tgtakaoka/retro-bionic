# Scenario for scripts/record-scenario.py: MS-DOS 2.0 on the P80C86:
# L loads the PC BIOS and mounts its disks, DOS boots from the floppy
# A:, lists and checks A: and the 32 MB hard disk C:, copies to B: and
# keeps time; then, with A: unmounted, boots from the hard disk.
#
# Needs the SD card's i8086/msdos200.hex, msdos200a.dsk, msdos200b.dsk
# and msdos200c.dsk (docs/samples.md).

key ?
pace 2.0

command L i8086/msdos200.hex
pace 2.0

# A short backtrace for the halt at the end.
key R
type G
wait backtrace?
type 5\r
waitfor 60 new date:
pace 1.0
type 11-25-2026\r
waitfor 20 new time:
pace 1.0
type 12:00\r
waitfor 20 A>
pace 2.0

type DIR\r
waitfor 30 A>
pace 2.0
type CHKDSK\r
waitfor 60 A>
pace 2.0
type DIR C:\r
waitfor 60 A>
pace 2.0
type CHKDSK C:\r
waitfor 120 A>
pace 2.0
type COPY A:*.COM B:\r
waitfor 120 A>
pace 1.5
type DIR B:\r
waitfor 30 A>
pace 2.0
type TIME\r
waitfor 20 new time:
pace 1.0
type \r
waitfor 20 A>
pace 2.0

halt

# A: unmounted, INT 19H boots the hard disk's MBR.
type O
wait Disk?
command A
pace 1.0
key R
type G
wait backtrace?
type 5\r
waitfor 60 new date:
pace 1.0
type \r
waitfor 20 new time:
pace 1.0
type \r
waitfor 20 C>
pace 2.0
type VER\r
waitfor 20 C>
pace 2.0
type DIR\r
waitfor 30 C>
pace 2.0

halt

# A: back, as L mounted it.
type O
wait Disk?
command A i8086/msdos200a.dsk
pace 2.0
