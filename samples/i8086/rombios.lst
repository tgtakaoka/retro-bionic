       E0C1 : 02
       E0C2 : 26 C6 06 49 00 03          mov     byte ptr es:[BDA_VMODE], 3
       E0C8 : 26 C7 06 4A 00 50          mov     word ptr es:[BDA_COLS], 80
       E0CE : 00
       E0CF : 26 C7 06 1A 00 1E          mov     word ptr es:[BDA_KBHEAD], BDA_KBBUF
       E0D5 : 00
       E0D6 : 26 C7 06 1C 00 1E          mov     word ptr es:[BDA_KBTAIL], BDA_KBBUF
       E0DC : 00
