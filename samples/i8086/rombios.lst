       E000 :                            org     0E000H
       E000 :
       E000 :                    ;;; Floppy formats by index, FMT_FD360 first: heads, sectors a track,
       E000 :                    ;;; cylinders - 1, the drive type INT 13H/08H reports.
       E000 :                    fd_table:
       E000 : 02 09 27 01                db      2, 9, 39, 1             ; fd360
       E004 : 02 09 4F 03                db      2, 9, 79, 3             ; fd720
       E008 : 02 0F 4F 02                db      2, 15, 79, 2            ; fd1200
       E00C : 02 12 4F 04                db      2, 18, 79, 4            ; fd1440
       E010 :
       E010 :                    ;;; The floppy's diskette parameter table INT 13H/08H points at: the
       E010 :                    ;;; 765's bytes mean nothing here but programs expect the pointer.
       E010 : DF 02 25 02 12 1B  dbt:    db      0DFH, 02H, 25H, 02H, 18, 1BH, 0FFH, 54H, 0F6H, 0FH, 08H
       E016 : FF 54 F6 0F 08
       E01B :
       E01B :                    ;;; INT 41H's fixed disk parameter table for hd32.
       E01B : 00 04              fdpt:   dw      HD_CYLS
       E01D : 04                         db      HD_HEADS
       E01E : 00 00 00 00                dw      0, 0
       E022 : FF FF                      dw      0FFFFH                  ; write precompensation: none
       E024 : 00 00                      db      0, 0                    ; ECC burst, control
       E026 : 00 00 00                   db      0, 0, 0                 ; timeouts
       E029 : FF 03                      dw      HD_CYLS-1               ; landing zone
       E02B : 10                         db      HD_SPT
       E02C : 00                         db      0
       E02D :
       E02D :                    ;;; Interrupt vectors POST sets: type, handler.
       E02D :                    vectors:
       E02D : 08 00 9E E1                dw      08H, int08
       E031 : 10 00 D6 E1                dw      10H, int10
       E035 : 11 00 70 E2                dw      11H, int11
       E039 : 12 00 7B E2                dw      12H, int12
       E03D : 13 00 21 E3                dw      13H, int13
       E041 : 14 00 86 E2                dw      14H, int14
       E045 : 15 00 89 E2                dw      15H, int15
       E049 : 16 00 91 E2                dw      16H, int16
       E04D : 17 00 8E E2                dw      17H, int17
       E051 : 19 00 6E E5                dw      19H, int19
       E055 : 1A 00 9D E5                dw      1AH, int1a
       E059 : 1C 00 D5 E1                dw      1CH, int1c
       E05D : 41 00 1B E0                dw      41H, fdpt
       E061 : =D                 VECTORS:        equ     ($-vectors)/4
