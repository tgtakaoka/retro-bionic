          0 : =50                DISK:   equ     50H
          0 :                            include "../i8080/sector_disk.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :
(1)       0 :                    ;;; The debugger's paravirtual sector disk (debugger/sector_disk.h).
(1)       0 :                    ;;; DISK is its base port.
(1)       0 : =50                DISK_DRIVE:     equ     DISK+0  ; 0-3
(1)       0 : =51                DISK_TRACK:     equ     DISK+1  ; 0-76
(1)       0 : =52                DISK_SECTOR:    equ     DISK+2  ; 1-26, physical
(1)       0 : =53                DISK_DMAL:      equ     DISK+3  ; DMA address, low byte
(1)       0 : =54                DISK_DMAH:      equ     DISK+4  ; high byte
(1)       0 : =55                DISK_COMMAND:   equ     DISK+5  ; write a command, read its status
(1)       0 : =56                DISK_MOUNTED:   equ     DISK+6  ; bit n: drive n has its image
(1)       0 : =57                DISK_DMAX:      equ     DISK+7  ; DMA address bits 16-23
(1)       0 : =1                 CMD_READ:       equ     1
(1)       0 : =2                 CMD_WRITE:      equ     2
          0 : =58                TIMER:  equ     58H
          0 :                            include "timer.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :
(1)       0 :                    ;;; The debugger's paravirtual interval timer (debugger/i8086/timer.h):
(1)       0 :                    ;;; the PC's 18.2 Hz tick, raised on INTR with its own type. TIMER is
(1)       0 :                    ;;; its base port.
(1)       0 : =58                TIMER_CTRL:     equ     TIMER+0 ; bit 0: run; read: bit 7 set while a
(1)       0 :                                                    ; tick waits for its acknowledge
(1)       0 : =59                TIMER_TYPE:     equ     TIMER+1 ; the interrupt type it answers INTA with
(1)       0 : =5A                TIMER_EOI:      equ     TIMER+2 ; write: acknowledge the tick
(1)       0 : =1                 TIMER_RUN:      equ     01H
          0 :
          0 : =F000              BIOSSEG:        equ     0F000H
          0 :                    ;;; The sector disk's format indexes, debugger/i8086/pc_disk.cpp's
          0 :                    ;;; order: CP/M's two first, then the DOS floppies, then the hard disk.
          0 : =2                 FMT_FD360:      equ     2
          0 : =5                 FMT_FD1440:     equ     5
          0 : =6                 FMT_HD32:       equ     6
          0 :                    ;;; Every hard disk is hd32: 65536 sectors, as 1024 x 4 x 16.
          0 : =400               HD_CYLS:        equ     1024
          0 : =4                 HD_HEADS:       equ     4
          0 : =10                HD_SPT:         equ     16
          0 : =8                 TICK_TYPE:      equ     8
          0 :
          0 :                    ;;; BIOS data area, offsets in segment 0040H.
          0 : =40                BDA:            equ     0040H
          0 : =10                BDA_EQUIP:      equ     10H     ; equipment word
          0 : =13                BDA_MEMSIZE:    equ     13H     ; KB of memory
          0 : =17                BDA_KBFLAGS:    equ     17H
          0 : =1A                BDA_KBHEAD:     equ     1AH     ; the keyboard buffer's head, an offset
          0 : =1C                BDA_KBTAIL:     equ     1CH     ; and tail
          0 : =1E                BDA_KBBUF:      equ     1EH     ; 16 words
          0 : =3E                BDA_KBEND:      equ     3EH
          0 : =41                BDA_FDSTATUS:   equ     41H     ; the last floppy operation's status
          0 : =49                BDA_VMODE:      equ     49H
          0 : =4A                BDA_COLS:       equ     4AH
          0 : =50                BDA_CURSOR:     equ     50H     ; page 0's cursor, column then row
          0 : =6C                BDA_TICKS:      equ     6CH     ; dword, since midnight
          0 : =70                BDA_ROLLOVER:   equ     70H     ; set once when TICKS passed a day
          0 : =74                BDA_HDSTATUS:   equ     74H
          0 : =75                BDA_HDCOUNT:    equ     75H
          0 : =B0                TICKS_A_DAY_LO: equ     00B0H   ; 1800B0H ticks of 54.9254 ms
          0 : =18                TICKS_A_DAY_HI: equ     0018H
          0 :
          0 : =0                 BOOT_SEG:       equ     0000H
          0 : =7C00              BOOT_OFF:       equ     7C00H
          0 :
          0 :                    ;;; INT 13H errors
          0 : =1                 ERR_BAD_CMD:    equ     01H
          0 : =4                 ERR_BAD_SECTOR: equ     04H
          0 : =CC                ERR_WRITE:      equ     0CCH
          0 : =80                ERR_NO_MEDIA:   equ     80H     ; a floppy without its image
          0 : =AA                ERR_NOT_READY:  equ     0AAH    ; a hard disk without its image
