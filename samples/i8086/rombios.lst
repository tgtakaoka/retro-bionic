       E061 : 0D 0A 50 43 20 42  banner: db      0DH, 0AH, 'PC BIOS 640K', 0
       E067 : 49 4F 53 20 36 34
       E06D : 30 4B 00
       E070 : 20 41 3A 00 20 42  drives: db      ' A:', 0, ' B:', 0, ' C:', 0, ' D:', 0
       E076 : 3A 00 20 43 3A 00
       E07C : 20 44 3A 00
       E080 : 0D 0A 00           crlf:   db      0DH, 0AH, 0
