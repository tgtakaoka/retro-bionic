(3)    20AA : =C0                MODE_STOP_gm:   equ     11000000B
(3)    20AA : =40                MODE_STOP1_gc:  equ     (1 << MODE_STOP_gp)
(3)    20AA : =80                MODE_STOP15_gc: equ     (2 << MODE_STOP_gp)
(3)    20AA : =C0                MODE_STOP2_gc:  equ     (3 << MODE_STOP_gp)
(3)    20AA : =20                MODE_EVEN_bm:   equ     00100000B   ; Even parity
(3)    20AA : =10                MODE_PARITY_bm: equ     00010000B   ; Parity enable
(3)    20AA : =2                 MODE_LEN_gp:    equ     2
(3)    20AA : =C                 MODE_LEN_gm:    equ     00001100B
(3)    20AA : =0                 MODE_LEN5_gc:   equ     (0 << MODE_LEN_gp)
(3)    20AA : =4                 MODE_LEN6_gc:   equ     (1 << MODE_LEN_gp)
(3)    20AA : =8                 MODE_LEN7_gc:   equ     (2 << MODE_LEN_gp)
(3)    20AA : =C                 MODE_LEN8_gc:   equ     (3 << MODE_LEN_gp)
(3)    20AA : =0                 MODE_BAUD_gp:   equ     0
(3)    20AA : =3                 MODE_BAUD_gm:   equ     00000011B
(3)    20AA : =1                 MODE_BAUD_X1:   equ     (1 << MODE_BAUD_gp)
(3)    20AA : =2                 MODE_BAUD_X16:  equ (2 << MODE_BAUD_gp)
(3)    20AA : =3                 MODE_BAUD_X64:  equ (3 << MODE_BAUD_gp)
(3)    20AA :                    ;;; Bit Definition of command register
(3)    20AA : =80                CMD_EH_bm:      equ     10000000B   ; Enter hunt mode
(3)    20AA : =40                CMD_IR_bm:      equ     01000000B   ; Internal Reset
(3)    20AA : =20                CMD_RTS_bm:     equ     00100000B   ; Request To Send
(3)    20AA : =10                CMD_ER_bm:      equ     00010000B   ; Error Reset
(3)    20AA : =8                 CMD_SBRK_bm:    equ     00001000B   ; Send Break
(3)    20AA : =4                 CMD_RxEN_bm:    equ     00000100B   ; Receive Enable
(3)    20AA : =2                 CMD_DTR_bm:     equ     00000010B   ; Data Terminal Ready
(3)    20AA : =1                 CMD_TxEN_bm:    equ     00000001B   ; Transmit enable
(3)    20AA :
(3)    20AA :                    ;;; Bit definition of status register
(3)    20AA : =80                ST_DSR_bm:      equ     10000000B   ; Data Set Ready
(3)    20AA : =40                ST_BRK_bm:      equ     01000000B   ; BREAK detected
(3)    20AA : =20                ST_FE_bm:       equ     00100000B   ; Framing Error
(3)    20AA : =10                ST_OE_bm:       equ     00010000B   ; Overrun Error
(3)    20AA : =8                 ST_PE_bm:       equ     00001000B   ; Parity Error
(3)    20AA : =2                 ST_TxEMPTY_bp:  equ     2           ; Transmitter empty
(3)    20AA : =1                 ST_RxRDY_bp:    equ     1           ; Receiver ready
(3)    20AA : =0                 ST_TxRDY_bp:    equ     0           ; transmitter ready
(2)    20AA :                    ;;; Async 1stop 8data x16
(2)    20AA : =4E                ASYNC_MODE:     equ     MODE_STOP1_gc|MODE_LEN8_gc|MODE_BAUD_X16
