(2)    20AA :                    ;;; i8251 Universal Synchronous/Asynchronous Receiver/Transmitter
(2)    20AA : =400               USART:  equ     0400H
(2)    20AA : =400               USARTD: equ     USART+0         ; Data register
(2)    20AA : =402               USARTS: equ     USART+2         ; Status register
(2)    20AA : =402               USARTC: equ     USART+2         ; Control register
(2)    20AA : =404               USARTRV:        equ     USART+4 ; Receive interrupt enable (EXTINT), 0=off
(2)    20AA : =406               USARTTV:        equ     USART+6 ; Transmit interrupt enable (EXTINT), 0=off
(2)    20AA :                            include "i8251.inc"
