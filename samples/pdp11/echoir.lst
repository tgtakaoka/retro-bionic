(1)       0 :                    ;;; The DCT11 starts at 173000 with PSW 340, mode register start address
(1)       0 :                    ;;; 6. The DCJ11 starts at 1000 with PSW 340, power-up mode 3: with the MMU
(1)       0 :                    ;;; off its 173000 is in the I/O page, not in memory. Its power-up mode 0
(1)       0 :                    ;;; reads the PC and PSW from VEC_PWRFAIL instead.
(1)       0 : =173000            ORG_RESET       =       173000
(1)       0 :
