          0 :                            include "pdp11.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; PDP-11: the samples use only the DCT11's instructions, which the
(1)       0 :                    ;;; DCJ11 also has, so one image runs on both.
(1)       0 :                            cpu     t11
(1)       0 :
(1)       0 :                    ;;; Processor Status Word
(1)       0 : =340               PSW_PRI_gm      =       340     ; Priority
(1)       0 : =340               PSW_PRI7        =       340     ; Priority 7, interrupts disabled
(1)       0 : =0                 PSW_PRI0        =       000     ; Priority 0, interrupts enabled
(1)       0 : =20                PSW_T           =       020     ; Trace trap
(1)       0 : =10                PSW_N           =       010     ; Negative
(1)       0 : =4                 PSW_Z           =       004     ; Zero
(1)       0 : =2                 PSW_V           =       002     ; Overflow
(1)       0 : =1                 PSW_C           =       001     ; Carry
(1)       0 :
(1)       0 :                    ;;; Trap vectors: a PC, then a PSW
(1)       0 : =4                 VEC_BUS         =       004     ; Bus error, odd address
(1)       0 : =10                VEC_RESINST     =       010     ; Reserved instruction
(1)       0 : =14                VEC_BPT         =       014     ; BPT instruction, T bit
(1)       0 : =20                VEC_IOT         =       020     ; IOT instruction
(1)       0 : =24                VEC_PWRFAIL     =       024     ; Power fail
(1)       0 : =30                VEC_EMT         =       030     ; EMT instruction
(1)       0 : =34                VEC_TRAP        =       034     ; TRAP instruction
(1)       0 :
(1)       0 :                    ;;; Both start at 173000 with PSW 340: the DCT11 with mode register
(1)       0 :                    ;;; start address 6, the DCJ11 with power-up mode 2. The DCJ11's power-up
(1)       0 :                    ;;; mode 0 reads the PC and PSW from VEC_PWRFAIL instead.
(1)       0 : =173000            ORG_RESET       =       173000
(1)       0 :
(1)       0 :                    ;;; BPT hands control back to the debugger: HALT acts differently on the
(1)       0 :                    ;;; two chips.
          0 :
          0 :                    ;;; MC6850 Asynchronous Communication Interface Adapter
          0 : =177560            ACIA    =       177560
          0 :                            include "mc6850.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; MC6850 Asynchronous Communication Interface Adapter
(1)       0 :                    ;;; One register per word, accessed by byte.
(1)       0 : =177560            ACIA_control    =       ACIA+0
(1)       0 : =177560            ACIA_status     =       ACIA+0
(1)       0 : =177562            ACIA_data       =       ACIA+2
(1)       0 : =177564            ACIA_intr       =       ACIA+4  ; Interrupt vector, for Rx and Tx
(1)       0 :                    ;;;  Counter Divider Select Bits
(1)       0 : =3                 CDS_gm          =       003     ; Group mask
(1)       0 : =0                 CDS_DIV1_gc     =       000     ; /1
(1)       0 : =1                 CDS_DIV16_gc    =       001     ; /16
(1)       0 : =2                 CDS_DIV64_gc    =       002     ; /64
(1)       0 : =3                 CDS_RESET_gc    =       003     ; Master Reset
(1)       0 :                    ;;;  Word Select Bits
(1)       0 : =34                WSB_gm          =       034     ; Group mask
(1)       0 : =0                 WSB_7E2_gc      =       000     ; 7 Bits + Even Parity + 2 Stop Bits
(1)       0 : =4                 WSB_7O2_gc      =       004     ; 7 bits + Odd Parity  + 2 Stop Bits
(1)       0 : =10                WSB_7E1_gc      =       010     ; 7 bits + Even Parity + 1 Stop Bits
(1)       0 : =14                WSB_7O1_gc      =       014     ; 7 bits + Odd Parity  + 1 Stop Bits
(1)       0 : =20                WSB_8N2_gc      =       020     ; 8 bits + No Parity   + 2 Stop Bits
(1)       0 : =24                WSB_8N1_gc      =       024     ; 8 bits + No Parity   + 1 Stop Bits
(1)       0 : =30                WSB_8E1_gc      =       030     ; 8 bits + Even Parity + 1 Stop Bits
(1)       0 : =34                WSB_8O1_gc      =       034     ; 8 bits + Odd Parity  + 1 Stop Bits
(1)       0 :                    ;;;  Transmit Control Bits
(1)       0 : =140               TCB_gm          =       140     ; Group mask
(1)       0 : =0                 TCB_DI_gc       =       000     ; RTS=Low,  Tx Interrupt Disabled
(1)       0 : =40                TCB_EI_gc       =       040     ; RTS=Low,  Tx Interrupt Enabled
(1)       0 : =100               TCB_RTS_gc      =       100     ; RTS=High, Tx Interrupt Disabled
(1)       0 : =140               TCB_BREAK_gc    =       140     ; RTS=Low,  Tx Interrupt Disabled
(1)       0 :                                                    ; Transmit Break Level
(1)       0 : =200               RIEB_bm         =       200     ; Receive Interrupt Enable Bit mask
(1)       0 :                    ;;; Status register
(1)       0 : =1                 RDRF_bm         =       001     ; Receive Data Register Full
(1)       0 : =2                 TDRE_bm         =       002     ; Transmit Data Register Empty
(1)       0 : =4                 DCDF_bm         =       004     ; Data Carrier Detect Flag
(1)       0 : =10                CTSF_bm         =       010     ; Clear To Send Flag
(1)       0 : =20                FERR_bm         =       020     ; Frame Error Flag
(1)       0 : =40                OVRN_bm         =       040     ; Receiver Overrun Flag
(1)       0 : =100               PERR_bm         =       100     ; Parity Error Flag
(1)       0 : =200               IRQF_bm         =       200     ; Interrupt Request Flag
          0 :
