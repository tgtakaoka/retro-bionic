(1)       0 : =FA1F              PFPAR:          equ     $FA1F  ; $FA1F: Port F Pin Assignment
(1)       0 : =FA21              SYPCR:          equ     $FA21  ; $FA21: System Protection Control, write-once
(1)       0 : =FA22              PICR:           equ     $FA22  ; $FA22: Periodic Interrupt Control
(1)       0 : =FA24              PITR:           equ     $FA24  ; $FA24: Periodic Interrupt Timer
(1)       0 : =FA27              SWSR:           equ     $FA27  ; $FA27: Software Watchdog Service
(1)       0 : =FA41              PORTC:          equ     $FA41  ; $FA41: Port C Data
(1)       0 : =FA44              CSPAR0:         equ     $FA44  ; $FA44: Chip-Select Pin Assignment 0
(1)       0 : =FA46              CSPAR1:         equ     $FA46  ; $FA46: Chip-Select Pin Assignment 1
