(1)       0 :                            cpu     68hc16
(1)       0 :                    ;;; Condition Code Register (CCR)
(1)       0 : =100               CC_CARRY      equ  %0000000100000000 ; set to 1 if carry occurred
(1)       0 : =200               CC_OVERFLOW   equ  %0000001000000000 ; set to 1 if overflow occurred
(1)       0 : =400               CC_ZERO       equ  %0000010000000000 ; set to 1 if result is zero
(1)       0 : =800               CC_NEGATIVE   equ  %0000100000000000 ; set to 1 if result is negative
(1)       0 : =1000              CC_EV         equ  %0001000000000000 ; set to 1 if AM overflowed into AM[35:32]
(1)       0 : =2000              CC_HALF_CARRY equ  %0010000000000000 ; if 1, decimal carry from least digit occurred
(1)       0 : =4000              CC_MV         equ  %0100000000000000 ; set to 1 if AM overflowed
(1)       0 : =8000              CC_STOP       equ  %1000000000000000 ; if 1, LPSTOP is disabled
(1)       0 : =E0                CC_IP_gm      equ  %0000000011100000 ; interrupt priority mask; CLI and SEI
(1)       0 :                                                         ; are ANDP/ORP on it
(1)       0 : =10                CC_SM         equ  %0000000000010000 ; saturate mode for MAC
(1)       0 : =F                 CC_PK_gm      equ  %0000000000001111 ; program bank
(1)       0 :
(1)       0 :                    ;;; Vector (CPU16RM Table 9-1); exception handlers run in bank 0
(1)       0 : =0                 VEC_RESET:      equ     $0000   ; $0000: ZK:SK:PK, PC, SP, IZ
(1)       0 : =8                 VEC_BKPT:       equ     $0008   ; $0008: Breakpoint
(1)       0 : =A                 VEC_BERR:       equ     $000A   ; $000A: Bus Error
(1)       0 : =C                 VEC_SWI:        equ     $000C   ; $000C: Software Interrupt
(1)       0 : =E                 VEC_ILLEGAL:    equ     $000E   ; $000E: Illegal Instruction
(1)       0 : =10                VEC_DIV0:       equ     $0010   ; $0010: Division by Zero
(1)       0 : =1E                VEC_UNINIT:     equ     $001E   ; $001E: Uninitialized Interrupt
(1)       0 : =22                VEC_IRQ1:       equ     $0022   ; $0022: Level 1 Interrupt Autovector
(1)       0 : =2E                VEC_IRQ7:       equ     $002E   ; $002E: Level 7 Interrupt Autovector
(1)       0 : =30                VEC_SPURIOUS:   equ     $0030   ; $0030: Spurious Interrupt
