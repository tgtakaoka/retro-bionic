(1)       0 :                    ;;; KW11-L Line Time Clock
(1)       0 : =177546            KW11L_LKS       =       KW11L+0 ; Line clock status
(1)       0 :                    ;;; Line clock status
(1)       0 : =200               LKS_MONITOR_bm  =       200     ; Line Clock Monitor, a tick has come
(1)       0 : =100               LKS_IE_bm       =       100     ; Interrupt Enable
