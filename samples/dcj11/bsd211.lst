          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                            include "../pdp11/pdp11.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; PDP-11: the samples use only the DCT11's instructions, which the
(1)       0 :                    ;;; DCJ11 also has, so one image runs on both.
(1)       0 :                            cpu     t11
(1)       0 :
(1)       0 :                    ;;; Processor Status Word
(1)       0 : =340               PSW_PRI_gm      =       340     ; Priority
(1)       0 : =340               PSW_PRI7        =       340     ; Priority 7, interrupts disabled
(1)       0 : =0                 PSW_PRI0        =       000     ; Priority 0, interrupts enabled
(1)       0 : =20                PSW_T           =       020     ; Trace trap
(1)       0 : =10                PSW_N           =       010     ; Negative
(1)       0 : =4                 PSW_Z           =       004     ; Zero
(1)       0 : =2                 PSW_V           =       002     ; Overflow
(1)       0 : =1                 PSW_C           =       001     ; Carry
(1)       0 :
(1)       0 :                    ;;; Trap vectors: a PC, then a PSW
(1)       0 : =4                 VEC_BUS         =       004     ; Bus error, odd address
(1)       0 : =10                VEC_RESINST     =       010     ; Reserved instruction
(1)       0 : =14                VEC_BPT         =       014     ; BPT instruction, T bit
(1)       0 : =20                VEC_IOT         =       020     ; IOT instruction
(1)       0 : =24                VEC_PWRFAIL     =       024     ; Power fail
(1)       0 : =30                VEC_EMT         =       030     ; EMT instruction
(1)       0 : =34                VEC_TRAP        =       034     ; TRAP instruction
(1)       0 :
(1)       0 :                    ;;; The DCT11 starts at 173000 with PSW 340, mode register start address
(1)       0 :                    ;;; 6. The DCJ11 starts at 1000 with PSW 340, power-up mode 3: with the MMU
(1)       0 :                    ;;; off its 173000 is in the I/O page, not in memory. Its power-up mode 0
(1)       0 :                    ;;; reads the PC and PSW from VEC_PWRFAIL instead.
(1)       0 : =173000            ORG_RESET       =       173000
(1)       0 :
(1)       0 :                    ;;; BPT hands control back to the debugger: HALT acts differently on the
(1)       0 :                    ;;; two chips.
          0 :                    ;;; The DCJ11 only: the disk is its board's.
          0 :                            cpu     j11
          0 :
          0 :                    ;;; MSCP Disk Controller
          0 : =172150            MSCP    =       172150
          0 :                            include "mscp.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; MSCP Disk Controller (RQDX3)
(1)       0 : =172150            MSCP_IP         =       MSCP+0  ; Initialization and polling
(1)       0 : =172152            MSCP_SA         =       MSCP+2  ; Status and address
(1)       0 :                    ;;; SA as the controller shows it
(1)       0 : =100000            SA_ERR_bm       =       100000  ; Error
(1)       0 : =40000             SA_STEP4_bm     =       040000  ; The initialization step
(1)       0 : =20000             SA_STEP3_bm     =       020000
(1)       0 : =10000             SA_STEP2_bm     =       010000
(1)       0 : =4000              SA_STEP1_bm     =       004000
(1)       0 :                    ;;; SA as the host answers it
(1)       0 : =100000            S1_VALID_bm     =       100000  ; Step 1: the ring sizes, interrupt enable, vector
(1)       0 : =200               S1_IE_bm        =       000200
(1)       0 : =1                 S4_GO_bm        =       000001  ; Step 4
(1)       0 :                    ;;; A ring descriptor's high word
(1)       0 : =100000            DESC_OWN_bm     =       100000  ; The controller's
(1)       0 : =40000             DESC_FLAG_bm    =       040000  ; Interrupt on the ring's transition
(1)       0 :                    ;;; Opcodes
(1)       0 : =3                 OP_GET_UNIT_STATUS =    3
(1)       0 : =4                 OP_SET_CONTROLLER =     4
(1)       0 : =10                OP_AVAILABLE    =       10
(1)       0 : =11                OP_ONLINE       =       11
(1)       0 : =41                OP_READ         =       41
(1)       0 : =42                OP_WRITE        =       42
(1)       0 : =200               OP_END_bm       =       200
          0 :
          0 :                    ;;; The MSCP bootstrap, as a KDJ11's ROM does it: initializes the
          0 :                    ;;; controller with rings of one, brings unit 0 online, reads its block 0
          0 :                    ;;; to 0 and runs it with R0 the unit and R1 the controller's address,
          0 :                    ;;; which 2.11BSD's rauboot passes on. On the SD card beside bsd211.dsk,
          0 :                    ;;; loading it mounts that disk as ra0.
         14 :                            org     VEC_BPT
         14 : 000014 000340              .word   VEC_BPT, PSW_PRI7 ; for halt to system
         20 :
       1000 :                            org     1000
       1000 :                    boot:
       1000 : 012706 001000              mov     #boot, sp
       1004 : 005000                     clr     r0              ; unit
       1006 : 012701 172150              mov     #MSCP, r1
       1012 : 012704 001156              mov     #init, r4
       1016 : 012705 004000              mov     #SA_STEP1_bm, r5
       1022 : 010102                     mov     r1, r2
       1024 : 005022                     clr     (r2)+           ; IP: initialize; R2 is SA
       1026 : 005712             wait:   tst     (r2)
       1030 : 100001                     bpl     step
       1032 : 000003                     bpt                     ; SA_ERR_bm
       1034 : 030512             step:   bit     r5, (r2)
       1036 : 001773                     beq     wait
       1040 : 012412                     mov     (r4)+, (r2)     ; the step's word
       1042 : 006305                     asl     r5
       1044 : 100370                     bpl     wait            ; through step 4, leaving DESC_OWN_bm in R5
       1046 :                    command:
       1046 : 105714                     tstb    (r4)            ; the next command's length
       1050 : 001434                     beq     done
       1052 : 012702 002000              mov     #rpkt-4, r2
       1056 : 005022             clear:  clr     (r2)+
       1060 : 020227 002204              cmp     r2, #comm
       1064 : 103774                     blo     clear
       1066 : 112467 001006              movb    (r4)+, cpkt-4   ; length
       1072 : 110067 001012              movb    r0, cpkt+4      ; unit
       1076 : 112467 001012              movb    (r4)+, cpkt+10  ; opcode
       1102 : 112467 001013              movb    (r4)+, cpkt+15  ; the byte count's high byte
       1106 : 012722 002004              mov     #rpkt, (r2)+    ; the response descriptor, the controller's
       1112 : 010522                     mov     r5, (r2)+
       1114 : 012722 002104              mov     #cpkt, (r2)+    ; the command descriptor
       1120 : 010512                     mov     r5, (r2)
       1122 : 024242                     cmp     -(r2), -(r2)    ; back to the response descriptor's flags
       1124 : 005711                     tst     (r1)            ; IP: poll
       1126 : 005712             owned:  tst     (r2)
       1130 : 100776                     bmi     owned           ; until the response is written
       1132 : 005767 000660              tst     rpkt+12         ; its status
       1136 : 001743                     beq     command
       1140 : 000003                     bpt
       1142 :                    done:
       1142 : 005011                     clr     (r1)            ; IP: the controller starts over for rauboot
       1144 : 005003                     clr     r3
       1146 : 012704 001020              mov     #boot+20, r4
       1152 : 005005                     clr     r5
       1154 : 005007                     clr     pc              ; block 0
       1156 :
       1156 :                    ;;; The steps' words: rings of one, no vector; the rings' base, low and
       1156 :                    ;;; high; GO.
       1156 : 100000             init:   .word   S1_VALID_bm
       1160 : 002204                     .word   comm
       1162 : 000000                     .word   0
       1164 : 000001                     .word   S4_GO_bm
       1166 :                    ;;; The commands: the packet's length, the opcode and the byte count's
       1166 :                    ;;; high byte; then none.
       1166 : 004420    000              .byte   20, OP_ONLINE, 0
       1171 : 040    001041              .byte   40, OP_READ, 2  ; 512 bytes
       1174 :    000                     .byte   0
       1175 :
       1175 :                    ;;; The packets, each after its length and credits words, then the
       1175 :                    ;;; communications area: the transition words and the two rings.
       2000 :                            org     2000
       2000 :                            .blkw   2
       2004 :                    rpkt:   .blkw   30.
       2100 :                            .blkw   2
       2104 :                    cpkt:   .blkw   30.
       2200 :                            .blkw   2
       2204 :                    comm:   .blkw   4
