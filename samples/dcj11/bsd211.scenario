# Scenario for scripts/record-scenario.py: 2.11BSD on the DCJ11, from the
# MSCP controller's disk on the SD card (docs/samples.md, "2.11BSD on the
# DCJ11"). U uploads the MSCP bootstrap and O mounts dcj11/bsd211.dsk as
# ra0; rauboot and /boot bring the GENERIC kernel up single-user, /usr
# is mounted, and its own as and cc build fmandel in /usr/root, each
# drawing the set on the FP11.
#
# The kernel sends each character with a parity bit, so the line is masked
# to 7 bits for the recording. After power-up SP may sit in the I/O page,
# where G's restore cannot stack PC and PS. Addresses are octal, the
# target's radix.
#
# Starts from the installed disk (bsd211-install.py's image, with the
# sources alone in /usr/root) freshly synced onto the card: the runs
# leave a.out and fmandel there, so sync it again before recording.

key ?
pace 2.0

# U uploads the bootstrap and O mounts the disk once, so a reboot never
# re-mounts it and the disk cache stays warm; the listing shows the cache.
key R
upload samples/dcj11/bsd211.hex
type O
wait Disk?
command ra0 dcj11/bsd211.dsk
type O
wait Disk?
command
pace 2.0
key R
type =
wait Set register?
command SP 1000
command I DL11 177
pace 1.0

# The bootstrap reads block 0: rauboot asks for the kernel, Enter takes
# ra(0,0,0)unix, which comes up single-user; its banner has a # in it,
# so the prompt is awaited by the line before it.
type G 5\r
waitfor 30 :
type \r
waitfor 300 intr ^C
pace 1.5
type mount /usr\r
waitfor 60 #
type cd /usr/root\r
waitfor 30 #
type ls -l\r
waitfor 30 #
pace 2.0

# 2.11BSD's as, then its C compiler; ls shows what each made, and each
# draws the set.
type as fmandel.s\r
waitfor 300 #
type ls -l\r
waitfor 30 #
pace 1.0
type ./a.out\r
waitfor 300 #
pace 3.0
type cc -O -o fmandel fmandel.c\r
waitfor 900 #
type ls -l\r
waitfor 30 #
pace 1.0
type ./fmandel\r
waitfor 300 #
pace 3.0

# The disk written out, then the halt.
type sync\r
waitfor 30 #
type sync\r
waitfor 30 #
pace 1.0
halt
command I DL11 377
