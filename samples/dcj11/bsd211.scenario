# Scenario for scripts/record-scenario.py: 2.11BSD on the DCJ11, from the
# MSCP controller's disk on the SD card (docs/samples.md, "2.11BSD on the
# DCJ11"). L loads the MSCP bootstrap from the card and mounts
# dcj11/bsd211.dsk beside it as ra0; rauboot and /boot bring the GENERIC
# kernel up single-user, ^D goes on to multi-user and root logs in. Its
# cc builds fmandel in /usr/root, which draws the set on the FP11, then
# banner and hangman from /usr/games.
#
# The kernel sends each character with a parity bit, so the line is masked
# to 7 bits for the recording. Addresses are octal, the target's radix.
#
# hangman's word is random: the guesses are consonants without n and y,
# so the word is never complete and each game is lost on its seventh
# miss, before the guesses run out; a key left over only asks for y or
# n, and n ends it.
#
# Starts from the installed disk (bsd211-install.py's image, with the
# sources alone in /usr/root) freshly put on the card by `make bsd211-sd
# NEWB=1`: the run leaves fmandel there, so put it again before
# recording.

key ?
pace 2.0

# L loads the bootstrap from the card and mounts the disk beside it; O's
# listing shows the mount and the cache.
key R
type L
wait Load?
command dcj11/bsd211.hex
type O
wait Disk?
command
pace 2.0
key R
command I DL11 177
pace 1.0

# The bootstrap reads block 0: rauboot asks for the kernel, Enter takes
# ra(0,0,0)unix, which comes up single-user; its banner has a # in it,
# so the prompt is awaited by the line before it. ^D runs /etc/rc to
# login:, and root has no password.
type G 10\r
waitfor 30 :
type \r
waitfor 300 intr ^C
waitfor 30 #
pace 1.5
type \x04
waitfor 400 login:
type root\r
waitfor 60 intr ^C
waitfor 30 #
pace 1.5
type cd /usr/root\r
waitfor 30 #
type ls -l\r
waitfor 30 #
pace 2.0

# 2.11BSD's C compiler; ls shows what it made, and fmandel draws the set.
type cc -O -o fmandel fmandel.c\r
waitfor 900 #
type ls -l\r
waitfor 30 #
pace 1.0
type ./fmandel\r
waitfor 300 #
pace 3.0

# banner prints its #s down the screen, so its end is not awaited by the
# prompt but paced.
type /usr/games/banner -w40 2.11BSD\r
pace 15.0

type /usr/games/hangman\r
waitfor 60 Guess:
pace 2.0
type z
pace 2.5
type q
pace 2.5
type x
pace 2.5
type j
pace 2.5
type k
pace 2.5
type v
pace 2.5
type w
pace 2.5
type f
pace 2.5
type b
pace 2.5
type g
pace 2.5
type p
pace 2.5
type m
pace 2.5
pace 3.0
type n
waitfor 30 #
pace 2.0

# halt syncs the disks and stops at the debugger's prompt.
type halt\r
waitfor 120 >
pace 3.0
