          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                            include "../pdp11/pdp11.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; PDP-11: the samples use only the DCT11's instructions, which the
(1)       0 :                    ;;; DCJ11 also has, so one image runs on both.
(1)       0 :                            cpu     t11
(1)       0 :
(1)       0 :                    ;;; Processor Status Word
(1)       0 : =340               PSW_PRI_gm      =       340     ; Priority
(1)       0 : =340               PSW_PRI7        =       340     ; Priority 7, interrupts disabled
(1)       0 : =0                 PSW_PRI0        =       000     ; Priority 0, interrupts enabled
(1)       0 : =20                PSW_T           =       020     ; Trace trap
(1)       0 : =10                PSW_N           =       010     ; Negative
(1)       0 : =4                 PSW_Z           =       004     ; Zero
(1)       0 : =2                 PSW_V           =       002     ; Overflow
(1)       0 : =1                 PSW_C           =       001     ; Carry
(1)       0 :
(1)       0 :                    ;;; Trap vectors: a PC, then a PSW
(1)       0 : =4                 VEC_BUS         =       004     ; Bus error, odd address
(1)       0 : =10                VEC_RESINST     =       010     ; Reserved instruction
(1)       0 : =14                VEC_BPT         =       014     ; BPT instruction, T bit
(1)       0 : =20                VEC_IOT         =       020     ; IOT instruction
(1)       0 : =24                VEC_PWRFAIL     =       024     ; Power fail
(1)       0 : =30                VEC_EMT         =       030     ; EMT instruction
(1)       0 : =34                VEC_TRAP        =       034     ; TRAP instruction
(1)       0 :
(1)       0 :                    ;;; The DCT11 starts at 173000 with PSW 340, mode register start address
(1)       0 :                    ;;; 6. The DCJ11 starts at 1000 with PSW 340, power-up mode 3: with the MMU
(1)       0 :                    ;;; off its 173000 is in the I/O page, not in memory. Its power-up mode 0
(1)       0 :                    ;;; reads the PC and PSW from VEC_PWRFAIL instead.
(1)       0 : =173000            ORG_RESET       =       173000
(1)       0 :
(1)       0 :                    ;;; BPT hands control back to the debugger: HALT acts differently on the
(1)       0 :                    ;;; two chips.
          0 :                    ;;; The DCJ11 only: the disk is its board's.
          0 :                            cpu     j11
          0 :
          0 :                    ;;; RK11 Disk Controller
          0 : =177400            RK11    =       177400
          0 :                            include "rk11.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; RK11 Disk Controller
(1)       0 : =177400            RK11_RKDS       =       RK11+0  ; Drive status
(1)       0 : =177402            RK11_RKER       =       RK11+2  ; Error
(1)       0 : =177404            RK11_RKCS       =       RK11+4  ; Control status
(1)       0 : =177406            RK11_RKWC       =       RK11+6  ; Word count, negative
(1)       0 : =177410            RK11_RKBA       =       RK11+10 ; Bus address
(1)       0 : =177412            RK11_RKDA       =       RK11+12 ; Disk address: drive, cylinder, surface, sector
(1)       0 :                    ;;; Drive status
(1)       0 : =200               RKDS_DRY_bm     =       200     ; Drive Ready
(1)       0 :                    ;;; Error
(1)       0 : =20000             RKER_WLO_bm     =       20000   ; Write to a locked drive
(1)       0 : =1                 RKER_WCE_bm     =       1       ; Write check: memory and disk differ
(1)       0 :                    ;;; Control status
(1)       0 : =100000            RKCS_ERR_bm     =       100000  ; Error
(1)       0 : =200               RKCS_RDY_bm     =       200     ; Control Ready
(1)       0 : =100               RKCS_IE_bm      =       100     ; Interrupt Enable
(1)       0 : =2                 RKCS_WRITE      =       2       ; Write function
(1)       0 : =4                 RKCS_READ       =       4       ; Read function
(1)       0 : =6                 RKCS_WCHK       =       6       ; Write check function
(1)       0 : =12                RKCS_RCHK       =       12      ; Read check function
(1)       0 : =14                RKCS_DRESET     =       14      ; Drive reset function
(1)       0 : =16                RKCS_WLOCK      =       16      ; Write lock function
(1)       0 : =1                 RKCS_GO_bm      =       1       ; Go
          0 :
          0 :                    ;;; The RK05 bootstrap: drive 0's first sector to 0, then run it. On the
          0 :                    ;;; SD card beside unix_v6.dsk, loading it mounts that disk.
       1000 :                            org     1000
       1000 :                    boot:
       1000 : 000005                     reset                   ; RKBA and RKDA to 0
       1002 : 012700 177406              mov     #RK11_RKWC, r0
       1006 : 012710 177400              mov     #-256., (r0)
       1012 : 012740 000005              mov     #RKCS_READ|RKCS_GO_bm, -(r0)
       1016 : 105710             wait:   tstb    (r0)            ; RKCS_RDY_bm
       1020 : 100376                     bpl     wait
       1022 : 005007                     clr     pc
