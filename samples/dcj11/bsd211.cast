[31.415469, "o", "\u001b[36m# [92 s cut: sample-sd.py compares the chunks and sends those that differ]\u001b[0m\r\n"]
[32.165469, "o", "dcj11/bsd211.dsk: 1359872 of 159334400 bytes sent in 91.5s\r\n"]
[32.178135, "o", "$ ../../scripts/record-scenario.py bsd211.scenario\r\n"]
[34.760207, "o", "\r\r\n* Bionic"]
[34.764227, "o", "DCJ11 * 1.0\r\r\nPC=001000 SP=001000 PS=340 _____ FPS=000000 ________\r\r\nR0=000000 R1=000000 R2=000000 R3=000000 R4=000000 R5=000000\r\r\n001000: 052525                BIS    (R5)+, (R5)+\r\r\n\r\r\n  R              : reset the target DCJ11\r\r\n  U              : upload Intel HEX / S-record (^C to end)\r\r\n  F [path]       : list files on SD card\r\r\n  L file         : load an Intel HEX / S-record file from card\r\r\n  O [drive [file]]: list disks, mount file on drive, unmount drive\r\r\n  O sync         : write the disk cache's dirty blocks to the card\r\r\n  O cache [on|off|through|back]\r\r\n                 : show the disk cache, turn it, set its write policy\r\r\n  Y put [file [offset [size]]]\r\r\n                 : receive a file by YMODEM onto the card, at offset;\r\r\n                   the sender names it when file is left out\r\r\n  Y get file [offset [len]]\r\r\n                 : send a card file by YMODEM\r\r\n  Y crc file [chunk]\r\r\n                 : the file's size and CRC-32 per chunk (default 1000)\r\r\n                   Y takes its numbers in hexadecimal\r\r\n  Y rm file      : delete a card file, unless a drive holds it\r\r\n  G [n]          : run freely, backtrace last n lines (default: all)\r\r\n  g addr [n]     : run until addr (a one-shot breakpoint), same backtrace\r\r\n  B addr         : set a breakpoint\r\r\n  b [index]      : list breakpoints, clear one\r\r\n  S              : step one instruction\r\r\n\r\r\n  r              : print registers\r\r\n  = reg value    : set a register (unknown name lists valid names)\r\r\n  d addr [len]   : dump data memory (len defaults to 16)\r\r\n  p addr [len]   : dump program memory (len defaults to 16)\r\r\n  D addr [n]     : disassemble n instructions (default 20)\r\r\n  m addr byte... : write & dump data memory, 16 bytes max\r\r\n  M addr byte... : write & dump program memory, 16 bytes max\r\r\n  c addr n v...  : fill data memory, n times v... (16 max)\r\r\n  C addr n v...  : fill program memory, likewise\r\r\n\r\r\n  I              : list the I/O devices; Enter at which? changes none\r\r\n  I dev [addr]   : select or turn on an I/O device, optionally its base\r\r\n  I -dev         : turn an I/O device off\r\r\n  I dev addr rx [tx]\r\r\n                 : likewise, and its Rx and Tx interrupt vectors\r\r\n                   (0: none; tx defaults to rx)\r\r\n  P [from to]    : show, or set, the target's memory area\r\r\n  W +identity    : write identity EEPROM\r\r\n  V              : toggle verbose bus-cycle printing\r\r\n  ?              : this help\r\r\n\r\r\n  HALT button    : stop a free running DCJ11\r\r\n                   held at power up skips the identity EEPROM check, to recover\r\r\n                   from a bad identity EEPROM\r\r\n  2nd USB serial : send any byte to stop a free running DCJ11\r\r\n> "]
