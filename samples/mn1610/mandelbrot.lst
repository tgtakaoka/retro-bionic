(1)     27A : CF08                       b       print_uint16
(1)     27B : 2001                       push    R0
(1)     27C : 082D                       mvi     R0, '-'
(1)     27D : 8FB8                       bal     putchar
(1)     27E : 2002                       pop     R0
(1)     27F : 6101                       eor     R1, R1          R1=0
(1)     280 : 5900                       s       R1, R0          R1=-value
(1)     281 : 7809                       mv      R0, R1
(1)     282 :                    print_uint16:
