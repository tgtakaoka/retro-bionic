(1)     28D : 625A                       or      R2, R2, nz      Skip if R2 != 0
(1)     28E : 2003                       ret                     Divide by zero
(1)     28F : 2301                       push    R3
(1)     290 : 6303                       eor     R3, R3
(1)     291 : 0B01                       mvi     R3, 1           bit=1
(1)     292 : CF03                       b       udiv16_prep
(1)     293 :                    udiv16_prep_loop:
(1)     293 : 220D                       sl      R2, re          divisor<<=1
(1)     294 : 230D                       sl      R3, re          bit<<=1
(1)     295 :                    udiv16_prep:
(1)     295 : 51EA                       c       R1, R2, lpz     Skip if dividend>=divisor
(1)     296 : CF03                       b       udiv16_prep_end
(1)     297 : 2A50                       tbit    R2, 0, nz       Skip if msb(R2)==1
(1)     298 : CFFB                       b       udiv16_prep_loop
(1)     299 :                    udiv16_prep_end:
(1)     299 : 6000                       eor     R0, R0          quotient=0 (R0)
(1)     29A :                    udiv16_loop:
(1)     29A : 59E2                       s       R1, R2, lpz     dividend-=divisor, skip if dividend>=divisor
(1)     29B : CF02                       b       udiv16_readd
(1)     29C : 601B                       or      R0, R3, skp     quotient|=bit
(1)     29D :                    udiv16_readd:
(1)     29D : 590A                       a       R1, R2          dividend+=divisor
(1)     29E : 2209                       sr      R2, re          divisor>>=1
(1)     29F : 2349                       sr      R3, re, z       bit>>=1, skip if bit==0
(1)     2A0 : CFFA                       b       udiv16_loop
(1)     2A1 : 2302                       pop     R3
(1)     2A2 : 2003                       ret
(1)     2A3 :
(1)     2A3 :                    *** Signed Divide: dividend / divisor = quotient
(1)     2A3 :                    *** @param R1 dividend
(1)     2A3 :                    *** @param R2 divisor
(1)     2A3 :                    *** @return R1 quotient
(1)     2A3 :                    *** @clobber R0 R2
(1)     2A3 :                    div16:
(1)     2A3 : 2301                       push    R3
(1)     2A4 : 7B09                       mv      R3, R1
(1)     2A5 : 2950                       tbit    R1, 0, nz       skip if msb(dividend)=1
(1)     2A6 : CF04                       b       div16_divisor
(1)     2A7 : 6000                       eor     R0, R0
(1)     2A8 : 5801                       s       R0, R1
(1)     2A9 : 7908                       mv      R1, R0          negate dividend
(1)     2AA :                    div16_divisor:
(1)     2AA : 6302                       eor     R3, R2          R3=sign(quotient)
(1)     2AB : 2A50                       tbit    R2, 0, nz       skip if msb(divisor)=1
(1)     2AC : CF04                       b       div16_divide
(1)     2AD : 6000                       eor     R0, R0
(1)     2AE : 5802                       s       R0, R2
(1)     2AF : 7A08                       mv      R2, R0          negate divisor
(1)     2B0 :                    div16_divide:
(1)     2B0 : 8FDD                       bal     udiv16
(1)     2B1 : 2B50                       tbit    R3, 0, nz       skip if quotient must be negated
(1)     2B2 : CF03                       b       div16_return
(1)     2B3 : 6101                       eor     R1, R1
(1)     2B4 : 5910                       s       R1, R0, skp     negate quotient
(1)     2B5 :                    div16_return:
(1)     2B5 : 7908                       mv      R1, R0
(1)     2B6 : 2302                       pop     R3
(1)     2B7 : 2003                       ret
(1)     2B8 :
(1)     2B8 :                    *** Signed Divide: dividend / |divisor| = quotient
(1)     2B8 :                    *** @param R1 dividend
(1)     2B8 :                    *** @param R2 divisor
(1)     2B8 :                    *** @return R1 quotient
(1)     2B8 :                    *** @clobber R0
(1)     2B8 :                    divu16:
