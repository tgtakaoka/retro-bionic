(1)     23C : CF03                       b       udiv16_prep_end
(1)     23D : 2A50                       tbit    R2, 0, nz       Skip if msb(R2)==1
(1)     23E : CFFB                       b       udiv16_prep_loop
(1)     23F :                    udiv16_prep_end:
(1)     23F : 6000                       eor     R0, R0          quotient=0 (R0)
(1)     240 :                    udiv16_loop:
(1)     240 : 59E2                       s       R1, R2, lpz     dividend-=divisor, skip if dividend>=divisor
(1)     241 : CF02                       b       udiv16_readd
(1)     242 : 601B                       or      R0, R3, skp     quotient|=bit
(1)     243 :                    udiv16_readd:
