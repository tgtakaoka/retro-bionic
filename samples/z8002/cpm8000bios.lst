          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                    ;;; The BIOS of cpm8000bios.inc for DRI's CP/M-8000 1.1 kernel.
          0 :                            include "cpm8000.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; CP/M-8000 1.1 on the Z8002: where everything sits in the 64K, shared
(1)       0 :                    ;;; by cpm8000bios.asm, cpm8000glue.asm and the Makefile's link.
(1)       0 :                            include "z8002.inc"
(2)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)       0 :                    ;;; Z8002
(2)       0 :                            cpu     z8002
(2)       0 :
(2)       0 :                    ;;; Reset reads the FCW at 0002H and the PC at 0004H, the reset entry of
(2)       0 :                    ;;; a Program Status Area at 0000H.
(2)       0 : =0                 ORG_RESET:      equ     0000H
(2)       0 :                    ;;; Program Status Area offsets: an FCW, then a PC.
(2)       0 : =4                 PSA_EPA:        equ     04H     ; extended instruction trap
(2)       0 : =8                 PSA_PRIV:       equ     08H     ; privileged instruction trap
(2)       0 : =C                 PSA_SC:         equ     0CH     ; system call
(2)       0 : =14                PSA_NMI:        equ     14H     ; non-maskable interrupt
(2)       0 : =18                PSA_NVI:        equ     18H     ; non-vectored interrupt
(2)       0 : =1C                PSA_VI:         equ     1CH     ; vectored interrupt: the FCW, then a PC
(2)       0 :                                                    ; for each identifier from 1EH, the one
(2)       0 :                                                    ; for identifier n at PSA_VI+2+2*n
(2)       0 :                    ;;; Flag and Control Word
(2)       0 : =4000              FCW_SN:         equ     4000H   ; system mode
(2)       0 : =2000              FCW_EPA:        equ     2000H   ; extended processor architecture
(2)       0 : =1000              FCW_VIE:        equ     1000H   ; vectored interrupt enable
(2)       0 : =800               FCW_NVIE:       equ     0800H   ; non-vectored interrupt enable
(2)       0 :
(2)       0 :                    ;;; The data area: queues and variables.
(2)       0 : =4000              DATA:           equ     4000H
(2)       0 :
(2)       0 :                    ;;; SC #SC_EXIT hands control back to the debugger, as a breakpoint does.
(2)       0 : =FF                SC_EXIT:        equ     0FFH
(1)       0 :
(1)       0 :                    ;;; The TPA runs from 0: a program is linked at 0 and the loader moves
(1)       0 :                    ;;; nothing, so the reset vector at 0004H belongs to the program once one
(1)       0 :                    ;;; has loaded. The loader also takes the TPA for a whole 64K segment: it
(1)       0 :                    ;;; puts the base page at 0FE00H and the program's stack below 0FD00H,
(1)       0 :                    ;;; whatever the memory region table says, and only sizes the program by
(1)       0 :                    ;;; it. So the BIOS comes first, the kernel, CCP and BDOS as DRI linked
(1)       0 :                    ;;; them with its commons linked after it at SYSTEM by xout-link.py, and
(1)       0 :                    ;;; the memory above the kernel is the program's stack.
(1)       0 : =8800              BIOS_ORG:       equ     8800H
(1)       0 : =9800              SYSTEM:         equ     9800H
(1)       0 : =8800              TPA_SIZE:       equ     BIOS_ORG
(1)       0 :                    ;;; The Program Status Area, on a 256-byte boundary: FCW and PC pairs
(1)       0 :                    ;;; through the vectored interrupts' table, identifiers 0 to 15.
(1)       0 : =8800              PSA:            equ     BIOS_ORG
(1)       0 : =40                PSA_SIZE:       equ     40H
(1)       0 :                    ;;; The system stack grows down from the kernel to the BIOS's data.
(1)       0 : =97FE              SYSSTK:         equ     SYSTEM-2
(1)       0 :
(1)       0 :                    ;;; System call numbers: SC #n.
(1)       0 : =1                 MEM_SC:         equ     1       ; memory management and context switch
(1)       0 : =2                 BDOS_SC:        equ     2
(1)       0 : =3                 BIOS_SC:        equ     3
(1)       0 :                    ;;; The exception vector the BIOS keeps: 48 longs, traps 0-31 and system
(1)       0 :                    ;;; calls 0-15 as 32-47, numbered as CP/M-68K's.
(1)       0 : =30                NTRAPS:         equ     48
(1)       0 : =20                SC0TRAP:        equ     32
(1)       0 : =1                 EPUTRAP:        equ     1
(1)       0 : =2                 SEGTRAP:        equ     2
(1)       0 : =8                 PITRAP:         equ     8
(1)       0 : =0                 NMITRAP:        equ     0
(1)       0 :
(1)       0 :                    ;;; The trap frame the dispatcher builds on the system stack, offsets
(1)       0 :                    ;;; from R15 in the dispatcher; a handler, called with CO bytes of return
(1)       0 :                    ;;; address on top, sees each CO higher. DRI's Z8002 glue (biosdefs2.z8k)
(1)       0 :                    ;;; shares it: R0-R14, the normal R15, then what the CPU pushed, the SC
(1)       0 :                    ;;; identifier, FCW and PC.
(1)       0 : =0                 FR_R0:          equ     0
(1)       0 : =C                 FR_R6:          equ     12
(1)       0 : =E                 FR_R7:          equ     14
(1)       0 : =1C                FR_R14:         equ     28
(1)       0 : =1E                FR_NR15:        equ     30
(1)       0 : =20                FR_ID:          equ     32
(1)       0 : =22                FR_FCW:         equ     34
(1)       0 : =24                FR_PC:          equ     36
(1)       0 : =26                FRAME:          equ     38
(1)       0 :                    ;;; A program's startup context (the CCP's go.c), which xfer loads: R0-R15,
(1)       0 :                    ;;; a word it ignores, the FCW and the PC as segment and offset.
(1)       0 : =22                CTX_FCW:        equ     34
(1)       0 : =26                CTX_PC:         equ     38
(1)       0 : =2                 CO:             equ     2
(1)       0 :
(1)       0 :                    ;;; The firmware's synthesized segments for a split instruction/data
(1)       0 :                    ;;; program: the system (the kernel and a merged program), the running
(1)       0 :                    ;;; program's code, and its data. A segment is the high half of the
(1)       0 :                    ;;; EXTMEM address the debugger forms, segment<<16 | offset.
(1)       0 : =0                 SEG_SYS:        equ     0
(1)       0 : =1                 SEG_CODE:       equ     1
(1)       0 : =2                 SEG_DATA:       equ     2
(1)       0 :
(1)       0 :                    ;;; The SPLIT device: a control port that turns the routing on for a
(1)       0 :                    ;;; split program, and a copy engine that moves bytes across the
(1)       0 :                    ;;; segments so the BIOS, in system mode, can load a program's code and
(1)       0 :                    ;;; data and reach a split program's disk buffers.
(1)       0 : =160               SPLIT:          equ     160H
(1)       0 : =160               SPLIT_CTRL:     equ     SPLIT+0
(1)       0 : =161               SPLIT_SRCSEG:   equ     SPLIT+1
(1)       0 : =162               SPLIT_SRCL:     equ     SPLIT+2
(1)       0 : =163               SPLIT_SRCH:     equ     SPLIT+3
(1)       0 : =164               SPLIT_DSTSEG:   equ     SPLIT+4
(1)       0 : =165               SPLIT_DSTL:     equ     SPLIT+5
(1)       0 : =166               SPLIT_DSTH:     equ     SPLIT+6
(1)       0 : =167               SPLIT_COUNTL:   equ     SPLIT+7
(1)       0 : =168               SPLIT_COUNTH:   equ     SPLIT+8
(1)       0 : =1                 SPLIT_ON:       equ     1
          0 :                            include "usart.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; i8251 Universal Synchronous/Asynchronous Receiver/Transmitter
(1)       0 : =140               USART:  equ     140H
(1)       0 : =140               USARTD: equ     USART+0         ; Data register
(1)       0 : =141               USARTS: equ     USART+1         ; Status register
(1)       0 : =141               USARTC: equ     USART+1         ; Control register
(1)       0 : =142               USARTRV:        equ     USART+2 ; Receive interrupt identifier
(1)       0 : =143               USARTTV:        equ     USART+3 ; Transmit interrupt identifier
(1)       0 :                    ;;; The identifiers the USART answers its vectored interrupts with: even,
(1)       0 :                    ;;; as the Z8001 requires.
(1)       0 : =2                 RX_ID:          equ     2
(1)       0 : =4                 TX_ID:          equ     4
(1)       0 :                            include "../z80/i8251.inc"
(2)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)       0 :
(2)       0 :                    ;;; i8251 USART device emulator.
(2)       0 :                    ;;; Bit definition of mode register
(2)       0 : =6                 MODE_STOP_gp:   equ     6
(2)       0 : =C0                MODE_STOP_gm:   equ     11000000B
(2)       0 : =40                MODE_STOP1_gc:  equ     (1 << MODE_STOP_gp)
(2)       0 : =80                MODE_STOP15_gc: equ     (2 << MODE_STOP_gp)
(2)       0 : =C0                MODE_STOP2_gc:  equ     (3 << MODE_STOP_gp)
(2)       0 : =20                MODE_EVEN_bm:   equ     00100000B
(2)       0 : =10                MODE_PARITY_bm: equ     00010000B
(2)       0 : =2                 MODE_LEN_gp:    equ     2
(2)       0 : =C                 MODE_LEN_gm:    equ     00001100B
(2)       0 : =0                 MODE_LEN5_gc:   equ     (0 << MODE_LEN_gp)
(2)       0 : =4                 MODE_LEN6_gc:   equ     (1 << MODE_LEN_gp)
(2)       0 : =8                 MODE_LEN7_gc:   equ     (2 << MODE_LEN_gp)
(2)       0 : =C                 MODE_LEN8_gc:   equ     (3 << MODE_LEN_gp)
(2)       0 : =0                 MODE_BAUD_gp:   equ     0
(2)       0 : =3                 MODE_BAUD_gm:   equ     00000011B
(2)       0 : =1                 MODE_BAUD_X1:   equ     (1 << MODE_BAUD_gp)
(2)       0 : =2                 MODE_BAUD_X16:  equ (2 << MODE_BAUD_gp)
(2)       0 : =3                 MODE_BAUD_X64:  equ (3 << MODE_BAUD_gp)
(2)       0 :                    ;;; Bit Definition of command register
(2)       0 : =80                CMD_EH_bm:      equ     10000000B   ; Enter hunt mode
(2)       0 : =40                CMD_IR_bm:      equ     01000000B   ; Internal Reset
(2)       0 : =20                CMD_RTS_bm:     equ     00100000B   ; Request To Send
(2)       0 : =10                CMD_ER_bm:      equ     00010000B   ; Error Reset
(2)       0 : =8                 CMD_SBRK_bm:    equ     00001000B   ; Send Break
(2)       0 : =4                 CMD_RxEN_bm:    equ     00000100B   ; Receive Enable
(2)       0 : =2                 CMD_DTR_bm:     equ     00000010B   ; Data Terminal Ready
(2)       0 : =1                 CMD_TxEN_bm:    equ     00000001B   ; Transmit enable
(2)       0 :
(2)       0 :                    ;;; Bit definition of status register
(2)       0 : =80                ST_DSR_bm:      equ     10000000B   ; Data Set Ready
(2)       0 : =40                ST_BRK_bm:      equ     01000000B   ; BREAK detected
(2)       0 : =20                ST_FE_bm:       equ     00100000B   ; Framing Error
(2)       0 : =10                ST_OE_bm:       equ     00010000B   ; Overrun Error
(2)       0 : =8                 ST_PE_bm:       equ     00001000B   ; Parity Error
(2)       0 : =2                 ST_TxEMPTY_bp:  equ     2           ; Transmitter empty
(2)       0 : =1                 ST_RxRDY_bp:    equ     1           ; Receiver ready
(2)       0 : =0                 ST_TxRDY_bp:    equ     0           ; Transmitter ready
(1)       0 :                    ;;; Async 1stop 8data x16
(1)       0 : =4E                ASYNC_MODE:     equ     MODE_STOP1_gc|MODE_LEN8_gc|MODE_BAUD_X16
(1)       0 :                    ;;; RTS/DTR, error reset, Rx enable, Tx enable
(1)       0 : =37                RX_EN_TX_EN:    equ     CMD_RTS_bm|CMD_DTR_bm|CMD_ER_bm|CMD_RxEN_bm|CMD_TxEN_bm
(1)       0 : =36                RX_EN_TX_DIS:   equ     CMD_RTS_bm|CMD_DTR_bm|CMD_ER_bm|CMD_RxEN_bm
          0 :                            include "cpm8000sys.inc"
