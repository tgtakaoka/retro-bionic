(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; The CP/M-8000 BIOS for the Z8002: the console on the i8251 and four
(1)       0 :                    ;;; drives on the debugger's sector disk, both polled, byte I/O at
(1)       0 :                    ;;; 16-bit port addresses. cpm8000bios.asm links it with DRI's 1.1 kernel
(1)       0 :                    ;;; and the Z8002 glue of cpm8000glue.asm, pcpm8000bios.asm with the 1.2
(1)       0 :                    ;;; kernel built from P-CP/M-Z8K's sources; either, at SYSTEM by
(1)       0 :                    ;;; xout-link.py, calls the BIOS with SC #3: R3 the function, RR4 and RR6
(1)       0 :                    ;;; the parameters, the result back in RR6 (R7 for a word). SC #2 is the
(1)       0 :                    ;;; BDOS, SC #1 memory management and the context switch that starts a
(1)       0 :                    ;;; program. All traps go through the exception vector, 48 longs the BDOS
(1)       0 :                    ;;; fills with BIOS function 22, as CP/M-68K's.
(1)       0 :
(1)       0 : =150               DISK:   equ     150H
(1)       0 :                            include "../i8080/sector_disk.inc"
(2)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)       0 :
(2)       0 :                    ;;; The debugger's paravirtual sector disk (debugger/sector_disk.h).
(2)       0 :                    ;;; DISK is its base port.
(2)       0 : =150               DISK_DRIVE:     equ     DISK+0  ; 0-3
(2)       0 : =151               DISK_TRACK:     equ     DISK+1  ; 0-76
(2)       0 : =152               DISK_SECTOR:    equ     DISK+2  ; 1-26, physical
(2)       0 : =153               DISK_DMAL:      equ     DISK+3  ; DMA address, low byte
(2)       0 : =154               DISK_DMAH:      equ     DISK+4  ; high byte
(2)       0 : =155               DISK_COMMAND:   equ     DISK+5  ; write a command, read its status
(2)       0 : =156               DISK_MOUNTED:   equ     DISK+6  ; bit n: drive n has its image
(2)       0 : =157               DISK_DMAX:      equ     DISK+7  ; DMA address bits 16-23
(2)       0 : =1                 CMD_READ:       equ     1
(2)       0 : =2                 CMD_WRITE:      equ     2
(1)       0 : =4                 NDISKS: equ     4
(1)       0 :                    ;;; A Disk Parameter Header with the kernel's 16-bit pointers: XLT, three
(1)       0 :                    ;;; scratch words, DIRBUF, DPB, CSV and ALV.
(1)       0 : =10                DPH_SIZE:       equ     16
(1)       0 : =0                 DPH_XLT:        equ     0
(1)       0 : =A                 DPH_DPB:        equ     10
(1)       0 : =7F                ALV_SIZE:       equ     127     ; hd8's 1016 blocks, a bit each
(1)       0 : =10                CSV_SIZE:       equ     16      ; the 8" disk's 64 directory entries
