(1)    74C0 :                    ;;; The trap dispatcher. Each trap pushes its number below what the CPU
(1)    74C0 :                    ;;; pushed, then saves R0-R14 under it and swaps it for the normal R15,
(1)    74C0 :                    ;;; the frame of cpm8000.inc, and calls the exception vector's handler
