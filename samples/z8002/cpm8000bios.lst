(1)    7984 :
(1)    7984 : 00                 iobyte: byte    0
(1)    7985 :                    ;;; The kernel's: the system's segment, 0, and the program's code
(1)    7985 :                    ;;; segment, which map_adr -1 sets.
(1)    7986 :                            align   2
(1)    7986 :                    _sysseg:
(1)    7986 : 0000                       word    0
(1)    7988 : 0000               usrseg: word    0
(1)    798A :                    ;;; The running program's data segment, which the BDOS entry gives its
(1)    798A :                    ;;; parameters.
(1)    798A :                    _usrseg:
(1)    798A : 0000                       word    0
(1)    798C : 0000               gttxt:  word    0
(1)    798E :
(1)    798E :                    ;;; Uninitialised areas: the exception vector, then the BDOS's scratch.
(1)    798E : =798E              bss:    equ     $
(1)    798E : =798E              trapvec:        equ     bss
(1)    798E : =7A4E              dirbuf:         equ     trapvec+NTRAPS*4
(1)    798E : =7ACE              csvs:           equ     dirbuf+128
(1)    798E : =7B0E              alv:            equ     csvs+CSV_SIZE*NDISKS
(1)    798E :                    ;;; The disk's banked DMA target, and a system-segment scratch one sector
(1)    798E :                    ;;; wide that a split program's read and write bounce through.
(1)    798E : =7D0A              dma_off:        equ     alv+ALV_SIZE*NDISKS
(1)    798E : =7D0C              dma_seg:        equ     dma_off+2
(1)    798E : =7D0E              scratch:        equ     dma_seg+2
(1)    798E : =7D8E              bss_end:        equ     scratch+128
(1)    798E :                            end
