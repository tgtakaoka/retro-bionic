(1)     3F2 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     3F2 :                    ;;; Console through the USART's interrupts: received characters queue
(1)     3F2 :                    ;;; at rx_queue, characters to send at tx_queue. The USART interrupts on
(1)     3F2 :                    ;;; VI with identifier RX_ID or TX_ID, which usart.inc defines. The queues
(1)     3F2 :                    ;;; are offsets in the data area DATA.
(1)     3F2 : =2000              rx_queue:       equ     2000H
(1)     3F2 : =80                rx_queue_size:  equ     128
(1)     3F2 : =2080              tx_queue:       equ     2080H
(1)     3F2 : =80                tx_queue_size:  equ     128
(1)     3F2 :
(1)     3F2 :                    ;;; Initialize the queues and the USART
(1)     3F2 :                    ;;; @clobber R0 R1
(1)     3F2 :                    init_io:
(1)     3F2 : 2101 2000                  ld      r1, #rx_queue
(1)     3F6 : C880                       ldb     rl0, #rx_queue_size
(1)     3F8 : 5F00 04FE                  call    queue_init
(1)     3FC : 2101 2080                  ld      r1, #tx_queue
(1)     400 : C880                       ldb     rl0, #tx_queue_size
(1)     402 : 5F00 04FE                  call    queue_init
(1)     406 : 8C88                       clrb    rl0
(1)     408 : 3A86 0141                  outb    USARTC, rl0
(1)     40C : 3A86 0141                  outb    USARTC, rl0
(1)     410 : 3A86 0141                  outb    USARTC, rl0     ; safest way to sync mode
(1)     414 : C840                       ldb     rl0, #CMD_IR_bm
(1)     416 : 3A86 0141                  outb    USARTC, rl0     ; reset
(1)     41A : 8D07                       nop
(1)     41C : 8D07                       nop
(1)     41E : C84E                       ldb     rl0, #ASYNC_MODE
(1)     420 : 3A86 0141                  outb    USARTC, rl0
