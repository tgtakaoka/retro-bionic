(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; Z8002
(1)       0 :                            cpu     z8002
(1)       0 :
(1)       0 :                    ;;; Reset reads the FCW at 0002H and the PC at 0004H, the reset entry of
(1)       0 :                    ;;; a Program Status Area at 0000H.
(1)       0 : =0                 ORG_RESET:      equ     0000H
(1)       0 :                    ;;; Program Status Area offsets: an FCW, then a PC.
(1)       0 : =4                 PSA_EPA:        equ     04H     ; extended instruction trap
(1)       0 : =8                 PSA_PRIV:       equ     08H     ; privileged instruction trap
(1)       0 : =C                 PSA_SC:         equ     0CH     ; system call
(1)       0 : =14                PSA_NMI:        equ     14H     ; non-maskable interrupt
(1)       0 : =18                PSA_NVI:        equ     18H     ; non-vectored interrupt
(1)       0 : =1C                PSA_VI:         equ     1CH     ; vectored interrupt: the FCW, then a PC
(1)       0 :                                                    ; for each identifier from 1EH, the one
(1)       0 :                                                    ; for identifier n at PSA_VI+2+2*n
(1)       0 :                    ;;; Flag and Control Word
(1)       0 : =4000              FCW_SN:         equ     4000H   ; system mode
(1)       0 : =2000              FCW_EPA:        equ     2000H   ; extended processor architecture
(1)       0 : =1000              FCW_VIE:        equ     1000H   ; vectored interrupt enable
(1)       0 : =800               FCW_NVIE:       equ     0800H   ; non-vectored interrupt enable
(1)       0 :
(1)       0 :                    ;;; The data area: queues and variables.
(1)       0 : =4000              DATA:           equ     4000H
(1)       0 :
(1)       0 :                    ;;; SC #SC_EXIT hands control back to the debugger, as a breakpoint does.
(1)       0 : =FF                SC_EXIT:        equ     0FFH
          0 :                            fpu     on
