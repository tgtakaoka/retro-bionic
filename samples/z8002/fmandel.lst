(1)     388 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     388 :                    ;;; Zilog's Z8070 emulator, FPE.O of CP/M-8000, on the bare Z8002: the
(1)     388 :                    ;;; extended instruction trap builds the frame FPE takes at fp_epu, the
(1)     388 :                    ;;; Olivetti M20's, below what the CPU pushed, and what FPE needs of the
(1)     388 :                    ;;; system follows. One address space: the program's addresses are
(1)     388 :                    ;;; FPE's.
(1)     388 :
(1)     388 :                    ;;; The frame: R0-R13, the normal R14 and R15, the trap's identifier
(1)     388 :                    ;;; (the instruction's first word), the FCW, the PC's segment and the PC.
(1)     388 : =0                 FPE_R0:         equ     0
(1)     388 : =1C                FPE_NR14:       equ     28
(1)     388 : =1E                FPE_NR15:       equ     30
(1)     388 : =20                FPE_ID:         equ     32
(1)     388 : =22                FPE_FCW:        equ     34
(1)     388 : =24                FPE_PCSEG:      equ     36
(1)     388 : =26                FPE_PC:         equ     38
(1)     388 : =4                 FPE_CO:         equ     4       ; FPE's stack above the frame: a word and the call
(1)     388 :
(1)     388 :                    fpe_trap:
(1)     388 : 030F 0022                  sub     r15, #FPE_ID+2  ; the CPU's identifier, FCW and PC at FPE_ID+2
(1)     38C : 1CF9 000D                  ldm     @r15, r0, #14
(1)     390 : 6FFE 001C                  ld      FPE_NR14(r15), r14
(1)     394 : 7D07                       ldctl   r0, nsp
(1)     396 : 6FF0 001E                  ld      FPE_NR15(r15), r0
(1)     39A : 61F0 0022                  ld      r0, FPE_ID+2(r15)
(1)     39E : 6FF0 0020                  ld      FPE_ID(r15), r0
(1)     3A2 : 61F0 0024                  ld      r0, FPE_FCW+2(r15)
(1)     3A6 : 6FF0 0022                  ld      FPE_FCW(r15), r0
(1)     3AA : 4DF8 0024                  clr     FPE_PCSEG(r15)
(1)     3AE : 0DF9 0000                  push    @r15, #0
(1)     3B2 : 5F00 59EA                  call    fp_epu          ; runs the instruction, the PC past it
(1)     3B6 : A9F1                       inc     r15, #2
(1)     3B8 : 61F0 0022                  ld      r0, FPE_FCW(r15)
(1)     3BC : 6FF0 0024                  ld      FPE_FCW+2(r15), r0      ; the flags a comparison set
(1)     3C0 : 1CF1 000D                  ldm     r0, @r15, #14
(1)     3C4 : 61FE 001C                  ld      r14, FPE_NR14(r15)
(1)     3C8 : 010F 0022                  add     r15, #FPE_ID+2
(1)     3CC : 7B00                       iret
(1)     3CE :
(1)     3CE :                    ;;; Where the frame keeps R0, the identifier, the FCW and the PC's
(1)     3CE :                    ;;; segment, as offsets from FPE's stack.
(1)     3CE : 0004               stareg:         word    FPE_R0+FPE_CO
(1)     3D0 : 0024               staevnt:        word    FPE_ID+FPE_CO
(1)     3D2 : 0026               stafcw:         word    FPE_FCW+FPE_CO
(1)     3D4 : 0028               stapcsg:        word    FPE_PCSEG+FPE_CO
(1)     3D6 :
(1)     3D6 :                    ;;; R3=the instruction word at R7, the trapped program's PC.
(1)     3D6 :                    gettext:
(1)     3D6 : 2173                       ld      r3, @r7
(1)     3D8 : 8CA8                       clrb    rl2
(1)     3DA : 9E08                       ret
(1)     3DC :
(1)     3DC :                    ;;; R3 bytes from the program's R7 to FPE's R5, and back.
(1)     3DC :                    getmem:
(1)     3DC :                    putmem:
(1)     3DC : 8D34                       test    r3
(1)     3DE : 9E06                       ret     z
(1)     3E0 : 93F3                       push    @r15, r3
(1)     3E2 : 93F5                       push    @r15, r5
(1)     3E4 : 93F7                       push    @r15, r7
(1)     3E6 : BA71 0350                  ldirb   @r5, @r7, r3
(1)     3EA : 97F7                       pop     r7, @r15
(1)     3EC : 97F5                       pop     r5, @r15
(1)     3EE : 97F3                       pop     r3, @r15
(1)     3F0 : 9E08                       ret
