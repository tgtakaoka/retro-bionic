(1)     238 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     238 :                    ;;; samples/arith/fmandel.c in Z8070 instructions, as DRI's C compiles
(1)     238 :                    ;;; it: each sum and product is worked out in double from the float
(1)     238 :                    ;;; variables, then stored as float. Without a Z8070 each instruction
(1)     238 :                    ;;; traps, and Zilog's emulator, FPE.O, runs it.
(1)     238 :
(1)     238 :                    ;;; Print one 79x25 frame of the Mandelbrot set in float: each point is
(1)     238 :                    ;;; its escape iteration in hex, or a space if it does not escape in 16.
(1)     238 :                    ;;; Exits to the debugger when NUL is received.
(1)     238 :                    fmandel:
(1)     238 : 2101 FFF4                  ld      r1, #-12
(1)     23C : 6F01 401C                  ld      vY, r1          ; Y=-12
(1)     240 :                    fmandel_y:
(1)     240 : 2101 FFCF                  ld      r1, #-49
(1)     244 : 6F01 401E                  ld      vX, r1          ; X=-49
(1)     248 :                    fmandel_x:
(1)     248 : 6107 401E                  ld      r7, vX
(1)     24C : B16A                       exts    rr6
(1)     24E : 8F08 8621                  fldil   f0, rr6
(1)     252 : 4F04 70B3 0374             fmuld   dbl f0, kCA
(1)     258 : 4F0C 8001 4000             flds    vCA, f0         ; CA=X*0.0458
(1)     25E : 4F0C 8001 4008             flds    vA, f0          ; A=CA
(1)     264 : 6107 401C                  ld      r7, vY
(1)     268 : B16A                       exts    rr6
(1)     26A : 8F08 8621                  fldil   f0, rr6
(1)     26E : 4F04 70B3 037C             fmuld   dbl f0, kCB
(1)     274 : 4F0C 8001 4004             flds    vCB, f0         ; CB=Y*0.08333
(1)     27A : 4F0C 8001 400C             flds    vB, f0          ; B=CB
(1)     280 : 4D08 4020                  clr     vI              ; I=0
(1)     284 :                    fmandel_i:
(1)     284 : 4F04 8001 4008             flds    f0, vA
(1)     28A : 4F0C 8003 4014             fldd    vT, f0
(1)     290 : 4F04 70B3 4014             fmuld   dbl f0, vT      ; A*A
(1)     296 : 4F04 8201 400C             flds    f2, vB
(1)     29C : 4F0C 8203 4014             fldd    vT, f2
(1)     2A2 : 4F04 72B3 4014             fmuld   dbl f2, vT      ; B*B
(1)     2A8 : 8E04 7290                  fsub    dbl f0, f2
(1)     2AC : 4F04 8201 4000             flds    f2, vCA
(1)     2B2 : 8E04 7280                  fadd    dbl f0, f2
(1)     2B6 : 4F0C 8001 4010             flds    vN, f0          ; N=A*A-B*B+CA
(1)     2BC : 4F04 8001 4008             flds    f0, vA
(1)     2C2 : 8E04 7080                  fadd    dbl f0, f0      ; 2*A
(1)     2C6 : 4F04 8201 400C             flds    f2, vB
(1)     2CC : 8E04 72B0                  fmul    dbl f0, f2
(1)     2D0 : 4F04 8201 4004             flds    f2, vCB
(1)     2D6 : 8E04 7280                  fadd    dbl f0, f2
(1)     2DA : 4F0C 8001 400C             flds    vB, f0          ; B=2*A*B+CB
(1)     2E0 : 4F04 8001 4010             flds    f0, vN
(1)     2E6 : 4F0C 8001 4008             flds    vA, f0          ; A=N
(1)     2EC : 4F0C 8003 4014             fldd    vT, f0
(1)     2F2 : 4F04 70B3 4014             fmuld   dbl f0, vT      ; A*A
(1)     2F8 : 4F04 8201 400C             flds    f2, vB
(1)     2FE : 4F0C 8203 4014             fldd    vT, f2
(1)     304 : 4F04 72B3 4014             fmuld   dbl f2, vT      ; B*B
(1)     30A : 8E04 7280                  fadd    dbl f0, f2
(1)     30E : 4F04 8221 0384             fldil   f2, kFour
(1)     314 : 8E00 4210                  fcpf    f0, f2
(1)     318 : 8E40 C010                  fldctlb fcb4            ; the comparison to the flags
(1)     31C : EA09                       jr      gt, print_i     ; if A*A+B*B>4
(1)     31E : 6900 4020                  inc     vI, #1          ; I+=1
(1)     322 : 6101 4020                  ld      r1, vI
