# Scenario for scripts/record-scenario.py: CP/M-8000 1.2, built on the
# board from P-CP/M-Z8K's sources, on the Z8002: the system loaded from
# the SD card with its disks, then DRI's C compiling, linking and
# running B:IMANDEL.C. The 1.2 CCP echoes each pass ZCC chains to, A>
# and all, so the wait for ZCC3's end starts from an Enter typed while
# it runs, which the CCP reads after it.
#
# Needs the SD card's z8002/pcpm8002.hex, pcpm8002a.dsk and
# pcpm8002b.dsk (make pcpm8000-sd, docs/samples.md).

key ?
pace 2.0

type L
wait Load?
command z8002/pcpm8002.hex
key R
type G
wait backtrace?
type 5\r
waitfor 20 A>
type \r
wait A>
pace 1.5

type DIR B:\r
waitfor 20 A>
type \r
wait A>
pace 1.5
type ZCC -C -M1 B:IMANDEL.C\r
waitfor 600 ZCC3 -M2
type \r
waitfor 600 A>
type \r
wait A>
pace 1.5
type LD8K -W -I -O B:IMANDEL.Z8K STARTUP.O B:IMANDEL.O -LCPM\r
waitfor 600 A>
type \r
wait A>
pace 1.5
type B:IMANDEL\r
waitfor 300 A>
type \r
wait A>
pace 2.0

halt
