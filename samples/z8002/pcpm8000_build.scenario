# Scenario for scripts/record-scenario.py, which pcpm8000-build.py
# bench runs: the 1.1 system, bld8002.hex, loaded from the SD card with
# bld8002a.dsk beside it as A:, the only drive, which holds P-CP/M-Z8K's
# CCP, BDOS and Kontron's Z8002 glue with DRI's compiler and assembler;
# ZCC compiles the C and ASZ8K assembles the glue there, a module at a
# time. 1.1's CCP prints no prompt between the passes ZCC chains to, so
# each wait is for the next A>.
#
# Needs the SD card's z8002/bld8002.hex and bld8002a.dsk, which
# pcpm8000-build.py puts there.

key ?
pace 2.0

# L mounts bld8002a.dsk beside the system as A:, the only drive.
key R
type L
wait Load?
command z8002/bld8002.hex
pace 2.0

# Reset again: the PC comes from the system just loaded.
key R
type G
wait backtrace?
type 5\r
waitfor 30 A>
type DIR\r
waitfor 30 A>

type ZCC -C -M1 CCP.C\r
waitfor 900 A>
type ZCC -C -M1 GO.C\r
waitfor 900 A>
type ZCC -C -M1 BDOSMAIN.C\r
waitfor 900 A>
type ZCC -C -M1 BDOSMISC.C\r
waitfor 900 A>
type ZCC -C -M1 BDOSRW.C\r
waitfor 900 A>
type ZCC -C -M1 CONBDOS.C\r
waitfor 900 A>
type ZCC -C -M1 DSKUTIL.C\r
waitfor 900 A>
type ZCC -C -M1 FILEIO.C\r
waitfor 900 A>
type ZCC -C -M1 IOSYS.C\r
waitfor 900 A>
type ZCC -C -M1 PGMLD.C\r
waitfor 900 A>
type ASZ8K -O CCPIF.O CCPIF.8KN\r
waitfor 900 A>
type ASZ8K -O BDOSIF2.O BDOSIF2.8KN\r
waitfor 900 A>
type ASZ8K -O EXCEPTN2.O EXCEPTN2.8KN\r
waitfor 900 A>

halt
