       9850 :                    ;;; The exception handler, which each entry of the kernel's calr table
       9850 :                    ;;; at excrtn0 reaches: entry k of the table is exception 2+k for k up
       9850 :                    ;;; to 21, and 32+k-22 above. Exceptions 2-11 and 32-39 may be
       9850 :                    ;;; redirected to a program's handler through the BDOS's 18 vectors at
       9850 :                    ;;; evec_adr; the rest print the exception and warm boot. Replaces
       9850 :                    ;;; except to sysexc, before print; the link keeps _bios5 and print out
       9850 :                    ;;; of the patches' reach.
