       8450 :                    ;;; The exception handler, which each entry of the kernel's calr table
       8450 :                    ;;; at excrtn0 reaches: entry k of the table is exception 2+k for k up
       8450 :                    ;;; to 21, and 32+k-22 above. Exceptions 2-11 and 32-39 may be
       8450 :                    ;;; redirected to a program's handler through the BDOS's 18 vectors at
       8450 :                    ;;; evec_adr; the rest print the exception and warm boot. Replaces
       8450 :                    ;;; except to sysexc, before print; the link keeps _bios5 and print out
       8450 :                    ;;; of the patches' reach.
