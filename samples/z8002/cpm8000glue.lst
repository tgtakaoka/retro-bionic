       99AA : E102                       jr      lt, exc_default
       99AC : 0101 0030                  add     r1, #4*12
       99B0 :                    exc_default:
       99B0 : B311 FFFE                  srl     r1, #2
       99B4 : 0101 0002                  add     r1, #2          ; the exception number
       99B8 : 0B01 0017                  cp      r1, #23
