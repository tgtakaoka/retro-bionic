          0 : =32                BIOSF:          equ     50      ; BDOS 50: direct BIOS call
          0 : =3E                SETSUPF:        equ     62      ; BDOS 62: set system mode
          0 :
          0 :                    ;;; The BDOS entry, SC #2's handler through the BIOS's exception vector:
          0 :                    ;;; R5 the function, RR6 the parameter, which for a program running
          0 :                    ;;; split gets the data segment; the result goes back in the caller's R7.
          0 :                    ;;; Replaces _traphnd to set_sup.
       8400 :                            org     _traphnd
       8400 : 0B05 003E                  cp      r5, #SETSUPF
       8404 : E61F                       jr      eq, set_sup
       8406 : 0B05 0032                  cp      r5, #BIOSF
       840A : E616                       jr      eq, bios_call
       840C : 9462                       ldl     rr2, rr6
       840E : 61F0 0024                  ld      r0, FR_FCW+CO(r15)
       8412 : A70E                       bit     r0, #14         ; a system caller's address is physical
