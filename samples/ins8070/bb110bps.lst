          0 :                            cpu     8070
          0 :
          0 : =48                COLD4   =       X'0048
          0 : =FD00              BAUDFLG =       X'FD00
          0 :
          0 :                    ;;; Baudrate flag
       FD00 :                            .=      BAUDFLG
       FD00 :                            ;; bit7: 0=external, 1=internal (#F1/SA)
       FD00 :                            ;; bit2-1: 0=4800bps, 1=1200bps, 2=300bps, 3=110bps
       FD00 : 86                         .byte   (1 << 7) | (3 << 1)
       FD01 :
       FD01 :                    ;;; Override RAM end check: just below the ACIA. BASIC starts the
       FD01 :                    ;;; program at 8000H when it finds RAM there, as the debugger has.
         48 :                            .=      COLD4
         48 : 26 FF DE                   ld      P2, =X'DEFF
         4B : C6 02                      ld      A, @2, P2
