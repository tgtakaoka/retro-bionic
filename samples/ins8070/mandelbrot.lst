(1)    10A4 :                    ;;; Signed comparison: minuend - subtrahend
(1)    10A4 :                    ;;; @param EA minuend
(1)    10A4 :                    ;;; @param T  subtrahend
(1)    10A4 :                    ;;; @return A=0  BZ (minuend == subtrahend)
(1)    10A4 :                    ;;;         A=1  BP (minuend > subtrahend)
(1)    10A4 :                    ;;;         A=-1    (minuend < subtrahend)
(1)    10A4 :                    ;;; @clobber EA
(1)    10A4 :                    cmpsi2:
