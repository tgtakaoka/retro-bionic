(1)    1108 : 38                         pop     A               ; A=sign(quotient)
(1)    1109 : 64 07                      bp      divsi2_exit
(1)    110B : 84 00 00                   ld      EA, =0
(1)    110E : B9 02                      sub     EA, 2, SP       ; negate quotient
(1)    1110 : 89 02                      st      EA, 2, SP       ; store quotient
(1)    1112 :                    divsi2_exit:
(1)    1112 : 3A                         pop     EA
(1)    1113 : 09                         ld      T, EA           ; T=|divisor|
(1)    1114 : 3A                         pop     EA              ; EA=quotient
(1)    1115 : 5C                         ret
