(1)    10C7 :                    ;;; Signed multiplication: product = multiplicand * multiplier
(1)    10C7 :                    ;;; MPY takes only a non-negative multiplier; a negative one is negated
(1)    10C7 :                    ;;; with the multiplicand, which leaves the 16-bit product unchanged.
(1)    10C7 :                    ;;; @param EA: multiplicand
(1)    10C7 :                    ;;; @param T: multiplier
(1)    10C7 :                    ;;; @return EA: product
(1)    10C7 :                    ;;; @local SP[3:2] multiplicand
(1)    10C7 :                    ;;; @local SP[1:0] multiplier
(1)    10C7 :                    ;;; @discard T
(1)    10C7 :                    mulsi2:
(1)    10C7 : 08                         push    EA             ; save multiplicand
(1)    10C8 : 0B                         ld      EA, T          ; EA=multiplier
(1)    10C9 : 08                         push    EA             ; save multiplier
(1)    10CA : 40                         ld      A, E           ; A=high(multiplier)
(1)    10CB : 64 0E                      bp      mulsi2_multiply ; branch if multiplier >= 0
(1)    10CD : 84 00 00                   ld      EA, =0
(1)    10D0 : B9 00                      sub     EA, 0, SP
(1)    10D2 : 89 00                      st      EA, 0, SP       ; negate multiplier
(1)    10D4 : 84 00 00                   ld      EA, =0
(1)    10D7 : B9 02                      sub     EA, 2, SP
(1)    10D9 : 89 02                      st      EA, 2, SP       ; negate multiplicand
(1)    10DB :                    mulsi2_multiply:
(1)    10DB : 81 02                      ld      EA, 2, SP       ; EA=multiplicand
(1)    10DD : A1 00                      ld      T, 0, SP        ; T=multiplier
(1)    10DF : 2C                         mpy     EA, T           ; T=product
(1)    10E0 : 3A                         pop     EA
(1)    10E1 : 3A                         pop     EA              ; discard locals
(1)    10E2 : 0B                         ld      EA, T           ; EA=product
(1)    10E3 : 5C                         ret
(1)    10E4 :
(1)    10E4 :                    ;;; Signed division: quotient = dividend / divisor
(1)    10E4 :                    ;;; @param EA: dividend
(1)    10E4 :                    ;;; @param T: divisor
(1)    10E4 :                    ;;; @return EA: quotient
(1)    10E4 :                    ;;; @discard T
(1)    10E4 :                    ;;; @local SP[4:3] dividend
(1)    10E4 :                    ;;; @local SP[2:1] divisor
(1)    10E4 :                    ;;; @local SP[0] sign(quotient)
(1)    10E4 :                    divsi2:
(1)    10E4 : 08                         push    EA              ; save dividend
(1)    10E5 : 0B                         ld      EA, T           ; EA=divisor
(1)    10E6 : 08                         push    EA              ; save divisor
(1)    10E7 : 40                         ld      A, E            ; A=high(divisor)
(1)    10E8 : E1 03                      xor     A, 3, SP        ; A=sign(quotient)
(1)    10EA : 0A                         push    A               ; save sign(quotient)
(1)    10EB : C1 02                      ld      A, 2, SP        ; A=high(divisor)
