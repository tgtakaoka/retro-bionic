(1)    10EF : 84 00 00                   ld      EA, =0
(1)    10F2 : B9 01                      sub     EA, 1, SP
(1)    10F4 : 89 01                      st      EA, 1, SP       ; negate divisor
(1)    10F6 :                    divsi2_dividend:
(1)    10F6 : C1 04                      ld      A, 4, SP        ; A=high(dividend)
(1)    10F8 : 64 07                      bp      divsi2_divide
(1)    10FA : 84 00 00                   ld      EA, =0
(1)    10FD : B9 03                      sub     EA, 3, SP
(1)    10FF : 89 03                      st      EA, 3, SP       ; negate dividend
(1)    1101 :                    divsi2_divide:
(1)    1101 : 81 03                      ld      EA, 3, SP       ; EA=|dividend|
(1)    1103 : A1 01                      ld      T, 1, SP        ; T=|divisor|
(1)    1105 : 0D                         div     EA, T           ; EA=quotient
