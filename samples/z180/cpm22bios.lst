(1)    FB85 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)    FB85 :                    ;;; Reads C sectors of drive A's system tracks into HL, from track 0
(1)    FB85 :                    ;;; sector 2, past the boot sector. Z when all were read, NZ on an error.
(1)    FB85 :                    ;;; 8080 instructions only.
(1)    FB85 :                    load_system:
(1)    FB85 : AF                         xra     a
(1)    FB86 : CD D3 FB                   call    disk_drive
(1)    FB89 : CD D9 FB                   call    disk_track
(1)    FB8C : 06 02                      mvi     b, 2
(1)    FB8E :                    load_sector:
(1)    FB8E : 78                         mov     a, b
(1)    FB8F : CD DF FB                   call    disk_sector
(1)    FB92 : 7D                         mov     a, l
