          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                    ;;; CP/M 2.2 BIOS on 16-bit ports, for the Z180, Z280 and Z380.
          0 :                            cpu     8080
          0 :                            include "../i8080/cpm22.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :
(1)       0 :                    ;;; CP/M 2.2 in 64K on 8" single-sided single-density disks: 77 tracks of
(1)       0 :                    ;;; 26 sectors of 128 bytes. The system tracks 0 and 1 hold the boot
(1)       0 :                    ;;; sector, then CCP and BDOS, then the BIOS.
(1)       0 : =40                MSIZE:  equ     64
(1)       0 : =E400              CCP:    equ     (MSIZE-7)*1024  ; E400
(1)       0 : =EC00              BDOS:   equ     CCP+0800H       ; EC00
(1)       0 : =FA00              BIOS:   equ     CCP+1600H       ; FA00
(1)       0 : =3                 IOBYTE: equ     0003H
(1)       0 : =4                 TDRIVE: equ     0004H           ; current drive and user
(1)       0 : =1A                SPT:    equ     26              ; sectors a track
(1)       0 : =2C                CCP_SECTORS:    equ     (BIOS-CCP)/128          ; 44
(1)       0 : =7                 BIOS_SECTORS:   equ     2*SPT-1-CCP_SECTORS     ; 7, to the end of track 1
(1)       0 : =4                 NDISKS: equ     4
(1)       0 :
(1)       0 :                    ;;; The BIOS's scratch areas, past it on the system tracks.
(1)    FD80 :                            org     BIOS+BIOS_SECTORS*128
(1)    FD80 :                    dirbuf: ds      128
(1)    FE00 :                    csv:    ds      16*NDISKS
(1)    FE40 :                    alv:    ds      31*NDISKS
       FEBC :
       FA00 :                            org     BIOS
       FA00 :                            include "../i8080/cpm22bios.inc"
(1)    FA00 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)    FA00 :                    ;;; CP/M 2.2 BIOS: the console on the i8251 USART and four drives on the
(1)    FA00 :                    ;;; debugger's sector disk. 8080 instructions only. The harness puts it at
(1)    FA00 :                    ;;; BIOS and supplies the port routines con_* and disk_*, which keep every
(1)    FA00 :                    ;;; register but A and the flags; the image builder puts it on the system
(1)    FA00 :                    ;;; tracks after CCP and BDOS.
(1)    FA00 :                            cpu     8080
(1)    FA00 :
(1)    FA00 : C3 44 FA                   jmp     boot
(1)    FA03 : C3 5A FA           wboote: jmp     wboot
(1)    FA06 : C3 AD FA                   jmp     const
(1)    FA09 : C3 B6 FA                   jmp     conin
(1)    FA0C : C3 C2 FA                   jmp     conout
