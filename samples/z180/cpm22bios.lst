(1)    FB36 :
(1)    FB36 :                    ;;; 8" single-density disk parameters: 1K blocks, 243 of them, 64
(1)    FB36 :                    ;;; directory entries, 2 system tracks.
(1)    FB36 :                    dpb:
(1)    FB36 : 1A 00                      dw      SPT             ; SPT, sectors a track
(1)    FB38 : 03                         db      3               ; BSH, block shift
(1)    FB39 : 07                         db      7               ; BLM, block mask
(1)    FB3A : 00                         db      0               ; EXM, extent mask
(1)    FB3B : F2 00                      dw      242             ; DSM, last block
(1)    FB3D : 3F 00                      dw      63              ; DRM, last directory entry
(1)    FB3F : C0                         db      0C0H            ; AL0, the directory's blocks
(1)    FB40 : 00                         db      0               ; AL1
(1)    FB41 : 10 00                      dw      16              ; CKS, directory check size
(1)    FB43 : 02 00                      dw      2               ; OFF, system tracks
