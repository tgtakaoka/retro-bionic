       FBBB :                            include "cpm22io.inc"
(1)    FBBB :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)    FBBB :                    ;;; CP/M's port routines on 16-bit I/O addresses: the i8251 at 0140H and
(1)    FBBB :                    ;;; the sector disk at 0150H, clear of the on-chip I/O. Each keeps every
(1)    FBBB :                    ;;; register but A and the flags. Z180, Z280 and Z380.
(1)    FBBB :                            include "usart.inc"
(2)    FBBB :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)    FBBB :                    ;;; i8251 Universal Synchronous/Asynchronous Receiver/Transmitter
(2)    FBBB : =140               USART:  equ     0140H           ; A8-A15 nonzero: clear of on-chip I/O
(2)    FBBB : =140               USARTD: equ     USART+0         ; Data register
(2)    FBBB : =141               USARTS: equ     USART+1         ; Status register
(2)    FBBB : =141               USARTC: equ     USART+1         ; Control register
(2)    FBBB : =142               USARTRV:        equ     USART+2 ; Receive interrupt vector (ORG_*)
(2)    FBBB : =143               USARTTV:        equ     USART+3 ; Transmit interrupt vector (ORG_*)
(2)    FBBB :                            include "../z80/i8251.inc"
(3)    FBBB :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(3)    FBBB :
(3)    FBBB :                    ;;; i8251 USART device emulator.
(3)    FBBB :                    ;;; Bit definition of mode register
(3)    FBBB : =6                 MODE_STOP_gp:   equ     6
(3)    FBBB : =C0                MODE_STOP_gm:   equ     11000000B
(3)    FBBB : =40                MODE_STOP1_gc:  equ     (1 << MODE_STOP_gp)
(3)    FBBB : =80                MODE_STOP15_gc: equ     (2 << MODE_STOP_gp)
(3)    FBBB : =C0                MODE_STOP2_gc:  equ     (3 << MODE_STOP_gp)
(3)    FBBB : =20                MODE_EVEN_bm:   equ     00100000B
(3)    FBBB : =10                MODE_PARITY_bm: equ     00010000B
(3)    FBBB : =2                 MODE_LEN_gp:    equ     2
(3)    FBBB : =C                 MODE_LEN_gm:    equ     00001100B
(3)    FBBB : =0                 MODE_LEN5_gc:   equ     (0 << MODE_LEN_gp)
(3)    FBBB : =4                 MODE_LEN6_gc:   equ     (1 << MODE_LEN_gp)
(3)    FBBB : =8                 MODE_LEN7_gc:   equ     (2 << MODE_LEN_gp)
(3)    FBBB : =C                 MODE_LEN8_gc:   equ     (3 << MODE_LEN_gp)
(3)    FBBB : =0                 MODE_BAUD_gp:   equ     0
(3)    FBBB : =3                 MODE_BAUD_gm:   equ     00000011B
(3)    FBBB : =1                 MODE_BAUD_X1:   equ     (1 << MODE_BAUD_gp)
(3)    FBBB : =2                 MODE_BAUD_X16:  equ (2 << MODE_BAUD_gp)
(3)    FBBB : =3                 MODE_BAUD_X64:  equ (3 << MODE_BAUD_gp)
(3)    FBBB :                    ;;; Bit Definition of command register
(3)    FBBB : =80                CMD_EH_bm:      equ     10000000B   ; Enter hunt mode
(3)    FBBB : =40                CMD_IR_bm:      equ     01000000B   ; Internal Reset
(3)    FBBB : =20                CMD_RTS_bm:     equ     00100000B   ; Request To Send
(3)    FBBB : =10                CMD_ER_bm:      equ     00010000B   ; Error Reset
(3)    FBBB : =8                 CMD_SBRK_bm:    equ     00001000B   ; Send Break
(3)    FBBB : =4                 CMD_RxEN_bm:    equ     00000100B   ; Receive Enable
(3)    FBBB : =2                 CMD_DTR_bm:     equ     00000010B   ; Data Terminal Ready
(3)    FBBB : =1                 CMD_TxEN_bm:    equ     00000001B   ; Transmit enable
(3)    FBBB :
(3)    FBBB :                    ;;; Bit definition of status register
(3)    FBBB : =80                ST_DSR_bm:      equ     10000000B   ; Data Set Ready
(3)    FBBB : =40                ST_BRK_bm:      equ     01000000B   ; BREAK detected
(3)    FBBB : =20                ST_FE_bm:       equ     00100000B   ; Framing Error
(3)    FBBB : =10                ST_OE_bm:       equ     00010000B   ; Overrun Error
(3)    FBBB : =8                 ST_PE_bm:       equ     00001000B   ; Parity Error
(3)    FBBB : =2                 ST_TxEMPTY_bp:  equ     2           ; Transmitter empty
(3)    FBBB : =1                 ST_RxRDY_bp:    equ     1           ; Receiver ready
(3)    FBBB : =0                 ST_TxRDY_bp:    equ     0           ; Transmitter ready
(2)    FBBB :                    ;;; Async 1stop 8data x16
(2)    FBBB : =4E                ASYNC_MODE:     equ     MODE_STOP1_gc|MODE_LEN8_gc|MODE_BAUD_X16
(2)    FBBB :                    ;;; RTS/DTR, error reset, Rx enable, Tx enable
(2)    FBBB : =37                RX_EN_TX_EN:    equ     CMD_RTS_bm|CMD_DTR_bm|CMD_ER_bm|CMD_RxEN_bm|CMD_TxEN_bm
(2)    FBBB : =36                RX_EN_TX_DIS:   equ     CMD_RTS_bm|CMD_DTR_bm|CMD_ER_bm|CMD_RxEN_bm
(1)    FBBB : =2                 ST_RxRDY_bm:    equ     1 << ST_RxRDY_bp
(1)    FBBB : =1                 ST_TxRDY_bm:    equ     1 << ST_TxRDY_bp
(1)    FBBB : =150               DISK:   equ     0150H
(1)    FBBB :                            include "../i8080/sector_disk.inc"
(2)    FBBB :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)    FBBB :
(2)    FBBB :                    ;;; The debugger's paravirtual sector disk (debugger/sector_disk.h).
(2)    FBBB :                    ;;; DISK is its base port.
(2)    FBBB : =150               DISK_DRIVE:     equ     DISK+0  ; 0-3
(2)    FBBB : =151               DISK_TRACK:     equ     DISK+1  ; 0-76
(2)    FBBB : =152               DISK_SECTOR:    equ     DISK+2  ; 1-26, physical
(2)    FBBB : =153               DISK_DMAL:      equ     DISK+3  ; DMA address, low byte
(2)    FBBB : =154               DISK_DMAH:      equ     DISK+4  ; high byte
(2)    FBBB : =155               DISK_COMMAND:   equ     DISK+5  ; write a command, read its status
(2)    FBBB : =156               DISK_MOUNTED:   equ     DISK+6  ; bit n: drive n has its image
(2)    FBBB : =1                 CMD_READ:       equ     1
(2)    FBBB : =2                 CMD_WRITE:      equ     2
(1)    FBBB :
