(1)    FBCD :                    con_control:
(1)    FBCD : C5                         push    BC
(1)    FBCE : 01 41 01                   ld      BC, USARTC
(1)    FBD1 : 18 32                      jr      port_out
(1)    FBD3 :                    disk_drive:
(1)    FBD3 : C5                         push    BC
(1)    FBD4 : 01 50 01                   ld      BC, DISK_DRIVE
(1)    FBD7 : 18 2C                      jr      port_out
(1)    FBD9 :                    disk_track:
