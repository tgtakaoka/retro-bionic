(1)    FB3E : EB                         xchg
(1)    FB3F : 09                         dad     b
(1)    FB40 : 6E                         mov     l, m
(1)    FB41 : 26 00                      mvi     h, 0
(1)    FB43 : C9                         ret
(1)    FB44 :
(1)    FB44 :                    ;;; Skew 6, the 8" standard of DRI's skeletal CBIOS.ASM.
(1)    FB44 :                    xlt:
(1)    FB44 : 01 07 0D 13 19 05          db      1, 7, 13, 19, 25, 5, 11, 17, 23, 3, 9, 15, 21
       FB4A : 0B 11 17 03 09 0F
       FB50 : 15
(1)    FB51 : 02 08 0E 14 1A 06          db      2, 8, 14, 20, 26, 6, 12, 18, 24, 4, 10, 16, 22
       FB57 : 0C 12 18 04 0A 10
       FB5D : 16
(1)    FB5E :
(1)    FB5E :                    ;;; 8" single-density disk parameters: 1K blocks, 243 of them, 64
(1)    FB5E :                    ;;; directory entries, 2 system tracks.
(1)    FB5E :                    dpb:
(1)    FB5E : 1A 00                      dw      SPT             ; SPT, sectors a track
(1)    FB60 : 03                         db      3               ; BSH, block shift
(1)    FB61 : 07                         db      7               ; BLM, block mask
(1)    FB62 : 00                         db      0               ; EXM, extent mask
(1)    FB63 : F2 00                      dw      242             ; DSM, last block
(1)    FB65 : 3F 00                      dw      63              ; DRM, last directory entry
(1)    FB67 : C0                         db      0C0H            ; AL0, the directory's blocks
(1)    FB68 : 00                         db      0               ; AL1
(1)    FB69 : 10 00                      dw      16              ; CKS, directory check size
(1)    FB6B : 02 00                      dw      2               ; OFF, system tracks
(1)    FB6D :
(1)    FB6D :                    ;;; hd8, 8 MB: 256 tracks of 256 sectors from 0, 8K blocks, 1016 of them,
(1)    FB6D :                    ;;; 1024 directory entries, 2 system tracks. Every CP/M shares it.
(1)    FB6D :                    dpb_hd8:
(1)    FB6D : 00 01                      dw      256             ; SPT
(1)    FB6F : 06                         db      6               ; BSH
(1)    FB70 : 3F                         db      63              ; BLM
(1)    FB71 : 03                         db      3               ; EXM
(1)    FB72 : F7 03                      dw      1015            ; DSM
(1)    FB74 : FF 03                      dw      1023            ; DRM
(1)    FB76 : F0                         db      0F0H            ; AL0
(1)    FB77 : 00                         db      0               ; AL1
(1)    FB78 : 00 00                      dw      0               ; CKS: fixed
(1)    FB7A : 02 00                      dw      2               ; OFF
(1)    FB7C :
