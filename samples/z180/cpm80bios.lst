(1)    FB7C : 44 FB 00 00 00 00  dph0:   dw      xlt, 0, 0, 0, dirbuf, dpb, csv+16*0, alv+ALV_BYTES*0
       FB82 : 00 00 43 FD 5E FB
       FB88 : C3 FD 03 FE
(1)    FB8C : 44 FB 00 00 00 00          dw      xlt, 0, 0, 0, dirbuf, dpb, csv+16*1, alv+ALV_BYTES*1
       FB92 : 00 00 43 FD 5E FB
       FB98 : D3 FD 82 FE
(1)    FB9C : 44 FB 00 00 00 00          dw      xlt, 0, 0, 0, dirbuf, dpb, csv+16*2, alv+ALV_BYTES*2
       FBA2 : 00 00 43 FD 5E FB
       FBA8 : E3 FD 01 FF
(1)    FBAC : 44 FB 00 00 00 00          dw      xlt, 0, 0, 0, dirbuf, dpb, csv+16*3, alv+ALV_BYTES*3
       FBB2 : 00 00 43 FD 5E FB
       FBB8 : F3 FD 80 FF
