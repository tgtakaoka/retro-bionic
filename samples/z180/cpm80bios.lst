(1)    FAFC : 69                         mov     l, c                    ; HL=C*16
(1)    FAFD : 29                         dad     h
(1)    FAFE : 29                         dad     h
(1)    FAFF : 29                         dad     h
(1)    FB00 : 29                         dad     h
(1)    FB01 : 11 7C FB                   lxi     d, dph0
(1)    FB04 : 19                         dad     d
(1)    FB05 :                    ;;; The drive's format picks its skew table and DPB.
(1)    FB05 : CD 3A FC                   call    disk_format
(1)    FB08 : E6 F0                      ani     0F0H                    ; the format's index
(1)    FB0A : 11 44 FB                   lxi     d, xlt
