(1)    FBC5 : 78                         mov     a, b
(1)    FBC6 : CD 16 FC                   call    disk_sector
(1)    FBC9 : 7D                         mov     a, l
(1)    FBCA : CD 1C FC                   call    disk_dmal
(1)    FBCD : 7C                         mov     a, h
(1)    FBCE : CD 22 FC                   call    disk_dmah
(1)    FBD1 : 3E 01                      mvi     a, CMD_READ
(1)    FBD3 : CD 28 FC                   call    disk_command
(1)    FBD6 : CD 2E FC                   call    disk_status
(1)    FBD9 : B7                         ora     a
(1)    FBDA : C0                         rnz
(1)    FBDB : 11 80 00                   lxi     d, 128
(1)    FBDE : 19                         dad     d
(1)    FBDF : 04                         inr     b
(1)    FBE0 : 78                         mov     a, b
(1)    FBE1 : FE 1B                      cpi     SPT+1
(1)    FBE3 : DA ED FB                   jc      load_count
(1)    FBE6 : 06 01                      mvi     b, 1                    ; on to track 1
(1)    FBE8 : 3E 01                      mvi     a, 1
(1)    FBEA : CD 10 FC                   call    disk_track
(1)    FBED :                    load_count:
(1)    FBED : 0D                         dcr     c
(1)    FBEE : C2 C5 FB                   jnz     load_sector
(1)    FBF1 : C9                         ret
       FBF2 :                            include "cpm80io.inc"
(1)    FBF2 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)    FBF2 :                    ;;; CP/M's port routines on 16-bit I/O addresses: the i8251 at 0140H and
(1)    FBF2 :                    ;;; the sector disk at 0150H, clear of the on-chip I/O. Each keeps every
(1)    FBF2 :                    ;;; register but A and the flags. Z180, Z280 and Z380.
(1)    FBF2 :                            include "usart.inc"
(2)    FBF2 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)    FBF2 :                    ;;; i8251 Universal Synchronous/Asynchronous Receiver/Transmitter
(2)    FBF2 : =140               USART:  equ     0140H           ; A8-A15 nonzero: clear of on-chip I/O
(2)    FBF2 : =140               USARTD: equ     USART+0         ; Data register
(2)    FBF2 : =141               USARTS: equ     USART+1         ; Status register
(2)    FBF2 : =141               USARTC: equ     USART+1         ; Control register
(2)    FBF2 : =142               USARTRV:        equ     USART+2 ; Receive interrupt vector (ORG_*)
(2)    FBF2 : =143               USARTTV:        equ     USART+3 ; Transmit interrupt vector (ORG_*)
(2)    FBF2 :                            include "../z80/i8251.inc"
(3)    FBF2 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(3)    FBF2 :
(3)    FBF2 :                    ;;; i8251 USART device emulator.
(3)    FBF2 :                    ;;; Bit definition of mode register
(3)    FBF2 : =6                 MODE_STOP_gp:   equ     6
(3)    FBF2 : =C0                MODE_STOP_gm:   equ     11000000B
(3)    FBF2 : =40                MODE_STOP1_gc:  equ     (1 << MODE_STOP_gp)
(3)    FBF2 : =80                MODE_STOP15_gc: equ     (2 << MODE_STOP_gp)
(3)    FBF2 : =C0                MODE_STOP2_gc:  equ     (3 << MODE_STOP_gp)
(3)    FBF2 : =20                MODE_EVEN_bm:   equ     00100000B
(3)    FBF2 : =10                MODE_PARITY_bm: equ     00010000B
(3)    FBF2 : =2                 MODE_LEN_gp:    equ     2
(3)    FBF2 : =C                 MODE_LEN_gm:    equ     00001100B
(3)    FBF2 : =0                 MODE_LEN5_gc:   equ     (0 << MODE_LEN_gp)
(3)    FBF2 : =4                 MODE_LEN6_gc:   equ     (1 << MODE_LEN_gp)
(3)    FBF2 : =8                 MODE_LEN7_gc:   equ     (2 << MODE_LEN_gp)
(3)    FBF2 : =C                 MODE_LEN8_gc:   equ     (3 << MODE_LEN_gp)
(3)    FBF2 : =0                 MODE_BAUD_gp:   equ     0
(3)    FBF2 : =3                 MODE_BAUD_gm:   equ     00000011B
(3)    FBF2 : =1                 MODE_BAUD_X1:   equ     (1 << MODE_BAUD_gp)
(3)    FBF2 : =2                 MODE_BAUD_X16:  equ (2 << MODE_BAUD_gp)
(3)    FBF2 : =3                 MODE_BAUD_X64:  equ (3 << MODE_BAUD_gp)
(3)    FBF2 :                    ;;; Bit Definition of command register
(3)    FBF2 : =80                CMD_EH_bm:      equ     10000000B   ; Enter hunt mode
(3)    FBF2 : =40                CMD_IR_bm:      equ     01000000B   ; Internal Reset
(3)    FBF2 : =20                CMD_RTS_bm:     equ     00100000B   ; Request To Send
(3)    FBF2 : =10                CMD_ER_bm:      equ     00010000B   ; Error Reset
(3)    FBF2 : =8                 CMD_SBRK_bm:    equ     00001000B   ; Send Break
(3)    FBF2 : =4                 CMD_RxEN_bm:    equ     00000100B   ; Receive Enable
(3)    FBF2 : =2                 CMD_DTR_bm:     equ     00000010B   ; Data Terminal Ready
(3)    FBF2 : =1                 CMD_TxEN_bm:    equ     00000001B   ; Transmit enable
(3)    FBF2 :
(3)    FBF2 :                    ;;; Bit definition of status register
(3)    FBF2 : =80                ST_DSR_bm:      equ     10000000B   ; Data Set Ready
(3)    FBF2 : =40                ST_BRK_bm:      equ     01000000B   ; BREAK detected
(3)    FBF2 : =20                ST_FE_bm:       equ     00100000B   ; Framing Error
(3)    FBF2 : =10                ST_OE_bm:       equ     00010000B   ; Overrun Error
(3)    FBF2 : =8                 ST_PE_bm:       equ     00001000B   ; Parity Error
(3)    FBF2 : =2                 ST_TxEMPTY_bp:  equ     2           ; Transmitter empty
(3)    FBF2 : =1                 ST_RxRDY_bp:    equ     1           ; Receiver ready
(3)    FBF2 : =0                 ST_TxRDY_bp:    equ     0           ; Transmitter ready
(2)    FBF2 :                    ;;; Async 1stop 8data x16
(2)    FBF2 : =4E                ASYNC_MODE:     equ     MODE_STOP1_gc|MODE_LEN8_gc|MODE_BAUD_X16
(2)    FBF2 :                    ;;; RTS/DTR, error reset, Rx enable, Tx enable
(2)    FBF2 : =37                RX_EN_TX_EN:    equ     CMD_RTS_bm|CMD_DTR_bm|CMD_ER_bm|CMD_RxEN_bm|CMD_TxEN_bm
(2)    FBF2 : =36                RX_EN_TX_DIS:   equ     CMD_RTS_bm|CMD_DTR_bm|CMD_ER_bm|CMD_RxEN_bm
(1)    FBF2 : =2                 ST_RxRDY_bm:    equ     1 << ST_RxRDY_bp
(1)    FBF2 : =1                 ST_TxRDY_bm:    equ     1 << ST_TxRDY_bp
(1)    FBF2 : =150               DISK:   equ     0150H
(1)    FBF2 :                            include "../i8080/sector_disk.inc"
(2)    FBF2 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)    FBF2 :
(2)    FBF2 :                    ;;; The debugger's paravirtual sector disk (debugger/sector_disk.h).
(2)    FBF2 :                    ;;; DISK is its base port.
(2)    FBF2 : =150               DISK_DRIVE:     equ     DISK+0  ; 0-3
(2)    FBF2 : =151               DISK_TRACK:     equ     DISK+1  ; 0-76
(2)    FBF2 : =152               DISK_SECTOR:    equ     DISK+2  ; 1-26, physical
(2)    FBF2 : =153               DISK_DMAL:      equ     DISK+3  ; DMA address, low byte
(2)    FBF2 : =154               DISK_DMAH:      equ     DISK+4  ; high byte
(2)    FBF2 : =155               DISK_COMMAND:   equ     DISK+5  ; write a command, read its status
(2)    FBF2 : =156               DISK_MOUNTED:   equ     DISK+6  ; bit n: drive n has its image
(2)    FBF2 : =157               DISK_DMAX:      equ     DISK+7  ; DMA address bits 16-23
(2)    FBF2 : =1                 CMD_READ:       equ     1
(2)    FBF2 : =2                 CMD_WRITE:      equ     2
(1)    FBF2 :
(1)    FBF2 :                            cpu     z80
(1)    FBF2 :                    con_status:
(1)    FBF2 : C5                         push    BC
(1)    FBF3 : 01 41 01                   ld      BC, USARTS
(1)    FBF6 : 18 46                      jr      port_in
(1)    FBF8 :                    con_in:
(1)    FBF8 : C5                         push    BC
(1)    FBF9 : 01 40 01                   ld      BC, USARTD
(1)    FBFC : 18 40                      jr      port_in
(1)    FBFE :                    con_out:
(1)    FBFE : C5                         push    BC
(1)    FBFF : 01 40 01                   ld      BC, USARTD
(1)    FC02 : 18 3E                      jr      port_out
(1)    FC04 :                    con_control:
(1)    FC04 : C5                         push    BC
(1)    FC05 : 01 41 01                   ld      BC, USARTC
(1)    FC08 : 18 38                      jr      port_out
(1)    FC0A :                    disk_drive:
(1)    FC0A : C5                         push    BC
(1)    FC0B : 01 50 01                   ld      BC, DISK_DRIVE
(1)    FC0E : 18 32                      jr      port_out
(1)    FC10 :                    disk_track:
(1)    FC10 : C5                         push    BC
(1)    FC11 : 01 51 01                   ld      BC, DISK_TRACK
(1)    FC14 : 18 2C                      jr      port_out
(1)    FC16 :                    disk_sector:
(1)    FC16 : C5                         push    BC
(1)    FC17 : 01 52 01                   ld      BC, DISK_SECTOR
(1)    FC1A : 18 26                      jr      port_out
(1)    FC1C :                    disk_dmal:
(1)    FC1C : C5                         push    BC
(1)    FC1D : 01 53 01                   ld      BC, DISK_DMAL
(1)    FC20 : 18 20                      jr      port_out
(1)    FC22 :                    disk_dmah:
(1)    FC22 : C5                         push    BC
(1)    FC23 : 01 54 01                   ld      BC, DISK_DMAH
(1)    FC26 : 18 1A                      jr      port_out
(1)    FC28 :                    disk_command:
(1)    FC28 : C5                         push    BC
(1)    FC29 : 01 55 01                   ld      BC, DISK_COMMAND
(1)    FC2C : 18 14                      jr      port_out
(1)    FC2E :                    disk_status:
(1)    FC2E : C5                         push    BC
(1)    FC2F : 01 55 01                   ld      BC, DISK_COMMAND
(1)    FC32 : 18 0A                      jr      port_in
(1)    FC34 :                    disk_mounted:
(1)    FC34 : C5                         push    BC
(1)    FC35 : 01 56 01                   ld      BC, DISK_MOUNTED
(1)    FC38 : 18 04                      jr      port_in
(1)    FC3A :                    disk_format:
(1)    FC3A : C5                         push    BC
(1)    FC3B : 01 50 01                   ld      BC, DISK_DRIVE          ; the format's index in bits 4-7
(1)    FC3E :                    port_in:
(1)    FC3E : ED 78                      in      A, (C)
(1)    FC40 : C1                         pop     BC
(1)    FC41 : C9                         ret
(1)    FC42 :                    port_out:
(1)    FC42 : ED 79                      out     (C), A
(1)    FC44 : C1                         pop     BC
(1)    FC45 : C9                         ret
