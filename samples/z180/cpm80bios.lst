(1)    FA73 : 32 05 00                   sta     0005H
(1)    FA76 : 21 06 EC                   lxi     h, BDOS+6
(1)    FA79 : 22 06 00                   shld    0006H
(1)    FA7C : 01 80 00                   lxi     b, 0080H
