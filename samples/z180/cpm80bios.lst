(1)    FB36 :                    ;;; or BC itself without one.
(1)    FB36 :                    sectran:
(1)    FB36 : 7A                         mov     a, d
(1)    FB37 : B3                         ora     e
(1)    FB38 : C2 3E FB                   jnz     sectran_table
(1)    FB3B : 60                         mov     h, b
(1)    FB3C : 69                         mov     l, c
(1)    FB3D : C9                         ret
