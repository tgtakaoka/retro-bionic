(1)    FBBC :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)    FBBC :                    ;;; Reads C sectors of drive A's system tracks into HL, from track 0
(1)    FBBC :                    ;;; sector 2, past the boot sector. Z when all were read, NZ on an error.
(1)    FBBC :                    ;;; 8080 instructions only.
(1)    FBBC :                    load_system:
(1)    FBBC : AF                         xra     a
(1)    FBBD : CD 0A FC                   call    disk_drive
(1)    FBC0 : CD 10 FC                   call    disk_track
(1)    FBC3 : 06 02                      mvi     b, 2
