          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                    ;;; CP/M 2.2 cold boot on 16-bit ports: L z180/cpm80.hex loads this and
          0 :                    ;;; mounts cpm80.dsk as A: (and cpm80b.dsk etc. as B:-D:). It reads CCP,
          0 :                    ;;; BDOS and the BIOS from the system tracks and enters the BIOS's cold
          0 :                    ;;; boot. For the Z180, Z280 and Z380.
          0 :                    ;;;
          0 :                    ;;; The Z380's memory decodes all its address lines until told otherwise,
          0 :                    ;;; and CP/M's programs count on 64K wrapping, so the boot sets its
          0 :                    ;;; address mask register to 16 bits. The port is nothing on the others.
          0 :                            cpu     8080
          0 :                            include "../i8080/cpm80.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :
(1)       0 :                    ;;; CP/M 2.2 in 64K on 8" single-sided single-density disks: 77 tracks of
(1)       0 :                    ;;; 26 sectors of 128 bytes. The system tracks 0 and 1 hold the boot
(1)       0 :                    ;;; sector, then CCP and BDOS, then the BIOS.
(1)       0 : =40                MSIZE:  equ     64
(1)       0 : =E400              CCP:    equ     (MSIZE-7)*1024  ; E400
(1)       0 : =EC00              BDOS:   equ     CCP+0800H       ; EC00
(1)       0 : =FA00              BIOS:   equ     CCP+1600H       ; FA00
(1)       0 : =3                 IOBYTE: equ     0003H
(1)       0 : =4                 TDRIVE: equ     0004H           ; current drive and user
(1)       0 : =1A                SPT:    equ     26              ; sectors a track
(1)       0 : =2C                CCP_SECTORS:    equ     (BIOS-CCP)/128          ; 44
(1)       0 : =7                 BIOS_SECTORS:   equ     2*SPT-1-CCP_SECTORS     ; 7, to the end of track 1
(1)       0 : =4                 NDISKS: equ     4
(1)       0 :
(1)       0 : =7F                ALV_BYTES:      equ     127     ; hd8's 1016 blocks; ibm-3740 needs 31
(1)       0 :
(1)       0 :                    ;;; The BIOS's scratch areas, to the top of memory. The cold boot loads
(1)       0 :                    ;;; the BIOS's sectors over their start, which nothing has used yet.
(1)    FD43 :                            org     0FFFFH-128-16*NDISKS-ALV_BYTES*NDISKS   ; FD43
(1)    FD43 :                    dirbuf: ds      128
(1)    FDC3 :                    csv:    ds      16*NDISKS
(1)    FE03 :                    alv:    ds      ALV_BYTES*NDISKS
       FFFF :
          0 :                            org     0000H
          0 : 31 00 01                   lxi     sp, 0100H
          3 : 3E 10                      mvi     a, 16
          5 : CD 9E 00                   call    addr_mask
          8 : 21 00 E4                   lxi     h, CCP
          B : 0E 33                      mvi     c, CCP_SECTORS+BIOS_SECTORS
          D : CD 14 00                   call    load_system
         10 : CA 00 FA                   jz      BIOS                    ; cold boot
         13 : 76                         hlt
         14 :                            include "../i8080/cpm80load.inc"
(1)      14 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)      14 :                    ;;; Reads C sectors of drive A's system tracks into HL, from track 0
(1)      14 :                    ;;; sector 2, past the boot sector. Z when all were read, NZ on an error.
(1)      14 :                    ;;; 8080 instructions only.
(1)      14 :                    load_system:
(1)      14 : AF                         xra     a
(1)      15 : CD 62 00                   call    disk_drive
(1)      18 : CD 68 00                   call    disk_track
(1)      1B : 06 02                      mvi     b, 2
(1)      1D :                    load_sector:
(1)      1D : 78                         mov     a, b
(1)      1E : CD 6E 00                   call    disk_sector
(1)      21 : 7D                         mov     a, l
(1)      22 : CD 74 00                   call    disk_dmal
(1)      25 : 7C                         mov     a, h
(1)      26 : CD 7A 00                   call    disk_dmah
(1)      29 : 3E 01                      mvi     a, CMD_READ
(1)      2B : CD 80 00                   call    disk_command
(1)      2E : CD 86 00                   call    disk_status
(1)      31 : B7                         ora     a
(1)      32 : C0                         rnz
(1)      33 : 11 80 00                   lxi     d, 128
(1)      36 : 19                         dad     d
(1)      37 : 04                         inr     b
(1)      38 : 78                         mov     a, b
(1)      39 : FE 1B                      cpi     SPT+1
(1)      3B : DA 45 00                   jc      load_count
(1)      3E : 06 01                      mvi     b, 1                    ; on to track 1
(1)      40 : 3E 01                      mvi     a, 1
(1)      42 : CD 68 00                   call    disk_track
(1)      45 :                    load_count:
(1)      45 : 0D                         dcr     c
(1)      46 : C2 1D 00                   jnz     load_sector
(1)      49 : C9                         ret
         4A :                            include "cpm80io.inc"
(1)      4A :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)      4A :                    ;;; CP/M's port routines on 16-bit I/O addresses: the i8251 at 0140H and
(1)      4A :                    ;;; the sector disk at 0150H, clear of the on-chip I/O. Each keeps every
(1)      4A :                    ;;; register but A and the flags. Z180, Z280 and Z380.
(1)      4A :                            include "usart.inc"
(2)      4A :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)      4A :                    ;;; i8251 Universal Synchronous/Asynchronous Receiver/Transmitter
(2)      4A : =140               USART:  equ     0140H           ; A8-A15 nonzero: clear of on-chip I/O
(2)      4A : =140               USARTD: equ     USART+0         ; Data register
(2)      4A : =141               USARTS: equ     USART+1         ; Status register
(2)      4A : =141               USARTC: equ     USART+1         ; Control register
(2)      4A : =142               USARTRV:        equ     USART+2 ; Receive interrupt vector (ORG_*)
(2)      4A : =143               USARTTV:        equ     USART+3 ; Transmit interrupt vector (ORG_*)
(2)      4A :                            include "../z80/i8251.inc"
(3)      4A :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(3)      4A :
(3)      4A :                    ;;; i8251 USART device emulator.
(3)      4A :                    ;;; Bit definition of mode register
(3)      4A : =6                 MODE_STOP_gp:   equ     6
(3)      4A : =C0                MODE_STOP_gm:   equ     11000000B
(3)      4A : =40                MODE_STOP1_gc:  equ     (1 << MODE_STOP_gp)
(3)      4A : =80                MODE_STOP15_gc: equ     (2 << MODE_STOP_gp)
(3)      4A : =C0                MODE_STOP2_gc:  equ     (3 << MODE_STOP_gp)
(3)      4A : =20                MODE_EVEN_bm:   equ     00100000B
(3)      4A : =10                MODE_PARITY_bm: equ     00010000B
(3)      4A : =2                 MODE_LEN_gp:    equ     2
(3)      4A : =C                 MODE_LEN_gm:    equ     00001100B
(3)      4A : =0                 MODE_LEN5_gc:   equ     (0 << MODE_LEN_gp)
(3)      4A : =4                 MODE_LEN6_gc:   equ     (1 << MODE_LEN_gp)
(3)      4A : =8                 MODE_LEN7_gc:   equ     (2 << MODE_LEN_gp)
(3)      4A : =C                 MODE_LEN8_gc:   equ     (3 << MODE_LEN_gp)
(3)      4A : =0                 MODE_BAUD_gp:   equ     0
(3)      4A : =3                 MODE_BAUD_gm:   equ     00000011B
(3)      4A : =1                 MODE_BAUD_X1:   equ     (1 << MODE_BAUD_gp)
(3)      4A : =2                 MODE_BAUD_X16:  equ (2 << MODE_BAUD_gp)
(3)      4A : =3                 MODE_BAUD_X64:  equ (3 << MODE_BAUD_gp)
(3)      4A :                    ;;; Bit Definition of command register
(3)      4A : =80                CMD_EH_bm:      equ     10000000B   ; Enter hunt mode
(3)      4A : =40                CMD_IR_bm:      equ     01000000B   ; Internal Reset
(3)      4A : =20                CMD_RTS_bm:     equ     00100000B   ; Request To Send
(3)      4A : =10                CMD_ER_bm:      equ     00010000B   ; Error Reset
(3)      4A : =8                 CMD_SBRK_bm:    equ     00001000B   ; Send Break
(3)      4A : =4                 CMD_RxEN_bm:    equ     00000100B   ; Receive Enable
(3)      4A : =2                 CMD_DTR_bm:     equ     00000010B   ; Data Terminal Ready
(3)      4A : =1                 CMD_TxEN_bm:    equ     00000001B   ; Transmit enable
(3)      4A :
(3)      4A :                    ;;; Bit definition of status register
(3)      4A : =80                ST_DSR_bm:      equ     10000000B   ; Data Set Ready
(3)      4A : =40                ST_BRK_bm:      equ     01000000B   ; BREAK detected
(3)      4A : =20                ST_FE_bm:       equ     00100000B   ; Framing Error
(3)      4A : =10                ST_OE_bm:       equ     00010000B   ; Overrun Error
(3)      4A : =8                 ST_PE_bm:       equ     00001000B   ; Parity Error
(3)      4A : =2                 ST_TxEMPTY_bp:  equ     2           ; Transmitter empty
(3)      4A : =1                 ST_RxRDY_bp:    equ     1           ; Receiver ready
(3)      4A : =0                 ST_TxRDY_bp:    equ     0           ; Transmitter ready
(2)      4A :                    ;;; Async 1stop 8data x16
(2)      4A : =4E                ASYNC_MODE:     equ     MODE_STOP1_gc|MODE_LEN8_gc|MODE_BAUD_X16
(2)      4A :                    ;;; RTS/DTR, error reset, Rx enable, Tx enable
(2)      4A : =37                RX_EN_TX_EN:    equ     CMD_RTS_bm|CMD_DTR_bm|CMD_ER_bm|CMD_RxEN_bm|CMD_TxEN_bm
(2)      4A : =36                RX_EN_TX_DIS:   equ     CMD_RTS_bm|CMD_DTR_bm|CMD_ER_bm|CMD_RxEN_bm
(1)      4A : =2                 ST_RxRDY_bm:    equ     1 << ST_RxRDY_bp
(1)      4A : =1                 ST_TxRDY_bm:    equ     1 << ST_TxRDY_bp
(1)      4A : =150               DISK:   equ     0150H
(1)      4A :                            include "../i8080/sector_disk.inc"
(2)      4A :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)      4A :
(2)      4A :                    ;;; The debugger's paravirtual sector disk (debugger/sector_disk.h).
(2)      4A :                    ;;; DISK is its base port.
(2)      4A : =150               DISK_DRIVE:     equ     DISK+0  ; 0-3
(2)      4A : =151               DISK_TRACK:     equ     DISK+1  ; 0-76
(2)      4A : =152               DISK_SECTOR:    equ     DISK+2  ; 1-26, physical
(2)      4A : =153               DISK_DMAL:      equ     DISK+3  ; DMA address, low byte
(2)      4A : =154               DISK_DMAH:      equ     DISK+4  ; high byte
(2)      4A : =155               DISK_COMMAND:   equ     DISK+5  ; write a command, read its status
(2)      4A : =156               DISK_MOUNTED:   equ     DISK+6  ; bit n: drive n has its image
(2)      4A : =157               DISK_DMAX:      equ     DISK+7  ; DMA address bits 16-23
(2)      4A : =1                 CMD_READ:       equ     1
(2)      4A : =2                 CMD_WRITE:      equ     2
(1)      4A :
(1)      4A :                            cpu     z80
(1)      4A :                    con_status:
(1)      4A : C5                         push    BC
(1)      4B : 01 41 01                   ld      BC, USARTS
(1)      4E : 18 46                      jr      port_in
(1)      50 :                    con_in:
(1)      50 : C5                         push    BC
(1)      51 : 01 40 01                   ld      BC, USARTD
(1)      54 : 18 40                      jr      port_in
(1)      56 :                    con_out:
(1)      56 : C5                         push    BC
(1)      57 : 01 40 01                   ld      BC, USARTD
(1)      5A : 18 3E                      jr      port_out
(1)      5C :                    con_control:
(1)      5C : C5                         push    BC
(1)      5D : 01 41 01                   ld      BC, USARTC
(1)      60 : 18 38                      jr      port_out
(1)      62 :                    disk_drive:
(1)      62 : C5                         push    BC
(1)      63 : 01 50 01                   ld      BC, DISK_DRIVE
(1)      66 : 18 32                      jr      port_out
(1)      68 :                    disk_track:
(1)      68 : C5                         push    BC
(1)      69 : 01 51 01                   ld      BC, DISK_TRACK
(1)      6C : 18 2C                      jr      port_out
(1)      6E :                    disk_sector:
(1)      6E : C5                         push    BC
(1)      6F : 01 52 01                   ld      BC, DISK_SECTOR
(1)      72 : 18 26                      jr      port_out
(1)      74 :                    disk_dmal:
(1)      74 : C5                         push    BC
(1)      75 : 01 53 01                   ld      BC, DISK_DMAL
(1)      78 : 18 20                      jr      port_out
(1)      7A :                    disk_dmah:
(1)      7A : C5                         push    BC
(1)      7B : 01 54 01                   ld      BC, DISK_DMAH
(1)      7E : 18 1A                      jr      port_out
(1)      80 :                    disk_command:
(1)      80 : C5                         push    BC
(1)      81 : 01 55 01                   ld      BC, DISK_COMMAND
(1)      84 : 18 14                      jr      port_out
(1)      86 :                    disk_status:
(1)      86 : C5                         push    BC
(1)      87 : 01 55 01                   ld      BC, DISK_COMMAND
(1)      8A : 18 0A                      jr      port_in
(1)      8C :                    disk_mounted:
(1)      8C : C5                         push    BC
(1)      8D : 01 56 01                   ld      BC, DISK_MOUNTED
(1)      90 : 18 04                      jr      port_in
(1)      92 :                    disk_format:
(1)      92 : C5                         push    BC
(1)      93 : 01 50 01                   ld      BC, DISK_DRIVE          ; the format's index in bits 4-7
(1)      96 :                    port_in:
(1)      96 : ED 78                      in      A, (C)
(1)      98 : C1                         pop     BC
(1)      99 : C9                         ret
(1)      9A :                    port_out:
(1)      9A : ED 79                      out     (C), A
(1)      9C : C1                         pop     BC
(1)      9D : C9                         ret
