          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                    ;;; CP/M 2.2 cold boot on 16-bit ports: L z180/cpm22.hex loads this and
          0 :                    ;;; mounts cpm22.dsk as A: (and cpm22b.dsk etc. as B:-D:). It reads CCP,
          0 :                    ;;; BDOS and the BIOS from the system tracks and enters the BIOS's cold
          0 :                    ;;; boot. For the Z180, Z280 and Z380.
          0 :                            cpu     8080
          0 :                            include "../i8080/cpm22.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :
(1)       0 :                    ;;; CP/M 2.2 in 64K on 8" single-sided single-density disks: 77 tracks of
(1)       0 :                    ;;; 26 sectors of 128 bytes. The system tracks 0 and 1 hold the boot
(1)       0 :                    ;;; sector, then CCP and BDOS, then the BIOS.
(1)       0 : =40                MSIZE:  equ     64
(1)       0 : =E400              CCP:    equ     (MSIZE-7)*1024  ; E400
(1)       0 : =EC00              BDOS:   equ     CCP+0800H       ; EC00
(1)       0 : =FA00              BIOS:   equ     CCP+1600H       ; FA00
(1)       0 : =3                 IOBYTE: equ     0003H
(1)       0 : =4                 TDRIVE: equ     0004H           ; current drive and user
(1)       0 : =1A                SPT:    equ     26              ; sectors a track
(1)       0 : =2C                CCP_SECTORS:    equ     (BIOS-CCP)/128          ; 44
(1)       0 : =7                 BIOS_SECTORS:   equ     2*SPT-1-CCP_SECTORS     ; 7, to the end of track 1
(1)       0 : =4                 NDISKS: equ     4
(1)       0 :
(1)       0 :                    ;;; The BIOS's scratch areas, past it on the system tracks.
(1)    FD80 :                            org     BIOS+BIOS_SECTORS*128
(1)    FD80 :                    dirbuf: ds      128
(1)    FE00 :                    csv:    ds      16*NDISKS
(1)    FE40 :                    alv:    ds      31*NDISKS
       FEBC :
          0 :                            org     0000H
          0 : 31 00 01                   lxi     sp, 0100H
          3 : 21 00 E4                   lxi     h, CCP
          6 : 0E 33                      mvi     c, CCP_SECTORS+BIOS_SECTORS
          8 : CD 0F 00                   call    load_system
          B : CA 00 FA                   jz      BIOS                    ; cold boot
          E : 76                         hlt
          F :                            include "../i8080/cpm22load.inc"
(1)       F :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       F :                    ;;; Reads C sectors of drive A's system tracks into HL, from track 0
(1)       F :                    ;;; sector 2, past the boot sector. Z when all were read, NZ on an error.
(1)       F :                    ;;; 8080 instructions only.
(1)       F :                    load_system:
(1)       F : AF                         xra     a
(1)      10 : CD 5D 00                   call    disk_drive
(1)      13 : CD 63 00                   call    disk_track
(1)      16 : 06 02                      mvi     b, 2
(1)      18 :                    load_sector:
(1)      18 : 78                         mov     a, b
(1)      19 : CD 69 00                   call    disk_sector
(1)      1C : 7D                         mov     a, l
(1)      1D : CD 6F 00                   call    disk_dmal
(1)      20 : 7C                         mov     a, h
(1)      21 : CD 75 00                   call    disk_dmah
(1)      24 : 3E 01                      mvi     a, CMD_READ
(1)      26 : CD 7B 00                   call    disk_command
(1)      29 : CD 81 00                   call    disk_status
(1)      2C : B7                         ora     a
(1)      2D : C0                         rnz
(1)      2E : 11 80 00                   lxi     d, 128
(1)      31 : 19                         dad     d
(1)      32 : 04                         inr     b
(1)      33 : 78                         mov     a, b
(1)      34 : FE 1B                      cpi     SPT+1
(1)      36 : DA 40 00                   jc      load_count
(1)      39 : 06 01                      mvi     b, 1                    ; on to track 1
(1)      3B : 3E 01                      mvi     a, 1
(1)      3D : CD 63 00                   call    disk_track
(1)      40 :                    load_count:
(1)      40 : 0D                         dcr     c
(1)      41 : C2 18 00                   jnz     load_sector
(1)      44 : C9                         ret
         45 :                            include "cpm22io.inc"
(1)      45 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)      45 :                    ;;; CP/M's port routines on 16-bit I/O addresses: the i8251 at 0140H and
(1)      45 :                    ;;; the sector disk at 0150H, clear of the on-chip I/O. Each keeps every
(1)      45 :                    ;;; register but A and the flags. Z180, Z280 and Z380.
(1)      45 :                            include "usart.inc"
(2)      45 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)      45 :                    ;;; i8251 Universal Synchronous/Asynchronous Receiver/Transmitter
(2)      45 : =140               USART:  equ     0140H           ; A8-A15 nonzero: clear of on-chip I/O
(2)      45 : =140               USARTD: equ     USART+0         ; Data register
(2)      45 : =141               USARTS: equ     USART+1         ; Status register
(2)      45 : =141               USARTC: equ     USART+1         ; Control register
(2)      45 : =142               USARTRV:        equ     USART+2 ; Receive interrupt vector (ORG_*)
(2)      45 : =143               USARTTV:        equ     USART+3 ; Transmit interrupt vector (ORG_*)
(2)      45 :                            include "../z80/i8251.inc"
(3)      45 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(3)      45 :
(3)      45 :                    ;;; i8251 USART device emulator.
(3)      45 :                    ;;; Bit definition of mode register
(3)      45 : =6                 MODE_STOP_gp:   equ     6
(3)      45 : =C0                MODE_STOP_gm:   equ     11000000B
(3)      45 : =40                MODE_STOP1_gc:  equ     (1 << MODE_STOP_gp)
(3)      45 : =80                MODE_STOP15_gc: equ     (2 << MODE_STOP_gp)
(3)      45 : =C0                MODE_STOP2_gc:  equ     (3 << MODE_STOP_gp)
(3)      45 : =20                MODE_EVEN_bm:   equ     00100000B
(3)      45 : =10                MODE_PARITY_bm: equ     00010000B
(3)      45 : =2                 MODE_LEN_gp:    equ     2
(3)      45 : =C                 MODE_LEN_gm:    equ     00001100B
(3)      45 : =0                 MODE_LEN5_gc:   equ     (0 << MODE_LEN_gp)
(3)      45 : =4                 MODE_LEN6_gc:   equ     (1 << MODE_LEN_gp)
(3)      45 : =8                 MODE_LEN7_gc:   equ     (2 << MODE_LEN_gp)
(3)      45 : =C                 MODE_LEN8_gc:   equ     (3 << MODE_LEN_gp)
(3)      45 : =0                 MODE_BAUD_gp:   equ     0
(3)      45 : =3                 MODE_BAUD_gm:   equ     00000011B
(3)      45 : =1                 MODE_BAUD_X1:   equ     (1 << MODE_BAUD_gp)
(3)      45 : =2                 MODE_BAUD_X16:  equ (2 << MODE_BAUD_gp)
(3)      45 : =3                 MODE_BAUD_X64:  equ (3 << MODE_BAUD_gp)
(3)      45 :                    ;;; Bit Definition of command register
(3)      45 : =80                CMD_EH_bm:      equ     10000000B   ; Enter hunt mode
(3)      45 : =40                CMD_IR_bm:      equ     01000000B   ; Internal Reset
(3)      45 : =20                CMD_RTS_bm:     equ     00100000B   ; Request To Send
(3)      45 : =10                CMD_ER_bm:      equ     00010000B   ; Error Reset
(3)      45 : =8                 CMD_SBRK_bm:    equ     00001000B   ; Send Break
(3)      45 : =4                 CMD_RxEN_bm:    equ     00000100B   ; Receive Enable
(3)      45 : =2                 CMD_DTR_bm:     equ     00000010B   ; Data Terminal Ready
(3)      45 : =1                 CMD_TxEN_bm:    equ     00000001B   ; Transmit enable
(3)      45 :
(3)      45 :                    ;;; Bit definition of status register
(3)      45 : =80                ST_DSR_bm:      equ     10000000B   ; Data Set Ready
(3)      45 : =40                ST_BRK_bm:      equ     01000000B   ; BREAK detected
(3)      45 : =20                ST_FE_bm:       equ     00100000B   ; Framing Error
(3)      45 : =10                ST_OE_bm:       equ     00010000B   ; Overrun Error
(3)      45 : =8                 ST_PE_bm:       equ     00001000B   ; Parity Error
(3)      45 : =2                 ST_TxEMPTY_bp:  equ     2           ; Transmitter empty
(3)      45 : =1                 ST_RxRDY_bp:    equ     1           ; Receiver ready
(3)      45 : =0                 ST_TxRDY_bp:    equ     0           ; Transmitter ready
(2)      45 :                    ;;; Async 1stop 8data x16
(2)      45 : =4E                ASYNC_MODE:     equ     MODE_STOP1_gc|MODE_LEN8_gc|MODE_BAUD_X16
(2)      45 :                    ;;; RTS/DTR, error reset, Rx enable, Tx enable
(2)      45 : =37                RX_EN_TX_EN:    equ     CMD_RTS_bm|CMD_DTR_bm|CMD_ER_bm|CMD_RxEN_bm|CMD_TxEN_bm
(2)      45 : =36                RX_EN_TX_DIS:   equ     CMD_RTS_bm|CMD_DTR_bm|CMD_ER_bm|CMD_RxEN_bm
(1)      45 : =2                 ST_RxRDY_bm:    equ     1 << ST_RxRDY_bp
(1)      45 : =1                 ST_TxRDY_bm:    equ     1 << ST_TxRDY_bp
(1)      45 : =150               DISK:   equ     0150H
(1)      45 :                            include "../i8080/sector_disk.inc"
(2)      45 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)      45 :
(2)      45 :                    ;;; The debugger's paravirtual sector disk (debugger/sector_disk.h).
(2)      45 :                    ;;; DISK is its base port.
(2)      45 : =150               DISK_DRIVE:     equ     DISK+0  ; 0-3
(2)      45 : =151               DISK_TRACK:     equ     DISK+1  ; 0-76
(2)      45 : =152               DISK_SECTOR:    equ     DISK+2  ; 1-26, physical
(2)      45 : =153               DISK_DMAL:      equ     DISK+3  ; DMA address, low byte
(2)      45 : =154               DISK_DMAH:      equ     DISK+4  ; high byte
(2)      45 : =155               DISK_COMMAND:   equ     DISK+5  ; write a command, read its status
(2)      45 : =156               DISK_MOUNTED:   equ     DISK+6  ; bit n: drive n has its image
(2)      45 : =1                 CMD_READ:       equ     1
(2)      45 : =2                 CMD_WRITE:      equ     2
(1)      45 :
(1)      45 :                            cpu     z80
(1)      45 :                    con_status:
(1)      45 : C5                         push    BC
(1)      46 : 01 41 01                   ld      BC, USARTS
(1)      49 : 18 40                      jr      port_in
(1)      4B :                    con_in:
(1)      4B : C5                         push    BC
(1)      4C : 01 40 01                   ld      BC, USARTD
(1)      4F : 18 3A                      jr      port_in
(1)      51 :                    con_out:
(1)      51 : C5                         push    BC
(1)      52 : 01 40 01                   ld      BC, USARTD
(1)      55 : 18 38                      jr      port_out
(1)      57 :                    con_control:
(1)      57 : C5                         push    BC
(1)      58 : 01 41 01                   ld      BC, USARTC
(1)      5B : 18 32                      jr      port_out
(1)      5D :                    disk_drive:
(1)      5D : C5                         push    BC
(1)      5E : 01 50 01                   ld      BC, DISK_DRIVE
(1)      61 : 18 2C                      jr      port_out
(1)      63 :                    disk_track:
(1)      63 : C5                         push    BC
(1)      64 : 01 51 01                   ld      BC, DISK_TRACK
(1)      67 : 18 26                      jr      port_out
(1)      69 :                    disk_sector:
(1)      69 : C5                         push    BC
(1)      6A : 01 52 01                   ld      BC, DISK_SECTOR
(1)      6D : 18 20                      jr      port_out
(1)      6F :                    disk_dmal:
(1)      6F : C5                         push    BC
(1)      70 : 01 53 01                   ld      BC, DISK_DMAL
(1)      73 : 18 1A                      jr      port_out
(1)      75 :                    disk_dmah:
(1)      75 : C5                         push    BC
(1)      76 : 01 54 01                   ld      BC, DISK_DMAH
(1)      79 : 18 14                      jr      port_out
(1)      7B :                    disk_command:
(1)      7B : C5                         push    BC
(1)      7C : 01 55 01                   ld      BC, DISK_COMMAND
(1)      7F : 18 0E                      jr      port_out
(1)      81 :                    disk_status:
(1)      81 : C5                         push    BC
(1)      82 : 01 55 01                   ld      BC, DISK_COMMAND
(1)      85 : 18 04                      jr      port_in
(1)      87 :                    disk_mounted:
(1)      87 : C5                         push    BC
(1)      88 : 01 56 01                   ld      BC, DISK_MOUNTED
(1)      8B :                    port_in:
(1)      8B : ED 78                      in      A, (C)
(1)      8D : C1                         pop     BC
(1)      8E : C9                         ret
(1)      8F :                    port_out:
(1)      8F : ED 79                      out     (C), A
(1)      91 : C1                         pop     BC
