(1)    12D6 : C5 C5 CC                   ldw     RR12, @R5
(1)    12D9 : 37 EE 06                   btjrf   divsi2_abs_dividend, R14, #7
(1)    12DC : 60 CE                      com     R14
(1)    12DE : 60 CF                      com     R15
(1)    12E0 : A0 CE                      incw    RR14            ; dividend = -dividend
(1)    12E2 :                    divsi2_abs_dividend:
(1)    12E2 : 37 CE 06                   btjrf   divsi2_divide, R12, #7
(1)    12E5 : 60 CC                      com     R12
(1)    12E7 : 60 CD                      com     R13
(1)    12E9 : A0 CC                      incw    RR12            ; divisor = -divisor
(1)    12EB :                    divsi2_divide:
(1)    12EB : F6 12 53                   call    udiv16
(1)    12EE : C7 E4                      ld      R14, @R4
(1)    12F0 : B3 E5                      xor     R14, @R5        ; R14=sign(@R4)^sign(@R5)
(1)    12F2 : 37 EE 06                   btjrf   divsi2_end, R14, #7
(1)    12F5 : 60 CC                      com     R12
(1)    12F7 : 60 CD                      com     R13
(1)    12F9 : A0 CC                      incw    RR12            ; quotient = -quotient
(1)    12FB :                    divsi2_end:
(1)    12FB : D7 4C                      ld      0(R4), R12
(1)    12FD : 97 D4 01                   ld      1(R4), R13
(1)    1300 : AF                         ret
       1301 :
       1301 :                            end
