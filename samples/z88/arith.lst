       1000 :                            org     %1000
       1000 : =1000              stack:  equ     $
       1000 :
         20 :                            org     ORG_RESET
         20 :                            setrp   %C0
         20 :                    init_config:
         20 : E6 FE 02                   ld      EMT, #EMT_STACK_DM ; stack is on external data memory
         23 : E6 F0 FF                   ld      P0M, #P0M_ADRH     ; Port 0 is address bus high
         26 : E6 F1 28                   ld      PM, #PM_P1BUS | PM_DM ; Port 1 is data bus and address bus low
         29 : C6 D8 10 00                ldw     SPH, #stack
         2D :
         2D :                    init_usart:
         2D : C6 CC FF 00                ldw     RR12, #USART
         31 : B0 C0                      clr     R0
         33 : F7 0D 01                   lde     USARTC(RR12), R0
         36 : F7 0D 01                   lde     USARTC(RR12), R0
         39 : F7 0D 01                   lde     USARTC(RR12), R0 ; safest way to sync mode
         3C : 0C 40                      ld      R0, #CMD_IR_bm
         3E : F7 0D 01                   lde     USARTC(RR12), R0 ; reset
         41 : FF                         nop
         42 : FF                         nop
         43 : 0C 4E                      ld      R0, #MODE_STOP1_gc LOR MODE_LEN8_gc LOR MODE_BAUD_X16
         45 : F7 0D 01                   lde     USARTC(RR12), R0 ; async 1stop 8data x16
         48 : FF                         nop
         49 : FF                         nop
         4A : 0C 37                      ld      R0, #CMD_RTS_bm LOR CMD_DTR_bm LOR CMD_ER_bm LOR CMD_RxEN_bm LOR CMD_TxEN_bm
         4C : F7 0D 01                   lde     USARTC(RR12), R0 ; RTS/DTR, error reset, Rx enable, Tx enable
         4F :
         4F : F6 10 00                   call    arith
         52 : F6 00 72                   call    newline
         55 : 3F                         wfi                     ; halt to system
         56 :
         56 :                    ;;; @param R0 character; CR is followed by LF
         56 :                    ;;; @clobber R0 RR12
         56 :                    putchar:
         56 : 70 C1                      push    R1
         58 : C6 CC FF 00                ldw     RR12, #USART
         5C :                    putchar_loop:
         5C : E7 1D 01                   lde     R1, USARTS(RR12)
         5F : 76 C1 01                   tm      R1, #ST_TxRDY_bm
         62 : 6B F8                      jr      z, putchar_loop
         64 : D3 0D                      lde     USARTD(RR12), R0
         66 : A6 C0 0D                   cp      R0, #%0D
         69 : EB 04                      jr      nz, putchar_end
         6B : 0C 0A                      ld      R0, #%0A
         6D : 8B ED                      jr      putchar_loop
         6F :                    putchar_end:
         6F : 50 C1                      pop     R1
         71 : AF                         ret
         72 :
         72 :                    newline:
         72 : 70 C0                      push    R0
         74 : 0C 0D                      ld      R0, #%0D
         76 : F6 00 56                   call    putchar
         79 : 50 C0                      pop     R0
         7B : AF                         ret
         7C :
         7C :                    putspace:
         7C : 70 C0                      push    R0
         7E : 0C 20                      ld      R0, #' '
         80 : F6 00 56                   call    putchar
         83 : 50 C0                      pop     R0
         85 : AF                         ret
         86 :
         86 :                    ;;; Print " " and the letters of the set C, Z, S, V flags, if any
         86 :                    ;;; @param FLAGS
         86 :                    ;;; @clobber R0 R1
         86 :                    putflags:
         86 : 18 D5                      ld      R1, FLAGS
         88 : 76 C1 F0                   tm      R1, #F_CARRY LOR F_ZERO LOR F_SIGN LOR F_OVERFLOW
         8B : EB 01                      jr      nz, putflags_spc
         8D : AF                         ret
         8E :                    putflags_spc:
         8E : F6 00 7C                   call    putspace
         91 : 19 D5                      ld      FLAGS, R1
         93 : FB 05                      jr      nc, putflags_nc
         95 : 0C 43                      ld      R0, #'C'
         97 : F6 00 56                   call    putchar
         9A :                    putflags_nc:
         9A : 19 D5                      ld      FLAGS, R1
         9C : EB 05                      jr      nz, putflags_nz
         9E : 0C 5A                      ld      R0, #'Z'
         A0 : F6 00 56                   call    putchar
         A3 :                    putflags_nz:
         A3 : 19 D5                      ld      FLAGS, R1
         A5 : DB 05                      jr      pl, putflags_pl
         A7 : 0C 53                      ld      R0, #'S'
         A9 : F6 00 56                   call    putchar
         AC :                    putflags_pl:
         AC : 19 D5                      ld      FLAGS, R1
         AE : CB 05                      jr      nov, putflags_nov
         B0 : 0C 56                      ld      R0, #'V'
         B2 : F6 00 56                   call    putchar
         B5 :                    putflags_nov:
         B5 : AF                         ret
         B6 :
         B6 :                    ;;; Print "a op b"
         B6 :                    ;;; @param R0 op letter
         B6 :                    ;;; @clobber RR0 R10-R15
         B6 :                    expr:
         B6 : 70 C0                      push    R0
         B8 : C4 10 C0                   ldw     RR0, a
         BB : F6 11 AC                   call    print_int16
         BE : F6 00 7C                   call    putspace
         C1 : 50 C0                      pop     R0
         C3 : F6 00 56                   call    putchar
