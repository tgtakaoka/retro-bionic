(1)     13E :                    ;;; @clobber AR2 AR3 ARP=2
(1)     13E :                    queue_add:
(1)     13E : 6006                       sacl    queue_char      ; save element
(1)     13F : 7202                       sar     AR2,queue_ptr   ; save queue pointer
(1)     140 : 558A                       larp    AR2
(1)     141 : 20A0                       lac     *+              ; ACC=queue_len
(1)     142 : 1080                       sub     *               ; queue_len-queue_size
(1)     143 : F380 014B                  blz     queue_add_elem  ; branch if queue_len<queue_size
(1)     145 : D001 FFFF                  lalk    -1
(1)     147 : 6003                       sacl    queue_work
(1)     148 : 4003                       zalh    queue_work      ; ACC<0
(1)     149 : 4906                       adds    queue_char      ; restore element
(1)     14A : CE26                       ret
