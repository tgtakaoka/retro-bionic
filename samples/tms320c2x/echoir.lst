(1)       0 :                    ;;; Origin
(1)       0 : =0                 ORG_RESET:      .equ    0000H   ; Reset
(1)       0 : =2                 ORG_INT0:       .equ    0002H   ; #INT0
(1)       0 : =4                 ORG_INT1:       .equ    0004H   ; #INT1
(1)       0 : =6                 ORG_INT2:       .equ    0006H   ; #INT2
(1)       0 : =18                ORG_TINT:       .equ    0018H   ; Timer
(1)       0 : =1A                ORG_RINT:       .equ    001AH   ; Serial port receive
(1)       0 : =1C                ORG_XINT:       .equ    001CH   ; Serial port transmit
(1)       0 : =1E                ORG_TRAP:       .equ    001EH   ; TRAP
(1)       0 :                    ;;; Memory mapped registers
(1)       0 : =0                 DRR:    .equ    0               ; Serial port data receive
(1)       0 : =1                 DXR:    .equ    1               ; Serial port data transmit
(1)       0 : =2                 TIM:    .equ    2               ; Timer
(1)       0 : =3                 PRD:    .equ    3               ; Period
(1)       0 : =4                 IMR:    .equ    4               ; Interrupt mask
(1)       0 : =5                 GREG:   .equ    5               ; Global memory allocation
(1)       0 :                    ;;; Interrupt mask bits
(1)       0 : =1                 IMR_INT0:       .equ    000001B
(1)       0 : =2                 IMR_INT1:       .equ    000010B
(1)       0 : =4                 IMR_INT2:       .equ    000100B
(1)       0 : =8                 IMR_TINT:       .equ    001000B
(1)       0 : =10                IMR_RINT:       .equ    010000B
(1)       0 : =20                IMR_XINT:       .equ    100000B
(1)       0 :                    ;;; Data memory
(1)       0 : =60                B2:     .equ    0060H           ; 32 words on page 0
(1)       0 : =200               B0:     .equ    0200H           ; 256 words on pages 4 and 5
(1)       0 : =300               B1:     .equ    0300H           ; 256 words on pages 6 and 7
(1)       0 : =4                 PAGE_B0:        .equ    B0>>7
(1)       0 :                    ;;; Halt to system
(1)       0 : =CE1E              HALT:   .equ    0CE1EH          ; TRAP
