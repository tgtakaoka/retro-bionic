(1)     157 : 558B                       larp    AR3
(1)     158 : 4106                       zals    queue_char
(1)     159 : 6080                       sacl    *               ; queue_buf[queue_put]=element
(1)     15A : 558A                       larp    AR2
(1)     15B : 2004                       lac     queue_index
(1)     15C : CC01                       addk    1
(1)     15D : 6004                       sacl    queue_index     ; queue_put+1
(1)     15E : 1003                       sub     queue_work      ; queue_put+1-queue_size
(1)     15F : F380 0163                  blz     queue_add_exit  ; branch if queue_put+1<queue_size
(1)     161 : CA00                       zac
(1)     162 : 6004                       sacl    queue_index     ; queue_put=0
(1)     163 :                    queue_add_exit:
(1)     163 : 2004                       lac     queue_index
(1)     164 : 6080                       sacl    *               ; update queue_put
(1)     165 : 4106                       zals    queue_char      ; restore element
(1)     166 : CE26                       ret
(1)     167 :
(1)     167 :                    ;;; [queue] Remove an element from queue
