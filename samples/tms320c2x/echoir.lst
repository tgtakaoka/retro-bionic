        133 :                            .include "queue.inc"
(1)     133 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     133 :                    ;;; [queue] queue structure in data memory
(1)     133 : =0                 queue_len:      .equ    0       ; queue length
(1)     133 : =1                 queue_size:     .equ    1       ; buffer size
(1)     133 : =2                 queue_put:      .equ    2       ; queue put index
(1)     133 : =3                 queue_get:      .equ    3       ; queue get index
(1)     133 : =4                 queue_buf:      .equ    4       ; buffer start offset
(1)     133 :
(1)     133 :                    ;;; Each routine expects DP on the page of its work space: queue_ptr,
(1)     133 :                    ;;; queue_work, queue_index, queue_addr and queue_char.
(1)     133 :
(1)     133 :                    ;;; [queue] Initialize queue
(1)     133 :                    ;;; @param AR2 queue work space pointer
(1)     133 :                    ;;; @param ACC queue work space size
(1)     133 :                    ;;; @clobber ACC AR2 ARP=2
(1)     133 :                    queue_init:
(1)     133 : CD04                       subk    queue_buf
(1)     134 : 6003                       sacl    queue_work      ; queue_size
(1)     135 : 558A                       larp    AR2
(1)     136 : CA00                       zac
(1)     137 : 60A0                       sacl    *+              ; queue_len=0
(1)     138 : 2003                       lac     queue_work
(1)     139 : 60A0                       sacl    *+              ; queue_size
(1)     13A : CA00                       zac
(1)     13B : 60A0                       sacl    *+              ; queue_put=0
(1)     13C : 60A0                       sacl    *+              ; queue_get=0
(1)     13D : CE26                       ret
(1)     13E :
(1)     13E :                    ;;; [queue] Add an element to queue
(1)     13E :                    ;;; @param AR2 queue work space pointer
(1)     13E :                    ;;; @param ACC an element
