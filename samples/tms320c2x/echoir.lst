(1)     14C : 2080                       lac     *
(1)     14D : CC01                       addk    1
(1)     14E : 60A0                       sacl    *+              ; queue_len++
(1)     14F : 20A0                       lac     *+              ; ACC=queue_size
(1)     150 : 6003                       sacl    queue_work
(1)     151 : 2080                       lac     *               ; ACC=queue_put
(1)     152 : 6004                       sacl    queue_index
(1)     153 : 0002                       add     queue_ptr
(1)     154 : CC04                       addk    queue_buf
(1)     155 : 6005                       sacl    queue_addr
