        10F : CA94                       lack    RX_INT_TX_NO
        110 : 6002                       sacl    acia_tx_dis
        111 : E402                       out     acia_tx_dis,ACIA_control ; 8 bits + No Parity + 1 Stop Bits
        112 : CAB4                       lack    RX_INT_TX_INT
        113 : 6003                       sacl    acia_tx_int
