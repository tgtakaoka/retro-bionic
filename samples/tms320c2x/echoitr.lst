        180 :                            .include "queue.inc"
(1)     180 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     180 :                    ;;; [queue] queue structure in data memory
(1)     180 : =0                 queue_len:      .equ    0       ; queue length
(1)     180 : =1                 queue_size:     .equ    1       ; buffer size
(1)     180 : =2                 queue_put:      .equ    2       ; queue put index
(1)     180 : =3                 queue_get:      .equ    3       ; queue get index
(1)     180 : =4                 queue_buf:      .equ    4       ; buffer start offset
(1)     180 :
(1)     180 :                    ;;; Each routine expects DP on the page of its work space: queue_ptr,
(1)     180 :                    ;;; queue_work, queue_index, queue_addr and queue_char.
(1)     180 :
(1)     180 :                    ;;; [queue] Initialize queue
(1)     180 :                    ;;; @param AR2 queue work space pointer
(1)     180 :                    ;;; @param ACC queue work space size
(1)     180 :                    ;;; @clobber ACC AR2 ARP=2
(1)     180 :                    queue_init:
(1)     180 : CD04                       subk    queue_buf
(1)     181 : 6006                       sacl    queue_work      ; queue_size
(1)     182 : 558A                       larp    AR2
(1)     183 : CA00                       zac
(1)     184 : 60A0                       sacl    *+              ; queue_len=0
(1)     185 : 2006                       lac     queue_work
(1)     186 : 60A0                       sacl    *+              ; queue_size
(1)     187 : CA00                       zac
(1)     188 : 60A0                       sacl    *+              ; queue_put=0
(1)     189 : 60A0                       sacl    *+              ; queue_get=0
(1)     18A : CE26                       ret
(1)     18B :
(1)     18B :                    ;;; [queue] Add an element to queue
(1)     18B :                    ;;; @param AR2 queue work space pointer
(1)     18B :                    ;;; @param ACC an element
(1)     18B :                    ;;; @return ACC<0 if queue is full
(1)     18B :                    ;;; @clobber AR2 AR3 ARP=2
(1)     18B :                    queue_add:
(1)     18B : 6009                       sacl    queue_char      ; save element
(1)     18C : 7205                       sar     AR2,queue_ptr   ; save queue pointer
(1)     18D : 558A                       larp    AR2
(1)     18E : 20A0                       lac     *+              ; ACC=queue_len
(1)     18F : 1080                       sub     *               ; queue_len-queue_size
(1)     190 : F380 0198                  blz     queue_add_elem  ; branch if queue_len<queue_size
(1)     192 : D001 FFFF                  lalk    -1
(1)     194 : 6006                       sacl    queue_work
(1)     195 : 4006                       zalh    queue_work      ; ACC<0
(1)     196 : 4909                       adds    queue_char      ; restore element
(1)     197 : CE26                       ret
(1)     198 :                    queue_add_elem:
(1)     198 : 3205                       lar     AR2,queue_ptr   ; AR2=&queue_len
(1)     199 : 2080                       lac     *
(1)     19A : CC01                       addk    1
(1)     19B : 60A0                       sacl    *+              ; queue_len++
(1)     19C : 20A0                       lac     *+              ; ACC=queue_size
(1)     19D : 6006                       sacl    queue_work
(1)     19E : 2080                       lac     *               ; ACC=queue_put
(1)     19F : 6007                       sacl    queue_index
(1)     1A0 : 0005                       add     queue_ptr
(1)     1A1 : CC04                       addk    queue_buf
(1)     1A2 : 6008                       sacl    queue_addr
(1)     1A3 : 3308                       lar     AR3,queue_addr  ; AR3=&queue_buf[queue_put]
(1)     1A4 : 558B                       larp    AR3
(1)     1A5 : 4109                       zals    queue_char
(1)     1A6 : 6080                       sacl    *               ; queue_buf[queue_put]=element
(1)     1A7 : 558A                       larp    AR2
(1)     1A8 : 2007                       lac     queue_index
(1)     1A9 : CC01                       addk    1
(1)     1AA : 6007                       sacl    queue_index     ; queue_put+1
(1)     1AB : 1006                       sub     queue_work      ; queue_put+1-queue_size
(1)     1AC : F380 01B0                  blz     queue_add_exit  ; branch if queue_put+1<queue_size
(1)     1AE : CA00                       zac
(1)     1AF : 6007                       sacl    queue_index     ; queue_put=0
(1)     1B0 :                    queue_add_exit:
(1)     1B0 : 2007                       lac     queue_index
(1)     1B1 : 6080                       sacl    *               ; update queue_put
(1)     1B2 : 4109                       zals    queue_char      ; restore element
(1)     1B3 : CE26                       ret
(1)     1B4 :
(1)     1B4 :                    ;;; [queue] Remove an element from queue
(1)     1B4 :                    ;;; @param AR2 queue work space pointer
(1)     1B4 :                    ;;; @return ACC an element
(1)     1B4 :                    ;;; @return ACC<0 if queue is empty
(1)     1B4 :                    ;;; @clobber AR2 AR3 ARP=2
(1)     1B4 :                    queue_remove:
(1)     1B4 : 7205                       sar     AR2,queue_ptr   ; save queue pointer
(1)     1B5 : 558A                       larp    AR2
(1)     1B6 : 2080                       lac     *               ; ACC=queue_len
(1)     1B7 : F180 01BC                  bgz     queue_remove_elem ; branch if queue_len>0
(1)     1B9 : D001 FFFF                  lalk    -1              ; ACC<0
(1)     1BB : CE26                       ret
(1)     1BC :                    queue_remove_elem:
(1)     1BC : CD01                       subk    1
(1)     1BD : 60A0                       sacl    *+              ; queue_len--
(1)     1BE : 20A0                       lac     *+              ; ACC=queue_size
(1)     1BF : 6006                       sacl    queue_work
(1)     1C0 : 55A0                       mar     *+              ; AR2=&queue_get
(1)     1C1 : 2080                       lac     *               ; ACC=queue_get
(1)     1C2 : 6007                       sacl    queue_index
(1)     1C3 : 0005                       add     queue_ptr
(1)     1C4 : CC04                       addk    queue_buf
(1)     1C5 : 6008                       sacl    queue_addr
(1)     1C6 : 3308                       lar     AR3,queue_addr  ; AR3=&queue_buf[queue_get]
(1)     1C7 : 558B                       larp    AR3
(1)     1C8 : 4180                       zals    *
(1)     1C9 : 6009                       sacl    queue_char      ; element=queue_buf[queue_get]
(1)     1CA : 558A                       larp    AR2
(1)     1CB : 2007                       lac     queue_index
(1)     1CC : CC01                       addk    1
(1)     1CD : 6007                       sacl    queue_index     ; queue_get+1
(1)     1CE : 1006                       sub     queue_work      ; queue_get+1-queue_size
(1)     1CF : F380 01D3                  blz     queue_remove_exit ; branch if queue_get+1<queue_size
(1)     1D1 : CA00                       zac
(1)     1D2 : 6007                       sacl    queue_index     ; queue_get=0
(1)     1D3 :                    queue_remove_exit:
(1)     1D3 : 2007                       lac     queue_index
(1)     1D4 : 6080                       sacl    *               ; update queue_get
(1)     1D5 : 4109                       zals    queue_char      ; restore element
(1)     1D6 : CE26                       ret
