(1)     1EB : 200E                       lac     isr_work
(1)     1EC : D004 0002                  andk    TDRE_bm
(1)     1EE : F680 01F8                  bz      int1_isr_exit
(1)     1F0 : D200 0380                  lrlk    AR2,tx_queue
(1)     1F2 : FE80 01B4                  call    queue_remove
(1)     1F4 : F380 0201                  blz     int1_isr_send_empty
(1)     1F6 : 600E                       sacl    isr_work
(1)     1F7 : E50E                       out     isr_work,ACIA_data
(1)     1F8 :                    int1_isr_exit:
(1)     1F8 : 320C                       lar     AR2,isr_ar2     ; restore AR2
(1)     1F9 : 330D                       lar     AR3,isr_ar3     ; restore AR3
(1)     1FA : 400B                       zalh    isr_acch        ; restore ACC
(1)     1FB : 490A                       adds    isr_accl
(1)     1FC : C800                       ldpk    0
(1)     1FD : 5161                       lst1    isr_st1         ; restore ST1
(1)     1FE : 5060                       lst     isr_st0         ; restore ST0, DP and ARP last
(1)     1FF : CE00                       eint
