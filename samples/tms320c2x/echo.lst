          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                            .include "tms320c25.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; TMS320C25
(1)       0 :                            .cpu    320c25
(1)       0 :                    ;;; Origin
(1)       0 : =0                 ORG_RESET:      .equ    0000H   ; Reset
(1)       0 : =2                 ORG_INT0:       .equ    0002H   ; #INT0
(1)       0 : =4                 ORG_INT1:       .equ    0004H   ; #INT1
(1)       0 : =6                 ORG_INT2:       .equ    0006H   ; #INT2
(1)       0 : =18                ORG_TINT:       .equ    0018H   ; Timer
(1)       0 : =1A                ORG_RINT:       .equ    001AH   ; Serial port receive
(1)       0 : =1C                ORG_XINT:       .equ    001CH   ; Serial port transmit
(1)       0 : =1E                ORG_TRAP:       .equ    001EH   ; TRAP
(1)       0 :                    ;;; Memory mapped registers
(1)       0 : =0                 DRR:    .equ    0               ; Serial port data receive
(1)       0 : =1                 DXR:    .equ    1               ; Serial port data transmit
(1)       0 : =2                 TIM:    .equ    2               ; Timer
(1)       0 : =3                 PRD:    .equ    3               ; Period
(1)       0 : =4                 IMR:    .equ    4               ; Interrupt mask
(1)       0 : =5                 GREG:   .equ    5               ; Global memory allocation
(1)       0 :                    ;;; Interrupt mask bits
(1)       0 : =1                 IMR_INT0:       .equ    000001B
(1)       0 : =2                 IMR_INT1:       .equ    000010B
(1)       0 : =4                 IMR_INT2:       .equ    000100B
(1)       0 : =8                 IMR_TINT:       .equ    001000B
(1)       0 : =10                IMR_RINT:       .equ    010000B
(1)       0 : =20                IMR_XINT:       .equ    100000B
(1)       0 :                    ;;; Data memory
(1)       0 : =60                B2:     .equ    0060H           ; 32 words on page 0
(1)       0 : =200               B0:     .equ    0200H           ; 256 words on pages 4 and 5
(1)       0 : =300               B1:     .equ    0300H           ; 256 words on pages 6 and 7
(1)       0 : =4                 PAGE_B0:        .equ    B0>>7
(1)       0 :                    ;;; Halt to system
(1)       0 : =CE1E              HALT:   .equ    0CE1EH          ; TRAP
          0 :
          0 :                    ;;; MC6850 Asynchronous Communication Interface Adapter
          0 : =4                 ACIA:   .equ    4
          0 :                            .include "mc6850.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; MC6850
(1)       0 :                    ;;; Asynchronous Communication Interface Adapter
(1)       0 : =4                 ACIA_control:   .equ    ACIA+0
(1)       0 : =4                 ACIA_status:    .equ    ACIA+0
(1)       0 : =5                 ACIA_data:      .equ    ACIA+1
(1)       0 : =6                 ACIA_intr:      .equ    ACIA+2
(1)       0 :                    ;;;  Counter Divider Select Bits
(1)       0 : =3                 CDS_gm:         .equ    11B       ; Group mask
(1)       0 : =0                 CDS_DIV1_gc:    .equ    00000000B ; /1
(1)       0 : =1                 CDS_DIV16_gc:   .equ    00000001B ; /16
(1)       0 : =2                 CDS_DIV64_gc:   .equ    00000010B ; /64
(1)       0 : =3                 CDS_RESET_gc:   .equ    00000011B ; Master Reset
(1)       0 :                    ;;;  Word Select Bits
(1)       0 : =1C                WSB_gm:         .equ    00011100B ; Group mask
(1)       0 : =0                 WSB_7E2_gc:     .equ    00000000B ; 7 Bits + Even Parity + 2 Stop Bits
(1)       0 : =4                 WSB_7O2_gc:     .equ    00000100B ; 7 bits + Odd Parity  + 2 Stop Bits
(1)       0 : =8                 WSB_7E1_gc:     .equ    00001000B ; 7 bits + Even Parity + 1 Stop Bits
(1)       0 : =C                 WSB_7O1_gc:     .equ    00001100B ; 7 bits + Odd Parity  + 1 Stop Bits
(1)       0 : =10                WSB_8N2_gc:     .equ    00010000B ; 8 bits + No Parity   + 2 Stop Bits
(1)       0 : =14                WSB_8N1_gc:     .equ    00010100B ; 8 bits + No Parity   + 1 Stop Bits
(1)       0 : =18                WSB_8E1_gc:     .equ    00011000B ; 8 bits + Even Parity + 1 Stop Bits
(1)       0 : =1C                WSB_8O1_gc:     .equ    00011100B ; 8 bits + Odd Parity  + 1 Stop Bits
(1)       0 :                    ;;; Transmit Control Bits
(1)       0 : =60                TCB_gm:         .equ    01100000B ; Group mask
(1)       0 : =0                 TCB_DI_gc:      .equ    00000000B ; RTS=Low,  Tx Interrupt Disabled
(1)       0 : =20                TCB_EI_gc:      .equ    00100000B ; RTS=Low,  Tx Interrupt Enabled
(1)       0 : =40                TCB_RTS_gc:     .equ    01000000B ; RTS=High, Tx Interrupt Disabled
(1)       0 : =60                TCB_BREAK_gc:   .equ    01100000B ; RTS=Low,  Tx Interrupt Disabled
(1)       0 :                                                      ; Transmit Break Level
(1)       0 : =80                RIEB_bm:        .equ    10000000B ; Receive Interrupt Enable Bit mask
(1)       0 :                    ;;; Status register
(1)       0 : =1                 RDRF_bm:        .equ    00000001B ; Receive Data Register Full
(1)       0 : =2                 TDRE_bm:        .equ    00000010B ; Transmit Data Register Empty
(1)       0 : =4                 DCDF_bm:        .equ    00000100B ; Data Carrier Detect Flag
(1)       0 : =8                 CTSF_bm:        .equ    00001000B ; Clear To Send Flag
(1)       0 : =10                FERR_bm:        .equ    00010000B ; Frame Error Flag
(1)       0 : =20                OVRN_bm:        .equ    00100000B ; Receiver Overrun Flag
(1)       0 : =40                PERR_bm:        .equ    01000000B ; Parity Error Flag
(1)       0 : =80                IRQF_bm:        .equ    10000000B ; Interrupt Request Flag
          0 :
          0 :                    ;;; Data memory
        200 :                            .org    B0
        200 :                    work:   .bss    1
        201 :                    char:   .bss    1
        202 :
          0 :                            .org    ORG_RESET
          0 : FF80 0100                  b       initialize
          2 :
        100 :                            .org    100H
        100 :                    initialize:
        100 : CE02                       rovm                    ; reset leaves OVM unchanged
        101 : C804                       ldpk    PAGE_B0
        102 :                    ;;; Initialize ACIA
        102 : CA03                       lack    CDS_RESET_gc
        103 : 6000                       sacl    work
        104 : E400                       out     work,ACIA_control ; Master reset
        105 : CA14                       lack    WSB_8N1_gc
        106 : 6000                       sacl    work
        107 : E400                       out     work,ACIA_control ; 8 bits + No Parity + 1 Stop Bits
        108 :
        108 : FE80 0116          loop:   call    getchar
        10A : F680 0115                  bz      halt_to_system
        10C : FE80 011F          echo:   call    putchar
        10E : CA0D                       lack    0DH             ; Carriage return
        10F : 1001                       sub     char
        110 : F580 0108                  bnz     loop
        112 : CA0A                       lack    0AH             ; Newline
        113 : FF80 010C                  b       echo
        115 :                    halt_to_system:
        115 : CE1E                       .word   HALT
        116 :
        116 :                    getchar:
        116 : 8400                       in      work,ACIA_status
        117 : 2000                       lac     work
        118 : D004 0001                  andk    RDRF_bm
        11A : F680 0116                  bz      getchar
        11C : 8501                       in      char,ACIA_data
        11D : 4101                       zals    char
        11E : CE26                       ret
        11F :
        11F :                    putchar:
        11F : 6001                       sacl    char
        120 :                    putchar_loop:
        120 : 8400                       in      work,ACIA_status
        121 : 2000                       lac     work
        122 : D004 0002                  andk    TDRE_bm
        124 : F680 0120                  bz      putchar_loop
        126 : E501                       out     char,ACIA_data
        127 : 4101                       zals    char
        128 : CE26                       ret
