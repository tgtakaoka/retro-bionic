(1)     248 : 2940                       tbit    R1, 0, z        skip if msb(dividend)=0
(1)     249 : 1F09                       neg     R1, c           negate dividend
(1)     24A : 8FE7                       bal     udiv16
(1)     24B : 2E4F                       tbit    STR, 15, z      skip if quotient stays positive
(1)     24C : 1F08                       neg     R0, c           negate quotient
(1)     24D : 7908                       mv      R1, R0
(1)     24E : 2003                       ret
(1)     24F :
(1)     24F :                    *** Multiply: multiplicand * multiplier = product
