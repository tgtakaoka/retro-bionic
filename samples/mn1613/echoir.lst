        209 :                    init_usart:
        209 :                            * Initialize USART
        209 : 6000                       eor     R0, R0          R0=0
        20A : 1081                       wt      R0, USARTC
        20B : 1081                       wt      R0, USARTC
        20C : 1081                       wt      R0, USARTC      Safest way to sync mode
        20D : 0840                       mvi     R0, CMD_IR_bm
        20E : 1081                       wt      R0, USARTC      Reset
        20F : 7808                       mv      R0, R0          delay
        210 : 7808                       mv      R0, R0          delay
        211 : 084E                       mvi     R0, ASYNC_MODE
        212 : 1081                       wt      R0, USARTC
        213 : 7808                       mv      R0, R0          delay
        214 : 7808                       mv      R0, R0          delay
        215 : 0837                       mvi     R0, RX_EN_TX_EN
        216 : 1081                       wt      R0, USARTC      Enable Rx/Tx
        217 : 0803                       mvi     R0, OPSW1+1     Use IRQ1 for Rx interrupt
        218 : 1082                       wt      R0, USARTRV
        219 : 6000                       eor     R0, R0          Disable Tx interrupt
        21A : 1083                       wt      R0, USARTTV
        21B : 2003                       ret
        21C :
        21C : 8F09               loop:   bal     getchar
        21D : 6058                       or      R0, R0, nz      Skip if R0!=0
        21E : 2000                       h                       Halt to system
        21F : 8F0D               echo:   bal     putchar
        220 : 5047 000D                  cbi     R0, x'0D', e    Skip if R0=CR
        222 : CFFA                       b       loop
        223 : 080A                       mvi     R0, x'0A'       NL
        224 : CFFB                       b       echo
        225 :
        225 :                    *** @return R0 received char
        225 :                    *** @clobber X0
        225 :                    getchar:
        225 : 7B0F 2000                  mvwi    X0, rx_queue
        227 :                    getchar_wait:
        227 : 3606                       rbit    STR, STR_IRQ1           Disable IRQ1
        228 : 8F2C                       bal     queue_remove
        229 : 3E96                       sbit    STR, STR_IRQ1, enz      Enable IRQ1, skip if E=1
        22A : CFFD                       b       getchar_wait
        22B : 2003                       ret
        22C :
        22C :                    *** @param R0 char to send
        22C :                    putchar:
        22C : 2001                       push    R0
        22D :                    putchar_wait:
        22D : 1881                       rd      R0, USARTS
        22E : 285F                       tbit    R0, ST_TxRDY_bp, nz     Skip if TxRDY=1
        22F : CFFE                       b       putchar_wait
        230 : 2002                       pop     R0
        231 : 1080                       wt      R0, USARTD
        232 : 2003                       ret
