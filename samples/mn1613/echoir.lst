        233 :                            include "queue.inc"
(1)     233 :                    *** -*- mode: asm; mode: flying-spell; -*-
(1)     233 :                    *** [queue] queue structure
(1)     233 : =0                 queue_len:      equ     0       ; queue length
(1)     233 : =1                 queue_size:     equ     1       ; buffer size
(1)     233 : =2                 queue_put:      equ     2       ; queue put index
(1)     233 : =3                 queue_get:      equ     3       ; queue get index
(1)     233 : =4                 queue_buf:      equ     4       ; buffer start offset
(1)     233 :
(1)     233 :                    *** [queue] Initialize queue
(1)     233 :                    *** @param X0 queue work space pointer
(1)     233 :                    *** @param R0 queue work space size
(1)     233 :                    *** @clobber R0 X0
(1)     233 :                    queue_init:
(1)     233 : 2101                       push    R1
(1)     234 : 6101                       eor     R1, R1          clear R1
(1)     235 : A100                       st      R1, queue_len(X0)       clear queue_len
(1)     236 : 4004                       si      R0, queue_buf
(1)     237 : A001                       st      R0, queue_size(X0)      set queue_size
(1)     238 : A102                       st      R1, queue_put(X0)       clear queue_put
(1)     239 : A103                       st      R1, queue_get(X0)       clear queue_get
(1)     23A : 4B04                       ai      X0, queue_buf
(1)     23B :                    queue_init_loop:
(1)     23B : 21C6                       str     R1, (X0)+
(1)     23C : 4041                       si      R0, 1, z
(1)     23D : CFFE                       b       queue_init_loop
(1)     23E : 2102                       pop     R1
(1)     23F : 2003                       ret
(1)     240 :
(1)     240 :                    *** [queue] Add an element to queue
(1)     240 :                    *** @param X0 queue work space pointer
(1)     240 :                    *** @param R0 an element
(1)     240 :                    *** @return ST.E 0 if queue is full
(1)     240 :                    queue_add:
(1)     240 : 2101                       push    R1
(1)     241 : 2201                       push    R2
(1)     242 : E100                       l       R1, queue_len(X0)
(1)     243 : E201                       l       R2, queue_size(X0)      R2=queue_size
(1)     244 : 51FA                       c       R1, R2, lm              skip if queue_len < queue_size
(1)     245 : CF0B                       b       queue_add_return
(1)     246 : E102                       l       R1, queue_put(X0)
(1)     247 : 5B09                       a       X0, R1                  X0=&queue_buf[queue_put]
(1)     248 : A004                       st      R0, queue_buf(X0)       store element
(1)     249 : 5B01                       s       X0, R1                  restore X0
(1)     24A : 4901                       ai      R1, 1                   queue_put+=1
(1)     24B : 51FA                       c       R1, R2, lm              skip if queue_put < queue_size
(1)     24C : 6101                       eor     R1, R1                  R1=0
(1)     24D : A102                       st      R1, queue_put(X0)       update queue_put
(1)     24E : E600                       ims     queue_len(X0)           queue_len+=1
(1)     24F : 3E10                       sbit    STR, STR_E, skp         ST.E=1, then skip
(1)     250 :                    queue_add_return:
(1)     250 : 3600                       rbit    STR, STR_E              ST.E=0
(1)     251 : 2202                       pop     R2
(1)     252 : 2102                       pop     R1
(1)     253 : 2003                       ret
(1)     254 :
(1)     254 :                    *** [queue] Remove an element from queue
(1)     254 :                    *** @param X0 queue work space pointer
(1)     254 :                    *** @return R0 an element
(1)     254 :                    *** @return ST.E 0 if queue is empty
(1)     254 :                    queue_remove:
(1)     254 : 2101                       push    R1
(1)     255 : E100                       l       R1, queue_len(X0)
(1)     256 : 6159                       or      R1, R1, nz              skip if queue_len != 0
(1)     257 : CF0F                       b       queue_remove_return
(1)     258 : E103                       l       R1, queue_get(X0)
(1)     259 : 5B09                       a       X0, R1                  X0=&queue_buf[queue_get]
(1)     25A : E004                       l       R0, queue_buf(X0)       remove element
(1)     25B : 5B01                       s       X0, R1                  restore X0
(1)     25C : 4901                       ai      R1, 1                   queue_get+=1
(1)     25D : 2201                       push    R2
(1)     25E : E201                       l       R2, queue_size(X0)      R2=queue_size
(1)     25F : 51FA                       c       R1, R2, lm              skip if queue_get < queue_size
(1)     260 : 6101                       eor     R1, R1                  R1=0
(1)     261 : A103                       st      R1, queue_get(X0)       update queue_get
(1)     262 : 2202                       pop     R2
(1)     263 : A600                       dms     queue_len(X0)           queue_len-=1
(1)     264 : 7808                       mv      R0, R0                  nop, for dms skipping on zero
(1)     265 : 3E10                       sbit    STR, STR_E, skp         ST.E=1, then skip
(1)     266 :                    queue_remove_return:
(1)     266 : 3600                       rbit    STR, STR_E              ST.E=0
(1)     267 : 2102                       pop     R1
(1)     268 : 2003                       ret
