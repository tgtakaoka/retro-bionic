(1)       0 : =6                 STR_IRQ1:       equ     6       IRQ1 Mask, 1=enabled
(1)       0 : =7                 STR_IRQ2:       equ     7       IRQ2 Mask, 1=enabled
(1)       0 :                    *** Interrupt vector and save area
(1)       0 : =0                 OPSW0:          equ     X'0000' IRQ0 old STR:IC
