        103 :                    init_usart:
        103 : AF                         xor     A               ; clear A
        104 : ED D3 41 01                outa    (USARTC), A
        108 : ED D3 41 01                outa    (USARTC), A
        10C : ED D3 41 01                outa    (USARTC), A     ; safest way to sync mode
        110 : 3E 40                      ld      A, CMD_IR_bm
        112 : ED D3 41 01                outa    (USARTC), A     ; reset
        116 : 00                         nop
        117 : 00                         nop
        118 : 3E 4E                      ld      A, ASYNC_MODE
