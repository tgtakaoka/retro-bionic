        12A : CB 4F                      bit     ST_RxRDY_bp, A
        12C : 28 F8                      jr      Z, receive_loop
        12E :                    receive_data:
        12E : ED DB 40 01                ina     A, (USARTD)
        132 : 47                         ld      B, A
        133 : B7                         or      A, A
        134 : 28 15                      jr      Z, halt_to_system
        136 :                    transmit_loop:
        136 : ED DB 41 01                ina     A, (USARTS)
        13A : CB 47                      bit     ST_TxRDY_bp, A
        13C : 28 F8                      jr      Z, transmit_loop
        13E :                    transmit_data:
