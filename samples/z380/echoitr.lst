(1)     1E1 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     1E1 :                    ;;; [queue] queue structure
(1)     1E1 : =0                 queue_len:      equ     0       ; queue length
(1)     1E1 : =1                 queue_size:     equ     1       ; buffer size
(1)     1E1 : =2                 queue_put:      equ     2       ; queue put index
(1)     1E1 : =3                 queue_get:      equ     3       ; queue get index
(1)     1E1 : =4                 queue_buf:      equ     4       ; buffer start offset
(1)     1E1 :
(1)     1E1 :                    ;;; [queue] Initialize queue
(1)     1E1 :                    ;;; @param IX queue work space pointer
(1)     1E1 :                    ;;; @param B queue work space size
(1)     1E1 :                    ;;; @clobber B
(1)     1E2 :                            align   2
(1)     1E2 :                    queue_init:
(1)     1E2 : F5                         push    AF
(1)     1E3 : DD E5                      push    IX
(1)     1E5 : DD 36 00 00                ld      (IX+queue_len), 0
(1)     1E9 : 78                         ld      A, B
(1)     1EA : D6 04                      sub     queue_buf
(1)     1EC : DD 77 01                   ld      (IX+queue_size), A
(1)     1EF : C6 02                      add     A, 2            ; for queue_put and queue_get
(1)     1F1 :                    queue_init_loop:
(1)     1F1 : DD 23                      inc     IX
(1)     1F3 : DD 36 01 00                ld      (IX+queue_size), 0
(1)     1F7 : 3D                         dec     A
(1)     1F8 : 20 F7                      jr      NZ, queue_init_loop
(1)     1FA : DD E1                      pop     IX
(1)     1FC : F1                         pop     AF
(1)     1FD : C9                         ret
(1)     1FE :
(1)     1FE :                    ;;; [queue] Add an element to queue
(1)     1FE :                    ;;; @param IX queue work space pointer
(1)     1FE :                    ;;; @param A an element
(1)     1FE :                    ;;; @return F.C 0 if queue is full
(1)     1FE :                            align   2
(1)     1FE :                    queue_add:
(1)     1FE : D5                         push    DE
(1)     1FF : 57                         ld      D, A            ; save an element
(1)     200 : DD 7E 00                   ld      A, (IX+queue_len)
(1)     203 : DD BE 01                   cp      (IX+queue_size)
(1)     206 : 7A                         ld      A, D               ; restore an element
(1)     207 : 38 02                      jr      C, queue_add_store ; queue_len < queue_size
(1)     209 : D1                         pop     DE                 ; F.C=0
(1)     20A : C9                         ret
(1)     20B :                    queue_add_store:
(1)     20B : DD 34 00                   inc     (IX+queue_len)
(1)     20E : DD 5E 02                   ld      E, (IX+queue_put)
(1)     211 : 16 00                      ld      D, 0
(1)     213 : DD E5                      push    IX
(1)     215 : DD 19                      add     IX, DE          ; IX+queue_buf=&queue_buf[queue_put]
(1)     217 : DD 77 04                   ld      (IX+queue_buf), A ; store an element
(1)     21A : DD E1                      pop     IX
(1)     21C : 57                         ld      D, A            ; save an element
(1)     21D : 7B                         ld      A, E
(1)     21E : 3C                         inc     A               ; queue_put++
(1)     21F : DD BE 01                   cp      (IX+queue_size)
(1)     222 : 38 01                      jr      C, queue_add_update ; queue_put < queue_size
(1)     224 : AF                         xor     A                   ; wrap around
(1)     225 :                    queue_add_update:
(1)     225 : DD 77 02                   ld      (IX+queue_put), A
(1)     228 : 7A                         ld      A, D            ; restore an element
(1)     229 : D1                         pop     DE
(1)     22A : 37                         scf                     ; set carry
(1)     22B : C9                         ret
(1)     22C :
(1)     22C :                    ;;; [queue] Remove an element from queue
(1)     22C :                    ;;; @param IX queue work space pointer
