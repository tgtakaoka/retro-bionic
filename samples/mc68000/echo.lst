          0 :                            include "mc68000.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; MC68000 family
(1)       0 :                            cpu     mc68000
(1)       0 :
(1)       0 :                    ;;; Status Register (SR)
(1)       0 : =8000              SR_T:           equ     %1000000000000000 ; trace
(1)       0 : =2000              SR_S:           equ     %0010000000000000 ; supervisor
(1)       0 : =700               SR_I_gm:        equ     %0000011100000000 ; interrupt priority mask
(1)       0 : =10                SR_X:           equ     %0000000000010000 ; extend
(1)       0 : =8                 SR_N:           equ     %0000000000001000 ; negative
(1)       0 : =4                 SR_Z:           equ     %0000000000000100 ; zero
(1)       0 : =2                 SR_V:           equ     %0000000000000010 ; overflow
(1)       0 : =1                 SR_C:           equ     %0000000000000001 ; carry
(1)       0 :
(1)       0 :                    ;;; Exception vectors with VBR 0 (M68000UM Table 6-2)
(1)       0 : =0                 VEC_RESET:      equ     $000000 ; $000000: SSP, then PC
(1)       0 : =8                 VEC_BERR:       equ     $000008 ; $000008: Bus Error
(1)       0 : =C                 VEC_ADDR:       equ     $00000C ; $00000C: Address Error
(1)       0 : =10                VEC_ILLEGAL:    equ     $000010 ; $000010: Illegal Instruction
(1)       0 : =14                VEC_DIV0:       equ     $000014 ; $000014: Zero Divide
(1)       0 : =18                VEC_CHK:        equ     $000018 ; $000018: CHK Instruction
(1)       0 : =1C                VEC_TRAPV:      equ     $00001C ; $00001C: TRAPV Instruction
(1)       0 : =20                VEC_PRIV:       equ     $000020 ; $000020: Privilege Violation
(1)       0 : =24                VEC_TRACE:      equ     $000024 ; $000024: Trace
(1)       0 : =3C                VEC_UNINIT:     equ     $00003C ; $00003C: Uninitialized Interrupt
(1)       0 : =60                VEC_SPURIOUS:   equ     $000060 ; $000060: Spurious Interrupt
(1)       0 : =64                VEC_LEVEL1:     equ     $000064 ; $000064: Level 1 Interrupt Autovector
(1)       0 : =7C                VEC_LEVEL7:     equ     $00007C ; $00007C: Level 7 Interrupt Autovector
(1)       0 : =80                VEC_TRAP0:      equ     $000080 ; $000080: TRAP #0
(1)       0 : =100               VEC_USER:       equ     $000100 ; $000100: User Interrupt Vectors, 64-255
(1)       0 :
(1)       0 :                    ;;; Every interrupt is acknowledged with a vector number: the ACIA's is
(1)       0 :                    ;;; the first user vector, as the regress wires it (I ACIA addr 64).
(1)       0 : =40                VECNUM_ACIA:    equ     64
(1)       0 : =100               VEC_ACIA:       equ     VECNUM_ACIA*4
(1)       0 :
(1)       0 :                    ;;; MC6850 Asynchronous Communication Interface Adapter at $FFFFF0,
(1)       0 :                    ;;; reached as (ACIA_xxx).w on every board: a board with fewer address
(1)       0 :                    ;;; lines sees it masked to them.
(1)       0 : =FFFFF0            ACIA:           equ     $FFFFF0
(1)       0 :                            include "../mc6800/mc6850.inc"
(2)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)       0 :
(2)       0 :                    ;;; MC6850
(2)       0 :                    ;;; Asynchronous Communication Interface Adapter
(2)       0 :
(2)       0 :                    ;;; Control register (write)
(2)       0 : =FFFFF0            ACIA_control:   equ     ACIA+0
(2)       0 :                            ;; Counter Divider Select Bits
(2)       0 : =3                 CDS_gm:         equ     %11    ; Group mask
(2)       0 : =0                 CDS_DIV1_gc:    equ     %00000000 ; /1
(2)       0 : =1                 CDS_DIV16_gc:   equ     %00000001 ; /16
(2)       0 : =2                 CDS_DIV64_gc:   equ     %00000010 ; /64
(2)       0 : =3                 CDS_RESET_gc:   equ     %00000011 ; Master Reset
(2)       0 :                            ;; Word Select Bits
(2)       0 : =1C                WSB_gm:         equ     %00011100 ; Group mask
(2)       0 : =0                 WSB_7E2_gc:     equ     %00000000 ; 7 Bits + Even Parity + 2 Stop Bits
(2)       0 : =4                 WSB_7O2_gc:     equ     %00000100 ; 7 bits + Odd Parity  + 2 Stop Bits
(2)       0 : =8                 WSB_7E1_gc:     equ     %00001000 ; 7 bits + Even Parity + 1 Stop Bits
(2)       0 : =C                 WSB_7O1_gc:     equ     %00001100 ; 7 bits + Odd Parity  + 1 Stop Bits
(2)       0 : =10                WSB_8N2_gc:     equ     %00010000 ; 8 bits + No Parity   + 2 Stop Bits
(2)       0 : =14                WSB_8N1_gc:     equ     %00010100 ; 8 bits + No Parity   + 1 Stop Bits
(2)       0 : =18                WSB_8E1_gc:     equ     %00011000 ; 8 bits + Even Parity + 1 Stop Bits
(2)       0 : =1C                WSB_8O1_gc:     equ     %00011100 ; 8 bits + Odd Parity  + 1 Stop Bits
(2)       0 :                            ;; Transmit Control Bits
(2)       0 : =60                TCB_gm:         equ     %01100000 ; Group mask
(2)       0 : =0                 TCB_DI_gc:      equ     %00000000 ; RTS=Low,  Tx Interrupt Disabled
(2)       0 : =20                TCB_EI_gc:      equ     %00100000 ; RTS=Low,  Tx Interrupt Enabled
(2)       0 : =40                TCB_RTS_gc:     equ     %01000000 ; RTS=High, Tx Interrupt Disabled
(2)       0 : =60                TCB_BREAK_gc:   equ     %01100000 ; RTS=Low,  Tx Interrupt Disabled
(2)       0 :                                                      ; Transmit Break Level
(2)       0 : =80                RIEB_bm:        equ     %10000000 ; Receive Interrupt Enable Bit mask
(2)       0 :
(2)       0 :                    ;;; Status register (read)
(2)       0 : =FFFFF0            ACIA_status:    equ     ACIA+0
(2)       0 : =1                 RDRF_bm:        equ     %00000001 ; Receive Data Register Full
(2)       0 : =2                 TDRE_bm:        equ     %00000010 ; Transmit Data Register Empty
(2)       0 : =4                 DCDF_bm:        equ     %00000100 ; Data Carrier Detect Flag
(2)       0 : =8                 CTSF_bm:        equ     %00001000 ; Clear To Send Flag
(2)       0 : =10                FERR_bm:        equ     %00010000 ; Frame Error Flag
(2)       0 : =20                OVRN_bm:        equ     %00100000 ; Receiver Overrun Flag
(2)       0 : =40                PERR_bm:        equ     %01000000 ; Parity Error Flag
(2)       0 : =80                IRQF_bm:        equ     %10000000 ; Interrupt Request Flag
(2)       0 :
(2)       0 :                    ;;; Data register
(2)       0 : =FFFFF1            ACIA_data:      equ     ACIA+1          ; Data register
(1)       0 :
(1)       0 :                    ;;; Interrupts on, all levels; and off again. Neither touches CCR.
(1)       0 : =F8FF              INTR_ON:        equ     $F8FF   ; ANDI #INTR_ON,SR
(1)       0 : =700               INTR_OFF:       equ     $0700   ; ORI  #INTR_OFF,SR
          0 :
          0 : =1000              stack:  equ     $1000           ; SSP: a push decrements it first
          0 :
          0 :                            org     VEC_RESET
          0 : 0000 1000                  dc.l    stack
          4 : 0000 1000                  dc.l    initialize
          8 :
       1000 :                            org     $1000
       1000 :                    initialize:
       1000 : 11FC 0003 FFF0             move.b  #CDS_RESET_gc,(ACIA_control).w ; Master reset
       1006 : 11FC 0014 FFF0             move.b  #WSB_8N1_gc,(ACIA_control).w   ; 8 bits + No Parity + 1 Stop Bits
       100C :                                                                   ; Transmit, Receive interrupts disabled
       100C :
       100C : 6114               loop:   bsr.s   getchar
       100E : 4A00                       tst.b   d0
       1010 : 670E                       beq.s   halt_to_system
       1012 : 611C               echo:   bsr.s   putchar
       1014 : B03C 000D                  cmp.b   #$0D,d0
       1018 : 66F2                       bne.s   loop
       101A : 103C 000A                  move.b  #$0A,d0
       101E : 60F2                       bra.s   echo
       1020 :                    halt_to_system:
       1020 : 4AFC                       illegal                 ; halt to system
       1022 :
       1022 :                    getchar:
       1022 : 0838 0000 FFF0             btst    #0,(ACIA_status).w ; RDRF
       1028 : 67F8                       beq.s   getchar
       102A : 1038 FFF1                  move.b  (ACIA_data).w,d0
       102E : 4E75                       rts
       1030 :
       1030 :                    putchar:
       1030 : 0838 0001 FFF0             btst    #1,(ACIA_status).w ; TDRE
       1036 : 67F8                       beq.s   putchar
       1038 : 11C0 FFF1                  move.b  d0,(ACIA_data).w
       103C : 4E75                       rts
