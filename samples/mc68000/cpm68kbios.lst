      1B2B0 :                    ;;; Scratch areas.
      1B2B0 :                    dirbuf: ds.b    128
      1B330 :                    csv:    ds.b    16*NDISKS
      1B370 :                    alv:    ds.b    ALV_SIZE*NDISKS
      1B56C :                    iobyte: ds.b    1
