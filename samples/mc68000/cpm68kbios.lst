(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :
(1)       0 :                    ;;; CP/M-68K 1.3's CCP and BDOS linked at 15000H with an empty BIOS at
(1)       0 :                    ;;; 1B000H: DRI's DISK8/CPM15000.SR for the 68000, or the 68010 system
(1)       0 :                    ;;; cpm68010.sub links. Both end below 1B000H, with their entry points
(1)       0 :                    ;;; at the same addresses, and the S-record image zeroes their BSS. The
(1)       0 :                    ;;; BIOS follows, and the TPA is the memory above it, up to TPA_GAP
(1)       0 :                    ;;; below the top of the board's address space, where the I/O devices
(1)       0 :                    ;;; are.
(1)       0 : =15000             CPM:            equ     $15000          ; cold start
(1)       0 : =150BC             CCP:            equ     $150BC          ; warm start
(1)       0 : =1B000             BIOS:           equ     $1B000          ; _init
(1)       0 : =1C000             TPA:            equ     $1C000
(1)       0 : =10000             TPA_GAP:        equ     $10000
(1)       0 : =800000            MEM_MAX:        equ     $800000         ; Alcyon's AS68 fails with more
(1)       0 : =1A                SPT:            equ     26              ; sectors a track
          0 :
          0 : =FFFFE0            DISK:   equ     $FFFFE0
          0 :                            include "../i8080/sector_disk.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :
(1)       0 :                    ;;; The debugger's paravirtual sector disk (debugger/sector_disk.h).
(1)       0 :                    ;;; DISK is its base port.
(1)       0 : =FFFFE0            DISK_DRIVE:     equ     DISK+0  ; 0-3
(1)       0 : =FFFFE1            DISK_TRACK:     equ     DISK+1  ; 0-76
(1)       0 : =FFFFE2            DISK_SECTOR:    equ     DISK+2  ; 1-26, physical
(1)       0 : =FFFFE3            DISK_DMAL:      equ     DISK+3  ; DMA address, low byte
(1)       0 : =FFFFE4            DISK_DMAH:      equ     DISK+4  ; high byte
(1)       0 : =FFFFE5            DISK_COMMAND:   equ     DISK+5  ; write a command, read its status
(1)       0 : =FFFFE6            DISK_MOUNTED:   equ     DISK+6  ; bit n: drive n has its image
(1)       0 : =FFFFE7            DISK_DMAX:      equ     DISK+7  ; DMA address bits 16-23
(1)       0 : =1                 CMD_READ:       equ     1
(1)       0 : =2                 CMD_WRITE:      equ     2
          0 : =4                 NDISKS: equ     4
          0 : =1A                DPH_SIZE:       equ     26
          0 : =0                 DPH_XLT:        equ     0
          0 : =E                 DPH_DPB:        equ     14
          0 : =7F                ALV_SIZE:       equ     127     ; hd8's 1016 blocks, a bit each
