      1B218 : 1218 040A 1016
      1B21E :
      1B21E :                    ;;; 8" single-density disk parameters: 1K blocks, 243 of them, 64
      1B21E :                    ;;; directory entries, 2 system tracks.
      1B21E :                    dpb:
      1B21E : 001A                       dc.w    SPT             ; SPT, sectors a track
      1B220 : 03                         dc.b    3               ; BSH, block shift
      1B221 :   07                       dc.b    7               ; BLM, block mask
      1B222 : 00                         dc.b    0               ; EXM, extent mask
      1B223 :   00                       dc.b    0
      1B224 : 00F2                       dc.w    242             ; DSM, last block
      1B226 : 003F                       dc.w    63              ; DRM, last directory entry
      1B228 : C0                         dc.b    $C0             ; AL0, the directory's blocks
      1B229 :   00                       dc.b    0               ; AL1
      1B22A : 0010                       dc.w    16              ; CKS, directory check size
      1B22C : 0002                       dc.w    2               ; OFF, system tracks
      1B22E :
      1B22E :                    ;;; hd8, the debugger's 8 MB format: 256 tracks of 256 sectors from 0,
      1B22E :                    ;;; no skew, 8K blocks, 1024 directory entries, 2 system tracks. The
      1B22E :                    ;;; values are the format's, the same under every CP/M.
      1B22E :                    dpb_hd8:
      1B22E : 0100                       dc.w    256             ; SPT
      1B230 : 06                         dc.b    6               ; BSH
      1B231 :   3F                       dc.b    63              ; BLM
      1B232 : 03                         dc.b    3               ; EXM
      1B233 :   00                       dc.b    0
      1B234 : 03F7                       dc.w    1015            ; DSM
      1B236 : 03FF                       dc.w    1023            ; DRM
      1B238 : F0                         dc.b    $F0             ; AL0
      1B239 :   00                       dc.b    0               ; AL1
      1B23A : 0000                       dc.w    0               ; CKS, a fixed disk
      1B23C : 0002                       dc.w    2               ; OFF
      1B23E :
      1B23E :                    ;;; SELDSK sets each DPH's skew and DPB by the drive's format.
      1B23E : 0001 B204          dph0:   dc.l    xlt
      1B242 : 0000 0000 0000             dc.w    0, 0, 0
      1B248 : 0001 B2B0 0001             dc.l    dirbuf, dpb, csv+16*0, alv+ALV_SIZE*0
      1B24E : B21E 0001 B330
      1B254 : 0001 B370
      1B258 : 0001 B204                  dc.l    xlt
      1B25C : 0000 0000 0000             dc.w    0, 0, 0
      1B262 : 0001 B2B0 0001             dc.l    dirbuf, dpb, csv+16*1, alv+ALV_SIZE*1
      1B268 : B21E 0001 B340
      1B26E : 0001 B3EF
      1B272 : 0001 B204                  dc.l    xlt
      1B276 : 0000 0000 0000             dc.w    0, 0, 0
      1B27C : 0001 B2B0 0001             dc.l    dirbuf, dpb, csv+16*2, alv+ALV_SIZE*2
      1B282 : B21E 0001 B350
      1B288 : 0001 B46E
      1B28C : 0001 B204                  dc.l    xlt
      1B290 : 0000 0000 0000             dc.w    0, 0, 0
      1B296 : 0001 B2B0 0001             dc.l    dirbuf, dpb, csv+16*3, alv+ALV_SIZE*3
      1B29C : B21E 0001 B360
      1B2A2 : 0001 B4ED
      1B2A6 :
      1B2A6 :                    ;;; One region: the TPA, sized at cold boot.
      1B2A6 : 0001               mrt:    dc.w    1
      1B2A8 : 0001 C000                  dc.l    TPA
      1B2AC :                    mrt_size:
      1B2AC : 0000 0000                  dc.l    0
