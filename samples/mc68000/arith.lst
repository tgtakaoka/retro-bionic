(1)       0 :                    ;;; Exception vectors with VBR 0 (M68000UM Table 6-2)
(1)       0 : =0                 VEC_RESET:      equ     $000000 ; $000000: SSP, then PC
(1)       0 : =8                 VEC_BERR:       equ     $000008 ; $000008: Bus Error
(1)       0 : =C                 VEC_ADDR:       equ     $00000C ; $00000C: Address Error
(1)       0 : =10                VEC_ILLEGAL:    equ     $000010 ; $000010: Illegal Instruction
(1)       0 : =14                VEC_DIV0:       equ     $000014 ; $000014: Zero Divide
(1)       0 : =18                VEC_CHK:        equ     $000018 ; $000018: CHK Instruction
(1)       0 : =1C                VEC_TRAPV:      equ     $00001C ; $00001C: TRAPV Instruction
