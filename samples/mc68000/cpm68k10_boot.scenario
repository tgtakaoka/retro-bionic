# Scenario for scripts/record-scenario.py, the end of a `make cpm68k10`
# cast: the MC68010 system the board just linked, L mc68000/cpm68k10.s19
# mounting cpm68k10a.dsk and cpm68k10b.dsk beside it, boots to A>.
#
# Needs the SD card's mc68000/cpm68k10.s19, cpm68k10a.dsk and
# cpm68k10b.dsk, which `make cpm68k10-sd` puts there.

pace 2.0

command L mc68000/cpm68k10.s19

key R
type G
wait backtrace?
type 5\r
waitfor 20 A>
pace 1.5

type DIR\r
wait A>
type DIR B:\r
wait A>
pace 2.0

halt
