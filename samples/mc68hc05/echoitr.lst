(1)    10B7 : 7C                         inc     queue_len,x      ; increment queue length
(1)    10B8 : E6 02                      lda     queue_put,x      ; 8 bits offset
(1)    10BA : 4C                         inca
(1)    10BB : E7 02                      sta     queue_put,x     ; update put pointer
