       10FB :                    isr_irq:
       10FB : C6 FF FF                   lda     COP_RESET       ; service the MC68HC08's COP
       10FE : C7 FF FF                   sta     COP_RESET
       1101 : C6 FF E0                   lda     ACIA_status
       1104 : A5 80                      bit     #IRQF_bm
       1106 : 27 20                      beq     isr_irq_exit
       1108 : C6 FF E0                   lda     ACIA_status
       110B : A5 01                      bit     #RDRF_bm
       110D : 27 08                      beq     isr_irq_send
