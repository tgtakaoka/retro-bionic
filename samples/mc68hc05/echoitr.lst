(1)    10CC : 97                         tax
(1)    10CD : C6 10 AE                   lda     queue_add_A
(1)    10D0 : F7                         sta     ,x              ; put element
(1)    10D1 : CE 10 AD                   ldx     queue_add_X     ; restore X
