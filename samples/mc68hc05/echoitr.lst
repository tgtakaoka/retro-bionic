       111A : A5 02                      bit     #TDRE_bm
       111C : 27 0A                      beq     isr_irq_exit
       111E : AE 90                      ldx     #tx_queue
       1120 : CD 10 DA                   jsr     queue_remove
       1123 : 24 04                      bcc     isr_irq_send_empty
       1125 : C7 FF E1                   sta     ACIA_data       ; send character
       1128 :                    isr_irq_exit:
