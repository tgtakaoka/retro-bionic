[2.031554, "o", "\r\r\n* Bionic"]
[2.035497, "o", "MC6802 * 1.0\r\r\nPC=017A SP=0FFD X=2000 A=F6 B=0D CC=__N___\r\r\n017A: 86 CF     LDAA #$CF\r\r\n\r\r\n  R              : reset the target MC6802\r\r\n  U              : upload Intel HEX / S-record (^C to end)\r\r\n  G [n]          : run freely, backtrace last n lines (default: all)\r\r\n  g addr [n]     : run until addr (a one-shot breakpoint), same backtrace\r\r\n  B addr         : set a breakpoint\r\r\n  b [index]      : list breakpoints, clear one\r\r\n  S              : step one instruction\r\r\n\r\r\n  r              : print registers\r\r\n  = reg value    : set a register (unknown name lists valid names)\r\r\n  d addr [len]   : dump data memory (len defaults to 16)\r\r\n  p addr [len]   : dump program memory (len defaults to 16)\r\r\n  D addr [n]     : disassemble n instructions (default 20)\r\r\n  m addr byte... : write & dump data memory, 16 bytes max\r\r\n  M addr byte... : write & dump program memory, 16 bytes max\r\r\n  c addr n v...  : fill data memory, n times v... (16 max)\r\r\n  C addr n v...  : fill program memory, likewise\r\r\n\r\r\n  I dev [addr]   : select an I/O device, opt"]
[2.035639, "o", "ionally its base\r\r\n  P [from to]    : show, or set, protect area\r\r\n  W +identity    : write identity EEPROM\r\r\n  V              : toggle verbose bus-cycle printing\r\r\n  ?              : this help\r\r\n\r\r\n  HALT button    : stop a free running MC6802\r\r\n                   held at power up skips the identity EEPROM check, to recover\r\r\n                   from a bad identity EEPROM\r\r\n  2nd USB serial : send any byte to stop a free running MC6802\r\r\n> "]
[5.282508, "o", "Reset\r\r\nPC=0100 SP=7FFF X=2000 A=F6 B=0D CC=_I____\r\r\n0100: 8E 0F FF  LDS  #$0FFF\r\r\n> "]
