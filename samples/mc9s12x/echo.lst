(1)    FFFE :                            org     VEC_RESET
(1)    FFFE : 40 00                      fdb     initialize
(1)   10000 :
(1)    4000 :                            org     CODE_ORG
(1)    4000 :                    initialize:
(1)    4000 : CF 40 00                   lds     #stack
(1)    4003 : 86 03                      ldaa    #CDS_RESET_gc   ; Master reset
(1)    4005 : 7A DF 00                   staa    ACIA_control
(1)    4008 : 86 14                      ldaa    #WSB_8N1_gc     ; 8 bits + No Parity + 1 Stop Bits
(1)    400A :                                                    ; Transmit, Receive interrupts disabled
(1)    400A : 7A DF 00                   staa    ACIA_control
(1)    400D :
(1)    400D : 07 1B              loop:   bsr     getchar
(1)    400F : 97                         tsta
(1)    4010 : 27 0A                      beq     halt_to_system
(1)    4012 : 07 21              echo:   bsr     putchar
(1)    4014 : 81 0D                      cmpa    #$0D
(1)    4016 : 26 F5                      bne     loop
(1)    4018 : 86 0A                      ldaa    #$0A
(1)    401A : 20 F6                      bra     echo
(1)    401C :                    halt_to_system:
(1)    401C : CE 40 23                   ldx     #step_swi
(1)    401F : 7E FF F6                   stx     VEC_SWI
(1)    4022 : 3F                         swi
(1)    4023 :                    step_swi:
(1)    4023 : CE FF F6                   ldx     #VEC_SWI
(1)    4026 : 7E FF F6                   stx     VEC_SWI
(1)    4029 : 3F                         swi                     ; halt to system
(1)    402A :
(1)    402A :                    getchar:
(1)    402A : B6 DF 00                   ldaa    ACIA_status
(1)    402D : 85 01                      bita    #RDRF_bm
(1)    402F : 27 F9                      beq     getchar
(1)    4031 : B6 DF 01                   ldaa    ACIA_data
(1)    4034 : 3D                         rts
(1)    4035 :
(1)    4035 :                    putchar:
(1)    4035 : F6 DF 00                   ldab    ACIA_status
(1)    4038 : C5 02                      bitb    #TDRE_bm
(1)    403A : 27 F9                      beq     putchar
(1)    403C : 7A DF 01                   staa    ACIA_data
(1)    403F : 3D                         rts
