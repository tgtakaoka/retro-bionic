(2)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)       0 :                    ;;; The CPU12: what every MC68HC12, HCS12 and HCS12X shares
(2)       0 :                            cpu     68hc12
(2)       0 :                    ;;; Condition Code Register (CC)
(2)       0 : =1                 CC_CARRY      equ  %00000001   ; set to 1 if carry occurred
(2)       0 : =2                 CC_OVERFLOW   equ  %00000010   ; set to 1 if overflow occurred
(2)       0 : =4                 CC_ZERO       equ  %00000100   ; set to 1 if result is zero
(2)       0 : =8                 CC_NEGATIVE   equ  %00001000   ; set to 1 if result is negative
(2)       0 : =10                CC_IRQ        equ  %00010000   ; if 1, IRQ is masked
(2)       0 : =20                CC_HALF_CARRY equ  %00100000   ; if 1, decimal carry from least digit occurred
(2)       0 : =40                CC_XIRQ       equ  %01000000   ; if 1, XIRQ is masked
(2)       0 : =80                CC_STOP       equ  %10000000   ; if 1, STOP instruction is disabled
(2)       0 :
(2)       0 :                    ;;; Vector
(2)       0 : =FFF2              VEC_IRQ:        equ     $FFF2  ; $FFF2: #IRQ
(2)       0 : =FFF4              VEC_XIRQ:       equ     $FFF4  ; $FFF4: #XIRQ
(2)       0 : =FFF6              VEC_SWI:        equ     $FFF6  ; $FFF6: Software Interrupt
(2)       0 : =FFF8              VEC_TRAP:       equ     $FFF8  ; $FFF8: Unimplemented Opcode Trap
(2)       0 : =FFFA              VEC_COP:        equ     $FFFA  ; $FFFA: COP (Watchdog) Failure
(2)       0 : =FFFC              VEC_CMF:        equ     $FFFC  ; $FFFC: Clock Monitor Fail
(2)       0 : =FFFE              VEC_RESET:      equ     $FFFE  ; $FFFE: Reset
(1)       0 :                            include "../mc68hc12/mc68hc12_sci.inc"
(2)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)       0 :                    ;;; SCI registers, as offsets from the chip's SCI0_BASE
(2)       0 : =0                 SC0BDH:         equ     0      ; Baud Rate Control High: SBR12-SBR8
(2)       0 : =1                 SC0BDL:         equ     1      ; Baud Rate Control Low: SBR7-SBR0
(2)       0 : =2                 SC0CR1:         equ     2      ; Control Register 1
(2)       0 : =3                 SC0CR2:         equ     3      ; Control Register 2
(2)       0 : =4                 SC0SR1:         equ     4      ; Status Register 1
(2)       0 : =5                 SC0SR2:         equ     5      ; Status Register 2
(2)       0 : =6                 SC0DRH:         equ     6      ; Data Register High: R8/T8
(2)       0 : =7                 SC0DRL:         equ     7      ; Data Register Low
(2)       0 :                    ;;; SC0CR2
(2)       0 : =80                SC0CR2_TIE_bm:  equ     %10000000 ; Transmit Interrupt Enable
(2)       0 : =40                SC0CR2_TCIE_bm: equ     %01000000 ; Transmit Complete Interrupt Enable
(2)       0 : =20                SC0CR2_RIE_bm:  equ     %00100000 ; Receiver Interrupt Enable
(2)       0 : =10                SC0CR2_ILIE_bm: equ     %00010000 ; Idle Line Interrupt Enable
(2)       0 : =8                 SC0CR2_TE_bm:   equ     %00001000 ; Transmitter Enable
(2)       0 : =4                 SC0CR2_RE_bm:   equ     %00000100 ; Receiver Enable
(2)       0 :                    ;;; SC0SR1
(2)       0 : =80                SC0SR1_TDRE_bm: equ     %10000000 ; Transmit Data Register Empty
(2)       0 : =40                SC0SR1_TC_bm:   equ     %01000000 ; Transmit Complete
(2)       0 : =20                SC0SR1_RDRF_bm: equ     %00100000 ; Receive Data Register Full
(2)       0 : =10                SC0SR1_IDLE_bm: equ     %00010000 ; Idle Line Detected
(2)       0 : =8                 SC0SR1_OR_bm:   equ     %00001000 ; Overrun Error
(2)       0 : =4                 SC0SR1_NF_bm:   equ     %00000100 ; Noise Error
(2)       0 : =2                 SC0SR1_FE_bm:   equ     %00000010 ; Framing Error
(2)       0 : =1                 SC0SR1_PF_bm:   equ     %00000001 ; Parity Error
