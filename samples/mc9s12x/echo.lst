(1)       0 :
(1)       0 : =FFD6              VEC_SCI0:       equ     $FFD6  ; $FFD6: SCI0
(1)       0 :
(1)       0 :                    ;;; Internal memory, as reset leaves it in special test mode with ROMCTL
(1)       0 :                    ;;; low: the Flash off
(1)       0 : =0                 REG_BASE:       equ     $0000  ; $0000-$07FF: registers
(1)       0 : =800               EEPROM_BASE:    equ     $0800  ; $0800-$0FFF: EEPROM
(1)       0 : =1000              RAM_BASE:       equ     $1000  ; $1000-$3FFF: RAM
(1)       0 :
(1)       0 : =C8                SCI0_BASE:      equ     REG_BASE+$C8
(1)       0 :
(1)       0 :                    ;;; Where the samples go: data, queues and the stack in internal RAM; code
(1)       0 :                    ;;; outside, from $4000.
(1)       0 : =2000              DATA_ORG:       equ     $2000
(1)       0 : =2100              QUEUE_ORG:      equ     $2100
(1)       0 : =4000              STACK_TOP:      equ     $4000   ; SP points at the last byte pushed
(1)       0 : =4000              CODE_ORG:       equ     $4000
