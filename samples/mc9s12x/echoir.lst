(2)       0 :                            ;; Counter Divider Select Bits
(2)       0 : =3                 CDS_gm:         equ     %11    ; Group mask
(2)       0 : =0                 CDS_DIV1_gc:    equ     %00000000 ; /1
(2)       0 : =1                 CDS_DIV16_gc:   equ     %00000001 ; /16
(2)       0 : =2                 CDS_DIV64_gc:   equ     %00000010 ; /64
(2)       0 : =3                 CDS_RESET_gc:   equ     %00000011 ; Master Reset
(2)       0 :                            ;; Word Select Bits
(2)       0 : =1C                WSB_gm:         equ     %00011100 ; Group mask
(2)       0 : =0                 WSB_7E2_gc:     equ     %00000000 ; 7 Bits + Even Parity + 2 Stop Bits
(2)       0 : =4                 WSB_7O2_gc:     equ     %00000100 ; 7 bits + Odd Parity  + 2 Stop Bits
(2)       0 : =8                 WSB_7E1_gc:     equ     %00001000 ; 7 bits + Even Parity + 1 Stop Bits
(2)       0 : =C                 WSB_7O1_gc:     equ     %00001100 ; 7 bits + Odd Parity  + 1 Stop Bits
(2)       0 : =10                WSB_8N2_gc:     equ     %00010000 ; 8 bits + No Parity   + 2 Stop Bits
(2)       0 : =14                WSB_8N1_gc:     equ     %00010100 ; 8 bits + No Parity   + 1 Stop Bits
(2)       0 : =18                WSB_8E1_gc:     equ     %00011000 ; 8 bits + Even Parity + 1 Stop Bits
(2)       0 : =1C                WSB_8O1_gc:     equ     %00011100 ; 8 bits + Odd Parity  + 1 Stop Bits
(2)       0 :                            ;; Transmit Control Bits
(2)       0 : =60                TCB_gm:         equ     %01100000 ; Group mask
(2)       0 : =0                 TCB_DI_gc:      equ     %00000000 ; RTS=Low,  Tx Interrupt Disabled
(2)       0 : =20                TCB_EI_gc:      equ     %00100000 ; RTS=Low,  Tx Interrupt Enabled
(2)       0 : =40                TCB_RTS_gc:     equ     %01000000 ; RTS=High, Tx Interrupt Disabled
(2)       0 : =60                TCB_BREAK_gc:   equ     %01100000 ; RTS=Low,  Tx Interrupt Disabled
(2)       0 :                                                      ; Transmit Break Level
(2)       0 : =80                RIEB_bm:        equ     %10000000 ; Receive Interrupt Enable Bit mask
(2)       0 :
