(2)    4079 : A6 E5                      ldaa    b,x             ; read an element
(2)    407B : 63 00                      dec     queue_len,x
(2)    407D : C0 03                      subb    #queue_buf-1    ; the next get index
(2)    407F : 6B 03                      stab    queue_get,x
(2)    4081 : E1 01                      cmpb    queue_size,x
(2)    4083 : 25 04                      blo     queue_remove_return ; carry is set
(2)    4085 : 69 03                      clr     queue_get,x
(2)    4087 : 14 01                      sec                     ; set carry
(2)    4089 :                    queue_remove_return:
