(2)    406D :                    queue_remove:
(2)    406D : E7 00                      tst     queue_len,x
(2)    406F : 26 03                      bne     queue_remove_elem
(2)    4071 : 10 FE                      clc                     ; clear carry
(2)    4073 : 3D                         rts
(2)    4074 :                    queue_remove_elem:
(2)    4074 : 37                         pshb
