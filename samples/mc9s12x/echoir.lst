(2)    4042 :                    ;;; [queue] queue structure
(2)    4042 : =0                 queue_len:      equ     0       ; queue length
(2)    4042 : =1                 queue_size:     equ     1       ; buffer size
(2)    4042 : =2                 queue_put:      equ     2       ; queue put index
(2)    4042 : =3                 queue_get:      equ     3       ; queue get index
(2)    4042 : =4                 queue_buf:      equ     4       ; buffer start offset
(2)    4042 :
(2)    4042 :                    ;;; [queue] Initialize queue
(2)    4042 :                    ;;; @param X queue work space pointer
(2)    4042 :                    ;;; @param B queue work space size
(2)    4042 :                    ;;; @clobber B
(2)    4042 :                    queue_init:
(2)    4042 : 37                         pshb
(2)    4043 : 34                         pshx
(2)    4044 :                    queue_init_loop:
(2)    4044 : 69 30                      clr     1,x+
(2)    4046 : 04 31 FB                   dbne    b,queue_init_loop
(2)    4049 : 30                         pulx
(2)    404A : 33                         pulb
(2)    404B : C0 04                      subb    #queue_buf
(2)    404D : 6B 01                      stab    queue_size,x
(2)    404F : 3D                         rts
(2)    4050 :
(2)    4050 :                    ;;; [queue] Add an element to queue
(2)    4050 :                    ;;; @param X queue work space pointer
(2)    4050 :                    ;;; @param A an element
(2)    4050 :                    ;;; @return CC.C 0 if queue is full
(2)    4050 :                    queue_add:
(2)    4050 : 37                         pshb
(2)    4051 : E6 00                      ldab    queue_len,x
(2)    4053 : E1 01                      cmpb    queue_size,x
(2)    4055 : 24 14                      bhs     queue_add_return ; carry is cleared
(2)    4057 : E6 02                      ldab    queue_put,x
(2)    4059 : CB 04                      addb    #queue_buf      ; 8 bits offset of the element
(2)    405B : 6A E5                      staa    b,x             ; store an element
(2)    405D : 62 00                      inc     queue_len,x
(2)    405F : C0 03                      subb    #queue_buf-1    ; the next put index
(2)    4061 : 6B 02                      stab    queue_put,x
(2)    4063 : E1 01                      cmpb    queue_size,x
(2)    4065 : 25 04                      blo     queue_add_return ; carry is set
(2)    4067 : 69 02                      clr     queue_put,x
(2)    4069 : 14 01                      sec                     ; set carry
(2)    406B :                    queue_add_return:
(2)    406B : 33                         pulb
(2)    406C : 3D                         rts
(2)    406D :
(2)    406D :                    ;;; [queue] Remove an element from queue
