(1)     189 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     189 :                    ;;; [queue] queue structure
(1)     189 : =0                 queue_len:      equ     0       ; queue length
(1)     189 : =1                 queue_size:     equ     1       ; buffer size
(1)     189 : =2                 queue_put:      equ     2       ; queue put index
(1)     189 : =3                 queue_get:      equ     3       ; queue get index
(1)     189 : =4                 queue_buf:      equ     4       ; buffer start offset
(1)     189 :
(1)     189 :                    ;;; [queue] Initialize queue
(1)     189 :                    ;;; @param IX queue work space pointer
(1)     189 :                    ;;; @param B queue work space size
(1)     189 :                    ;;; @clobber B IX
(1)     189 :                    queue_init:
(1)     189 : F4 00 37 00                ld      (ix+queue_len), 0
(1)     18D : F8 6A 04                   sub     b, queue_buf
(1)     190 : F4 01 20                   ld      (ix+queue_size), b
(1)     193 : F8 68 02                   add     b, 2            ; for queue_put and queue_get
(1)     196 : F4 02 3C                   lda     ix, ix+queue_put
(1)     199 :                    queue_init_loop:
(1)     199 : EC 37 00                   ld      (ix), 0
(1)     19C : 94                         inc     ix
(1)     19D : 18 FA                      djnz    queue_init_loop
(1)     19F : 1E                         ret
(1)     1A0 :
(1)     1A0 :                    ;;; [queue] Add an element to queue
(1)     1A0 :                    ;;; @param IX queue work space pointer
(1)     1A0 :                    ;;; @param A an element
(1)     1A0 :                    ;;; @return F.C 0 if queue is full
(1)     1A0 :                    queue_add:
(1)     1A0 : 56                         push    af              ; save an element
(1)     1A1 : F0 00 2E                   ld      a, (ix+queue_len)
(1)     1A4 : F0 01 67                   cp      a, (ix+queue_size)
(1)     1A7 : C7 03                      jr      c, queue_add_store ; queue_len < queue_size
(1)     1A9 : 5E                         pop     af
(1)     1AA : 0C                         rcf                     ; clear carry
(1)     1AB : 1E                         ret
(1)     1AC :                    queue_add_store:
(1)     1AC : 86                         inc     a               ; queue_len++
(1)     1AD : F4 00 26                   ld      (ix+queue_len), a
(1)     1B0 : 52                         push    hl
(1)     1B1 : F4 04 3A                   lda     hl, ix+queue_buf
(1)     1B4 : F0 02 2E                   ld      a, (ix+queue_put)
(1)     1B7 : F7 3A                      lda     hl, hl+a
(1)     1B9 : F2 03 2E                   ld      a, (sp+3)       ; get element
(1)     1BC : EA 26                      ld      (hl), a         ; store element
(1)     1BE : 5A                         pop     hl
(1)     1BF : F0 02 2E                   ld      a, (ix+queue_put)
(1)     1C2 : 86                         inc     a
(1)     1C3 : F0 01 67                   cp      a, (ix+queue_size)
(1)     1C6 : C7 02                      jr      c, queue_add_update ; queue_put < queue_size
(1)     1C8 : 36 00                      ld      a, 0                ; wrap around
(1)     1CA :                    queue_add_update:
(1)     1CA : F4 02 26                   ld      (ix+queue_put), a
(1)     1CD : 5E                         pop     af
(1)     1CE : 0D                         scf                     ; set carry
(1)     1CF : 1E                         ret
(1)     1D0 :
(1)     1D0 :                    ;;; [queue] Remove an element from queue
(1)     1D0 :                    ;;; @param IX queue work space pointer
(1)     1D0 :                    ;;; @return A an element
(1)     1D0 :                    ;;; @return F.C 0 if queue is empty
(1)     1D0 :                    queue_remove:
(1)     1D0 : E4 2E                      ld      a, (ix)           ; queue_len
(1)     1D2 : FE 66                      or      a, a              ; clear carry
(1)     1D4 : FE D6                      ret     z                 ; carry is cleared by |or|
(1)     1D6 : 52                         push    hl
(1)     1D7 : 8E                         dec     a               ; queue_len--
(1)     1D8 : F4 00 26                   ld      (ix+queue_len), a
(1)     1DB : F4 04 3A                   lda     hl, ix+queue_buf
(1)     1DE : F0 03 2E                   ld      a, (ix+queue_get)
(1)     1E1 : F3 2E                      ld      a, (hl+a)       ; read element
(1)     1E3 : 2C                         ld      h, a            ; save element
(1)     1E4 : F0 03 2E                   ld      a, (ix+queue_get)
(1)     1E7 : 86                         inc     a
(1)     1E8 : F0 01 67                   cp      a, (ix+queue_size)
(1)     1EB : C7 02                      jr      c, queue_remove_update ; queue_get < queue_size
(1)     1ED : 36 00                      ld      a, 0                   ; wrap around
(1)     1EF :                    queue_remove_update:
(1)     1EF : F4 03 26                   ld      (ix+queue_get), a
(1)     1F2 : 24                         ld      a, h            ; restore element
(1)     1F3 : 5A                         pop     hl
(1)     1F4 : 0D                         scf                     ; set carry
(1)     1F5 : 1E                         ret
