[2.014326, "o", "TMS9980 * 1.0\r\r\nPC=0232  WP=0100  ST=__E__P______0000\r\r\nR0=0000  R1=0000  R2=0000  R3=0001  R4=0000  R5=9CC5  R6=6D02  R7=42D1\r\r\nR8=31DA  R9=2000 R10=1FFE R11=0214 R12=B1D7 R13=93B2 R14=53D1 R15=F4ED\r\r\n0232: 13FB            JEQ  >022A\r\r\n\r\r\n  R              : reset the target TMS9980\r\r\n  U              : upload Intel HEX / S-record (^C to end)\r\r\n  G [n]          : run freely, backtrace last n lines (default: all)\r\r\n  g addr [n]     : run until addr (a one-shot breakpoint), same backtrace\r\r\n  B addr         : set a breakpoint\r\r\n  b [index]      : list breakpoints, clear one\r\r\n  S              : step one instruction\r\r\n\r\r\n  r              : print registers\r\r\n  = reg value    : set a register (unknown name lists valid names)\r\r\n  d addr [len]   : dump data memory (len defaults to 16)\r\r\n  p addr [len]   : dump program memory (len defaults to 16)\r\r\n  D addr [n]     : disassemble n instructions (default 20)\r\r\n  m addr byte... : write & dump data memory, 16 bytes max\r\r\n  M addr byte... : write & dump program memory, 16 bytes max\r\r\n  c addr n v...  : fill data memory, n times v... (16 max)\r\r\n  C addr n v...  : fill program memory, likewise\r\r\n\r\r\n  I dev [addr]   : select an I/O device, optionally its base\r\r\n  P [from to]    : show, or set, protect area\r\r\n  W +identity    : write identity EEPROM\r\r\n  V              : toggle verbose bus-cycle printing\r\r\n  ?              : this help\r\r\n\r\r\n  HALT button    : stop a free running TMS9980\r\r\n                   held at power up skips the identity EEPROM check, to recover\r\r\n                   from a bad identity EEPROM\r\r\n  2nd USB serial : send any byte to stop a free running TMS9980\r\r\n> "]
