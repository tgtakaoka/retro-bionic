(1)     187 : =32                Fv:     equ     50              ; fixed-point 1.0
(1)     187 :                    ;;; Print one 79x25 frame of the Mandelbrot set: each point is its
(1)     187 :                    ;;; escape iteration in hex, or a space if it does not escape in 16.
