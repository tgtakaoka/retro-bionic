        165 : F5                         push    AF
        166 : E5                         push    HL
        167 : 21 80 20                   ld      HL, tx_queue
        16A :                    putchar_retry:
        16A : F3                         di
        16B : CD F9 02                   call    queue_add
        16E : FB                         ei
        16F : 30 F9                      jr      NC, putchar_retry ; branch if queue is full
