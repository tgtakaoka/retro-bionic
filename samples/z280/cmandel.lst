(1)     2E7 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     2E7 :                    ;;; [queue] The byte ring of ../z80/queue.inc, same structure and
(1)     2E7 :                    ;;; interface, written for the Z280: the element is addressed by
(1)     2E7 :                    ;;; base-index addressing, (HL+IX) with HL the offset into the
(1)     2E7 :                    ;;; structure, instead of two 16-bit adds through DE.
(1)     2E7 : =0                 queue_len:      equ     0       ; queue length
(1)     2E7 : =1                 queue_size:     equ     1       ; buffer size
(1)     2E7 : =2                 queue_put:      equ     2       ; queue put index
(1)     2E7 : =3                 queue_get:      equ     3       ; queue get index
(1)     2E7 : =4                 queue_buf:      equ     4       ; buffer start offset
(1)     2E7 :
(1)     2E7 :                    ;;; [queue] Initialize queue
