(1)       0 :                    ;;; Master Status register (3.3.1)
(1)       0 : =8000              MSR_BH_bm:      equ     8000H   ; Breakpoint-on-Halt enable
(1)       0 : =4000              MSR_US_bm:      equ     4000H   ; User/System: 1 = user mode
(1)       0 : =200               MSR_SSP_bm:     equ     0200H   ; Single-Step Pending
(1)       0 : =100               MSR_SS_bm:      equ     0100H   ; Single-Step enable
(1)       0 :                    ;;; Interrupt Request Enable bits, one per group (Table 6-1)
(1)       0 : =1                 MSR_INTA_bm:    equ     0001H   ; maskable interrupt line A
(1)       0 : =2                 MSR_CT0_bm:     equ     0002H   ; Counter/Timer 0, DMA channel 0
(1)       0 : =4                 MSR_INTB_bm:    equ     0004H   ; maskable interrupt line B
(1)       0 : =8                 MSR_CT1_bm:     equ     0008H   ; Counter/Timer 1, UART receiver, DMA channel 1
(1)       0 : =10                MSR_INTC_bm:    equ     0010H   ; maskable interrupt line C
(1)       0 : =20                MSR_UTX_bm:     equ     0020H   ; UART transmitter, DMA channel 2
(1)       0 : =40                MSR_CT2_bm:     equ     0040H   ; Counter/Timer 2, DMA channel 3
(1)       0 :                    ;;; Interrupt/Trap Vector Table (Table 6-5): each entry is an MSR word
(1)       0 :                    ;;; followed by a PC word. The table starts on a 4K physical boundary;
(1)       0 :                    ;;; the Vector Table Pointer holds A23-A12 of it in bits 15-4.
(1)       0 : =4                 IVT_NMI:        equ     04H
(1)       0 : =8                 IVT_INTA:       equ     08H
(1)       0 : =C                 IVT_INTB:       equ     0CH
(1)       0 : =10                IVT_INTC:       equ     10H
(1)       0 : =14                IVT_CT0:        equ     14H
(1)       0 : =18                IVT_CT1:        equ     18H
(1)       0 : =20                IVT_CT2:        equ     20H
(1)       0 : =24                IVT_DMA0:       equ     24H
(1)       0 : =28                IVT_DMA1:       equ     28H
(1)       0 : =2C                IVT_DMA2:       equ     2CH
(1)       0 : =30                IVT_DMA3:       equ     30H
(1)       0 : =34                IVT_URX:        equ     34H
(1)       0 : =38                IVT_UTX:        equ     38H
(1)       0 : =3C                IVT_SSTEP:      equ     3CH     ; Single-Step trap
(1)       0 : =40                IVT_BHALT:      equ     40H     ; Breakpoint-on-Halt trap
(1)       0 : =44                IVT_DIV:        equ     44H     ; Division Exception trap
(1)       0 : =48                IVT_SOVF:       equ     48H     ; Stack Overflow Warning trap
(1)       0 : =4C                IVT_ACCV:       equ     4CH     ; Access Violation trap
(1)       0 : =50                IVT_SC:         equ     50H     ; System Call trap
(1)       0 : =54                IVT_PRIV:       equ     54H     ; Privileged Instruction trap
(1)       0 : =58                IVT_EPU:        equ     58H     ; four Extended Instruction traps, 58H-64H
(1)       0 : =70                IVT_INTA_VEC:   equ     70H     ; 128 PC words for vectored line A (and NMI)
(1)       0 : =170               IVT_INTB_VEC:   equ     170H    ; 128 PC words for vectored line B
(1)       0 : =270               IVT_INTC_VEC:   equ     270H    ; 128 PC words for vectored line C
(1)       0 : =370               IVT_SIZE:       equ     370H
(1)       0 :                    ;;; Cache Control register (3.2.4)
(1)       0 : =80                CACHE_MC_bm:    equ     80H     ; on-chip memory is fixed memory, not a cache
(1)       0 : =40                CACHE_I_bm:     equ     40H     ; do not cache instruction fetches
(1)       0 : =20                CACHE_D_bm:     equ     20H     ; do not cache data
(1)       0 : =10                CACHE_LMB_bm:   equ     10H     ; burst transactions below 800000H
(1)       0 : =8                 CACHE_HMB_bm:   equ     08H     ; burst transactions from 800000H
