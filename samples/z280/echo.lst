        100 :                            org     0100H
        100 :                    init:
        100 : 31 00 10                   ld      SP, stack
        103 :
        103 :                    init_usart:
        103 : AF                         xor     A               ; clear A
        104 : 01 41 01                   ld      BC, USARTC
        107 : ED 79                      out     (C), A          ; (USARTC)
        109 : ED 79                      out     (C), A          ; (USARTC)
        10B : ED 79                      out     (C), A          ; safest way to sync mode
        10D : 3E 40                      ld      A, CMD_IR_bm
        10F : ED 79                      out     (C), A          ; reset
        111 : 00                         nop
        112 : 00                         nop
        113 : 3E 4E                      ld      A, ASYNC_MODE
        115 : ED 79                      out     (C), A
        117 : 00                         nop
        118 : 00                         nop
        119 : 3E 37                      ld      A, RX_EN_TX_EN
        11B : ED 79                      out     (C), A
        11D :
        11D :                    loop:
        11D : 01 41 01                   ld      BC, USARTS
        120 :                    receive_loop:
        120 : ED 78                      in      A, (C)          ; (USARTS)
        122 : CB 4F                      bit     ST_RxRDY_bp, A
        124 : 28 FA                      jr      Z, receive_loop
        126 :                    receive_data:
        126 : 01 40 01                   ld      BC, USARTD
        129 : ED 78                      in      A, (C)          ; (USARTD)
        12B : 57                         ld      D, A
        12C : B7                         or      A, A
        12D : 28 1A                      jr      Z, halt_to_system
        12F : 01 41 01                   ld      BC, USARTS
        132 :                    transmit_loop:
        132 : ED 78                      in      A, (C)          ; (USARTS)
        134 : CB 47                      bit     ST_TxRDY_bp, A
        136 : 28 FA                      jr      Z, transmit_loop
        138 :                    transmit_data:
        138 : 7A                         ld      A, D
        139 : 01 40 01                   ld      BC, USARTD
        13C : ED 79                      out     (C), A          ; (USARTD)
        13E : FE 0D                      cp      0DH
        140 : 20 DB                      jr      NZ, loop
        142 : 16 0A                      ld      D, 0AH
        144 : 01 41 01                   ld      BC, USARTS
        147 : 18 E9                      jr      transmit_loop
        149 :                    halt_to_system:
        149 : 21 38 00                   ld      HL, ORG_RST38
        14C : 36 FF                      ld      (HL), 0FFH
        14E : FF                         rst     38h
