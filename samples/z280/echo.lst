(1)       0 : =141               USARTS: equ     USART+1         ; Status register
(1)       0 : =141               USARTC: equ     USART+1         ; Control register
(1)       0 : =142               USARTRV:        equ     USART+2 ; Receive interrupt vector (ORG_*)
(1)       0 : =143               USARTTV:        equ     USART+3 ; Transmit interrupt vector (ORG_*)
