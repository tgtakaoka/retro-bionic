(1)     2DA :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     2DA :                    ;;; [queue] queue structure
(1)     2DA : =0                 queue_len:      equ     0       ; queue length
(1)     2DA : =1                 queue_size:     equ     1       ; buffer size
(1)     2DA : =2                 queue_put:      equ     2       ; queue put index
(1)     2DA : =3                 queue_get:      equ     3       ; queue get index
(1)     2DA : =4                 queue_buf:      equ     4       ; buffer start offset
(1)     2DA :
(1)     2DA :                    ;;; [queue] Initialize queue
(1)     2DA :                    ;;; @param HL queue work space pointer
(1)     2DA :                    ;;; @param B queue work space size
(1)     2DA :                    ;;; @clobber B
(1)     2DA :                    queue_init:
