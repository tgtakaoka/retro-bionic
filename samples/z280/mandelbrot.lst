(1)     2ED : 23                         inc     HL
(1)     2EE : 36 00                      ld      (HL), 0         ; queue_put
(1)     2F0 : 23                         inc     HL
(1)     2F1 : 36 00                      ld      (HL), 0         ; queue_get
