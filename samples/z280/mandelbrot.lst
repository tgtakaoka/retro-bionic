(1)     182 :
(1)     182 : =32                Fv:     equ     50              ; fixed-point 1.0
(1)     182 :                    ;;; Print one 79x25 frame of the Mandelbrot set: each point is its
(1)     182 :                    ;;; escape iteration in hex, or a space if it does not escape in 16.
(1)     182 :                    ;;; Exits to the debugger when NUL is received.
(1)     182 :                    mandelbrot:
(1)     182 : 3E F4                      ld      A, -12
(1)     184 : 32 A4 02                   ld      (vY), A         ; Y=-12
(1)     187 :                    loop_y:
