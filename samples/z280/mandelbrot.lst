(1)     2EF : E5                         push    HL
(1)     2F0 : DD E3                      ex      (SP), IX        ; IX points queue structure
(1)     2F2 : 57                         ld      D, A            ; save an element
(1)     2F3 : DD 7E 00                   ld      A, (IX+queue_len)
(1)     2F6 : DD BE 01                   cp      (IX+queue_size)
(1)     2F9 : 7A                         ld      A, D               ; restore an element
(1)     2FA : 38 05                      jr      C, queue_add_store ; queue_len < queue_size
(1)     2FC : DD E3                      ex      (SP), IX           ; F.C=1
(1)     2FE : E1                         pop     HL
(1)     2FF : D1                         pop     DE
(1)     300 : C9                         ret
