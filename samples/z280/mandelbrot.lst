(1)     30C : 77                         ld      (HL), A         ; store an element
(1)     30D : 7B                         ld      A, E
(1)     30E : 3C                         inc     A               ; queue_put++
(1)     30F : DD BE 01                   cp      (IX+queue_size)
(1)     312 : 38 01                      jr      C, queue_add_update ; queue_put < queue_size
(1)     314 : AF                         xor     A                   ; wrap around
(1)     315 :                    queue_add_update:
(1)     315 : DD 77 02                   ld      (IX+queue_put), A
(1)     318 : 7E                         ld      A, (HL)         ; restore an element
(1)     319 : DD E3                      ex      (SP), IX
(1)     31B : E1                         pop     HL
(1)     31C : D1                         pop     DE
(1)     31D : 37                         scf                     ; set carry
(1)     31E : C9                         ret
(1)     31F :
(1)     31F :                    ;;; [queue] Remove an element from queue
