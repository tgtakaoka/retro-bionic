(1)     18F : ED 64                      exts    A               ; HL=X
(1)     191 : FD ED F2 E5 00             multw   HL, 229         ; DEHL=X*229
(1)     196 : FD ED FA 64 00             divw    DEHL, 100       ; HL=X*229/100
(1)     19B : 22 94 02                   ld      (vC), HL        ; C=X*229/100
(1)     19E : 22 98 02                   ld      (vA), HL        ; A=C
