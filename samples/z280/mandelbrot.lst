(1)     2DC : 36 00                      ld      (HL), 0         ; queue_len
(1)     2DE : 78                         ld      A, B
(1)     2DF : D6 04                      sub     queue_buf
(1)     2E1 : 23                         inc     HL
(1)     2E2 : 77                         ld      (HL), A         ; queue_size
(1)     2E3 : C6 02                      add     A, 2            ; for queue_put and queue_get
(1)     2E5 :                    queue_init_loop:
(1)     2E5 : 23                         inc     HL
(1)     2E6 : 36 00                      ld      (HL), 0
(1)     2E8 : 3D                         dec     A
