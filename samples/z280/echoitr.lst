(1)     1D5 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     1D5 :                    ;;; [queue] The byte ring of ../z80/queue.inc, same structure and
(1)     1D5 :                    ;;; interface, written for the Z280: the element is addressed by
(1)     1D5 :                    ;;; base-index addressing, (HL+IX) with HL the offset into the
(1)     1D5 :                    ;;; structure, instead of two 16-bit adds through DE.
(1)     1D5 : =0                 queue_len:      equ     0       ; queue length
(1)     1D5 : =1                 queue_size:     equ     1       ; buffer size
(1)     1D5 : =2                 queue_put:      equ     2       ; queue put index
(1)     1D5 : =3                 queue_get:      equ     3       ; queue get index
(1)     1D5 : =4                 queue_buf:      equ     4       ; buffer start offset
(1)     1D5 :
(1)     1D5 :                    ;;; [queue] Initialize queue
(1)     1D5 :                    ;;; @param HL queue work space pointer
(1)     1D5 :                    ;;; @param B queue work space size
(1)     1D5 :                    queue_init:
(1)     1D5 : F5                         push    AF
(1)     1D6 : E5                         push    HL
(1)     1D7 : 36 00                      ld      (HL), 0         ; queue_len
(1)     1D9 : 78                         ld      A, B
(1)     1DA : D6 04                      sub     queue_buf
(1)     1DC : 23                         inc     HL
(1)     1DD : 77                         ld      (HL), A         ; queue_size
(1)     1DE : 23                         inc     HL
(1)     1DF : 36 00                      ld      (HL), 0         ; queue_put
(1)     1E1 : 23                         inc     HL
(1)     1E2 : 36 00                      ld      (HL), 0         ; queue_get
(1)     1E4 : E1                         pop     HL
(1)     1E5 : F1                         pop     AF
(1)     1E6 : C9                         ret
(1)     1E7 :
(1)     1E7 :                    ;;; [queue] Add an element to queue
(1)     1E7 :                    ;;; @param HL queue work space pointer
(1)     1E7 :                    ;;; @param A an element
(1)     1E7 :                    ;;; @return F.C 0 if queue is full
(1)     1E7 :                    queue_add:
(1)     1E7 : E5                         push    HL
(1)     1E8 : DD E3                      ex      (SP), IX        ; IX points queue structure
(1)     1EA : F5                         push    AF              ; keep the element
(1)     1EB : DD 7E 00                   ld      A, (IX+queue_len)
(1)     1EE : DD BE 01                   cp      (IX+queue_size)
(1)     1F1 : 30 20                      jr      NC, queue_add_full  ; queue_len >= queue_size
(1)     1F3 : DD 34 00                   inc     (IX+queue_len)
(1)     1F6 : DD 7E 02                   ld      A, (IX+queue_put)
(1)     1F9 : 21 04 00                   ld      HL, queue_buf
(1)     1FC : ED 6D                      add     HL, A           ; HL=offset of queue_buf[queue_put]; A unchanged
(1)     1FE : 3C                         inc     A               ; queue_put++
(1)     1FF : DD BE 01                   cp      (IX+queue_size)
(1)     202 : 38 01                      jr      C, queue_add_update ; queue_put < queue_size
(1)     204 : AF                         xor     A                   ; wrap around
(1)     205 :                    queue_add_update:
(1)     205 : DD 77 02                   ld      (IX+queue_put), A
(1)     208 : F1                         pop     AF
(1)     209 : ED 0B                      ld      (HL+IX), A      ; store an element
(1)     20B : ED 2A 00 00                lda     HL, (IX+0)      ; restore HL, no stack access
(1)     20F : DD E1                      pop     IX
(1)     211 : 37                         scf                     ; set carry
(1)     212 : C9                         ret
(1)     213 :                    queue_add_full:
(1)     213 : F1                         pop     AF
(1)     214 : ED 2A 00 00                lda     HL, (IX+0)      ; restore HL, no stack access
(1)     218 : DD E1                      pop     IX
(1)     21A : B7                         or      A               ; clear carry
(1)     21B : C9                         ret
(1)     21C :
(1)     21C :                    ;;; [queue] Remove an element from queue
(1)     21C :                    ;;; @param HL queue work space pointer
(1)     21C :                    ;;; @return A an element
(1)     21C :                    ;;; @return F.C 0 if queue is empty
(1)     21C :                    queue_remove:
(1)     21C : 7E                         ld      A, (HL)         ; queue_len
(1)     21D : B7                         or      A               ; clear carry
(1)     21E : C8                         ret     Z               ; queue_len == 0
(1)     21F : E5                         push    HL
(1)     220 : DD E3                      ex      (SP), IX        ; IX points queue structure
(1)     222 : DD 35 00                   dec     (IX+queue_len)
(1)     225 : DD 7E 03                   ld      A, (IX+queue_get)
(1)     228 : 21 04 00                   ld      HL, queue_buf
(1)     22B : ED 6D                      add     HL, A           ; HL=offset of queue_buf[queue_get]; A unchanged
(1)     22D : 3C                         inc     A               ; queue_get++
(1)     22E : DD BE 01                   cp      (IX+queue_size)
(1)     231 : 38 01                      jr      C, queue_remove_update ; queue_get < queue_size
(1)     233 : AF                         xor     A                      ; wrap around
(1)     234 :                    queue_remove_update:
(1)     234 : DD 77 03                   ld      (IX+queue_get), A
(1)     237 : DD 79                      ld      A, (HL+IX)      ; read an element
(1)     239 : ED 2A 00 00                lda     HL, (IX+0)      ; restore HL, no stack access
(1)     23D : DD E1                      pop     IX
(1)     23F : 37                         scf                     ; set carry
(1)     240 : C9                         ret
