(1)     1DC :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     1DC :                    ;;; [queue] The byte ring of ../z80/queue.inc, same structure and
(1)     1DC :                    ;;; interface, written for the Z280: the element is addressed by
(1)     1DC :                    ;;; base-index addressing, (HL+IX) with HL the offset into the
(1)     1DC :                    ;;; structure, instead of two 16-bit adds through DE.
(1)     1DC : =0                 queue_len:      equ     0       ; queue length
(1)     1DC : =1                 queue_size:     equ     1       ; buffer size
(1)     1DC : =2                 queue_put:      equ     2       ; queue put index
(1)     1DC : =3                 queue_get:      equ     3       ; queue get index
(1)     1DC : =4                 queue_buf:      equ     4       ; buffer start offset
(1)     1DC :
(1)     1DC :                    ;;; [queue] Initialize queue
(1)     1DC :                    ;;; @param HL queue work space pointer
(1)     1DC :                    ;;; @param B queue work space size
(1)     1DC :                    queue_init:
(1)     1DC : F5                         push    AF
(1)     1DD : E5                         push    HL
(1)     1DE : 36 00                      ld      (HL), 0         ; queue_len
(1)     1E0 : 78                         ld      A, B
(1)     1E1 : D6 04                      sub     queue_buf
(1)     1E3 : 23                         inc     HL
(1)     1E4 : 77                         ld      (HL), A         ; queue_size
(1)     1E5 : 23                         inc     HL
(1)     1E6 : 36 00                      ld      (HL), 0         ; queue_put
(1)     1E8 : 23                         inc     HL
(1)     1E9 : 36 00                      ld      (HL), 0         ; queue_get
(1)     1EB : E1                         pop     HL
(1)     1EC : F1                         pop     AF
(1)     1ED : C9                         ret
(1)     1EE :
(1)     1EE :                            align   2
(1)     1EE :                    ;;; [queue] Add an element to queue
(1)     1EE :                    ;;; @param HL queue work space pointer
(1)     1EE :                    ;;; @param A an element
(1)     1EE :                    ;;; @return F.C 0 if queue is full
(1)     1EE :                    queue_add:
(1)     1EE : E5                         push    HL
(1)     1EF : DD E3                      ex      (SP), IX        ; IX points queue structure
(1)     1F1 : F5                         push    AF              ; keep the element
(1)     1F2 : DD 7E 00                   ld      A, (IX+queue_len)
(1)     1F5 : DD BE 01                   cp      (IX+queue_size)
(1)     1F8 : 30 20                      jr      NC, queue_add_full  ; queue_len >= queue_size
(1)     1FA : DD 34 00                   inc     (IX+queue_len)
(1)     1FD : DD 7E 02                   ld      A, (IX+queue_put)
(1)     200 : 21 04 00                   ld      HL, queue_buf
(1)     203 : ED 6D                      add     HL, A           ; HL=offset of queue_buf[queue_put]; A unchanged
(1)     205 : 3C                         inc     A               ; queue_put++
(1)     206 : DD BE 01                   cp      (IX+queue_size)
(1)     209 : 38 01                      jr      C, queue_add_update ; queue_put < queue_size
(1)     20B : AF                         xor     A                   ; wrap around
(1)     20C :                    queue_add_update:
(1)     20C : DD 77 02                   ld      (IX+queue_put), A
(1)     20F : F1                         pop     AF
(1)     210 : ED 0B                      ld      (HL+IX), A      ; store an element
(1)     212 : ED 2A 00 00                lda     HL, (IX+0)      ; restore HL, no stack access
(1)     216 : DD E1                      pop     IX
(1)     218 : 37                         scf                     ; set carry
(1)     219 : C9                         ret
(1)     21A :                    queue_add_full:
(1)     21A : F1                         pop     AF
(1)     21B : ED 2A 00 00                lda     HL, (IX+0)      ; restore HL, no stack access
(1)     21F : DD E1                      pop     IX
(1)     221 : B7                         or      A               ; clear carry
(1)     222 : C9                         ret
(1)     223 :
(1)     224 :                            align   2
(1)     224 :                    ;;; [queue] Remove an element from queue
(1)     224 :                    ;;; @param HL queue work space pointer
(1)     224 :                    ;;; @return A an element
(1)     224 :                    ;;; @return F.C 0 if queue is empty
(1)     224 :                    queue_remove:
(1)     224 : 7E                         ld      A, (HL)         ; queue_len
(1)     225 : B7                         or      A               ; clear carry
(1)     226 : C8                         ret     Z               ; queue_len == 0
(1)     227 : E5                         push    HL
(1)     228 : DD E3                      ex      (SP), IX        ; IX points queue structure
(1)     22A : DD 35 00                   dec     (IX+queue_len)
(1)     22D : DD 7E 03                   ld      A, (IX+queue_get)
(1)     230 : 21 04 00                   ld      HL, queue_buf
(1)     233 : ED 6D                      add     HL, A           ; HL=offset of queue_buf[queue_get]; A unchanged
(1)     235 : 3C                         inc     A               ; queue_get++
(1)     236 : DD BE 01                   cp      (IX+queue_size)
(1)     239 : 38 01                      jr      C, queue_remove_update ; queue_get < queue_size
(1)     23B : AF                         xor     A                      ; wrap around
(1)     23C :                    queue_remove_update:
(1)     23C : DD 77 03                   ld      (IX+queue_get), A
(1)     23F : DD 79                      ld      A, (HL+IX)      ; read an element
(1)     241 : ED 2A 00 00                lda     HL, (IX+0)      ; restore HL, no stack access
