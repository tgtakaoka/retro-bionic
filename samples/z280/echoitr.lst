        248 : CB 4F                      bit     ST_RxRDY_bp, A
        24A : 28 0D                      jr      Z, isr_intr_rx_exit
        24C : 01 40 01                   ld      BC, USARTD
        24F : ED 78                      in      A, (C)          ; receive character
        251 : E5                         push    HL
        252 : 21 00 20                   ld      HL, rx_queue
        255 : CD E7 01                   call    queue_add
        258 : E1                         pop     HL
        259 :                    isr_intr_rx_exit:
        259 : C1                         pop     BC
        25A : F1                         pop     AF
        25B : FB                         ei
        25C : ED 4D                      reti
        25E :
        25E :                    isr_intr_tx:
        25E : F5                         push    AF
        25F : C5                         push    BC
        260 : 01 41 01                   ld      BC, USARTS
        263 : ED 78                      in      A, (C)          ; (USARTS)
        265 : CB 47                      bit     ST_TxRDY_bp, A
        267 : 28 0F                      jr      Z, isr_intr_tx_exit
        269 : E5                         push    HL
        26A : 21 80 20                   ld      HL, tx_queue
        26D : CD 1C 02                   call    queue_remove
        270 : E1                         pop     HL
        271 : 30 0A                      jr      NC, isr_intr_send_empty
        273 : 01 40 01                   ld      BC, USARTD
        276 : ED 79                      out     (C), A          ; send character
        278 :                    isr_intr_tx_exit:
        278 : C1                         pop     BC
        279 : F1                         pop     AF
        27A : FB                         ei
        27B : ED 4D                      reti
        27D :                    isr_intr_send_empty:
        27D : 3E 36                      ld      A, RX_EN_TX_DIS
        27F : 01 41 01                   ld      bc, USARTC
        282 : ED 79                      out     (C), A          ; disable Tx
        284 : C1                         pop     BC
        285 : F1                         pop     AF
        286 : FB                         ei
        287 : ED 4D                      reti
