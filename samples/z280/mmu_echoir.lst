          0 :                    ;;; the receive interrupt handler and the putchar/getchar services run in
          0 :                    ;;; system mode, the echo loop runs in user mode and reaches them with
          0 :                    ;;; System Call traps. User logical page 0 is mapped to physical
          0 :                    ;;; 0A5000H; every other user page is invalid. Interrupt mode 3, so the
          0 :                    ;;; receive interrupt and the traps vector through the table at 2000H
          0 :                    ;;; and return with RETIL, which restores the user's MSR.
          0 :                            include "z280.inc"
