(1)       0 : =F2                MMU_INVAL:      equ     00F2H   ; Invalidation port (byte, write only)
(1)       0 : =F4                MMU_BMOVE:      equ     00F4H   ; Block Move port (word; pointer += 1 after)
(1)       0 : =F5                MMU_DSEL:       equ     00F5H   ; Descriptor Select port (word)
(1)       0 :                    ;;; Master Control register (7.5)
