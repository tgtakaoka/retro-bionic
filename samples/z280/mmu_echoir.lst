(1)     1B4 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)     1B4 :                    ;;; [queue] The byte ring of ../z80/queue.inc, same structure and
(1)     1B4 :                    ;;; interface, written for the Z280: the element is addressed by
(1)     1B4 :                    ;;; base-index addressing, (HL+IX) with HL the offset into the
(1)     1B4 :                    ;;; structure, instead of two 16-bit adds through DE.
(1)     1B4 : =0                 queue_len:      equ     0       ; queue length
(1)     1B4 : =1                 queue_size:     equ     1       ; buffer size
(1)     1B4 : =2                 queue_put:      equ     2       ; queue put index
(1)     1B4 : =3                 queue_get:      equ     3       ; queue get index
(1)     1B4 : =4                 queue_buf:      equ     4       ; buffer start offset
(1)     1B4 :
(1)     1B4 :                    ;;; [queue] Initialize queue
(1)     1B4 :                    ;;; @param HL queue work space pointer
(1)     1B4 :                    ;;; @param B queue work space size
(1)     1B4 :                    queue_init:
(1)     1B4 : F5                         push    AF
(1)     1B5 : E5                         push    HL
(1)     1B6 : 36 00                      ld      (HL), 0         ; queue_len
(1)     1B8 : 78                         ld      A, B
(1)     1B9 : D6 04                      sub     queue_buf
(1)     1BB : 23                         inc     HL
(1)     1BC : 77                         ld      (HL), A         ; queue_size
(1)     1BD : 23                         inc     HL
(1)     1BE : 36 00                      ld      (HL), 0         ; queue_put
(1)     1C0 : 23                         inc     HL
(1)     1C1 : 36 00                      ld      (HL), 0         ; queue_get
(1)     1C3 : E1                         pop     HL
(1)     1C4 : F1                         pop     AF
(1)     1C5 : C9                         ret
(1)     1C6 :
(1)     1C6 :                    ;;; [queue] Add an element to queue
(1)     1C6 :                    ;;; @param HL queue work space pointer
(1)     1C6 :                    ;;; @param A an element
(1)     1C6 :                    ;;; @return F.C 0 if queue is full
(1)     1C6 :                    queue_add:
(1)     1C6 : E5                         push    HL
(1)     1C7 : DD E3                      ex      (SP), IX        ; IX points queue structure
(1)     1C9 : F5                         push    AF              ; keep the element
(1)     1CA : DD 7E 00                   ld      A, (IX+queue_len)
(1)     1CD : DD BE 01                   cp      (IX+queue_size)
