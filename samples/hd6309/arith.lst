(2)       0 : =10                CC_IRQ        equ  %00010000   ; if 1, IRQ is masked
(2)       0 : =20                CC_HALF_CARRY equ  %00100000   ; if 1, decimal carry from least digit occurred
(2)       0 : =40                CC_FIRQ       equ  %01000000   ; if 1, FIRQ is masked
