PROCEDURE fmandel
REM ASCII art Mandelbrot set: samples/arith/fmandel.bas in BASIC09.
DIM x,y,i:INTEGER
DIM ca,cb,a,b,t:REAL
FOR y=-12 TO 12
  FOR x=-49 TO 29
    ca=x*0.0458
    cb=y*0.08333
    a=ca
    b=cb
    FOR i=0 TO 15
      t=a*a-b*b+ca
      b=2*a*b+cb
      a=t
      IF a*a+b*b>4 THEN 180
    NEXT i
    PRINT " ";
    GOTO 200
180 IF i>9 THEN
      i=i+7
    ENDIF
    PRINT CHR$(48+i);
200 NEXT x
  PRINT
NEXT y
END
