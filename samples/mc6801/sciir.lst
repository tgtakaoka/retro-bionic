        142 :                            include "queue.inc"
(1)     142 :                    ;;; [queue] queue structure
(1)     142 : =0                 queue_len:      equ     0       ; queue length
(1)     142 : =1                 queue_size:     equ     1       ; buffer size
(1)     142 : =2                 queue_put:      equ     2       ; queue put index
(1)     142 : =3                 queue_get:      equ     3       ; queue get index
(1)     142 : =4                 queue_buf:      equ     4       ; buffer start offset
(1)     142 :
(1)     142 :                    ;;; [queue] Initialize queue
(1)     142 :                    ;;; @param X queue work space pointer
(1)     142 :                    ;;; @param B queue work space size
(1)     142 :                    ;;; @clobber B
(1)     142 :                    queue_init:
(1)     142 : 37                         pshb
(1)     143 : 3C                         pshx
(1)     144 :                    queue_init_loop:
(1)     144 : 6F 00                      clr     0,x
(1)     146 : 08                         inx
(1)     147 : 5A                         decb
(1)     148 : 26 FA                      bne     queue_init_loop
(1)     14A : 38                         pulx
(1)     14B : 33                         pulb
(1)     14C : C0 04                      subb    #queue_buf
(1)     14E : E7 01                      stab    queue_size,x
(1)     150 : 39                         rts
(1)     151 :
(1)     151 :                    ;;; [queue] Add an element to queue
(1)     151 :                    ;;; @param X queue work space pointer
(1)     151 :                    ;;; @param A an element
(1)     151 :                    ;;; @return CC.C 0 if queue is full
(1)     151 :                    queue_add:
(1)     151 : 37                 	pshb
(1)     152 : E6 00                      ldab    queue_len,x
(1)     154 : E1 01                      cmpb    queue_size,x
(1)     156 : 24 13                      bhs     queue_add_return ; carry is cleared
(1)     158 : E6 02                      ldab    queue_put,x     ; 8 bits offset
(1)     15A : 3C                         pshx
(1)     15B : 3A                         abx                     ; X+=B
(1)     15C : A7 04                      staa    queue_buf,x     ; store an element
(1)     15E : 38                         pulx
(1)     15F : 6C 00                      inc     queue_len,x
(1)     161 : 5C                         incb
(1)     162 : E7 02                      stab    queue_put,x
(1)     164 : E1 01                      cmpb    queue_size,x
(1)     166 : 25 03                      blo     queue_add_return ; carry is set
(1)     168 : 6F 02                      clr     queue_put,x
(1)     16A : 0D                         sec                     ; set carry
(1)     16B :                    queue_add_return:
(1)     16B : 33                 	pulb
(1)     16C : 39                         rts
(1)     16D :
(1)     16D :                    ;;; [queue] Remove an element from queue
(1)     16D :                    ;;; @param X queue work space pointer
(1)     16D :                    ;;; @return A an element
(1)     16D :                    ;;; @return CC.C 0 if queue is empty
(1)     16D :                    queue_remove:
(1)     16D : 6D 00                      tst     queue_len,x
(1)     16F : 26 02                      bne     queue_remove_elem
(1)     171 : 0C                         clc                     ; clear carry
(1)     172 : 39                         rts
(1)     173 :                    queue_remove_elem:
(1)     173 : 37                 	pshb
(1)     174 : E6 03                      ldab    queue_get,x     ; 8 bits offset
(1)     176 : 3C                         pshx
(1)     177 : 3A                         abx                     ; X+=B
(1)     178 : A6 04                      ldaa    queue_buf,x     ; read an element
(1)     17A : 38                         pulx
(1)     17B : 6A 00                      dec     queue_len,x
(1)     17D : 5C                         incb
(1)     17E : E7 03                      stab    queue_get,x
(1)     180 : E1 01                      cmpb    queue_size,x
(1)     182 : 25 03                      blo     queue_remove_return ; carry is set
(1)     184 : 6F 03                      clr     queue_get,x
(1)     186 : 0D                         sec                     ; set carry
