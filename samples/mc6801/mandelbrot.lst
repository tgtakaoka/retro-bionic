(1)     1CA :                    ;;; A step starts with |A| and |B| below 3F: C and D do, and a step
(1)     1CA :                    ;;; continues only when P*P+Q*Q <= 4, so |P| and |Q| were 2 or less.
(1)     1CA :                    ;;; With 3F below 256, |A|, |B|, Q <= 2 and S < F then multiply in
(1)     1CA :                    ;;; single MULs as bytes.
(1)     1CA :                    ;;; Q=|B|/F and S=|B|-Q*F come from the previous step, which divided B
(1)     1CA :                    ;;; by F for T; A*Q+A*S/F, which is A*B/F without overflowing 16 bits,
(1)     1CA :                    ;;; has the sign of A*B. B goes first, as vAm and vBm still hold this
(1)     1CA :                    ;;; step's |A| and |B| for A*A-B*B.
(1)     1CA :                    loop_i:
(1)     1CA : 96 50                      ldaa    vAm
(1)     1CC : D6 49                      ldab    vS+1
(1)     1CE : 3D                         mul                     ; |A*S|
(1)     1CF : CE 00 32                   ldx     #F
(1)     1D2 : BD 03 EF                   jsr     udiv16_8        ; |A*S/F|
(1)     1D5 : DE 4C                      ldx     vQ
(1)     1D7 : 27 09                      beq     loop_i_aq       ; branch if A*Q=0
(1)     1D9 : DD 5A                      std     tmp             ; tmp=|A*S/F|
(1)     1DB : 96 50                      ldaa    vAm
(1)     1DD : D6 4D                      ldab    vQ+1
(1)     1DF : 3D                         mul                     ; |A*Q|
(1)     1E0 : D3 5A                      addd    tmp             ; |A*Q+A*S/F|
(1)     1E2 :                    loop_i_aq:
(1)     1E2 : 05                         lsld
(1)     1E3 : DD 5A                      std     tmp             ; tmp=|2*(A*Q+A*S/F)|
(1)     1E5 : 96 44                      ldaa    vA
(1)     1E7 : 98 46                      eora    vB
(1)     1E9 : 2B 06                      bmi     loop_i_minus    ; branch if A*B < 0
(1)     1EB : DC 42                      ldd     vD
(1)     1ED : D3 5A                      addd    tmp             ; 2*(A*Q+A*S/F)+D
(1)     1EF : 20 04                      bra     loop_i_b
(1)     1F1 :                    loop_i_minus:
(1)     1F1 : DC 42                      ldd     vD
(1)     1F3 : 93 5A                      subd    tmp             ; 2*(A*Q+A*S/F)+D
(1)     1F5 :                    loop_i_b:
(1)     1F5 : DD 46                      std     vB              ; B=2*(A*Q+A*S/F)+D
(1)     1F7 : 96 51                      ldaa    vBm
