          0 :                            include "mc68hc12.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; MC68HC12 (MC68HC912BD32)
(1)       0 :                            cpu     68hc12
(1)       0 :                    ;;; Condition Code Register (CC)
(1)       0 : =1                 CC_CARRY      equ  %00000001   ; set to 1 if carry occurred
(1)       0 : =2                 CC_OVERFLOW   equ  %00000010   ; set to 1 if overflow occurred
(1)       0 : =4                 CC_ZERO       equ  %00000100   ; set to 1 if result is zero
(1)       0 : =8                 CC_NEGATIVE   equ  %00001000   ; set to 1 if result is negative
(1)       0 : =10                CC_IRQ        equ  %00010000   ; if 1, IRQ is masked
(1)       0 : =20                CC_HALF_CARRY equ  %00100000   ; if 1, decimal carry from least digit occurred
(1)       0 : =40                CC_XIRQ       equ  %01000000   ; if 1, XIRQ is masked
(1)       0 : =80                CC_STOP       equ  %10000000   ; if 1, STOP instruction is disabled
(1)       0 :
(1)       0 :                    ;;; Vector
(1)       0 : =FFD6              VEC_SCI0:       equ     $FFD6  ; $FFD6: SCI0
(1)       0 : =FFF2              VEC_IRQ:        equ     $FFF2  ; $FFF2: #IRQ
(1)       0 : =FFF4              VEC_XIRQ:       equ     $FFF4  ; $FFF4: #XIRQ
(1)       0 : =FFF6              VEC_SWI:        equ     $FFF6  ; $FFF6: Software Interrupt
(1)       0 : =FFF8              VEC_TRAP:       equ     $FFF8  ; $FFF8: Unimplemented Opcode Trap
(1)       0 : =FFFA              VEC_COP:        equ     $FFFA  ; $FFFA: COP (Watchdog) Failure
(1)       0 : =FFFC              VEC_CMF:        equ     $FFFC  ; $FFFC: Clock Monitor Fail
(1)       0 : =FFFE              VEC_RESET:      equ     $FFFE  ; $FFFE: Reset
(1)       0 :
(1)       0 :                    ;;; Internal memory, as reset leaves it in special expanded wide mode
(1)       0 : =0                 REG_BASE:       equ     $0000  ; $0000-$01FF: registers
(1)       0 : =800               RAM_BASE:       equ     $0800  ; $0800-$0BFF: RAM
(1)       0 : =D00               EEPROM_BASE:    equ     $0D00  ; $0D00-$0FFF: EEPROM
(1)       0 :
(1)       0 :                    ;;; SCI0
(1)       0 : =C0                SC0BDH:         equ     $C0    ; Baud Rate Control High: SBR12-SBR8
(1)       0 : =C1                SC0BDL:         equ     $C1    ; Baud Rate Control Low: SBR7-SBR0
(1)       0 : =C2                SC0CR1:         equ     $C2    ; Control Register 1
(1)       0 : =C3                SC0CR2:         equ     $C3    ; Control Register 2
(1)       0 : =C4                SC0SR1:         equ     $C4    ; Status Register 1
(1)       0 : =C5                SC0SR2:         equ     $C5    ; Status Register 2
(1)       0 : =C6                SC0DRH:         equ     $C6    ; Data Register High: R8/T8
(1)       0 : =C7                SC0DRL:         equ     $C7    ; Data Register Low
(1)       0 :                    ;;; SC0CR2
(1)       0 : =80                SC0CR2_TIE_bm:  equ     %10000000 ; Transmit Interrupt Enable
(1)       0 : =40                SC0CR2_TCIE_bm: equ     %01000000 ; Transmit Complete Interrupt Enable
(1)       0 : =20                SC0CR2_RIE_bm:  equ     %00100000 ; Receiver Interrupt Enable
(1)       0 : =10                SC0CR2_ILIE_bm: equ     %00010000 ; Idle Line Interrupt Enable
(1)       0 : =8                 SC0CR2_TE_bm:   equ     %00001000 ; Transmitter Enable
(1)       0 : =4                 SC0CR2_RE_bm:   equ     %00000100 ; Receiver Enable
(1)       0 :                    ;;; SC0SR1
(1)       0 : =80                SC0SR1_TDRE_bm: equ     %10000000 ; Transmit Data Register Empty
(1)       0 : =40                SC0SR1_TC_bm:   equ     %01000000 ; Transmit Complete
(1)       0 : =20                SC0SR1_RDRF_bm: equ     %00100000 ; Receive Data Register Full
(1)       0 : =10                SC0SR1_IDLE_bm: equ     %00010000 ; Idle Line Detected
(1)       0 : =8                 SC0SR1_OR_bm:   equ     %00001000 ; Overrun Error
(1)       0 : =4                 SC0SR1_NF_bm:   equ     %00000100 ; Noise Error
(1)       0 : =2                 SC0SR1_FE_bm:   equ     %00000010 ; Framing Error
(1)       0 : =1                 SC0SR1_PF_bm:   equ     %00000001 ; Parity Error
          0 :
          0 :                    ;;; SCI: Enable Rx and Tx
          0 : =C                 RX_ON_TX_ON:   equ     SC0CR2_TE_bm|SC0CR2_RE_bm
          0 :
          0 : =2000              stack:  equ     $2000           ; SP points at the last byte pushed
          0 :
       FFF6 :                            org     VEC_SWI
       FFF6 : FF F6                      fdb     VEC_SWI         ; for halt to system
       FFF8 :
       FFFE :                            org     VEC_RESET
       FFFE : 20 02                      fdb     initialize
      10000 :
       2000 :                            org     $2000
       2000 :                    device_base:
       2000 : 00 00                      fdb     $0000
       2002 :                    initialize:
       2002 : CF 20 00                   lds     #stack
       2005 :                    	;; Initialize SCI
       2005 : FE 20 00                   ldx     device_base
       2008 : 69 E0 C2                   clr     SC0CR1,x                    ; 8bit 1stop
       200B : 69 E0 C0                   clr     SC0BDH,x
       200E : 86 01                      ldaa    #1              ; SBR=1: E/16
       2010 : 6A E0 C1                   staa    SC0BDL,x
       2013 : 86 0C                      ldaa    #RX_ON_TX_ON
       2015 : 6A E0 C3                   staa    SC0CR2,x
       2018 :
       2018 :                    loop:
       2018 : 07 11                      bsr     getchar
       201A : 97                         tsta
       201B : 27 0A                      beq     halt_to_system
       201D : 07 1A              echo:   bsr     putchar
       201F : 81 0D                      cmpa    #$0D
       2021 : 26 F5                      bne     loop
       2023 : 86 0A                      ldaa    #$0A
       2025 : 20 F6                      bra     echo
       2027 :                    halt_to_system:
       2027 : 3F                         swi
       2028 :
       2028 :                    getchar_error:
       2028 : A6 E0 C7                   ldaa    SC0DRL,x          ; Reset OR/NF/FE
       202B :                    getchar:
       202B :                    ;;; Overrun or noise or framing error?
       202B : 0E E0 C4 0E F8             brset   SC0SR1,x, #SC0SR1_OR_bm|SC0SR1_NF_bm|SC0SR1_FE_bm, getchar_error
       2030 :                    ;;; Receive Data Register Full?
       2030 : 0F E0 C4 20 F6             brclr   SC0SR1,x, #SC0SR1_RDRF_bm, getchar
       2035 : A6 E0 C7                   ldaa    SC0DRL,x          ; Received data
       2038 : 3D                         rts
       2039 :
       2039 :                    putchar:
       2039 :                    ;;; Transmit Data Register Empty?
       2039 : 0F E0 C4 80 FB             brclr   SC0SR1,x, #SC0SR1_TDRE_bm, putchar
       203E : 6A E0 C7                   staa    SC0DRL,x          ; transmit data
       2041 : 3D                         rts
