(1)    2056 : 24 15                      bhs     queue_add_return ; carry is cleared
(1)    2058 : E6 02                      ldab    queue_put,x     ; 8 bits offset
(1)    205A : 34                         pshx
(1)    205B : 1A E5                      abx                     ; X+=B
(1)    205D : 6A 04                      staa    queue_buf,x     ; store an element
(1)    205F : 30                         pulx
(1)    2060 : 62 00                      inc     queue_len,x
(1)    2062 : 52                         incb
(1)    2063 : 6B 02                      stab    queue_put,x
(1)    2065 : E1 01                      cmpb    queue_size,x
(1)    2067 : 25 04                      blo     queue_add_return ; carry is set
(1)    2069 : 69 02                      clr     queue_put,x
(1)    206B : 14 01                      sec                     ; set carry
