          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                            include "mc9s12d.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; MC9S12DG128B
(1)       0 :                            include "mc68hc12.inc"
(2)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)       0 :                    ;;; The CPU12: what every MC68HC12, HCS12 and HCS12X shares
(2)       0 :                            cpu     68hc12
(2)       0 :                    ;;; Condition Code Register (CC)
(2)       0 : =1                 CC_CARRY      equ  %00000001   ; set to 1 if carry occurred
(2)       0 : =2                 CC_OVERFLOW   equ  %00000010   ; set to 1 if overflow occurred
(2)       0 : =4                 CC_ZERO       equ  %00000100   ; set to 1 if result is zero
(2)       0 : =8                 CC_NEGATIVE   equ  %00001000   ; set to 1 if result is negative
(2)       0 : =10                CC_IRQ        equ  %00010000   ; if 1, IRQ is masked
(2)       0 : =20                CC_HALF_CARRY equ  %00100000   ; if 1, decimal carry from least digit occurred
(2)       0 : =40                CC_XIRQ       equ  %01000000   ; if 1, XIRQ is masked
(2)       0 : =80                CC_STOP       equ  %10000000   ; if 1, STOP instruction is disabled
(2)       0 :
(2)       0 :                    ;;; Vector
(2)       0 : =FFF2              VEC_IRQ:        equ     $FFF2  ; $FFF2: #IRQ
(2)       0 : =FFF4              VEC_XIRQ:       equ     $FFF4  ; $FFF4: #XIRQ
(2)       0 : =FFF6              VEC_SWI:        equ     $FFF6  ; $FFF6: Software Interrupt
(2)       0 : =FFF8              VEC_TRAP:       equ     $FFF8  ; $FFF8: Unimplemented Opcode Trap
(2)       0 : =FFFA              VEC_COP:        equ     $FFFA  ; $FFFA: COP (Watchdog) Failure
(2)       0 : =FFFC              VEC_CMF:        equ     $FFFC  ; $FFFC: Clock Monitor Fail
(2)       0 : =FFFE              VEC_RESET:      equ     $FFFE  ; $FFFE: Reset
(1)       0 :                            include "mc68hc12_sci.inc"
(2)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(2)       0 :                    ;;; SCI registers, as offsets from the chip's SCI0_BASE
(2)       0 : =0                 SC0BDH:         equ     0      ; Baud Rate Control High: SBR12-SBR8
(2)       0 : =1                 SC0BDL:         equ     1      ; Baud Rate Control Low: SBR7-SBR0
(2)       0 : =2                 SC0CR1:         equ     2      ; Control Register 1
(2)       0 : =3                 SC0CR2:         equ     3      ; Control Register 2
(2)       0 : =4                 SC0SR1:         equ     4      ; Status Register 1
(2)       0 : =5                 SC0SR2:         equ     5      ; Status Register 2
(2)       0 : =6                 SC0DRH:         equ     6      ; Data Register High: R8/T8
(2)       0 : =7                 SC0DRL:         equ     7      ; Data Register Low
(2)       0 :                    ;;; SC0CR2
(2)       0 : =80                SC0CR2_TIE_bm:  equ     %10000000 ; Transmit Interrupt Enable
(2)       0 : =40                SC0CR2_TCIE_bm: equ     %01000000 ; Transmit Complete Interrupt Enable
(2)       0 : =20                SC0CR2_RIE_bm:  equ     %00100000 ; Receiver Interrupt Enable
(2)       0 : =10                SC0CR2_ILIE_bm: equ     %00010000 ; Idle Line Interrupt Enable
(2)       0 : =8                 SC0CR2_TE_bm:   equ     %00001000 ; Transmitter Enable
(2)       0 : =4                 SC0CR2_RE_bm:   equ     %00000100 ; Receiver Enable
(2)       0 :                    ;;; SC0SR1
(2)       0 : =80                SC0SR1_TDRE_bm: equ     %10000000 ; Transmit Data Register Empty
(2)       0 : =40                SC0SR1_TC_bm:   equ     %01000000 ; Transmit Complete
(2)       0 : =20                SC0SR1_RDRF_bm: equ     %00100000 ; Receive Data Register Full
(2)       0 : =10                SC0SR1_IDLE_bm: equ     %00010000 ; Idle Line Detected
(2)       0 : =8                 SC0SR1_OR_bm:   equ     %00001000 ; Overrun Error
(2)       0 : =4                 SC0SR1_NF_bm:   equ     %00000100 ; Noise Error
(2)       0 : =2                 SC0SR1_FE_bm:   equ     %00000010 ; Framing Error
(2)       0 : =1                 SC0SR1_PF_bm:   equ     %00000001 ; Parity Error
(1)       0 :
(1)       0 : =FFD6              VEC_SCI0:       equ     $FFD6  ; $FFD6: SCI0
(1)       0 :
(1)       0 :                    ;;; Internal memory, as reset leaves it in special test mode
(1)       0 : =0                 REG_BASE:       equ     $0000  ; $0000-$03FF: registers
(1)       0 : =0                 RAM_BASE:       equ     $0000  ; $0000-$1FFF: RAM, under the registers
(1)       0 :
(1)       0 : =C8                SCI0_BASE:      equ     REG_BASE+$C8
(1)       0 :
(1)       0 :                    ;;; Where the samples go: data and queues in RAM from $1000; code, and the
(1)       0 :                    ;;; stack below it, from $2000.
(1)       0 : =1000              DATA_ORG:       equ     $1000
(1)       0 : =1100              QUEUE_ORG:      equ     $1100
(1)       0 : =2000              STACK_TOP:      equ     $2000   ; SP points at the last byte pushed
(1)       0 : =2000              CODE_ORG:       equ     $2000
          0 :                            include "sci.inc"
(1)       0 :
(1)       0 :                    ;;; SCI: Enable Rx and Tx
(1)       0 : =C                 RX_ON_TX_ON:   equ     SC0CR2_TE_bm|SC0CR2_RE_bm
(1)       0 :
(1)       0 : =2000              stack:  equ     STACK_TOP           ; SP points at the last byte pushed
(1)       0 :
(1)    FFF6 :                            org     VEC_SWI
(1)    FFF6 : FF F6                      fdb     VEC_SWI         ; for halt to system
(1)    FFF8 :
(1)    FFFE :                            org     VEC_RESET
(1)    FFFE : 20 02                      fdb     initialize
(1)   10000 :
(1)    2000 :                            org     CODE_ORG
(1)    2000 :                    device_base:
(1)    2000 : 00 C8                      fdb     SCI0_BASE      ; the chip wrapper sets it
(1)    2002 :                    initialize:
(1)    2002 : CF 20 00                   lds     #stack
(1)    2005 :                    	;; Initialize SCI
(1)    2005 : FE 20 00                   ldx     device_base
(1)    2008 : 69 02                      clr     SC0CR1,x                    ; 8bit 1stop
(1)    200A : 69 00                      clr     SC0BDH,x
(1)    200C : 86 01                      ldaa    #1              ; SBR=1: E/16
(1)    200E : 6A 01                      staa    SC0BDL,x
(1)    2010 : 86 0C                      ldaa    #RX_ON_TX_ON
(1)    2012 : 6A 03                      staa    SC0CR2,x
(1)    2014 :
(1)    2014 :                    loop:
(1)    2014 : 07 10                      bsr     getchar
(1)    2016 : 97                         tsta
(1)    2017 : 27 0A                      beq     halt_to_system
(1)    2019 : 07 16              echo:   bsr     putchar
(1)    201B : 81 0D                      cmpa    #$0D
(1)    201D : 26 F5                      bne     loop
(1)    201F : 86 0A                      ldaa    #$0A
(1)    2021 : 20 F6                      bra     echo
(1)    2023 :                    halt_to_system:
(1)    2023 : 3F                         swi
(1)    2024 :
(1)    2024 :                    getchar_error:
(1)    2024 : A6 07                      ldaa    SC0DRL,x          ; Reset OR/NF/FE
(1)    2026 :                    getchar:
(1)    2026 :                    ;;; Overrun or noise or framing error?
(1)    2026 : 0E 04 0E FA                brset   SC0SR1,x, #SC0SR1_OR_bm|SC0SR1_NF_bm|SC0SR1_FE_bm, getchar_error
(1)    202A :                    ;;; Receive Data Register Full?
(1)    202A : 0F 04 20 F8                brclr   SC0SR1,x, #SC0SR1_RDRF_bm, getchar
(1)    202E : A6 07                      ldaa    SC0DRL,x          ; Received data
(1)    2030 : 3D                         rts
(1)    2031 :
(1)    2031 :                    putchar:
(1)    2031 :                    ;;; Transmit Data Register Empty?
(1)    2031 : 0F 04 80 FC                brclr   SC0SR1,x, #SC0SR1_TDRE_bm, putchar
(1)    2035 : 6A 07                      staa    SC0DRL,x          ; transmit data
(1)    2037 : 3D                         rts
