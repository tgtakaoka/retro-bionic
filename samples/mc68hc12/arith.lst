(2)       0 : =FFFA              VEC_COP:        equ     $FFFA  ; $FFFA: COP (Watchdog) Failure
(2)       0 : =FFFC              VEC_CMF:        equ     $FFFC  ; $FFFC: Clock Monitor Fail
(2)       0 : =FFFE              VEC_RESET:      equ     $FFFE  ; $FFFE: Reset
