(1)    207D :                    queue_remove:
(1)    207D : E7 00                      tst     queue_len,x
(1)    207F : 26 03                      bne     queue_remove_elem
(1)    2081 : 10 FE                      clc                     ; clear carry
(1)    2083 : 3D                         rts
(1)    2084 :                    queue_remove_elem:
(1)    2084 : 37                 	pshb
(1)    2085 : E6 03                      ldab    queue_get,x     ; 8 bits offset
(1)    2087 : 34                         pshx
(1)    2088 : 1A E5                      abx                     ; X+=B
(1)    208A : A6 04                      ldaa    queue_buf,x     ; read an element
(1)    208C : 30                         pulx
(1)    208D : 63 00                      dec     queue_len,x
(1)    208F : 52                         incb
(1)    2090 : 6B 03                      stab    queue_get,x
(1)    2092 : E1 01                      cmpb    queue_size,x
(1)    2094 : 25 04                      blo     queue_remove_return ; carry is set
(1)    2096 : 69 03                      clr     queue_get,x
(1)    2098 : 14 01                      sec                     ; set carry
