       2050 :                            include "../mc6801/queue.inc"
(1)    2050 :                    ;;; [queue] queue structure
(1)    2050 : =0                 queue_len:      equ     0       ; queue length
(1)    2050 : =1                 queue_size:     equ     1       ; buffer size
(1)    2050 : =2                 queue_put:      equ     2       ; queue put index
(1)    2050 : =3                 queue_get:      equ     3       ; queue get index
(1)    2050 : =4                 queue_buf:      equ     4       ; buffer start offset
(1)    2050 :
(1)    2050 :                    ;;; [queue] Initialize queue
(1)    2050 :                    ;;; @param X queue work space pointer
(1)    2050 :                    ;;; @param B queue work space size
(1)    2050 :                    ;;; @clobber B
(1)    2050 :                    queue_init:
(1)    2050 : 37                         pshb
(1)    2051 : 34                         pshx
(1)    2052 :                    queue_init_loop:
(1)    2052 : 69 00                      clr     0,x
(1)    2054 : 08                         inx
(1)    2055 : 53                         decb
(1)    2056 : 26 FA                      bne     queue_init_loop
(1)    2058 : 30                         pulx
(1)    2059 : 33                         pulb
(1)    205A : C0 04                      subb    #queue_buf
(1)    205C : 6B 01                      stab    queue_size,x
(1)    205E : 3D                         rts
(1)    205F :
(1)    205F :                    ;;; [queue] Add an element to queue
(1)    205F :                    ;;; @param X queue work space pointer
(1)    205F :                    ;;; @param A an element
(1)    205F :                    ;;; @return CC.C 0 if queue is full
(1)    205F :                    queue_add:
(1)    205F : 37                 	pshb
(1)    2060 : E6 00                      ldab    queue_len,x
(1)    2062 : E1 01                      cmpb    queue_size,x
(1)    2064 : 24 15                      bhs     queue_add_return ; carry is cleared
(1)    2066 : E6 02                      ldab    queue_put,x     ; 8 bits offset
(1)    2068 : 34                         pshx
(1)    2069 : 1A E5                      abx                     ; X+=B
(1)    206B : 6A 04                      staa    queue_buf,x     ; store an element
(1)    206D : 30                         pulx
(1)    206E : 62 00                      inc     queue_len,x
(1)    2070 : 52                         incb
(1)    2071 : 6B 02                      stab    queue_put,x
(1)    2073 : E1 01                      cmpb    queue_size,x
(1)    2075 : 25 04                      blo     queue_add_return ; carry is set
(1)    2077 : 69 02                      clr     queue_put,x
(1)    2079 : 14 01                      sec                     ; set carry
(1)    207B :                    queue_add_return:
(1)    207B : 33                 	pulb
(1)    207C : 3D                         rts
(1)    207D :
(1)    207D :                    ;;; [queue] Remove an element from queue
(1)    207D :                    ;;; @param X queue work space pointer
(1)    207D :                    ;;; @return A an element
