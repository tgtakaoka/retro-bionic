       1100 :                            org     $1100
       1100 :
       1100 : =80                rx_queue_size:  equ     128
       1100 :                    rx_queue:       rmb     rx_queue_size
       1180 :
       1180 :                    ;;; SCI: Enable Rx interrupt
       1180 : =2C                RX_INT_TX_NO:   equ     SC0CR2_TE_bm|SC0CR2_RE_bm|SC0CR2_RIE_bm
       1180 :
       1180 : =2000              stack:  equ     $2000           ; SP points at the last byte pushed
       1180 :
       FFD6 :                            org     VEC_SCI0
       FFD6 : 20 9F                      fdb     isr_sci
       FFD8 :
       FFF6 :                            org     VEC_SWI
       FFF6 : FF F6                      fdb     VEC_SWI         ; for halt to system
       FFF8 :
       FFFE :                            org     VEC_RESET
       FFFE : 20 02                      fdb     initialize
      10000 :
       2000 :                            org     $2000
       2000 :                    device_base:
       2000 : 00 00                      fdb     $0000
       2002 :                    initialize:
       2002 : CF 20 00                   lds     #stack
       2005 : CE 11 00                   ldx     #rx_queue
       2008 : C6 80                      ldab    #rx_queue_size
       200A : 16 20 50                   jsr     queue_init
       200D :                            ;; Initialize SCI
       200D : FE 20 00                   ldx     device_base
       2010 : 69 E0 C2                   clr     SC0CR1,x         ; 8bit 1stop
       2013 : 69 E0 C0                   clr     SC0BDH,x
       2016 : 86 01                      ldaa    #1              ; SBR=1: E/16
       2018 : 6A E0 C1                   staa    SC0BDL,x
       201B : 86 2C                      ldaa    #RX_INT_TX_NO
       201D : 6A E0 C3                   staa    SC0CR2,x         ; Enable Tx and Rx/Interrupt
       2020 : 10 EF                      cli                     ; Enable IRQ
       2022 : CE 11 00                   ldx     #rx_queue
       2025 : 20 02                      bra     loop
       2027 :
       2027 :                    wait:
       2027 : 20 00                      bra     loop            ; spin, IRQ enabled: it comes in running code
       2029 :                    loop:
       2029 : 14 10                      sei                     ; Disable IRQ
       202B : 16 20 7D                   jsr     queue_remove
       202E : 10 EF                      cli                     ; Enable IRQ
       2030 : 24 F5                      bcc     wait
       2032 : 97                         tsta
       2033 : 27 0C                      beq     halt_to_system
       2035 : 07 0B                      bsr     putchar
       2037 : 81 0D                      cmpa    #$0D
       2039 : 26 EE                      bne     loop
       203B : 86 0A                      ldaa    #$0A
       203D : 07 03                      bsr     putchar
       203F : 20 E8                      bra     loop
       2041 :                    halt_to_system:
       2041 : 3F                         swi                     ; halt_to_system
       2042 :
       2042 :                    putchar:
