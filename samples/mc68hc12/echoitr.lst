(1)       0 : =80                SC0CR2_TIE_bm:  equ     %10000000 ; Transmit Interrupt Enable
(1)       0 : =40                SC0CR2_TCIE_bm: equ     %01000000 ; Transmit Complete Interrupt Enable
(1)       0 : =20                SC0CR2_RIE_bm:  equ     %00100000 ; Receiver Interrupt Enable
(1)       0 : =10                SC0CR2_ILIE_bm: equ     %00010000 ; Idle Line Interrupt Enable
(1)       0 : =8                 SC0CR2_TE_bm:   equ     %00001000 ; Transmitter Enable
(1)       0 : =4                 SC0CR2_RE_bm:   equ     %00000100 ; Receiver Enable
(1)       0 :                    ;;; SC0SR1
(1)       0 : =80                SC0SR1_TDRE_bm: equ     %10000000 ; Transmit Data Register Empty
(1)       0 : =40                SC0SR1_TC_bm:   equ     %01000000 ; Transmit Complete
(1)       0 : =20                SC0SR1_RDRF_bm: equ     %00100000 ; Receive Data Register Full
(1)       0 : =10                SC0SR1_IDLE_bm: equ     %00010000 ; Idle Line Detected
(1)       0 : =8                 SC0SR1_OR_bm:   equ     %00001000 ; Overrun Error
(1)       0 : =4                 SC0SR1_NF_bm:   equ     %00000100 ; Noise Error
(1)       0 : =2                 SC0SR1_FE_bm:   equ     %00000010 ; Framing Error
(1)       0 : =1                 SC0SR1_PF_bm:   equ     %00000001 ; Parity Error
