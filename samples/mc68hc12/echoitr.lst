(2)    40C1 : 62 00                      inc     queue_len,x
(2)    40C3 : C0 03                      subb    #queue_buf-1    ; the next put index
(2)    40C5 : 6B 02                      stab    queue_put,x
(2)    40C7 : E1 01                      cmpb    queue_size,x
(2)    40C9 : 25 04                      blo     queue_add_return ; carry is set
(2)    40CB : 69 02                      clr     queue_put,x
(2)    40CD : 14 01                      sec                     ; set carry
