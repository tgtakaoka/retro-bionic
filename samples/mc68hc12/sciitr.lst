(1)    20B5 :                    ;;; [queue] queue structure
(1)    20B5 : =0                 queue_len:      equ     0       ; queue length
(1)    20B5 : =1                 queue_size:     equ     1       ; buffer size
(1)    20B5 : =2                 queue_put:      equ     2       ; queue put index
(1)    20B5 : =3                 queue_get:      equ     3       ; queue get index
(1)    20B5 : =4                 queue_buf:      equ     4       ; buffer start offset
(1)    20B5 :
(1)    20B5 :                    ;;; [queue] Initialize queue
