(1)    20B5 : 37                         pshb
(1)    20B6 : 34                         pshx
(1)    20B7 :                    queue_init_loop:
(1)    20B7 : 69 00                      clr     0,x
(1)    20B9 : 08                         inx
(1)    20BA : 53                         decb
(1)    20BB : 26 FA                      bne     queue_init_loop
(1)    20BD : 30                         pulx
(1)    20BE : 33                         pulb
(1)    20BF : C0 04                      subb    #queue_buf
