          0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
          0 :                    ;;; CP/M 2.2 on a V20/V30 in 8080 emulation mode. The Makefile appends
          0 :                    ;;; ../i8080/cpm80.hex, the 8080 cold boot, to this image at
          0 :                    ;;; SEG_I8080:0000; L v30/cpm80.hex loads both and mounts cpm80.dsk
          0 :                    ;;; beside it, whose BIOS polls the USART and runs with interrupts off.
          0 :                    ;;; The disk's DMAX puts the BIOS's 16-bit DMA addresses in SEG_I8080.
          0 :                            include "../i8080/i8080.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :                    ;;; i8080
(1)       0 :                            cpu     8080
(1)       0 :                    ;;; FLAGS Register
(1)       0 : =80                F_SIGN:         equ     10000000B ; set to 1 if negative
(1)       0 : =40                F_ZERO:         equ     01000000B ; set to 1 if zero
(1)       0 : =10                F_HALF_CARRY:   equ     00010000B ; set to 1 if carry from bit-3
(1)       0 : =4                 F_PARITY:       equ     00000100B ; set to 1 if even parity
(1)       0 : =1                 F_CARRY:        equ     00000001B ; set to 1 if carry
(1)       0 :                    ;;; Interrupt origin
(1)       0 : =0                 ORG_RESET:      equ     0000H   ; RESET
(1)       0 : =0                 ORG_RST0:       equ     0000H   ; RST 0
(1)       0 : =8                 ORG_RST1:       equ     0008H   ; RST 1
(1)       0 : =10                ORG_RST2:       equ     0010H   ; RST 2
(1)       0 : =18                ORG_RST3:       equ     0018H   ; RST 3
(1)       0 : =20                ORG_RST4:       equ     0020H   ; RST 4
(1)       0 : =28                ORG_RST5:       equ     0028H   ; RST 5
(1)       0 : =30                ORG_RST6:       equ     0030H   ; RST 6
(1)       0 : =38                ORG_RST7:       equ     0038H   ; RST 7
(1)       0 :                    ;;; RST instructions, which the 8251 hands the CPU in an INTA cycle
(1)       0 : =C7                INST_RST0:      equ     0C7H    ; RST 0
(1)       0 : =CF                INST_RST1:      equ     0CFH    ; RST 1
(1)       0 : =D7                INST_RST2:      equ     0D7H    ; RST 2
(1)       0 : =DF                INST_RST3:      equ     0DFH    ; RST 3
(1)       0 : =E7                INST_RST4:      equ     0E7H    ; RST 4
(1)       0 : =EF                INST_RST5:      equ     0EFH    ; RST 5
(1)       0 : =F7                INST_RST6:      equ     0F7H    ; RST 6
(1)       0 : =FF                INST_RST7:      equ     0FFH    ; RST 7
          0 :                            cpu     V30
          0 :
          0 : =1000              SEG_I8080:      equ     1000H   ; CP/M's 64K
          0 : =22                VEC_I8080:      equ     22H     ; BRKEM's vector to its reset entry
          0 : =50                DISK:           equ     50H
          0 :                            include "../i8080/sector_disk.inc"
(1)       0 :                    ;;; -*- mode: asm; mode: flyspell-prog; -*-
(1)       0 :
(1)       0 :                    ;;; The debugger's paravirtual sector disk (debugger/sector_disk.h).
(1)       0 :                    ;;; DISK is its base port.
(1)       0 : =50                DISK_DRIVE:     equ     DISK+0  ; 0-3
(1)       0 : =51                DISK_TRACK:     equ     DISK+1  ; 0-76
(1)       0 : =52                DISK_SECTOR:    equ     DISK+2  ; 1-26, physical
(1)       0 : =53                DISK_DMAL:      equ     DISK+3  ; DMA address, low byte
(1)       0 : =54                DISK_DMAH:      equ     DISK+4  ; high byte
(1)       0 : =55                DISK_COMMAND:   equ     DISK+5  ; write a command, read its status
(1)       0 : =56                DISK_MOUNTED:   equ     DISK+6  ; bit n: drive n has its image
(1)       0 : =57                DISK_DMAX:      equ     DISK+7  ; DMA address bits 16-23
(1)       0 : =1                 CMD_READ:       equ     1
(1)       0 : =2                 CMD_WRITE:      equ     2
          0 :
         88 :                            org     VEC_I8080*4
         88 : 00 00 00 10                dw      ORG_RESET, SEG_I8080
         8C :
       1000 :                            org     1000H
       1000 : =1000              stack:  equ     $
       1000 :
       1000 :                    init:
       1000 : B8 00 10                   mov     ax, SEG_I8080
       1003 : 8E D8                      mov     ds, ax          ; DS0, the 8080 data segment
       1005 : 31 C0                      xor     ax, ax
       1007 : 8E D0                      mov     ss, ax
       1009 : BC 00 10                   mov     sp, stack
       100C : B0 01                      mov     al, SEG_I8080/1000H     ; DMA bits 16-23
       100E : E6 57                      out     DISK_DMAX, al
       1010 : 0F FF 22                   brkem   VEC_I8080
       1013 : EB FE                      jmp     $               ; CP/M never returns
       1015 :
      FFFF0 :                            org     0FFFF0H
      FFFF0 : EA 00 10 00 00             jmpf    0:init
      FFFF5 :
      FFFF5 :                            end
