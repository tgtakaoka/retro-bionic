(1)       0 : =1                 CDS_DIV16_gc    =       001B    / /16
(1)       0 : =2                 CDS_DIV64_gc    =       010B    / /64
(1)       0 : =3                 CDS_RESET_gc    =       011B    / Master Reset
(1)       0 :                    //  Word Select Bits
(1)       0 : =34                WSB_gm          =       011100B / Group mask
(1)       0 : =0                 WSB_7E2_gc      =       000000B / 7 Bits + Even Parity + 2 Stop Bits
