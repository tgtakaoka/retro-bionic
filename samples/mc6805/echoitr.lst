       10F5 :                    isr_irq:
       10F5 : C6 17 F8                   lda     ACIA_status
       10F8 : A5 80                      bit     #IRQF_bm
       10FA : 27 1D                      beq     isr_irq_exit
       10FC : A5 01                      bit     #RDRF_bm
       10FE : 27 08                      beq     isr_irq_send
       1100 : C6 17 F9                   lda     ACIA_data       ; receive character
       1103 : AE 80                      ldx     #rx_queue
       1105 : CD 10 A9                   jsr     queue_add
       1108 :                    isr_irq_send:
       1108 : C6 17 F8                   lda     ACIA_status
       110B : A5 02                      bit     #TDRE_bm
       110D : 27 0A                      beq     isr_irq_exit
       110F : AE 90                      ldx     #tx_queue
       1111 : CD 10 D4                   jsr     queue_remove
       1114 : 24 04                      bcc     isr_irq_send_empty
       1116 : C7 17 F9                   sta     ACIA_data       ; send character
       1119 :                    isr_irq_exit:
       1119 : 80                         rti
       111A :                    isr_irq_send_empty:
       111A : A6 94                      lda     #RX_INT_TX_NO
       111C : C7 17 F8                   sta     ACIA_control    ; disable Tx interrupt
       111F : 80                         rti
