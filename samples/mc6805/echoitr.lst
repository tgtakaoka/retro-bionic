       1056 : A1 0A                      cmp     #10
       1058 : 25 04                      blo     put_hex8_dec
       105A : AB 37                      add     #'A'-10
       105C : 20 2C                      bra     putchar
       105E :                    put_hex8_dec:
       105E : AB 30                      add     #'0'
       1060 : 20 28                      bra     putchar
       1062 :
       1062 :                    ;;; Print uint8_t in binary
