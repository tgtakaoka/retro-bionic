       103E : 20 4A                      bra     putchar
       1040 :
       1040 :                    ;;; Print uint8_t in hex
       1040 :                    ;;; @param A(save_a) uint8_t value to be printed in hex.
       1040 :                    put_hex8:
       1040 : B7 50                      sta     save_a
       1042 : A6 30                      lda     #'0'
       1044 : AD 44                      bsr     putchar
       1046 : A6 78                      lda     #'x'
       1048 : AD 40                      bsr     putchar
       104A : B6 50                      lda     save_a
       104C : 44                         lsra
       104D : 44                         lsra
       104E : 44                         lsra
       104F : 44                         lsra
       1050 : AD 02                      bsr     put_hex4
       1052 : B6 50                      lda     save_a
       1054 :                    put_hex4:
