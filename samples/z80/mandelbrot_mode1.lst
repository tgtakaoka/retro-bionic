        110 : CD A9 03                   call    queue_init
        113 :                    init_usart:
        113 :                            ;; IN/OUT (C) put B on A8-A15. Boards decoding 16-bit I/O
        113 :                            ;; addresses find the USART at 0140H; the others decode A0-A7
        113 :                            ;; alone and find it at 40H.
        113 : 01 41 01                   ld      BC, 0100H|USARTC
        116 : AF                         xor     A               ; clear A
        117 : ED 79                      out     (C), A
        119 : ED 79                      out     (C), A
        11B : ED 79                      out     (C), A          ; safest way to sync mode
        11D : 3E 40                      ld      A, CMD_IR_bm
        11F : ED 79                      out     (C), A          ; reset
