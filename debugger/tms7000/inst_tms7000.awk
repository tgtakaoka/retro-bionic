#!/usr/bin/gawk -f
# -*- mode: awk; -*-
# Generates the tables of inst_tms7000.cpp; from debugger/tms7000:
#
#   gawk -f inst_tms7000.awk tms7000.txt \
#       | clang-format --assume-filename=inst_tms7000.cpp
#
# and replace the tables after the "// Generated by:" line in the .cpp.
# -v MODE=pretty prints the input tables back aligned instead.

BEGIN {
    if (MODE == "")
        MODE = "table";
    if (MODE != "table" && MODE != "pretty") {
        print "MODE must be table or pretty" > "/dev/stderr";
        exit 1;
    }
    PRETTY_PRINT = MODE == "pretty";
    GENERATE_TABLE = MODE == "table";
    GENERATED_BY = generated_by("inst_tms7000.awk");
}

# The command that made the tables, wrapped to 80 columns so clang-format
# keeps it.
function generated_by(script,  i, cmd, line, word) {
    cmd = "";
    line = "// Generated by: gawk -f " script;
    for (i = 1; i <= ARGC; i++) {
        word = (i < ARGC) ? ARGV[i] : "| clang-format";
        if (length(line) + 1 + length(word) > 78) {
            cmd = cmd line "\n";
            line = "//     " word;
        } else {
            line = line " " word;
        }
    }
    return cmd line;
}

BEGIN {
    if (PRETTY_PRINT) {
        pretty_print("op", "mnemo", "operand",    "#", "bus");
        pretty_print("--", "-----", "----------", "-", "-");
    }
    if (GENERATE_TABLE) {
        printf("%s\n", GENERATED_BY);
        printf("constexpr uint8_t INST_TABLE[] = {\n");
    }
}

function pretty_print(opc, mnemo, operand, len, bus) {
    if (PRETTY_PRINT == 0)
        return;
    printf("%-2s  %-5s  %-10s  %s  %s\n",
           opc, mnemo, operand, len, bus);
}

function generate_ENTRY(opc, mnemo, operand, len, bus) {
    if (GENERATE_TABLE == 0)
        return;
    if (bus == "-")
        bus = "0";
    if (len == "-") {
        printf("        0,  // %s\n",  opc);
    } else {
        printf("        E(%d, %d),  // %s: %-5s %s\n",
               len, bus, opc, mnemo, operand);
    }
}

END {
    if (GENERATE_TABLE)
        printf("};\n");
}

$1 !~ /[0-9A-F][0-9A-F]/ { next; }
$1 ~ /[0-9A-F][0-9A-F]/ {
    opc = $1;
    mne = $2;
    opr = $3;
    len = $4;
    bus = $5;

    pretty_print(opc, mne, opr, len, bus);
    generate_ENTRY(opc, mne, opr, len, bus);
}
